# Supabase — get these from your project dashboard → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Session signing secret — generate a random 32+ character string
# e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# Stripe memberships — leave PAYMENTS_ENABLED=false while MYAH is free.
# Use test keys (sk_test_…) until launch. See STRIPE.md.
PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=sk_test_replace-me
STRIPE_WEBHOOK_SECRET=whsec_replace-me
