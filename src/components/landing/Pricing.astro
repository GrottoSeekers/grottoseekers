---
const base = import.meta.env.BASE_URL;
---

<section id="pricing">
  <div class="section-inner">
    <p class="section-label">Simple Pricing</p>
    <h2 class="section-title">One plan. No surprises.</h2>
    <div class="divider"></div>

    <div class="pricing-grid">
      <div class="pricing-card free">
        <div class="pricing-badge">Start Here</div>
        <h3>Free Trial</h3>
        <div class="pricing-amount">
          <span class="amount">&pound;0</span>
          <span class="period">for 1 month</span>
        </div>
        <ul>
          <li>Your own sitter profile page</li>
          <li>Photo gallery &amp; carousel</li>
          <li>Enquiry form (email + WhatsApp)</li>
          <li>Add your reviews</li>
          <li>Services &amp; pricing display</li>
          <li>Mobile-friendly design</li>
        </ul>
        <a href={`${base}signup`} class="btn-primary">Start Free Trial</a>
      </div>

      <div class="pricing-card pro">
        <div class="pricing-badge popular">Most Popular</div>
        <h3>GrottoSitters Pro</h3>
        <div class="pricing-amount">
          <span class="amount">&pound;9</span>
          <span class="period">/ month</span>
        </div>
        <ul>
          <li>Everything in Free Trial</li>
          <li>Custom profile URL</li>
          <li>Unlimited photo uploads</li>
          <li>Priority support</li>
          <li>Profile analytics</li>
          <li>Cancel anytime</li>
        </ul>
        <a href={`${base}signup`} class="btn-primary">Start Free Trial</a>
        <p class="pricing-note">Billed monthly after trial. Cancel anytime.</p>
      </div>
    </div>

    <div class="pricing-reassurance">
      <p>
        One sit typically earns &pound;75&ndash;&pound;200+. Your GrottoSitters
        profile pays for itself with a single booking.
      </p>
    </div>
  </div>
</section>

<style>
  section {
    padding: 80px 48px;
    background: var(--warm-white);
  }

  .pricing-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
    max-width: 800px;
    margin: 0 auto;
  }

  .pricing-card {
    background: var(--cream);
    border: 1px solid rgba(200, 150, 62, 0.12);
    border-radius: 14px;
    padding: 36px 28px;
    position: relative;
    text-align: center;
  }

  .pricing-card.pro {
    border-color: var(--gold);
    border-width: 2px;
    box-shadow: 0 12px 40px rgba(200, 150, 62, 0.15);
  }

  .pricing-badge {
    display: inline-block;
    background: var(--gold-pale);
    color: var(--brown-mid);
    padding: 4px 16px;
    border-radius: 20px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 16px;
  }

  .pricing-badge.popular {
    background: var(--gold);
    color: #fff;
  }

  .pricing-card h3 {
    font-family: "Playfair Display", serif;
    font-size: 1.3rem;
    color: var(--brown-dark);
    margin-bottom: 12px;
  }

  .pricing-amount {
    margin-bottom: 24px;
  }

  .amount {
    font-family: "Playfair Display", serif;
    font-size: 3rem;
    color: var(--gold);
    font-weight: 700;
  }

  .period {
    font-size: 0.9rem;
    color: var(--text-soft);
  }

  ul {
    list-style: none;
    text-align: left;
    margin-bottom: 28px;
  }

  li {
    padding: 8px 0;
    color: var(--text-soft);
    font-size: 0.88rem;
    border-bottom: 1px solid rgba(200, 150, 62, 0.08);
    padding-left: 24px;
    position: relative;
  }

  li::before {
    content: "\2713";
    position: absolute;
    left: 0;
    color: var(--sage);
    font-weight: 700;
  }

  .pricing-note {
    margin-top: 12px;
    font-size: 0.78rem;
    color: var(--text-soft);
    font-style: italic;
  }

  .pricing-reassurance {
    text-align: center;
    margin-top: 40px;
    background: rgba(200, 150, 62, 0.08);
    border-left: 3px solid var(--gold);
    padding: 20px 24px;
    border-radius: 0 8px 8px 0;
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
  }

  .pricing-reassurance p {
    color: var(--text-soft);
    font-size: 0.92rem;
    line-height: 1.7;
  }

  @media (max-width: 768px) {
    section {
      padding: 60px 24px;
    }

    .pricing-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
