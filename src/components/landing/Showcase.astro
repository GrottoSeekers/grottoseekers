---
const base = import.meta.env.BASE_URL;
const photos = [
  { src: `${base}images/callum-niamh-airport.jpg`, alt: "Callum and Niamh at the airport" },
  { src: `${base}images/callum-niamh-boat.jpg`, alt: "Callum and Niamh on a boat" },
  { src: `${base}images/callum-niamh-dinner.jpg`, alt: "Callum and Niamh at dinner" },
];
---

<section id="showcase">
  <div class="section-inner">
    <p class="section-label">See It In Action</p>
    <h2 class="section-title">Real sitter, real profile.</h2>
    <div class="divider"></div>
    <p class="showcase-intro">
      Here's what a GrottoSitters profile looks like — this is Callum &amp; Niamh's
      live profile, the founders of the platform. Every sitter gets a page just
      like this.
    </p>

    <div class="showcase-preview">
      <div class="preview-browser">
        <div class="browser-bar">
          <div class="browser-dots">
            <span></span><span></span><span></span>
          </div>
          <div class="browser-url">grottositters.com/sitter/callum-niamh</div>
        </div>
        <div class="preview-content">
          <div class="preview-hero-mock">
            <div class="preview-photos">
              {photos.map((photo) => (
                <img src={photo.src} alt={photo.alt} loading="lazy" />
              ))}
            </div>
            <div class="preview-info">
              <h3>Callum &amp; Niamh</h3>
              <p>Trusted house &amp; pet sitters across the UK and Australia.</p>
              <div class="preview-stars">
                <span>&#9733;&#9733;&#9733;&#9733;&#9733;</span>
                <span class="star-count">40+ reviews</span>
              </div>
              <div class="preview-services">
                <span>House Sitting</span>
                <span>Dog Sitting</span>
                <span>All Pets</span>
              </div>
            </div>
          </div>
        </div>
      </div>
      <a href={`${base}sitter/callum-niamh`} class="btn-primary showcase-cta">View Full Profile</a>
    </div>
  </div>
</section>

<style>
  section {
    padding: 80px 48px;
    background: var(--cream);
  }

  .showcase-intro {
    color: var(--text-soft);
    margin-bottom: 40px;
    max-width: 600px;
    line-height: 1.75;
    font-size: 0.95rem;
  }

  .showcase-preview {
    text-align: center;
  }

  .preview-browser {
    background: #fff;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 20px 60px rgba(44, 26, 14, 0.12);
    max-width: 800px;
    margin: 0 auto 32px;
  }

  .browser-bar {
    background: var(--brown-dark);
    padding: 12px 16px;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .browser-dots {
    display: flex;
    gap: 6px;
  }

  .browser-dots span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.3);
  }

  .browser-dots span:first-child { background: #ff5f57; }
  .browser-dots span:nth-child(2) { background: #ffbd2e; }
  .browser-dots span:last-child { background: #28c840; }

  .browser-url {
    flex: 1;
    background: rgba(255, 255, 255, 0.1);
    padding: 6px 14px;
    border-radius: 6px;
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.8rem;
    font-family: monospace;
  }

  .preview-content {
    padding: 32px;
  }

  .preview-hero-mock {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
    align-items: center;
    text-align: left;
  }

  .preview-photos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }

  .preview-photos img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 8px;
  }

  .preview-photos img:first-child {
    grid-row: span 2;
    aspect-ratio: auto;
    height: 100%;
  }

  .preview-info h3 {
    font-family: "Playfair Display", serif;
    font-size: 1.5rem;
    color: var(--brown-dark);
    margin-bottom: 8px;
  }

  .preview-info p {
    color: var(--text-soft);
    font-size: 0.9rem;
    line-height: 1.6;
    margin-bottom: 12px;
  }

  .preview-stars {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
    color: var(--gold);
    font-size: 1rem;
  }

  .star-count {
    color: var(--text-soft);
    font-size: 0.8rem;
  }

  .preview-services {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .preview-services span {
    background: var(--gold-pale);
    color: var(--brown-mid);
    padding: 6px 14px;
    border-radius: 20px;
    font-size: 0.78rem;
    font-weight: 700;
  }

  .showcase-cta {
    margin-top: 8px;
  }

  @media (max-width: 768px) {
    section {
      padding: 60px 24px;
    }

    .preview-hero-mock {
      grid-template-columns: 1fr;
    }

    .preview-content {
      padding: 20px;
    }
  }
</style>
