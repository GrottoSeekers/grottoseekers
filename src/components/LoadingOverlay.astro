<div id="gs-loader" aria-hidden="true">
  <div class="loader-stack">
    <div class="loader-ring"></div>
    <img src="/images/logo-mark.png" alt="" />
  </div>
</div>

<style>
  #gs-loader {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: var(--myah-paper, #faf6ee);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }
  #gs-loader.visible {
    opacity: 1;
    pointer-events: all;
  }
  #gs-loader .loader-stack {
    position: relative;
    width: 132px;
    height: 132px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  #gs-loader .loader-ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 3px solid rgba(47, 93, 69, 0.18);
    border-top-color: #2f5d45;
    animation: gs-spin 0.8s linear infinite;
  }
  #gs-loader img {
    width: 72px;
    height: 72px;
    object-fit: contain;
  }
  @keyframes gs-spin {
    to { transform: rotate(360deg); }
  }
</style>

<script>
  const loader = document.getElementById('gs-loader');

  function show() {
    loader?.classList.add('visible');
  }

  // Nav links (exclude anchors, logout, external)
  document.querySelectorAll<HTMLAnchorElement>('a[href]').forEach(a => {
    const href = a.getAttribute('href') ?? '';
    if (
      href.startsWith('#') ||
      href.startsWith('http') ||
      href.startsWith('mailto') ||
      href.startsWith('tel') ||
      a.target === '_blank'
    ) return;
    a.addEventListener('click', e => {
      if (e.metaKey || e.ctrlKey || e.shiftKey) return;
      show();
    });
  });

  // Form submits
  document.querySelectorAll('form').forEach(form => {
    form.addEventListener('submit', () => show());
  });

  // Hide on back-navigation (bfcache restore)
  window.addEventListener('pageshow', e => {
    if (e.persisted) loader?.classList.remove('visible');
  });
</script>
