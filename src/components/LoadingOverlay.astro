<div id="gs-loader" aria-hidden="true">
  <div class="loader-stack">
    <div class="loader-ring"></div>
    <img src="/images/logo-mark.png" alt="" />
  </div>
</div>

<script>
  const loader = document.getElementById('gs-loader');

  function show() {
    loader?.classList.add('visible');
  }

  // Nav links (exclude anchors, logout, external)
  document.querySelectorAll<HTMLAnchorElement>('a[href]').forEach(a => {
    const href = a.getAttribute('href') ?? '';
    if (
      href.startsWith('#') ||
      href.startsWith('http') ||
      href.startsWith('mailto') ||
      href.startsWith('tel') ||
      a.target === '_blank'
    ) return;
    a.addEventListener('click', e => {
      if (e.metaKey || e.ctrlKey || e.shiftKey) return;
      show();
    });
  });

  // Form submits
  document.querySelectorAll('form').forEach(form => {
    form.addEventListener('submit', () => show());
  });

  // Hide on back-navigation (bfcache restore)
  window.addEventListener('pageshow', e => {
    if (e.persisted) loader?.classList.remove('visible');
  });
</script>
