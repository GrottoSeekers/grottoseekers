---
export const prerender = false;

import { supabase } from '../lib/supabase';
import '../styles/global.css';

interface HeroImage { src: string; pos: string }
interface Photo     { src: string; alt: string }
interface Review    { text: string; name: string; initials: string; platform: string }
interface Platform  { name: string; url: string; emoji: string; description: string }

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/');

let profile: any = null;
try {
  const { data, error } = await supabase
    .from('profiles')
    .select('*')
    .eq('slug', slug)
    .single();
  if (!error) profile = data;
} catch {}

if (!profile) {
  Astro.response.status = 404;
}

const heroImages    = (profile?.hero_images_json  ?? []) as HeroImage[];
const aboutImages   = (profile?.about_images_json ?? []) as Photo[];
const gallery       = (profile?.gallery_json       ?? []) as Photo[];
const reviews       = (profile?.reviews_json       ?? []) as Review[];
const platforms     = (profile?.platforms_json     ?? []) as Platform[];
const bioParagraphs = ((profile?.bio as string) ?? '').split('\n\n').filter(Boolean);

const isSolo = (profile?.account_type ?? 'solo') === 'solo';
const h = (profile?.headings_json ?? {}) as Record<string, string>;
const heading = {
  aboutLabel:     h.about_label     || (isSolo ? 'Who I Am' : 'Who We Are'),
  aboutTitle:     h.about_title     || 'A home away from home — for you and your pets.',
  reviewsLabel:   h.reviews_label   || 'What Pet Owners Say',
  reviewsTitle:   h.reviews_title   || '',
  galleryLabel:   h.gallery_label   || (isSolo ? 'Pets I\'ve Loved' : 'Pets We\'ve Loved'),
  galleryTitle:   h.gallery_title   || (isSolo ? 'My Sits' : 'Our Sits'),
  platformsLabel: h.platforms_label || (isSolo ? 'Find Me Online' : 'Find Us Online'),
  platformsTitle: h.platforms_title || 'Verified Profiles',
  enquiryLabel:   h.enquiry_label   || 'Get In Touch',
  enquiryTitle:   h.enquiry_title   || (profile ? `Book ${profile.name}` : ''),
};
const reviewsHeading = heading.reviewsTitle || (reviews.length === 1 ? '1 five-star review.' : `${reviews.length} five-star reviews.`);

const t = (profile?.theme_json ?? {}) as Record<string, string>;
const theme = {
  background:  t.background   || '',
  accent:      t.accent       || '',
  accentLight: t.accent_light || '',
  text:        t.text         || '',
  textSoft:    t.text_soft    || '',
};
const vars: string[] = [];
if (theme.background)  { vars.push(`--cream:${theme.background}`, `--warm-white:${theme.background}`); }
if (theme.accent)      { vars.push(`--gold:${theme.accent}`); }
if (theme.accentLight) { vars.push(`--gold-light:${theme.accentLight}`); }
if (theme.text)        { vars.push(`--brown-dark:${theme.text}`, `--text:${theme.text}`, `--brown-mid:${theme.text}`); }
if (theme.textSoft)    { vars.push(`--text-soft:${theme.textSoft}`); }
const themeStyle = vars.length ? vars.join(';') : undefined;
---

<!doctype html>
{profile ? (
<html lang="en" style={themeStyle ?? ''}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={`${profile.name} — trusted house & pet sitters.`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Lato:wght@300;400;700&display=swap" rel="stylesheet" />
    <title>{profile.name} — Grotto Sitters</title>
  </head>
  <body>
    <nav>
      <a href="/" class="nav-logo">Grotto <span>Sitters</span></a>
      <button class="nav-toggle" aria-label="Toggle navigation">
        <span></span><span></span><span></span>
      </button>
      <ul>
        <li class="nav-panel-brand"><a href="/">Grotto <span>Sitters</span></a></li>
        <li><a href="#about">About</a></li>
        {reviews.length > 0 && <li><a href="#reviews">Reviews</a></li>}
        {gallery.length > 0 && <li><a href="#gallery">Gallery</a></li>}
        {platforms.length > 0 && <li><a href="#profiles">Profiles</a></li>}
        <li><a href="#enquiry">{isSolo ? 'Book Me' : 'Book Us'}</a></li>
      </ul>
    </nav>
    <div class="nav-overlay" id="navOverlay"></div>

    <section class="hero">
      <div class="hero-slideshow" id="heroSlideshow">
        {heroImages.map((img, i) => (
          <div class={`hero-slide ${i === 0 ? 'active' : ''}`}>
            <img src={img.src} alt="" loading={i === 0 ? 'eager' : 'lazy'} style={`object-position: ${img.pos}`} />
          </div>
        ))}
      </div>
      <div class="hero-overlay"></div>
      <div class="hero-content">
        {profile.badge_text && <p class="hero-badge">{profile.badge_text}</p>}
        <h1>Grotto<br /><em>Sitters</em></h1>
        <p class="hero-names">{profile.name}</p>
        {profile.tagline && <p class="hero-tagline">{profile.tagline}</p>}
        <a href="#enquiry" class="btn-primary">{isSolo ? 'Book Me Today' : 'Book Us Today'}</a>
      </div>
    </section>

    <section id="about" class="about-section">
      <div class="section-inner about-grid">
        <div class="about-carousel">
          <div class="carousel-track" id="aboutCarouselTrack">
            {aboutImages.map((photo, i) => (
              <div class={`carousel-slide ${i === 0 ? 'active' : ''}`}>
                <img src={photo.src} alt={photo.alt} loading="lazy" />
              </div>
            ))}
          </div>
          <button class="carousel-btn carousel-prev" id="aboutPrev" aria-label="Previous photo">&#8249;</button>
          <button class="carousel-btn carousel-next" id="aboutNext" aria-label="Next photo">&#8250;</button>
          <div class="carousel-dots" id="aboutDots">
            {aboutImages.map((_, i) => (
              <button class={`dot ${i === 0 ? 'active' : ''}`} data-index={i} aria-label={`Go to photo ${i + 1}`}></button>
            ))}
          </div>
        </div>
        <div class="about-text">
          <p class="section-label">{heading.aboutLabel}</p>
          <h2 class="section-title">{heading.aboutTitle}</h2>
          <div class="divider"></div>
          {bioParagraphs.map(para => <p>{para}</p>)}
        </div>
      </div>
    </section>

    {reviews.length > 0 && (
    <section id="reviews" class="reviews-section">
      <div class="section-inner">
        <p class="section-label">{heading.reviewsLabel}</p>
        <h2 class="section-title">{reviewsHeading}</h2>
        <div class="divider"></div>
        <div class="stars-row">
          <span class="star">&#9733;</span><span class="star">&#9733;</span>
          <span class="star">&#9733;</span><span class="star">&#9733;</span>
          <span class="star">&#9733;</span>
          <span class="stars-label">5.0 across all platforms</span>
        </div>
        <div class="reviews-track-wrapper">
          <div class="reviews-track" id="reviewsTrack">
            {reviews.map(review => (
              <div class="review-card">
                <div class="review-stars">
                  <span class="star">&#9733;</span><span class="star">&#9733;</span>
                  <span class="star">&#9733;</span><span class="star">&#9733;</span>
                  <span class="star">&#9733;</span>
                </div>
                <p class="review-text">"{review.text}"</p>
                <div class="review-author">
                  <div class="review-avatar">{review.initials}</div>
                  <div>
                    <div class="review-name">{review.name}</div>
                    <div class="review-platform">{review.platform}</div>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
        <div class="reviews-nav">
          <button class="rev-btn" id="prevBtn">&larr;</button>
          <button class="rev-btn" id="nextBtn">&rarr;</button>
          <div class="rev-dots" id="revDots"></div>
        </div>
      </div>
    </section>
    )}

    {gallery.length > 0 && (
    <section id="gallery" class="gallery-section">
      <div class="section-inner">
        <p class="section-label">{heading.galleryLabel}</p>
        <h2 class="section-title">{heading.galleryTitle}</h2>
        <div class="divider"></div>
        <div class="gallery-grid">
          {gallery.map(img => (
            <div class="gallery-item">
              <img src={img.src} alt={img.alt} loading="lazy" />
            </div>
          ))}
        </div>
      </div>
    </section>
    )}

    {platforms.length > 0 && (
    <section id="profiles" class="platforms-section">
      <div class="section-inner">
        <p class="section-label">{heading.platformsLabel}</p>
        <h2 class="section-title">{heading.platformsTitle}</h2>
        <div class="divider"></div>
        <div class="profiles-grid">
          {platforms.map(p => (
            <a href={p.url} target="_blank" rel="noopener noreferrer" class="platform-card">
              <span class="platform-logo">{p.name.charAt(0).toUpperCase()}</span>
              <h3>{p.name}</h3>
              <p>{p.description}</p>
              <span class="platform-link-text">View Profile &rarr;</span>
            </a>
          ))}
        </div>
      </div>
    </section>
    )}

    <section id="enquiry" class="enquiry-section">
      <div class="section-inner enquiry-inner">
        <div class="enquiry-text">
          <p class="section-label">{heading.enquiryLabel}</p>
          <h2 class="section-title">{heading.enquiryTitle}</h2>
          <div class="divider"></div>
          <p>{isSolo ? 'Tell me about your home, your pets, and your dates and I\'ll get back to you within 24 hours.' : 'Tell us about your home, your pets, and your dates and we\'ll get back to you within 24 hours.'}</p>
          {profile.whatsapp_number && (
            <a href={`https://wa.me/${profile.whatsapp_number.replace(/[^0-9]/g, '')}?text=${encodeURIComponent(`Hi ${profile.name}! I found you on Grotto Sitters and I'm interested in your pet sitting services.`)}`} target="_blank" rel="noopener" class="whatsapp-btn">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              Message on WhatsApp
            </a>
          )}
        </div>
        <form class="enquiry-form" id="enquiryForm" data-slug={profile.slug}>
          <div class="form-row">
            <div class="form-group">
              <label for="fname">First Name</label>
              <input type="text" id="fname" name="first_name" placeholder="Jane" required />
            </div>
            <div class="form-group">
              <label for="lname">Last Name</label>
              <input type="text" id="lname" name="last_name" placeholder="Smith" required />
            </div>
          </div>
          <div class="form-group">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" placeholder="jane@example.com" required />
          </div>
          <div class="form-row">
            <div class="form-group">
              <label for="date-from">From</label>
              <input type="date" id="date-from" name="date_from" required />
            </div>
            <div class="form-group">
              <label for="date-to">To</label>
              <input type="date" id="date-to" name="date_to" required />
            </div>
          </div>
          <div class="form-group">
            <label for="message">{isSolo ? 'Tell me about your pets & home' : 'Tell us about your pets & home'}</label>
            <textarea id="message" name="message" rows="4" placeholder="Breed, age, any special needs..."></textarea>
          </div>
          <button type="submit" class="btn-primary" id="sendEnquiryBtn" style="width:100%">Send Enquiry</button>
          <p class="enquiry-status" id="enquiryStatus"></p>
        </form>
      </div>
    </section>

    <footer>
      <div class="footer-inner">
        <div class="footer-top">
          <div class="footer-brand">
            <h2>Grotto <span>Sitters</span></h2>
            <p>{profile.name} — experienced house and pet {isSolo ? 'sitter' : 'sitters'}.</p>
          </div>
          <div class="footer-links">
            <h4>Quick Links</h4>
            <ul>
              <li><a href="#about">{isSolo ? 'About Me' : 'About Us'}</a></li>
              <li><a href="#reviews">Reviews</a></li>
              <li><a href="#gallery">Gallery</a></li>
              <li><a href="#profiles">{isSolo ? 'My Profiles' : 'Our Profiles'}</a></li>
              <li><a href="#enquiry">{isSolo ? 'Book Me' : 'Book Us'}</a></li>
            </ul>
          </div>
          <div class="footer-links">
            <h4>Platforms</h4>
            <ul>
              {platforms.map(p => (
                <li><a href={p.url} target="_blank" rel="noopener noreferrer">{p.name}</a></li>
              ))}
            </ul>
          </div>
        </div>
        <div class="footer-bottom">
          <span>&copy; {new Date().getFullYear()} Grotto Sitters &middot; {profile.name}</span>
          <span>Made with &#128062; for pet lovers everywhere</span>
        </div>
      </div>
    </footer>
  </body>
</html>
) : (
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Lato:wght@300;400;700&display=swap" rel="stylesheet" />
    <title>Profile not found — Grotto Sitters</title>
  </head>
  <body style="min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;background:#faf6ee;font-family:Lato,sans-serif;text-align:center;padding:48px;">
    <h1 style="font-family:Playfair Display,serif;font-size:2rem;color:#2c1a0e;margin-bottom:12px;">Profile not found</h1>
    <p style="color:#6b4e35;font-size:1rem;line-height:1.7;margin-bottom:28px;max-width:400px;">We couldn't find a sitter with that URL. They may not have created their profile yet.</p>
    <a href="/" style="background:#c8963e;color:#fff;padding:12px 32px;border-radius:8px;text-decoration:none;font-weight:700;font-size:0.9rem;">Go to Grotto Sitters</a>
  </body>
</html>
)}

<style>
  .hero { min-height: 70vh; display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden; padding: 100px 48px 60px; text-align: center; }
  .hero-slideshow { position: absolute; inset: 0; z-index: 0; }
  .hero-slide { position: absolute; inset: 0; opacity: 0; transition: opacity 1.2s ease; }
  .hero-slide.active { opacity: 1; }
  .hero-slide img { width: 100%; height: 100%; object-fit: cover; }
  .hero-overlay { position: absolute; inset: 0; background: rgba(44,26,14,0.55); z-index: 1; }
  .hero-content { position: relative; z-index: 2; max-width: 700px; }
  .hero-badge { display: inline-block; background: rgba(255,255,255,0.15); color: #fff; padding: 8px 20px; border-radius: 50px; font-size: 0.8rem; font-weight: 700; letter-spacing: 0.1em; margin-bottom: 24px; }
  .hero-content h1 { font-family: "Playfair Display", serif; font-size: 5rem; color: #fff; line-height: 1; margin-bottom: 16px; }
  .hero-content h1 em { color: var(--gold); font-style: italic; }
  .hero-names { font-size: 1.15rem; color: rgba(255,255,255,0.9); font-weight: 700; letter-spacing: 0.06em; margin-bottom: 16px; }
  .hero-tagline { font-size: 1.15rem; color: rgba(255,255,255,0.8); line-height: 1.7; max-width: 520px; margin: 0 auto 36px; }

  .about-section { padding: 80px 48px; background: var(--warm-white); }
  .about-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center; }
  .about-carousel { position: relative; width: 100%; aspect-ratio: 4/5; border-radius: 12px; overflow: hidden; background: var(--gold-pale); }
  .carousel-track { position: relative; width: 100%; height: 100%; }
  .carousel-slide { position: absolute; inset: 0; opacity: 0; transition: opacity 0.5s ease; }
  .carousel-slide.active { opacity: 1; }
  .carousel-slide img { width: 100%; height: 100%; object-fit: cover; object-position: center top; display: block; }
  .carousel-btn { position: absolute; top: 50%; transform: translateY(-50%); background: rgba(255,255,255,0.85); border: none; width: 40px; height: 40px; border-radius: 50%; font-size: 1.4rem; color: var(--brown-dark); cursor: pointer; z-index: 2; display: flex; align-items: center; justify-content: center; transition: background 0.2s, transform 0.2s; }
  .carousel-btn:hover { background: #fff; transform: translateY(-50%) scale(1.1); }
  .carousel-prev { left: 12px; }
  .carousel-next { right: 12px; }
  .carousel-dots { position: absolute; bottom: 14px; left: 50%; transform: translateX(-50%); display: flex; gap: 8px; z-index: 2; }
  .dot { width: 10px; height: 10px; border-radius: 50%; border: 2px solid rgba(255,255,255,0.8); background: transparent; cursor: pointer; padding: 0; transition: background 0.2s; }
  .dot.active { background: rgba(255,255,255,0.9); }
  .about-text p { color: var(--text-soft); line-height: 1.8; margin-bottom: 16px; font-size: 0.95rem; }

  .reviews-section { padding: 80px 48px; background: var(--warm-white); }
  .stars-row { display: flex; align-items: center; gap: 4px; margin-bottom: 32px; }
  .star { color: var(--gold); font-size: 1.2rem; }
  .stars-label { color: var(--text-soft); font-size: 0.85rem; margin-left: 12px; font-weight: 700; }
  .reviews-track-wrapper { overflow: hidden; margin-bottom: 24px; }
  .reviews-track { display: flex; gap: 24px; transition: transform 0.4s ease; }
  .review-card { min-width: 340px; max-width: 340px; background: var(--cream); border: 1px solid rgba(200,150,62,0.12); border-radius: 12px; padding: 28px; flex-shrink: 0; }
  .review-stars { margin-bottom: 14px; }
  .review-stars .star { font-size: 0.95rem; }
  .review-text { color: var(--text-soft); font-size: 0.88rem; line-height: 1.75; margin-bottom: 20px; font-style: italic; }
  .review-author { display: flex; align-items: center; gap: 12px; }
  .review-avatar { width: 40px; height: 40px; border-radius: 50%; background: var(--gold); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 0.75rem; font-weight: 700; flex-shrink: 0; }
  .review-name { font-weight: 700; color: var(--brown-dark); font-size: 0.9rem; }
  .review-platform { color: var(--text-soft); font-size: 0.78rem; }
  .reviews-nav { display: flex; align-items: center; gap: 12px; }
  .rev-btn { width: 40px; height: 40px; border-radius: 50%; border: 1px solid rgba(200,150,62,0.3); background: transparent; color: var(--brown-mid); font-size: 1rem; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: background 0.2s, color 0.2s; }
  .rev-btn:hover { background: var(--gold); color: #fff; border-color: var(--gold); }
  .rev-dots { display: flex; gap: 6px; margin-left: 8px; }

  .gallery-section { padding: 80px 48px; background: var(--cream); }
  .gallery-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 16px; }
  .gallery-item { border-radius: 10px; overflow: hidden; aspect-ratio: 1; background: var(--gold-pale); }
  .gallery-item img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.3s ease; }
  .gallery-item:hover img { transform: scale(1.04); }

  .platforms-section { padding: 80px 48px; background: var(--warm-white); }
  .platforms-intro { color: var(--text-soft); margin-bottom: 40px; max-width: 500px; line-height: 1.75; font-size: 0.95rem; }
  .profiles-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 28px; }
  .platform-card { display: block; background: var(--cream); border: 1px solid rgba(200,150,62,0.15); border-radius: 12px; padding: 36px 28px; text-decoration: none; transition: transform 0.2s, box-shadow 0.2s; }
  .platform-card:hover { transform: translateY(-4px); box-shadow: 0 12px 32px rgba(44,26,14,0.08); }
  .platform-logo { font-family: "Playfair Display", serif; font-size: 1.6rem; font-weight: 700; width: 44px; height: 44px; border-radius: 50%; background: var(--gold); color: #fff; display: flex; align-items: center; justify-content: center; margin-bottom: 14px; }
  .platform-card h3 { font-family: "Playfair Display", serif; font-size: 1.25rem; color: var(--brown-dark); margin-bottom: 10px; }
  .platform-card p { color: var(--text-soft); line-height: 1.7; font-size: 0.9rem; margin-bottom: 16px; }
  .platform-link-text { color: var(--gold); font-weight: 700; font-size: 0.85rem; letter-spacing: 0.04em; }

  .enquiry-section { padding: 80px 48px; background: var(--cream); }
  .enquiry-inner { display: grid; grid-template-columns: 1fr 1.4fr; gap: 60px; align-items: start; }
  .enquiry-text p { color: var(--text-soft); line-height: 1.8; font-size: 0.95rem; }
  .enquiry-form { display: flex; flex-direction: column; gap: 18px; }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .form-group { display: flex; flex-direction: column; gap: 6px; }
  .form-group label { font-size: 0.8rem; font-weight: 700; letter-spacing: 0.06em; color: var(--brown-mid); text-transform: uppercase; }
  .form-group input, .form-group textarea {
    padding: 12px 16px; border: 1.5px solid rgba(200,150,62,0.25); border-radius: 6px;
    background: #fff; color: var(--text); font-family: "Lato", sans-serif; font-size: 0.95rem; transition: border-color 0.2s;
  }
  .form-group input:focus, .form-group textarea:focus { outline: none; border-color: var(--gold); }
  .form-group textarea { resize: vertical; min-height: 100px; }

  .whatsapp-btn {
    display: inline-flex; align-items: center; gap: 10px; margin-top: 20px;
    padding: 14px 24px; background: #25D366; color: #fff; border-radius: 8px;
    font-size: 0.9rem; font-weight: 700; text-decoration: none;
    transition: background 0.2s, transform 0.15s;
  }
  .whatsapp-btn:hover { background: #1ebe5d; transform: translateY(-1px); }
  .whatsapp-btn svg { flex-shrink: 0; }

  .enquiry-status { font-size: 0.85rem; text-align: center; min-height: 1.2em; }
  .enquiry-success { color: #166534; font-weight: 600; }
  .enquiry-error { color: #b91c1c; font-weight: 600; }

  @media (max-width: 768px) {
    .hero { padding: 100px 24px 60px; }
    .hero-content h1 { font-size: 3.2rem; }
    .about-section, .reviews-section, .gallery-section, .platforms-section, .enquiry-section { padding: 60px 24px; }
    .about-grid { grid-template-columns: 1fr; gap: 40px; }
    .review-card { min-width: 280px; max-width: 280px; }
    .gallery-grid { grid-template-columns: repeat(2, 1fr); }
    .profiles-grid, .enquiry-inner { grid-template-columns: 1fr; }
    .form-row { grid-template-columns: 1fr; }
  }
</style>

<script>
  const toggle  = document.querySelector('.nav-toggle');
  const navList = document.querySelector('nav ul');
  const overlay = document.getElementById('navOverlay');

  function closeMenu() {
    navList?.classList.remove('open');
    overlay?.classList.remove('open');
    toggle?.classList.remove('open');
  }

  toggle?.addEventListener('click', () => {
    const isOpen = navList?.classList.toggle('open');
    overlay?.classList.toggle('open', isOpen);
    toggle?.classList.toggle('open', isOpen);
  });

  overlay?.addEventListener('click', closeMenu);

  navList?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', (e) => {
      const href = link.getAttribute('href');
      if (href?.startsWith('#')) {
        e.preventDefault();
        closeMenu();
        setTimeout(() => {
          const target = document.querySelector(href);
          if (target) {
            const navH = (document.querySelector('nav') as HTMLElement)?.offsetHeight ?? 60;
            window.scrollTo({ top: (target as HTMLElement).getBoundingClientRect().top + window.scrollY - navH, behavior: 'smooth' });
          }
        }, 50);
      } else {
        closeMenu();
      }
    });
  });

  const heroSlides = document.querySelectorAll('#heroSlideshow .hero-slide');
  if (heroSlides.length > 1) {
    let cur = 0;
    setInterval(() => {
      heroSlides[cur].classList.remove('active');
      cur = (cur + 1) % heroSlides.length;
      heroSlides[cur].classList.add('active');
    }, 5000);
  }

  const slides  = document.querySelectorAll('#aboutCarouselTrack .carousel-slide');
  const dots    = document.querySelectorAll('#aboutDots .dot');
  const prevBtn = document.getElementById('aboutPrev');
  const nextBtn = document.getElementById('aboutNext');

  if (slides.length) {
    let cur = 0;
    let timer: ReturnType<typeof setInterval>;
    const goTo = (i: number) => {
      slides[cur].classList.remove('active');
      dots[cur]?.classList.remove('active');
      cur = (i + slides.length) % slides.length;
      slides[cur].classList.add('active');
      dots[cur]?.classList.add('active');
    };
    const reset = () => { clearInterval(timer); timer = setInterval(() => goTo(cur + 1), 4000); };
    prevBtn?.addEventListener('click', () => { goTo(cur - 1); reset(); });
    nextBtn?.addEventListener('click', () => { goTo(cur + 1); reset(); });
    dots.forEach(d => d.addEventListener('click', () => { goTo(Number((d as HTMLElement).dataset.index)); reset(); }));
    let tx = 0;
    const track = document.getElementById('aboutCarouselTrack');
    track?.addEventListener('touchstart', (e: TouchEvent) => { tx = e.touches[0].clientX; }, { passive: true });
    track?.addEventListener('touchend', (e: TouchEvent) => {
      const diff = tx - e.changedTouches[0].clientX;
      if (Math.abs(diff) > 40) { goTo(diff > 0 ? cur + 1 : cur - 1); reset(); }
    });
    reset();
  }

  const track   = document.getElementById('reviewsTrack') as HTMLElement;
  const cards   = track?.querySelectorAll('.review-card');
  const dotsEl  = document.getElementById('revDots') as HTMLElement;
  const revPrev = document.getElementById('prevBtn');
  const revNext = document.getElementById('nextBtn');

  if (track && cards && dotsEl) {
    let rcur = 0;
    const visible = () => window.innerWidth >= 900 ? 3 : window.innerWidth >= 600 ? 2 : 1;
    const cardW   = () => (cards[0] as HTMLElement).offsetWidth + 24;
    const maxIdx  = () => Math.max(0, cards.length - visible());
    const buildDots = () => {
      dotsEl.innerHTML = '';
      for (let i = 0; i <= maxIdx(); i++) {
        const d = Object.assign(document.createElement('div'), { className: `rev-dot${i === rcur ? ' active' : ''}` });
        Object.assign(d.style, { width:'8px', height:'8px', borderRadius:'50%', background: i === rcur ? 'var(--gold)' : 'var(--gold-pale)', cursor:'pointer', transition:'background 0.2s' });
        d.addEventListener('click', () => goRev(i));
        dotsEl.appendChild(d);
      }
    };
    const goRev = (i: number) => {
      rcur = Math.max(0, Math.min(i, maxIdx()));
      track.style.transform = `translateX(-${rcur * cardW()}px)`;
      dotsEl.querySelectorAll('div').forEach((d, j) => { d.style.background = j === rcur ? 'var(--gold)' : 'var(--gold-pale)'; });
    };
    revPrev?.addEventListener('click', () => goRev(rcur - 1));
    revNext?.addEventListener('click', () => goRev(rcur + 1));
    window.addEventListener('resize', () => { buildDots(); goRev(rcur); });
    buildDots();
    goRev(0);
  }

  const eForm = document.getElementById('enquiryForm') as HTMLFormElement;
  eForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('sendEnquiryBtn') as HTMLButtonElement;
    const status = document.getElementById('enquiryStatus')!;
    btn.disabled = true;
    btn.textContent = 'Sending...';
    status.textContent = '';
    status.className = 'enquiry-status';

    const fd = new FormData(eForm);
    fd.set('slug', eForm.dataset.slug ?? '');

    try {
      const res = await fetch('/api/enquiry', { method: 'POST', body: fd });
      if (res.ok) {
        status.textContent = 'Enquiry sent! You\'ll hear back soon.';
        status.classList.add('enquiry-success');
        eForm.reset();
      } else {
        const data = await res.json().catch(() => ({}));
        status.textContent = data.error || 'Something went wrong. Please try again.';
        status.classList.add('enquiry-error');
      }
    } catch {
      status.textContent = 'Failed to send. Please try again.';
      status.classList.add('enquiry-error');
    }
    btn.disabled = false;
    btn.textContent = 'Send Enquiry';
  });
</script>
