  <script define:vars={{ heroImages, aboutImages, reviews, isOwner, profileSlug: profile.slug }}>
    // ── Hero slideshow ────────────────────────────────────────────
    const heroSlides = Array.from(document.querySelectorAll('[data-hero-slide]'));
    if (heroSlides.length > 1) {
      let heroIdx = 0;
      setInterval(() => {
        heroSlides[heroIdx].style.opacity = '0';
        heroIdx = (heroIdx + 1) % heroSlides.length;
        heroSlides[heroIdx].style.opacity = '1';
      }, 5000);
    }

    // ── About carousel ────────────────────────────────────────────
    const aboutSlides = Array.from(document.querySelectorAll('[data-about-slide]'));
    const aboutDots = Array.from(document.querySelectorAll('[data-about-dot]'));
    let aboutIdx = 0;
    let aboutTimer;

    function goAbout(n) {
      aboutSlides[aboutIdx].style.opacity = '0';
      aboutDots[aboutIdx] && (aboutDots[aboutIdx].style.background = 'transparent');
      aboutIdx = (n + aboutSlides.length) % aboutSlides.length;
      aboutSlides[aboutIdx].style.opacity = '1';
      aboutDots[aboutIdx] && (aboutDots[aboutIdx].style.background = 'rgba(255,255,255,.9)');
    }

    if (aboutSlides.length > 1) {
      document.querySelector('[data-about-prev]')?.addEventListener('click', () => { clearInterval(aboutTimer); goAbout(aboutIdx - 1); aboutTimer = setInterval(() => goAbout(aboutIdx + 1), 4500); });
      document.querySelector('[data-about-next]')?.addEventListener('click', () => { clearInterval(aboutTimer); goAbout(aboutIdx + 1); aboutTimer = setInterval(() => goAbout(aboutIdx + 1), 4500); });
      aboutDots.forEach((dot, i) => dot.addEventListener('click', () => { clearInterval(aboutTimer); goAbout(i); aboutTimer = setInterval(() => goAbout(aboutIdx + 1), 4500); }));
      aboutTimer = setInterval(() => goAbout(aboutIdx + 1), 4500);
    }

    // ── Reviews carousel ─────────────────────────────────────────
    const track = document.getElementById('revTrack');
    const cards = track ? Array.from(track.querySelectorAll('[data-rev-card]')) : [];
    const dotsEl = document.getElementById('revDots');
    const CARD_W = 330 + 24;
    let revIdx = 0;
    let perPage = Math.max(1, Math.floor((window.innerWidth - 96) / CARD_W));

    function buildRevDots() {
      if (!dotsEl) return;
      const pages = Math.max(1, cards.length - perPage + 1);
      dotsEl.innerHTML = '';
      for (let i = 0; i < pages; i++) {
        const d = document.createElement('button');
        d.style.cssText = `width:9px;height:9px;border-radius:50%;border:none;cursor:pointer;padding:0;background:${i === revIdx ? '#2f5d45' : 'rgba(110,84,56,.25)'}`;
        d.addEventListener('click', () => goRev(i));
        dotsEl.appendChild(d);
      }
    }

    function goRev(n) {
      const max = Math.max(0, cards.length - perPage);
      revIdx = Math.max(0, Math.min(n, max));
      if (track) track.style.transform = `translateX(-${revIdx * CARD_W}px)`;
      buildRevDots();
    }

    document.getElementById('revPrev')?.addEventListener('click', () => goRev(revIdx - 1));
    document.getElementById('revNext')?.addEventListener('click', () => goRev(revIdx + 1));
    buildRevDots();

    // ── Gallery lightbox ─────────────────────────────────────────
    const lb = document.getElementById('lb');
    const lbImg = document.getElementById('lbImg');
    const lbCap = document.getElementById('lbCap');
    document.querySelectorAll('[data-lightbox]').forEach(btn => {
      btn.addEventListener('click', () => {
        lbImg.src = btn.dataset.lightbox;
        lbImg.alt = btn.dataset.lightboxAlt || '';
        lbCap.textContent = btn.dataset.lightboxAlt || '';
        lb.style.opacity = '1';
        lb.style.pointerEvents = 'all';
        document.body.style.overflow = 'hidden';
      });
    });
    document.getElementById('lbClose')?.addEventListener('click', closeLb);
    lb?.addEventListener('click', e => { if (e.target === lb) closeLb(); });
    document.addEventListener('keydown', e => { if (e.key === 'Escape') closeLb(); });
    function closeLb() {
      lb.style.opacity = '0'; lb.style.pointerEvents = 'none';
      document.body.style.overflow = '';
    }

    // ── Enquiry form ─────────────────────────────────────────────
    document.getElementById('enquiryForm')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = e.target.querySelector('[type=submit]');
      const status = document.getElementById('enquiryStatus');
      const fd = new FormData(e.target);
      btn.disabled = true;
      btn.textContent = 'Sending…';
      try {
        const res = await fetch('/api/enquiry', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            slug: profileSlug,
            first_name: fd.get('first_name'),
            last_name: fd.get('last_name'),
            email: fd.get('email'),
            date_from: fd.get('date_from'),
            date_to: fd.get('date_to'),
            message: fd.get('message'),
          })
        });
        if (res.ok) {
          if (status) status.textContent = "Enquiry sent! You'll hear back soon.";
          e.target.reset();
        } else {
          if (status) status.textContent = 'Something went wrong. Please try again.';
          if (status) status.style.color = '#c0392b';
        }
      } catch {
        if (status) { status.textContent = 'Something went wrong. Please try again.'; status.style.color = '#c0392b'; }
      }
      btn.disabled = false;
      btn.textContent = 'Send enquiry';
    });

    // ── Loading overlay on navigation ────────────────────────────
    const loader = document.getElementById('loader');
    document.querySelectorAll('a[href]').forEach(a => {
      const href = a.getAttribute('href') || '';
      if (href.startsWith('#') || href.startsWith('http') || href.startsWith('mailto') || href.startsWith('tel') || a.target === '_blank') return;
      a.addEventListener('click', e => {
        if (e.metaKey || e.ctrlKey || e.shiftKey) return;
        if (loader) { loader.style.opacity = '1'; loader.style.pointerEvents = 'all'; }
      });
    });
  </script>

</body>
</html>
) : (
