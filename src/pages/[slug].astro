---
export const prerender = false;

import { supabase } from '../lib/supabase';

interface HeroImage { src: string; pos: string }
interface Photo     { src: string; alt: string }
interface Review    { text: string; name: string; initials: string; platform: string }
interface Platform  { name: string; url: string; emoji: string; description: string }

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/');

let profile: any = null;
try {
  const { data, error } = await supabase
    .from('profiles')
    .select('*')
    .eq('slug', slug)
    .single();
  if (!error) profile = data;
} catch {}

if (!profile) {
  Astro.response.status = 404;
}

const heroImages    = (profile?.hero_images_json  ?? []) as HeroImage[];
const aboutImages   = (profile?.about_images_json ?? []) as Photo[];
const gallery       = (profile?.gallery_json       ?? []) as Photo[];
const reviews       = (profile?.reviews_json       ?? []) as Review[];
const platforms     = (profile?.platforms_json     ?? []) as Platform[];
const bioParagraphs = ((profile?.bio as string) ?? '').split('\n\n').filter(Boolean);

const isOwner = profile?.profile_type === 'owner';
const isSolo = (profile?.account_type ?? 'solo') === 'solo';
const pets: any[] = (profile?.pets_json ?? []) as any[];
const amenities: string[] = (profile?.amenities_json ?? []) as string[];

const h = (profile?.headings_json ?? {}) as Record<string, string>;
const heading = isOwner ? {
  aboutLabel:     h.about_label     || 'About Our Home',
  aboutTitle:     h.about_title     || 'A great place to stay — for you and the pets.',
  reviewsLabel:   h.reviews_label   || 'What Sitters Say',
  galleryLabel:   h.gallery_label   || 'Meet the Pets',
  galleryTitle:   h.gallery_title   || 'Our Pets',
  platformsLabel: h.platforms_label || 'Our Home',
  platformsTitle: h.platforms_title || 'Gallery',
  enquiryLabel:   h.enquiry_label   || 'Get In Touch',
  enquiryTitle:   h.enquiry_title   || (profile ? `Contact ${profile.name}` : ''),
} : {
  aboutLabel:     h.about_label     || (isSolo ? 'Who I Am' : 'Who We Are'),
  aboutTitle:     h.about_title     || 'A home away from home — for you and your pets.',
  reviewsLabel:   h.reviews_label   || 'What Pet Owners Say',
  galleryLabel:   h.gallery_label   || (isSolo ? "Pets I've Loved" : "Pets We've Loved"),
  galleryTitle:   h.gallery_title   || (isSolo ? 'My Sits' : 'Our Sits'),
  platformsLabel: h.platforms_label || (isSolo ? 'Find Me Online' : 'Find Us Online'),
  platformsTitle: h.platforms_title || 'Verified Profiles',
  enquiryLabel:   h.enquiry_label   || 'Get In Touch',
  enquiryTitle:   h.enquiry_title   || (profile ? (isSolo ? `Book ${profile.name}` : `Book ${profile.name}`) : ''),
};
const reviewsHeading = (h.reviews_title) || (reviews.length === 1 ? '1 five-star review.' : `${reviews.length}+ five-star reviews.`);
const reviewCount = reviews.length;
const rating = profile?.rating ?? 5.0;
const location = profile?.location ?? '';
const whatsapp = profile?.whatsapp_number ?? '';
const badgeText = profile?.badge_text ?? (isSolo ? 'Experienced sitter worldwide' : 'Experienced sitters worldwide');
const enquiryDesc = isOwner
  ? "Tell us about your experience, availability, and why you'd be a great fit."
  : (isSolo ? "Tell me about your home, your pets, and your dates and I'll get back to you within 24 hours." : "Tell us about your home, your pets, and your dates and we'll get back to you within 24 hours.");
---

<!doctype html>
{profile ? (
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={isOwner ? `${profile.name} — looking for a trusted pet sitter.` : `${profile.name} — trusted house & pet sitter${isSolo ? '' : 's'}.`} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="icon" type="image/png" href="/images/favicon.png" />
  <link rel="apple-touch-icon" href="/images/app-tile.png" />
  <meta property="og:image" content="/images/logo-tile.png" />
  <link href="https://fonts.googleapis.com/css2?family=Marcellus&family=Montserrat:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Lato:wght@400;700&display=swap" rel="stylesheet" />
  <title>{profile.name} — MYAH</title>
  <style>
    body { margin: 0; background: #faf6ee; color: #2c1a0e; font-family: "Montserrat", sans-serif; overflow-x: hidden; }
    * { box-sizing: border-box; }
    a { color: #2f5d45; }
    a:hover { color: #2c1a0e; }
    input::placeholder, textarea::placeholder { color: rgba(44,26,14,.35); }
    @keyframes gs-ring { to { transform: rotate(360deg); } }
    @keyframes gs-pulse { 0%,100% { transform: scale(1); } 50% { transform: scale(1.05); } }
    [data-navlink]:hover { color: #2f5d45 !important; }
    [data-cta]:hover { background: #3e7a5b !important; border-color: #3e7a5b !important; transform: translateY(-2px) !important; box-shadow: 0 12px 28px rgba(110,84,56,.36) !important; }
    [data-cta]:active { transform: translateY(0) scale(.98) !important; }
    [data-revbtn]:hover { background: #2f5d45 !important; color: #fff !important; border-color: #2f5d45 !important; }
    [data-aboutbtn]:hover { background: #fff !important; }
    [data-platcard]:hover { transform: translateY(-6px) !important; box-shadow: 0 20px 50px rgba(44,26,14,.1) !important; border-color: rgba(110,84,56,.45) !important; }
    [data-scrolldown]:hover { background: rgba(250,246,238,.25) !important; transform: translateX(-50%) translateY(3px) !important; }
    [data-lbclose]:hover { background: rgba(250,246,238,.25) !important; }
    [data-gallitem]:hover img { transform: scale(1.06); }
    [data-gallitem]:hover [data-gallovl] { opacity: 1 !important; }
    [data-field]:focus { border-color: #2f5d45 !important; box-shadow: 0 0 0 3px rgba(110,84,56,.15) !important; }
    [data-wabtn]:hover { background: #1ebe5d !important; transform: translateY(-2px) !important; }
    [data-wabtn]:active { transform: translateY(0) scale(.98) !important; }
    @media (max-width: 1000px) {
      [data-headernav] { display: none !important; }
      [data-topbar] { padding: 14px 24px !important; }
      [data-sec] { padding-left: 24px !important; padding-right: 24px !important; }
      [data-split] { grid-template-columns: minmax(0,1fr) !important; gap: 40px !important; }
      [data-statgrid] { grid-template-columns: repeat(2,minmax(0,1fr)) !important; }
    }
  </style>
</head>
<body style="background:#faf6ee">

  <!-- Loading overlay -->
  <div id="loader" aria-hidden="true" style="position:fixed;inset:0;z-index:9999;background:rgba(250,246,238,.92);backdrop-filter:blur(8px);display:flex;align-items:center;justify-content:center;opacity:0;pointer-events:none;transition:opacity .25s ease">
    <div style="position:relative;width:132px;height:132px;display:flex;align-items:center;justify-content:center">
      <div style="position:absolute;inset:0;border-radius:50%;border:3px solid rgba(110,84,56,.18)"></div>
      <div style="position:absolute;inset:0;border-radius:50%;border:3px solid transparent;border-top-color:#2f5d45;border-right-color:rgba(110,84,56,.45);animation:gs-ring 1s linear infinite"></div>
      <img src="/images/logo-mark.png" alt="" style="width:74px;height:74px;object-fit:contain;animation:gs-pulse 1.8s ease-in-out infinite" />
    </div>
  </div>

  <!-- Fixed header -->
  <header data-topbar="1" style="position:fixed;top:0;left:0;right:0;z-index:210;padding:16px 48px;display:flex;justify-content:space-between;align-items:center;gap:40px;background:rgba(250,246,238,.97);backdrop-filter:blur(12px);box-shadow:0 1px 0 rgba(110,84,56,.2)">
    <a href="/" style="display:inline-flex;align-items:center;gap:14px;text-decoration:none;line-height:1;margin-left:-4px;font-family:'Montserrat',sans-serif;font-weight:500;font-size:1.4rem;flex-shrink:0;letter-spacing:.28em">
      <img src="/images/logo-mark.png" alt="" style="height:46px;width:46px;display:block;object-fit:contain" />
      <span style="display:flex;flex-direction:column;gap:5px;padding-left:14px;border-left:1px solid rgba(110,84,56,.4)">
        <span style="color:#2f5d45;line-height:1">MYAH</span>
        <span style="font-family:'Lato',sans-serif;font-weight:700;font-size:.5rem;letter-spacing:.2em;text-transform:uppercase;color:#8a6a4f;line-height:1">Make Yourself At Home</span>
      </span>
    </a>
    <nav data-headernav="1" style="display:flex;align-items:center;gap:30px;flex-wrap:nowrap">
      <a href="#about" data-navlink="1" style="font-size:.8rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#5c3d20;text-decoration:none;white-space:nowrap;transition:color .2s">{isOwner ? 'Home' : 'About'}</a>
      {reviews.length > 0 && <a href="#reviews" data-navlink="1" style="font-size:.8rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#5c3d20;text-decoration:none;white-space:nowrap;transition:color .2s">Reviews</a>}
      {gallery.length > 0 && <a href="#gallery" data-navlink="1" style="font-size:.8rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#5c3d20;text-decoration:none;white-space:nowrap;transition:color .2s">Gallery</a>}
      {!isOwner && platforms.length > 0 && <a href="#profiles" data-navlink="1" style="font-size:.8rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#5c3d20;text-decoration:none;white-space:nowrap;transition:color .2s">Profiles</a>}
      <a href="#enquiry" data-cta="1" style="display:inline-flex;align-items:center;justify-content:center;gap:8px;font-size:.78rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#fff;text-decoration:none;background:#2f5d45;border:1.5px solid #2f5d45;border-radius:50px;padding:13px 28px;cursor:pointer;white-space:nowrap;box-shadow:0 4px 14px rgba(44,26,14,.18);transition:background .2s, border-color .2s, transform .12s">
        {isOwner ? 'Get In Touch' : (isSolo ? 'Book Me Today' : 'Book Us Today')}
      </a>
    </nav>
  </header>

  <!-- Hero -->
  <section style="min-height:78vh;display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden;padding:140px 48px 80px;text-align:center">
    <div style="position:absolute;inset:0;z-index:0;background:#2c1a0e">
      {heroImages.map((img, i) => (
        <img data-hero-slide="1" src={img.src} alt="" style={`position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:${img.pos || 'center 30%'};opacity:${i === 0 ? 1 : 0};transition:opacity 1.2s ease`} />
      ))}
      {heroImages.length === 0 && (
        <div style="position:absolute;inset:0;background:linear-gradient(135deg, #2c1a0e 0%, #3d2614 100%)"></div>
      )}
    </div>
    <div style="position:absolute;inset:0;z-index:1;background:linear-gradient(180deg, rgba(44,26,14,.52) 0%, rgba(44,26,14,.66) 100%)"></div>
    <div style="position:relative;z-index:2;max-width:720px">
      <p style="display:inline-flex;align-items:center;gap:10px;background:rgba(250,246,238,.14);border:1px solid rgba(196,171,138,.45);backdrop-filter:blur(6px);color:#fff;padding:9px 20px;border-radius:50px;font-size:.76rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;margin:0 0 26px">{badgeText}</p>
      <h1 style="font-family:'Montserrat',sans-serif;font-weight:500;letter-spacing:.28em;font-size:4.6rem;color:#fff;line-height:1;margin:0 0 18px">MYAH<br /><em style="color:#c4ab8a;">{isOwner ? 'Home' : 'Sitters'}</em></h1>
      <p style="font-size:1.1rem;color:#fff;font-weight:600;letter-spacing:.14em;text-transform:uppercase;margin:0 0 18px">{profile.name}</p>
      {profile.tagline && <p style="font-size:1.08rem;color:rgba(255,255,255,.85);line-height:1.75;max-width:540px;margin:0 auto 36px">{profile.tagline}</p>}
      <a href="#enquiry" data-cta="1" style="display:inline-flex;align-items:center;justify-content:center;gap:8px;font-size:.82rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#fff;text-decoration:none;background:#2f5d45;border:1.5px solid #2f5d45;border-radius:50px;padding:16px 36px;cursor:pointer;box-shadow:0 8px 26px rgba(44,26,14,.3);transition:background .2s, border-color .2s, transform .12s">
        {isOwner ? 'Get In Touch' : (isSolo ? 'Book Me Today' : 'Book Us Today')}
      </a>
      <div style="display:flex;align-items:center;justify-content:center;gap:20px;flex-wrap:wrap;margin:34px 0 0;font-size:.78rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:rgba(255,255,255,.72)">
        {reviewCount > 0 && <>
          <span style="display:flex;align-items:center;gap:8px"><span style="color:#c4ab8a;letter-spacing:.2em">★★★★★</span>{rating.toFixed(1)} rating</span>
          <span style="width:5px;height:5px;border-radius:50%;background:rgba(196,171,138,.6)"></span>
          <span>{reviewCount}+ reviews</span>
        </>}
        {location && <>
          <span style="width:5px;height:5px;border-radius:50%;background:rgba(196,171,138,.6)"></span>
          <span>{location}</span>
        </>}
      </div>
    </div>
    <a href="#about" aria-label="Scroll to about" data-scrolldown="1" style="position:absolute;bottom:30px;left:50%;transform:translateX(-50%);z-index:2;width:42px;height:42px;border-radius:50%;border:1px solid rgba(196,171,138,.5);background:rgba(250,246,238,.12);backdrop-filter:blur(6px);display:flex;align-items:center;justify-content:center;color:#fff;text-decoration:none;transition:background .2s, transform .2s">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"></path></svg>
    </a>
  </section>

  <!-- Credentials bar (sitter only) -->
  {!isOwner && reviewCount > 0 && (
  <section data-sec="1" style="background:#2c1a0e;padding:0 48px">
    <div data-statgrid="1" style="max-width:1100px;margin:0 auto;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:0;border-left:1px solid rgba(196,171,138,.18);border-right:1px solid rgba(196,171,138,.18)">
      <div style="padding:34px 26px;text-align:center;border-right:1px solid rgba(196,171,138,.18)">
        <div style="font-family:'Marcellus',serif;font-size:2rem;color:#c4ab8a;line-height:1">{reviewCount}+</div>
        <div style="font-size:.72rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:rgba(255,255,255,.6);margin-top:8px">Five-star reviews</div>
      </div>
      <div style="padding:34px 26px;text-align:center;border-right:1px solid rgba(196,171,138,.18)">
        <div style="font-family:'Marcellus',serif;font-size:2rem;color:#c4ab8a;line-height:1">{rating.toFixed(1)}</div>
        <div style="font-size:.72rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:rgba(255,255,255,.6);margin-top:8px">Average rating</div>
      </div>
      <div style="padding:34px 26px;text-align:center;border-right:1px solid rgba(196,171,138,.18)">
        <div style="font-family:'Marcellus',serif;font-size:2rem;color:#c4ab8a;line-height:1">{platforms.length || 2}</div>
        <div style="font-size:.72rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:rgba(255,255,255,.6);margin-top:8px">Verified platforms</div>
      </div>
      <div style="padding:34px 26px;text-align:center">
        <div style="font-family:'Marcellus',serif;font-size:2rem;color:#c4ab8a;line-height:1">30+</div>
        <div style="font-size:.72rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:rgba(255,255,255,.6);margin-top:8px">Pets cared for</div>
      </div>
    </div>
  </section>
  )}

  <!-- About -->
  <section id="about" data-sec="1" style="padding:100px 48px;background:#faf6ee">
    <div data-split="1" style="max-width:1100px;margin:0 auto;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:60px;align-items:center">
      {aboutImages.length > 0 ? (
      <div style="position:relative;width:100%;aspect-ratio:4/5;border-radius:18px;overflow:hidden;background:#e9e0d2;border:1px solid rgba(110,84,56,.22)">
        {aboutImages.map((img, i) => (
          <img data-about-slide="1" src={img.src} alt={img.alt} style={`position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center top;opacity:${i === 0 ? 1 : 0};transition:opacity .5s ease`} />
        ))}
        {aboutImages.length > 1 && <>
          <button data-aboutbtn="1" data-about-prev="1" aria-label="Previous photo" style="position:absolute;top:50%;left:14px;transform:translateY(-50%);background:rgba(250,246,238,.9);border:1px solid rgba(110,84,56,.3);width:42px;height:42px;border-radius:50%;font-size:1.3rem;color:#2c1a0e;cursor:pointer;z-index:2;display:flex;align-items:center;justify-content:center;transition:background .2s">&#8249;</button>
          <button data-aboutbtn="1" data-about-next="1" aria-label="Next photo" style="position:absolute;top:50%;right:14px;transform:translateY(-50%);background:rgba(250,246,238,.9);border:1px solid rgba(110,84,56,.3);width:42px;height:42px;border-radius:50%;font-size:1.3rem;color:#2c1a0e;cursor:pointer;z-index:2;display:flex;align-items:center;justify-content:center;transition:background .2s">&#8250;</button>
          <div style="position:absolute;bottom:16px;left:50%;transform:translateX(-50%);display:flex;gap:8px;z-index:2">
            {aboutImages.map((_, i) => (
              <button data-about-dot={i} aria-label={`Photo ${i+1}`} style={`width:10px;height:10px;border-radius:50%;border:2px solid rgba(255,255,255,.85);background:${i === 0 ? 'rgba(255,255,255,.9)' : 'transparent'};cursor:pointer;padding:0`}></button>
            ))}
          </div>
        </>}
      </div>
      ) : (
      <div style="position:relative;width:100%;aspect-ratio:4/5;border-radius:18px;overflow:hidden;background:linear-gradient(135deg,#e9e0d2 0%,#d4c4a8 100%);border:1px solid rgba(110,84,56,.22);display:flex;align-items:center;justify-content:center">
        <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="rgba(110,84,56,.3)" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
      </div>
      )}
      <div>
        <p style="font-size:.75rem;font-weight:600;letter-spacing:.2em;text-transform:uppercase;color:#6e5438;margin:0 0 18px;display:flex;align-items:center;gap:12px">
          <span style="width:26px;height:1px;background:#6e5438;display:block;flex-shrink:0"></span>
          {heading.aboutLabel}
        </p>
        <h2 style="font-family:'Marcellus',serif;font-size:2.5rem;color:#2c1a0e;line-height:1.2;margin:0" set:html={heading.aboutTitle.replace(' — ', ' — <em style="color:#2f5d45;">')} />
        <div style="width:48px;height:2px;background:#6e5438;margin:24px 0 26px"></div>
        {bioParagraphs.map(para => (
          <p style="color:#6b4e35;line-height:1.85;margin:0 0 16px;font-size:.98rem">{para}</p>
        ))}
        {bioParagraphs.length === 0 && (
          <p style="color:#8a6a4f;font-style:italic;font-size:.95rem">Bio coming soon.</p>
        )}
      </div>
    </div>
  </section>

  <!-- Reviews -->
  {reviews.length > 0 && (
  <section id="reviews" data-sec="1" style="padding:100px 48px;background:#faf6ee">
    <div style="max-width:1100px;margin:0 auto">
      <p style="font-size:.75rem;font-weight:600;letter-spacing:.2em;text-transform:uppercase;color:#6e5438;margin:0 0 18px;display:flex;align-items:center;gap:12px">
        <span style="width:26px;height:1px;background:#6e5438;display:block;flex-shrink:0"></span>
        {heading.reviewsLabel}
      </p>
      <h2 style="font-family:'Marcellus',serif;font-size:2.5rem;color:#2c1a0e;line-height:1.2;margin:0">{reviewsHeading.replace('five-star', '<em style="color:#2f5d45;">five-star</em>')}</h2>
      <div style="display:flex;align-items:center;gap:14px;margin:24px 0 36px">
        <span style="color:#2f5d45;font-size:1.05rem;letter-spacing:.24em">★★★★★</span>
        <span style="color:#6b4e35;font-size:.8rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase">5.0 across all platforms</span>
      </div>
      <div style="overflow:hidden;margin-bottom:26px">
        <div id="revTrack" style="display:flex;gap:24px;transition:transform .45s ease">
          {reviews.map(r => (
          <div data-rev-card="1" style="min-width:330px;max-width:330px;flex-shrink:0;background:#fff;border:1px solid rgba(110,84,56,.22);border-radius:18px;padding:30px 28px;display:flex;flex-direction:column;gap:16px;box-shadow:0 1px 2px rgba(44,26,14,.04);transition:box-shadow .3s ease, border-color .3s ease">
            <div style="color:#2f5d45;font-size:.85rem;letter-spacing:.3em">★★★★★</div>
            <p style="color:#6b4e35;font-size:.92rem;line-height:1.8;margin:0;font-style:italic">"{r.text}"</p>
            <div style="display:flex;align-items:center;gap:13px;margin-top:auto;padding-top:18px;border-top:1px solid rgba(44,26,14,.08)">
              <span style="width:42px;height:42px;border-radius:50%;background:#2f5d45;color:#fff;display:flex;align-items:center;justify-content:center;font-size:.78rem;font-weight:600;flex-shrink:0;letter-spacing:.04em">{r.initials}</span>
              <div style="min-width:0">
                <div style="font-weight:600;color:#2c1a0e;font-size:.92rem">{r.name}</div>
                <div style="color:#6b4e35;font-size:.78rem;letter-spacing:.04em">{r.platform}</div>
              </div>
            </div>
          </div>
          ))}
        </div>
      </div>
      <div style="display:flex;align-items:center;gap:12px">
        <button id="revPrev" data-revbtn="1" aria-label="Previous reviews" style="width:44px;height:44px;border-radius:50%;border:1.5px solid rgba(110,84,56,.4);background:transparent;color:#5c3d20;font-size:1rem;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:background .2s, color .2s, border-color .2s">&larr;</button>
