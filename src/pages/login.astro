---
import LandingLayout from "../layouts/LandingLayout.astro";
import "../styles/global.css";
const base = import.meta.env.BASE_URL;
---

<LandingLayout title="Log In — GrottoSitters">
  <section class="auth-section">
    <div class="auth-card">
      <h1>Welcome back</h1>
      <p class="auth-subtitle">Log in to manage your sitter profile.</p>

      <form id="loginForm">
        <div class="form-group">
          <label for="email">Email</label>
          <input
            type="email"
            id="email"
            name="email"
            placeholder="you@example.com"
            required
          />
        </div>

        <div class="form-group">
          <label for="password">Password</label>
          <input
            type="password"
            id="password"
            name="password"
            placeholder="Your password"
            required
          />
        </div>

        <button type="submit" class="btn-primary btn-full">Log In</button>
      </form>

      <div class="auth-footer">
        <p>Don't have an account? <a href={`${base}signup`}>Sign up free</a></p>
      </div>
    </div>
  </section>
</LandingLayout>

<style>
  .auth-section {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 120px 24px 80px;
    background: var(--gold-pale);
  }

  .auth-card {
    background: var(--warm-white);
    border: 1px solid rgba(200, 150, 62, 0.15);
    border-radius: 14px;
    padding: 48px 40px;
    max-width: 440px;
    width: 100%;
    box-shadow: 0 12px 40px rgba(44, 26, 14, 0.08);
  }

  h1 {
    font-family: "Playfair Display", serif;
    font-size: 2rem;
    color: var(--brown-dark);
    margin-bottom: 8px;
    text-align: center;
  }

  .auth-subtitle {
    text-align: center;
    color: var(--text-soft);
    font-size: 0.92rem;
    margin-bottom: 32px;
  }

  .form-group {
    margin-bottom: 20px;
  }

  label {
    display: block;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--brown-mid);
    margin-bottom: 6px;
  }

  input {
    width: 100%;
    padding: 12px 14px;
    border: 1px solid rgba(200, 150, 62, 0.2);
    border-radius: 8px;
    font-family: "Lato", sans-serif;
    font-size: 0.9rem;
    color: var(--text);
    background: var(--cream);
    transition: border-color 0.2s;
  }

  input:focus {
    outline: none;
    border-color: var(--gold);
  }

  .btn-full {
    width: 100%;
    text-align: center;
    margin-top: 8px;
  }

  .auth-footer {
    text-align: center;
    margin-top: 24px;
  }

  .auth-footer p {
    color: var(--text-soft);
    font-size: 0.88rem;
  }

  .auth-footer a {
    color: var(--gold);
    font-weight: 700;
    text-decoration: none;
  }

  .auth-footer a:hover {
    text-decoration: underline;
  }
</style>

<script>
  document.getElementById("loginForm")?.addEventListener("submit", (e) => {
    e.preventDefault();
    const email = (document.getElementById("email") as HTMLInputElement).value;
    const password = (document.getElementById("password") as HTMLInputElement).value;

    if (!email || !password) {
      alert("Please fill in all fields.");
      return;
    }

    // Supabase auth will replace this
    alert("Login functionality will be available once the platform launches. Stay tuned!");
  });
</script>
