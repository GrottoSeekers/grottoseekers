        .stats-grid { grid-column: 2; grid-row: 1; flex-direction: column; }
        .overview-grid { grid-template-columns: repeat(3, 1fr); }
        .sits-header { flex-direction: row; }
        .sits-grid { grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); }
        .no-profile { padding: 80px 48px; max-width: 520px; }
      }
      @media (max-width: 768px) {
