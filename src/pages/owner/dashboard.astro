---
export const prerender = false;

import '../../styles/global.css';
import { getSession } from '../../lib/auth';
import { supabase } from '../../lib/supabase';

const session = await getSession(Astro.request);
if (!session) return Astro.redirect('/login');

let profile: any = null;
try {
  const { data } = await supabase
    .from('profiles')
    .select('*')
    .eq('user_id', session.userId)
    .single();
  profile = data;
} catch {}

const pets: any[] = Array.isArray(profile?.pets_json) ? profile.pets_json : [];
const heroImages: any[] = Array.isArray(profile?.hero_images_json) ? profile.hero_images_json : [];
const amenities: string[] = Array.isArray(profile?.amenities_json) ? profile.amenities_json : [];
const gallery: any[] = Array.isArray(profile?.gallery_json) ? profile.gallery_json : [];

let listings: any[] = [];
if (profile) {
  const { data } = await supabase
    .from('listings')
    .select('*')
    .eq('profile_id', profile.id)
    .order('date_from', { ascending: false });
  listings = data ?? [];
}

const activeListings = listings.filter((l: any) => l.status === 'active');
const pastListings = listings.filter((l: any) => l.status !== 'active');

const saved = Astro.url.searchParams.get('saved');
const savedMessages: Record<string, string> = {
  listing: 'Listing saved!',
  deleted: 'Listing deleted.',
};
const savedMsg = savedMessages[saved ?? ''] ?? '';

function formatDate(d: string) {
  return new Date(d + 'T00:00:00').toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });
}

function daysBetween(from: string, to: string) {
  const ms = new Date(to + 'T00:00:00').getTime() - new Date(from + 'T00:00:00').getTime();
  return Math.ceil(ms / 86400000);
}

const homeSetUp = heroImages.length > 0 || pets.length > 0 || amenities.length > 0;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Lato:wght@300;400;700&display=swap" rel="stylesheet" />
    <title>Dashboard — Grotto Sitters</title>
  </head>
  <body>
    <nav>
      <a href="/" class="nav-logo">Grotto <span>Sitters</span></a>
      <div class="nav-right">
        <span class="nav-email">{session.email}</span>
        <a href="/api/auth/logout" class="nav-logout">Log out</a>
      </div>
    </nav>

    <main class="dash-wrap">
      <div class="section-inner">
        <header class="dash-header">
          <div>
            <p class="section-label">Owner Portal</p>
            <h1 class="section-title">Your Dashboard</h1>
            <div class="divider"></div>
          </div>
        </header>

        {savedMsg && <p class="toast toast-success">{savedMsg}</p>}

        {profile ? (
          <>
            {/* ─── PROFILE CARD ─────────────────────────────── */}
            <div class="dash-grid">
              <div class="dash-card profile-card">
                <div class="profile-card-inner">
                  {profile.profile_pic && (
                    <img src={profile.profile_pic} alt={profile.name} class="profile-avatar" />
                  )}
                  <div class="profile-card-info">
                    <h2 class="profile-name">{profile.name}</h2>
                    {profile.location && <p class="profile-location">📍 {profile.location}</p>}
                    {profile.tagline && <p class="profile-tagline">{profile.tagline}</p>}
                    <a href={`/${profile.slug}`} target="_blank" class="profile-link">
                      grottositters.com/{profile.slug}
                    </a>
                  </div>
                </div>
                <div class="profile-card-actions">
                  <a href="/owner/edit" class="btn-primary">Edit profile</a>
                  <a href={`/${profile.slug}`} target="_blank" class="btn-view">View public page</a>
                </div>
              </div>

              <div class="stats-grid">
                <div class="stat-card">
                  <span class="stat-number">{pets.length}</span>
                  <span class="stat-label">Pets</span>
                </div>
                <div class="stat-card">
                  <span class="stat-number">{activeListings.length}</span>
                  <span class="stat-label">Active sits</span>
                </div>
              </div>
            </div>

            {/* ─── SETUP STEPS ──────────────────────────────── */}
            {!homeSetUp && (
              <div class="setup-card">
                <h3>🏠 Set up your home</h3>
                <p>Add photos of your home, your pets, and amenities. This info is reused across all your sit listings — you only need to do it once.</p>
                <a href="/owner/edit" class="btn-primary">Set up home &amp; pets</a>
              </div>
            )}

            {/* ─── LISTINGS ─────────────────────────────────── */}
            <section class="listings-section">
              <div class="listings-header">
                <h2>Your sit listings</h2>
                <a href="/owner/listings/new" class="btn-primary btn-sm">+ New listing</a>
              </div>

              {listings.length === 0 ? (
                <div class="empty-listings">
                  <p>You haven't posted any sit listings yet. Create one so sitters can find your home and get in touch.</p>
                  <a href="/owner/listings/new" class="btn-outline">Post your first sit</a>
                </div>
              ) : (
                <>
                  {activeListings.length > 0 && (
                    <div class="listing-group">
                      <h3 class="listing-group-label">Active</h3>
                      {activeListings.map((l: any) => {
                        const duration = daysBetween(l.date_from, l.date_to);
                        return (
                          <div class="listing-row">
                            <div class="listing-row-info">
                              <h4>{l.title}</h4>
                              <p class="listing-row-dates">
                                📅 {formatDate(l.date_from)} — {formatDate(l.date_to)}
                                <span class="listing-row-duration">{duration}d</span>
                              </p>
                            </div>
                            <div class="listing-row-actions">
                              <a href={`/listings/${l.id}`} target="_blank" class="btn-view-sm">View</a>
                              <a href={`/owner/listings/${l.id}/edit`} class="btn-edit-sm">Edit</a>
                            </div>
                          </div>
                        );
                      })}
                    </div>
                  )}

                  {pastListings.length > 0 && (
                    <details class="listing-group past-group">
                      <summary class="listing-group-label">Past / closed ({pastListings.length})</summary>
                      {pastListings.map((l: any) => (
                        <div class="listing-row listing-row-past">
                          <div class="listing-row-info">
                            <h4>{l.title}</h4>
                            <p class="listing-row-dates">
                              {formatDate(l.date_from)} — {formatDate(l.date_to)}
                              <span class={`status-badge status-${l.status}`}>{l.status}</span>
                            </p>
                          </div>
                          <div class="listing-row-actions">
                            <a href={`/owner/listings/${l.id}/edit`} class="btn-edit-sm">Edit</a>
                          </div>
                        </div>
                      ))}
                    </details>
                  )}
                </>
              )}
            </section>

            {/* ─── QUICK OVERVIEW ───────────────────────────── */}
            <div class="overview-grid">
              <div class="overview-card">
                <h3>🏠 Home Photos</h3>
                <p>{heroImages.length} main photo{heroImages.length !== 1 ? 's' : ''} uploaded</p>
                <a href="/owner/edit#home">Manage photos &rarr;</a>
              </div>
              <div class="overview-card">
                <h3>🐾 Pets</h3>
                {pets.length > 0 ? (
                  <p>{pets.map((p: any) => p.name).join(', ')}</p>
                ) : (
                  <p>No pets added yet</p>
                )}
                <a href="/owner/edit#pets">Manage pets &rarr;</a>
              </div>
              <div class="overview-card">
                <h3>✨ Amenities</h3>
                <p>{amenities.length > 0 ? amenities.slice(0, 4).join(', ') + (amenities.length > 4 ? ` +${amenities.length - 4} more` : '') : 'None selected'}</p>
                <a href="/owner/edit#amenities">Edit amenities &rarr;</a>
              </div>
            </div>

            {/* ─── SHARE CARD ───────────────────────────────── */}
            <div class="dash-card share-card">
              <h3>Share your profile</h3>
              <p>Send this link so sitters can see your home, pets, and get in touch.</p>
              <div class="share-url">
                <input type="text" readonly value={`https://grottositters.com/${profile.slug}`} id="shareUrl" />
                <button onclick="copyUrl()" class="copy-btn">Copy</button>
              </div>
            </div>
          </>
        ) : (
          <div class="no-profile">
            <div class="no-profile-icon">🏠</div>
            <h2>Welcome to Grotto Sitters</h2>
            <p>Create your profile to get started. You'll then set up your home and pets, and post sit listings for sitters to find.</p>
            <a href="/owner/create" class="btn-primary">Create your profile</a>
          </div>
        )}
      </div>
    </main>

    <script>
      function copyUrl() {
        const input = document.getElementById('shareUrl') as HTMLInputElement;
        input?.select();
        navigator.clipboard?.writeText(input?.value ?? '').then(() => {
          const btn = document.querySelector('.copy-btn') as HTMLButtonElement;
          if (btn) { btn.textContent = 'Copied!'; setTimeout(() => { btn.textContent = 'Copy'; }, 2000); }
        });
      }
    </script>

    <style>
      body { min-height: 100vh; display: flex; flex-direction: column; background: var(--cream); }
      nav {
        position: static; border-bottom: 1px solid rgba(200,150,62,0.2); padding: 18px 48px;
        display: flex; justify-content: space-between; align-items: center;
      }
      .nav-right { display: flex; align-items: center; gap: 20px; }
      .nav-email { font-size: 0.85rem; color: var(--text-soft); }
      .nav-logout { font-size: 0.8rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--gold); text-decoration: none; }

      .dash-wrap { flex: 1; padding: 60px 48px; }
      .dash-header { margin-bottom: 40px; }

      .toast { padding: 12px 20px; border-radius: 8px; font-size: 0.9rem; margin-bottom: 24px; }
      .toast-success { background: #f0fdf4; color: #166534; border: 1px solid #bbf7d0; }

      .dash-grid { display: grid; grid-template-columns: 1fr 260px; gap: 24px; margin-bottom: 32px; }
      .dash-card { background: #fff; border-radius: 12px; padding: 32px; box-shadow: 0 2px 16px rgba(44,26,14,0.06); }

      .profile-card { grid-column: 1; }
      .profile-card-inner { display: flex; gap: 24px; align-items: flex-start; margin-bottom: 24px; }
      .profile-avatar { width: 80px; height: 80px; border-radius: 50%; object-fit: cover; flex-shrink: 0; }
      .profile-name { font-family: "Playfair Display", serif; font-size: 1.4rem; color: var(--brown-dark); margin-bottom: 4px; }
      .profile-location { font-size: 0.85rem; color: var(--gold); font-weight: 600; margin-bottom: 4px; }
      .profile-tagline { font-size: 0.9rem; color: var(--text-soft); line-height: 1.5; margin-bottom: 10px; }
      .profile-link { font-size: 0.8rem; color: var(--gold); font-weight: 700; text-decoration: none; }
      .profile-link:hover { text-decoration: underline; }
      .profile-card-actions { border-top: 1px solid rgba(44,26,14,0.08); padding-top: 24px; display: flex; gap: 16px; align-items: center; }
      .btn-view { font-size: 0.82rem; color: var(--gold); font-weight: 700; text-decoration: none; }

      .stats-grid { grid-column: 2; display: flex; flex-direction: column; gap: 16px; }
      .stat-card {
        background: #fff; border-radius: 12px; padding: 24px;
        box-shadow: 0 2px 16px rgba(44,26,14,0.06); text-align: center;
        flex: 1; display: flex; flex-direction: column; gap: 6px;
      }
      .stat-number { font-family: "Playfair Display", serif; font-size: 2rem; color: var(--gold); font-weight: 700; }
      .stat-label { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-soft); }

      /* ─── SETUP CARD ──────────────────────────────── */
      .setup-card {
        background: #fffbeb; border: 1.5px solid #fde68a; border-radius: 12px;
        padding: 28px 32px; margin-bottom: 32px;
      }
      .setup-card h3 { font-family: "Playfair Display", serif; font-size: 1.15rem; color: var(--brown-dark); margin-bottom: 8px; }
      .setup-card p { font-size: 0.92rem; color: #92400e; line-height: 1.6; margin-bottom: 18px; }

      /* ─── LISTINGS SECTION ────────────────────────── */
      .listings-section {
        background: #fff; border-radius: 12px; padding: 32px;
        box-shadow: 0 2px 16px rgba(44,26,14,0.06); margin-bottom: 32px;
      }
      .listings-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; }
      .listings-header h2 { font-family: "Playfair Display", serif; font-size: 1.3rem; color: var(--brown-dark); }
      .btn-sm { padding: 8px 18px !important; font-size: 0.82rem !important; }

      .empty-listings { text-align: center; padding: 40px 20px; }
      .empty-listings p { font-size: 0.92rem; color: var(--text-soft); line-height: 1.6; margin-bottom: 20px; max-width: 400px; margin-left: auto; margin-right: auto; }
      .btn-outline {
        display: inline-block; padding: 10px 24px; border: 2px solid var(--gold); border-radius: 8px;
        font-size: 0.85rem; font-weight: 700; color: var(--gold); background: none; cursor: pointer;
        text-decoration: none; letter-spacing: 0.04em;
      }
      .btn-outline:hover { background: rgba(200,150,62,0.08); }

      .listing-group { margin-bottom: 16px; }
      .listing-group-label {
        font-size: 0.72rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
        color: var(--text-soft); margin-bottom: 12px; cursor: pointer;
      }
      .past-group { margin-top: 8px; }
      .past-group summary { list-style: none; }
      .past-group summary::-webkit-details-marker { display: none; }

      .listing-row {
        display: flex; justify-content: space-between; align-items: center;
        padding: 16px 20px; border-radius: 10px; background: var(--cream); margin-bottom: 8px;
      }
      .listing-row-past { opacity: 0.7; }
      .listing-row-info h4 { font-family: "Playfair Display", serif; font-size: 1rem; color: var(--brown-dark); margin-bottom: 4px; }
      .listing-row-dates { font-size: 0.82rem; color: var(--text-soft); display: flex; align-items: center; gap: 8px; }
      .listing-row-duration {
        background: rgba(200,150,62,0.12); color: var(--gold); font-weight: 700;
        padding: 1px 8px; border-radius: 12px; font-size: 0.72rem;
      }
      .listing-row-actions { display: flex; gap: 10px; }
      .btn-view-sm, .btn-edit-sm {
        font-size: 0.78rem; font-weight: 700; text-decoration: none; padding: 6px 14px;
        border-radius: 6px; letter-spacing: 0.04em;
      }
      .btn-view-sm { color: var(--gold); background: rgba(200,150,62,0.08); }
      .btn-view-sm:hover { background: rgba(200,150,62,0.16); }
      .btn-edit-sm { color: var(--text-soft); background: rgba(44,26,14,0.04); }
      .btn-edit-sm:hover { background: rgba(44,26,14,0.08); }

      .status-badge {
        font-size: 0.68rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em;
        padding: 2px 8px; border-radius: 10px;
      }
      .status-filled { background: #dbeafe; color: #1e40af; }
      .status-cancelled { background: #fee2e2; color: #991b1b; }

      /* ─── OVERVIEW GRID ───────────────────────────── */
      .overview-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 32px; }
      .overview-card {
        background: #fff; border-radius: 12px; padding: 24px;
        box-shadow: 0 2px 16px rgba(44,26,14,0.06);
      }
      .overview-card h3 { font-size: 1rem; margin-bottom: 8px; color: var(--brown-dark); }
      .overview-card p { font-size: 0.88rem; color: var(--text-soft); line-height: 1.5; margin-bottom: 12px; }
      .overview-card a { font-size: 0.8rem; color: var(--gold); font-weight: 700; text-decoration: none; }
      .overview-card a:hover { text-decoration: underline; }

      /* ─── SHARE CARD ──────────────────────────────── */
      .share-card { margin-bottom: 32px; }
      .share-card h3 { font-family: "Playfair Display", serif; font-size: 1.2rem; color: var(--brown-dark); margin-bottom: 8px; }
      .share-card p { font-size: 0.9rem; color: var(--text-soft); margin-bottom: 16px; line-height: 1.6; }
      .share-url { display: flex; gap: 10px; }
      .share-url input {
        flex: 1; border: 1.5px solid rgba(44,26,14,0.15); border-radius: 6px; padding: 10px 14px;
        font-size: 0.9rem; font-family: "Lato", sans-serif; color: var(--text); background: var(--cream); outline: none;
      }
      .copy-btn {
        background: var(--gold); color: #fff; border: none; border-radius: 6px; padding: 10px 20px;
        font-size: 0.85rem; font-weight: 700; cursor: pointer; white-space: nowrap;
      }

      .no-profile {
        background: #fff; border-radius: 12px; padding: 80px 48px; text-align: center;
        box-shadow: 0 2px 16px rgba(44,26,14,0.06); max-width: 520px; margin: 0 auto;
      }
      .no-profile-icon { font-size: 3rem; margin-bottom: 20px; }
      .no-profile h2 { font-family: "Playfair Display", serif; font-size: 1.6rem; color: var(--brown-dark); margin-bottom: 12px; }
      .no-profile p { font-size: 0.95rem; color: var(--text-soft); line-height: 1.7; margin-bottom: 32px; }

      @media (max-width: 768px) {
        nav { padding: 14px 24px; }
        .nav-email { display: none; }
        .dash-wrap { padding: 40px 24px; }
        .dash-grid { grid-template-columns: 1fr; }
        .stats-grid { grid-column: 1; flex-direction: row; }
        .overview-grid { grid-template-columns: 1fr; }
        .share-url { flex-direction: column; }
        .listing-row { flex-direction: column; align-items: flex-start; gap: 12px; }
      }
    </style>
  </body>
</html>
