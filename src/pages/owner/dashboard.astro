---
import LoadingOverlay from '../../components/LoadingOverlay.astro';
export const prerender = false;

import '../../styles/global.css';
import { getSession } from '../../lib/auth';
import { supabase } from '../../lib/supabase';

const session = await getSession(Astro.request);
if (!session) return Astro.redirect('/login');

let profile: any = null;
try {
  const { data } = await supabase
    .from('profiles')
    .select('*')
    .eq('user_id', session.userId)
    .single();
  profile = data;
} catch {}

const pets: any[] = Array.isArray(profile?.pets_json) ? profile.pets_json : [];
const heroImages: any[] = Array.isArray(profile?.hero_images_json) ? profile.hero_images_json : [];
const amenities: string[] = Array.isArray(profile?.amenities_json) ? profile.amenities_json : [];

let listings: any[] = [];
if (profile) {
  const { data } = await supabase
    .from('listings')
    .select('*')
    .eq('profile_id', profile.id)
    .order('date_from', { ascending: false });
  listings = data ?? [];
}

const activeListings = listings.filter((l: any) => l.status === 'active');
const pastListings = listings.filter((l: any) => l.status !== 'active');

const saved = Astro.url.searchParams.get('saved');
const savedMessages: Record<string, string> = {
  listing: 'Listing saved!',
  deleted: 'Listing deleted.',
};
const savedMsg = savedMessages[saved ?? ''] ?? '';

function formatDateLong(d: string) {
  return new Date(d + 'T00:00:00').toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
}

function daysBetween(from: string, to: string) {
  const ms = new Date(to + 'T00:00:00').getTime() - new Date(from + 'T00:00:00').getTime();
  return Math.ceil(ms / 86400000);
}

// Listing strength checklist
const checklistItems = [
  { label: 'Home photos added', done: heroImages.length > 0 },
  { label: 'Pets added', done: pets.length > 0 },
  { label: 'Amenities selected', done: amenities.length > 0 },
  { label: 'About your home written', done: !!profile?.bio },
  { label: 'Ideal sitter described', done: !!profile?.ideal_sitter },
  { label: 'Second sit posted', done: listings.length >= 2 },
];
const donePct = profile ? Math.round((checklistItems.filter(i => i.done).length / checklistItems.length) * 100) : 0;
const doneCount = checklistItems.filter(i => i.done).length;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="icon" type="image/png" href="/images/favicon.png" />
    <link rel="apple-touch-icon" href="/images/app-tile.png" />
    <meta property="og:image" content="/images/logo-tile.png" />
    <link href="https://fonts.googleapis.com/css2?family=Marcellus&family=Montserrat:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Lato:wght@400;700&display=swap" rel="stylesheet" />
    <title>Dashboard — MYAH</title>
    <style>
      body { margin: 0; background: #faf6ee; color: #2c1a0e; font-family: "Montserrat", sans-serif; min-height: 100vh; display: flex; flex-direction: column; }
      * { box-sizing: border-box; }
      a { color: #2f5d45; }
      a:hover { color: #2c1a0e; }
      input::placeholder, textarea::placeholder { color: rgba(44,26,14,.35); }
      @keyframes gs-ring { to { transform: rotate(360deg); } }
      @keyframes gs-pulse { 0%,100% { transform: scale(1); } 50% { transform: scale(1.05); } }

      /* nav hover */
      [data-acct-link]:hover { color: #2f5d45 !important; }
      [data-overview-card]:hover { box-shadow: 0 10px 34px rgba(44,26,14,.08) !important; border-color: rgba(110,84,56,.4) !important; }
      [data-stat-card]:hover { box-shadow: 0 10px 34px rgba(44,26,14,.08) !important; border-color: rgba(110,84,56,.4) !important; }
      [data-profile-card]:hover { box-shadow: 0 10px 34px rgba(44,26,14,.08) !important; border-color: rgba(110,84,56,.4) !important; }
      [data-share-card]:hover { box-shadow: 0 10px 34px rgba(44,26,14,.08) !important; border-color: rgba(110,84,56,.4) !important; }
      [data-strength-card]:hover { box-shadow: 0 10px 34px rgba(44,26,14,.08) !important; border-color: rgba(110,84,56,.4) !important; }
      [data-primary-btn]:hover { background: #3e7a5b !important; border-color: #3e7a5b !important; transform: translateY(-2px) !important; box-shadow: 0 12px 28px rgba(110,84,56,.36) !important; }
      [data-outline-btn]:hover { background: #2f5d45 !important; color: #fff !important; border-color: #2f5d45 !important; }
      [data-sit-card]:hover { box-shadow: 0 10px 34px rgba(44,26,14,.08) !important; }
      [data-view-btn]:hover { background: #3e7a5b !important; border-color: #3e7a5b !important; transform: translateY(-2px) !important; }
      [data-edit-btn]:hover { background: #2f5d45 !important; color: #fff !important; border-color: #2f5d45 !important; }

      /* toast notifications */
      .msg-toast-container { position: fixed; top: 20px; right: 20px; z-index: 1000; display: flex; flex-direction: column; gap: 10px; pointer-events: none; }
      .msg-toast { background: #fff; border-radius: 14px; padding: 14px 18px; box-shadow: 0 8px 32px rgba(0,0,0,.18), 0 2px 8px rgba(0,0,0,.08); display: flex; gap: 12px; align-items: center; pointer-events: auto; cursor: pointer; text-decoration: none; color: inherit; transform: translateX(120%); animation: toast-in 0.4s cubic-bezier(0.34,1.56,0.64,1) forwards; max-width: 380px; border-left: 4px solid #2f5d45; }
      .msg-toast.toast-out { animation: toast-out 0.3s ease forwards; }
      @keyframes toast-in { from { transform: translateX(120%); opacity: 0; } to { transform: translateX(0); opacity: 1; } }
      @keyframes toast-out { from { transform: translateX(0); opacity: 1; } to { transform: translateX(120%); opacity: 0; } }
      .msg-toast-avatar { width: 42px; height: 42px; border-radius: 50%; object-fit: cover; flex-shrink: 0; }
      .msg-toast-avatar-ph { width: 42px; height: 42px; border-radius: 50%; flex-shrink: 0; background: rgba(47,93,69,.12); color: #2f5d45; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 1rem; font-family: "Marcellus", serif; }
      .msg-toast-body { flex: 1; min-width: 0; }
      .msg-toast-name { font-weight: 700; font-size: .88rem; color: #2c1a0e; }
      .msg-toast-preview { font-size: .82rem; color: #6b4e35; margin-top: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

      /* save flash */
      .save-toast { background: #f0fdf4; color: #166534; border: 1px solid #bbf7d0; border-radius: 8px; padding: 12px 20px; font-size: .9rem; margin-bottom: 24px; }

      @media (max-width: 900px) {
        [data-topnav] { padding: 12px 24px !important; }
        [data-dash-pad] { padding: 28px 24px 60px !important; }
        [data-dash-grid] { grid-template-columns: minmax(0,1fr) !important; }
        [data-stats] { flex-direction: row !important; }
        [data-overview] { grid-template-columns: minmax(0,1fr) !important; }
      }
    </style>
  </head>
  <body>
    <div id="msgToasts" class="msg-toast-container"></div>

    <!-- TOP NAV -->
    <nav data-topnav="1" style="display:flex;justify-content:space-between;align-items:center;padding:16px 48px;background:#fff;border-bottom:1px solid rgba(110,84,56,.18)">
      <a href="/" style="display:inline-flex;align-items:center;gap:14px;text-decoration:none;line-height:1;margin-left:-4px;font-family:'Montserrat',sans-serif;font-weight:500;font-size:1.35rem;letter-spacing:.28em">
        <img src="/images/logo-mark.png" alt="" style="height:44px;width:44px;display:block;object-fit:contain" />
        <span style="display:flex;flex-direction:column;gap:5px;padding-left:14px;border-left:1px solid rgba(110,84,56,.4)">
          <span style="color:#2f5d45;line-height:1">MYAH</span>
          <span style="font-family:'Lato',sans-serif;font-weight:700;font-size:.5rem;letter-spacing:.2em;text-transform:uppercase;color:#8a6a4f;line-height:1">Make Yourself At Home</span>
        </span>
      </a>
      <div style="display:flex;align-items:center;gap:22px;flex-wrap:wrap;justify-content:flex-end">
        <a href="/listings" data-acct-link style="font-size:.74rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#5c3d20;text-decoration:none;white-space:nowrap;transition:color .2s">Find a sitter</a>
        <a href="/owner/applications" data-acct-link style="font-size:.74rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#5c3d20;text-decoration:none;white-space:nowrap;transition:color .2s">Applications</a>
        <a href="/notifications" data-acct-link style="font-size:.74rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#5c3d20;text-decoration:none;white-space:nowrap;transition:color .2s">Notifications</a>
        <a href="/api/auth/logout" data-acct-link style="font-size:.74rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#2f5d45;text-decoration:none;white-space:nowrap;transition:color .2s">Log out</a>
      </div>
    </nav>

    <!-- TAB BAR -->
    <div style="display:flex;background:#fff;border-bottom:1px solid rgba(44,26,14,.08);box-shadow:0 1px 4px rgba(0,0,0,.04);position:sticky;top:0;z-index:10">
      <button type="button" id="tab-dashboard" onclick="switchTab('dashboard')" style="flex:1;display:flex;flex-direction:column;align-items:center;gap:5px;padding:13px 4px 12px;border:none;background:none;cursor:pointer;position:relative;font-family:'Montserrat',sans-serif;color:#2f5d45;transition:color .2s">
        <span style="display:flex"><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect></svg></span>
        <span style="font-size:.7rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase">Dashboard</span>
        <span id="line-dashboard" style="position:absolute;bottom:0;left:22%;right:22%;height:3px;border-radius:3px 3px 0 0;background:#2f5d45"></span>
      </button>
      <button type="button" id="tab-sits" onclick="switchTab('sits')" style="flex:1;display:flex;flex-direction:column;align-items:center;gap:5px;padding:13px 4px 12px;border:none;background:none;cursor:pointer;position:relative;font-family:'Montserrat',sans-serif;color:#8a6a4f;transition:color .2s">
        <span style="display:flex"><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg></span>
        <span style="font-size:.7rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase">My sits</span>
        <span id="line-sits" style="position:absolute;bottom:0;left:22%;right:22%;height:3px;border-radius:3px 3px 0 0;background:transparent"></span>
      </button>
      <button type="button" id="tab-messages" onclick="switchTab('messages')" style="flex:1;display:flex;flex-direction:column;align-items:center;gap:5px;padding:13px 4px 12px;border:none;background:none;cursor:pointer;position:relative;font-family:'Montserrat',sans-serif;color:#8a6a4f;transition:color .2s">
        <span style="display:flex;position:relative">
          <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
          <span id="navMsgBadge" style="display:none;position:absolute;top:-5px;right:-10px;background:#ef4444;color:#fff;font-size:.55rem;font-weight:700;min-width:16px;height:16px;border-radius:8px;padding:0 4px;align-items:center;justify-content:center;line-height:1;box-shadow:0 1px 4px rgba(239,68,68,.4)">0</span>
        </span>
        <span style="font-size:.7rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase">Messages</span>
        <span id="line-messages" style="position:absolute;bottom:0;left:22%;right:22%;height:3px;border-radius:3px 3px 0 0;background:transparent"></span>
      </button>
      <button type="button" id="tab-profile" onclick="switchTab('profile')" style="flex:1;display:flex;flex-direction:column;align-items:center;gap:5px;padding:13px 4px 12px;border:none;background:none;cursor:pointer;position:relative;font-family:'Montserrat',sans-serif;color:#8a6a4f;transition:color .2s">
        <span style="display:flex"><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg></span>
        <span style="font-size:.7rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase">Profile</span>
        <span id="line-profile" style="position:absolute;bottom:0;left:22%;right:22%;height:3px;border-radius:3px 3px 0 0;background:transparent"></span>
      </button>
    </div>

    <main data-dash-pad="1" style="flex:1;padding:44px 48px 70px">
      <div style="max-width:1100px;margin:0 auto">

        {savedMsg && <p class="save-toast">{savedMsg}</p>}

        <!-- ═══ DASHBOARD TAB ═══ -->
        <div id="panel-dashboard">
          {profile ? (
            <div style="display:flex;flex-direction:column;gap:24px">
              <!-- Header row -->
              <div style="display:flex;justify-content:space-between;align-items:flex-end;gap:24px;flex-wrap:wrap;border-bottom:1px solid rgba(110,84,56,.3);padding-bottom:26px">
                <div>
                  <p style="font-size:.75rem;font-weight:600;letter-spacing:.2em;text-transform:uppercase;color:#6e5438;margin:0 0 14px;display:flex;align-items:center;gap:12px"><span style="width:26px;height:1px;background:#6e5438;display:block;flex-shrink:0"></span>Your dashboard</p>
                  <h1 style="font-family:'Marcellus',serif;font-size:2.3rem;color:#2c1a0e;line-height:1.15;margin:0">Welcome back, <em style="color:#2f5d45">{profile.name?.split(' ')[0] ?? profile.name}</em></h1>
                </div>
                <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:center">
                  <a href="/owner/edit#photos" data-outline-btn style="display:inline-flex;align-items:center;gap:8px;font-size:.74rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#5c3d20;text-decoration:none;background:#fff;border:1.5px solid rgba(110,84,56,.35);border-radius:50px;padding:11px 20px;transition:background .2s, color .2s, border-color .2s">Add photos</a>
                  <a href="/owner/edit#pets" data-outline-btn style="display:inline-flex;align-items:center;gap:8px;font-size:.74rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#5c3d20;text-decoration:none;background:#fff;border:1.5px solid rgba(110,84,56,.35);border-radius:50px;padding:11px 20px;transition:background .2s, color .2s, border-color .2s">Add a pet</a>
                  <a href="/owner/listings/new" data-primary-btn style="display:inline-flex;align-items:center;justify-content:center;gap:9px;font-size:.78rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#fff;text-decoration:none;background:#2f5d45;border:1.5px solid #2f5d45;border-radius:50px;padding:13px 28px;cursor:pointer;white-space:nowrap;box-shadow:0 6px 20px rgba(110,84,56,.28);transition:background .2s, border-color .2s, transform .12s">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M12 5v14M5 12h14"></path></svg>
                    Post a sit
                  </a>
                </div>
              </div>

              <!-- Main grid -->
              <div data-dash-grid="1" style="display:grid;grid-template-columns:minmax(0,1fr) 260px;gap:24px;align-items:start">
                <!-- Profile card -->
                <div data-profile-card style="background:#fff;border:1px solid rgba(110,84,56,.22);border-radius:18px;padding:32px;box-shadow:0 1px 2px rgba(44,26,14,.04);transition:box-shadow .3s ease, border-color .3s ease">
                  <div style="display:flex;gap:24px;align-items:flex-start;margin-bottom:26px">
                    {profile.profile_pic ? (
                      <img src={profile.profile_pic} alt={profile.name} style="width:84px;height:84px;border-radius:50%;object-fit:cover;flex-shrink:0;border:2px solid rgba(110,84,56,.35)" />
