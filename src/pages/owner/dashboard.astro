                    </div>
                  </div>
                  <div style="border-top:1px solid rgba(44,26,14,.08);padding-top:24px;display:flex;gap:14px;align-items:center;flex-wrap:wrap">
                    <a href="/owner/edit" data-primary-btn style="display:inline-flex;align-items:center;justify-content:center;gap:8px;font-size:.78rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#fff;text-decoration:none;background:#2f5d45;border:1.5px solid #2f5d45;border-radius:50px;padding:13px 28px;cursor:pointer;white-space:nowrap;box-shadow:0 6px 20px rgba(110,84,56,.28);transition:background .2s, border-color .2s, transform .12s">Edit profile</a>
                    {profile.slug && <a href={`/${profile.slug}`} target="_blank" style="font-size:.78rem;color:#2f5d45;font-weight:600;text-decoration:none;letter-spacing:.1em;text-transform:uppercase;border-bottom:1px solid rgba(110,84,56,.4);padding-bottom:2px;transition:color .2s">View public page</a>}
                  </div>
                </div>

                <!-- Stats -->
                <div data-stats="1" style="display:flex;flex-direction:column;gap:16px">
                  <div data-stat-card style="background:#fff;border:1px solid rgba(110,84,56,.22);border-radius:18px;padding:26px;text-align:center;flex:1;display:flex;flex-direction:column;gap:7px;box-shadow:0 1px 2px rgba(44,26,14,.04);transition:box-shadow .3s ease, border-color .3s ease">
                    <span style="font-family:'Marcellus',serif;font-size:2.1rem;color:#6e5438;line-height:1">{pets.length}</span>
                    <span style="font-size:.72rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:#6b4e35">Pets</span>
                  </div>
                  <div data-stat-card style="background:#fff;border:1px solid rgba(110,84,56,.22);border-radius:18px;padding:26px;text-align:center;flex:1;display:flex;flex-direction:column;gap:7px;box-shadow:0 1px 2px rgba(44,26,14,.04);transition:box-shadow .3s ease, border-color .3s ease">
                    <span style="font-family:'Marcellus',serif;font-size:2.1rem;color:#6e5438;line-height:1">{activeListings.length}</span>
                    <span style="font-size:.72rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:#6b4e35">Active sits</span>
                  </div>
                </div>
              </div>

              <!-- Overview cards -->
              <div data-overview="1" style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px">
                <div data-overview-card style="background:#fff;border:1px solid rgba(110,84,56,.22);border-radius:18px;padding:26px;box-shadow:0 1px 2px rgba(44,26,14,.04);display:flex;flex-direction:column;gap:10px;transition:box-shadow .3s ease, border-color .3s ease">
                  <span style="width:44px;height:44px;border-radius:12px;background:#faf6ee;border:1px solid rgba(110,84,56,.28);color:#6e5438;display:flex;align-items:center;justify-content:center;margin-bottom:4px"><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="6" width="18" height="14" rx="2"></rect><circle cx="12" cy="13" r="3.5"></circle><path d="M8 6l1.5-2h5L16 6"></path></svg></span>
                  <h3 style="font-family:'Marcellus',serif;font-size:1.15rem;margin:0;color:#2c1a0e">Home photos</h3>
                  <p style="font-size:.88rem;color:#6b4e35;line-height:1.6;margin:0">{heroImages.length} main photo{heroImages.length !== 1 ? 's' : ''} uploaded</p>
                  <a href="/owner/edit#photos" style="font-size:.76rem;color:#2f5d45;font-weight:600;text-decoration:none;letter-spacing:.12em;text-transform:uppercase;margin-top:auto;padding-top:8px">Manage photos &rarr;</a>
                </div>
                <div data-overview-card style="background:#fff;border:1px solid rgba(110,84,56,.22);border-radius:18px;padding:26px;box-shadow:0 1px 2px rgba(44,26,14,.04);display:flex;flex-direction:column;gap:10px;transition:box-shadow .3s ease, border-color .3s ease">
                  <span style="width:44px;height:44px;border-radius:12px;background:#faf6ee;border:1px solid rgba(110,84,56,.28);color:#6e5438;display:flex;align-items:center;justify-content:center;margin-bottom:4px"><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="9" r="2.2"></circle><circle cx="16" cy="9" r="2.2"></circle><circle cx="12" cy="15.5" r="3"></circle></svg></span>
                  <h3 style="font-family:'Marcellus',serif;font-size:1.15rem;margin:0;color:#2c1a0e">Pets</h3>
                  <p style="font-size:.88rem;color:#6b4e35;line-height:1.6;margin:0">{pets.length > 0 ? pets.map((p: any) => p.name).join(', ') : 'No pets added yet'}</p>
                  <a href="/owner/edit#pets" style="font-size:.76rem;color:#2f5d45;font-weight:600;text-decoration:none;letter-spacing:.12em;text-transform:uppercase;margin-top:auto;padding-top:8px">Manage pets &rarr;</a>
                </div>
                <div data-overview-card style="background:#fff;border:1px solid rgba(110,84,56,.22);border-radius:18px;padding:26px;box-shadow:0 1px 2px rgba(44,26,14,.04);display:flex;flex-direction:column;gap:10px;transition:box-shadow .3s ease, border-color .3s ease">
                  <span style="width:44px;height:44px;border-radius:12px;background:#faf6ee;border:1px solid rgba(110,84,56,.28);color:#6e5438;display:flex;align-items:center;justify-content:center;margin-bottom:4px"><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg></span>
                  <h3 style="font-family:'Marcellus',serif;font-size:1.15rem;margin:0;color:#2c1a0e">Amenities</h3>
                  <p style="font-size:.88rem;color:#6b4e35;line-height:1.6;margin:0">{amenities.length > 0 ? amenities.slice(0, 4).join(', ') + (amenities.length > 4 ? ` +${amenities.length - 4} more` : '') : 'None selected'}</p>
                  <a href="/owner/edit#amenities" style="font-size:.76rem;color:#2f5d45;font-weight:600;text-decoration:none;letter-spacing:.12em;text-transform:uppercase;margin-top:auto;padding-top:8px">Edit amenities &rarr;</a>
                </div>
              </div>

              <!-- Listing strength -->
              <div data-strength-card style="background:#fff;border:1px solid rgba(110,84,56,.22);border-radius:18px;padding:32px;box-shadow:0 1px 2px rgba(44,26,14,.04);transition:box-shadow .3s ease, border-color .3s ease">
                <div style="display:flex;justify-content:space-between;align-items:baseline;gap:20px;flex-wrap:wrap;margin-bottom:16px">
                  <h3 style="font-family:'Marcellus',serif;font-size:1.3rem;color:#2c1a0e;margin:0">Listing strength</h3>
                  <span style="font-size:.78rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:#2f5d45">{doneCount} of {checklistItems.length} complete</span>
                </div>
                <div style="height:8px;border-radius:50px;background:rgba(110,84,56,.15);overflow:hidden;margin-bottom:22px">
                  <div style={`height:100%;width:${donePct}%;border-radius:50px;background:linear-gradient(90deg,#2f5d45 0%,#3e7a5b 100%);transition:width .4s ease`}></div>
                </div>
                <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:12px">
                  {checklistItems.map(item => (
                    <div style="display:flex;align-items:center;gap:11px;font-size:.88rem;color:#2c1a0e">
                      <span style={`width:20px;height:20px;border-radius:50%;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:.64rem;font-weight:700;line-height:1;${item.done ? 'background:#2f5d45;color:#fff;' : 'background:transparent;border:1.5px dashed rgba(110,84,56,.55);color:#2f5d45;'}`}>
                        {item.done ? '✓' : ''}
                      </span>
                      {item.label}
                    </div>
                  ))}
                </div>
              </div>

              <!-- Share card -->
              <div data-share-card style="background:#fff;border:1px solid rgba(110,84,56,.22);border-radius:18px;padding:32px;box-shadow:0 1px 2px rgba(44,26,14,.04);transition:box-shadow .3s ease, border-color .3s ease">
                <h3 style="font-family:'Marcellus',serif;font-size:1.3rem;color:#2c1a0e;margin:0 0 8px">Share your profile</h3>
                <p style="font-size:.93rem;color:#6b4e35;margin:0 0 20px;line-height:1.7;max-width:560px">Send this link so sitters can see your home, pets, and get in touch.</p>
                <div style="display:flex;gap:12px;flex-wrap:wrap">
                  <input id="shareUrl" type="text" readonly value={`https://myahsits.com/${profile.slug ?? ''}`} style="flex:1;min-width:240px;border:1.5px solid rgba(44,26,14,.15);border-radius:10px;padding:13px 16px;font-size:.92rem;font-family:'Montserrat',sans-serif;color:#2c1a0e;background:#faf6ee;outline:none" />
                  <button id="copyBtn" type="button" onclick="copyUrl()" data-primary-btn style="display:inline-flex;align-items:center;justify-content:center;gap:8px;font-size:.78rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#fff;background:#2f5d45;border:1.5px solid #2f5d45;border-radius:50px;box-shadow:0 6px 20px rgba(110,84,56,.28);padding:13px 28px;cursor:pointer;font-family:'Montserrat',sans-serif;white-space:nowrap;transition:background .2s, border-color .2s, transform .12s">Copy</button>
                </div>
              </div>
            </div>
          ) : (
            <div style="background:#fff;border:1px solid rgba(110,84,56,.22);border-radius:18px;padding:80px 48px;text-align:center;max-width:540px;margin:0 auto;box-shadow:0 1px 2px rgba(44,26,14,.04)">
              <span style="font-size:3rem;display:block;margin-bottom:20px">🏠</span>
              <h2 style="font-family:'Marcellus',serif;font-size:1.6rem;color:#2c1a0e;margin:0 0 12px">Welcome to MYAH</h2>
              <p style="font-size:.95rem;color:#6b4e35;line-height:1.7;margin:0 0 32px">Create your profile to get started. You'll then set up your home and pets, and post sit listings for sitters to find.</p>
              <a href="/owner/create" data-primary-btn style="display:inline-flex;align-items:center;justify-content:center;gap:8px;font-size:.82rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#fff;text-decoration:none;background:#2f5d45;border:1.5px solid #2f5d45;border-radius:50px;padding:16px 36px;box-shadow:0 6px 20px rgba(110,84,56,.28);transition:background .2s, border-color .2s, transform .12s">Create your profile</a>
            </div>
          )}
        </div>

        <!-- ═══ MY SITS TAB ═══ -->
        <div id="panel-sits" style="display:none">
          <div style="display:flex;justify-content:space-between;align-items:flex-end;gap:24px;flex-wrap:wrap;border-bottom:1px solid rgba(110,84,56,.3);padding-bottom:26px;margin-bottom:34px">
            <div>
              <p style="font-size:.75rem;font-weight:600;letter-spacing:.2em;text-transform:uppercase;color:#6e5438;margin:0 0 14px;display:flex;align-items:center;gap:12px"><span style="width:26px;height:1px;background:#6e5438;display:block;flex-shrink:0"></span>Your listings</p>
              <h1 style="font-family:'Marcellus',serif;font-size:2.3rem;color:#2c1a0e;margin:0 0 10px;line-height:1.2">My <em style="color:#2f5d45">sits</em></h1>
              <p style="font-size:.95rem;color:#6b4e35;line-height:1.7;max-width:520px;margin:0">Manage your sit listings. Active sits are visible to sitters browsing the platform.</p>
            </div>
            <a href="/owner/listings/new" data-primary-btn style="display:inline-flex;align-items:center;justify-content:center;gap:9px;font-size:.78rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#fff;text-decoration:none;background:#2f5d45;border:1.5px solid #2f5d45;border-radius:50px;padding:13px 28px;cursor:pointer;white-space:nowrap;box-shadow:0 6px 20px rgba(110,84,56,.28);transition:background .2s, border-color .2s, transform .12s">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M12 5v14M5 12h14"></path></svg>
              Post a sit
            </a>
          </div>

          {listings.length === 0 ? (
            <div style="background:#fff;border:1px solid rgba(110,84,56,.22);border-radius:18px;padding:80px 48px;text-align:center;max-width:540px;margin:0 auto;box-shadow:0 1px 2px rgba(44,26,14,.04)">
              <span style="font-size:3rem;display:block;margin-bottom:20px">📋</span>
              <h2 style="font-family:'Marcellus',serif;font-size:1.5rem;color:#2c1a0e;margin:0 0 12px">No sit listings yet</h2>
              <p style="font-size:.95rem;color:#6b4e35;line-height:1.7;margin:0 0 28px">Create your first listing so sitters can find your home and get in touch.</p>
              <a href="/owner/listings/new" data-primary-btn style="display:inline-flex;align-items:center;justify-content:center;gap:8px;font-size:.82rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#fff;text-decoration:none;background:#2f5d45;border:1.5px solid #2f5d45;border-radius:50px;padding:16px 36px;box-shadow:0 6px 20px rgba(110,84,56,.28);transition:background .2s, border-color .2s, transform .12s">Post your first sit</a>
            </div>
          ) : (
            <>
              {activeListings.length > 0 && (
                <div style="margin-bottom:38px">
                  <p style="font-size:.74rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:#6b4e35;margin:0 0 18px">Active</p>
                  <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:20px">
                    {activeListings.map((l: any) => {
                      const duration = daysBetween(l.date_from, l.date_to);
                      return (
                        <div data-sit-card style="background:#fff;border:1px solid rgba(110,84,56,.22);border-radius:18px;padding:26px;box-shadow:0 1px 2px rgba(44,26,14,.04);display:flex;flex-direction:column;gap:11px;transition:box-shadow .3s ease">
                          <span style="display:inline-block;font-size:.68rem;font-weight:600;text-transform:uppercase;letter-spacing:.12em;padding:5px 13px;border-radius:50px;width:fit-content;background:rgba(47,125,79,.1);color:#2f7d4f;border:1px solid rgba(47,125,79,.3)">Active</span>
                          <h3 style="font-family:'Marcellus',serif;font-size:1.18rem;color:#2c1a0e;line-height:1.3;margin:0">{l.title}</h3>
                          <p style="font-size:.86rem;color:#5c3d20;font-weight:600;margin:0">{formatDateLong(l.date_from)} — {formatDateLong(l.date_to)}</p>
                          <span style="display:inline-block;background:rgba(110,84,56,.12);color:#2f5d45;font-size:.74rem;font-weight:600;padding:5px 14px;border-radius:50px;width:fit-content;letter-spacing:.04em">{duration} day{duration !== 1 ? 's' : ''}</span>
                          {l.description && <p style="font-size:.88rem;color:#6b4e35;line-height:1.65;margin:0">{l.description.slice(0, 120)}{l.description.length > 120 ? '…' : ''}</p>}
                          <div style="display:flex;gap:10px;margin-top:8px;flex-wrap:wrap">
                            <a href={`/listings/${l.id}`} data-view-btn style="display:inline-flex;align-items:center;justify-content:center;font-size:.74rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;text-decoration:none;padding:11px 22px;border-radius:50px;color:#fff;background:#2f5d45;border:1.5px solid #2f5d45;transition:background .2s, border-color .2s, transform .12s">View listing</a>
                            <a href={`/owner/listings/${l.id}/edit`} data-edit-btn style="display:inline-flex;align-items:center;justify-content:center;font-size:.74rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;text-decoration:none;padding:11px 22px;border-radius:50px;color:#5c3d20;background:#fff;border:1.5px solid rgba(110,84,56,.35);transition:background .2s, color .2s, border-color .2s">Edit</a>
                          </div>
                        </div>
                      );
                    })}
                  </div>
                </div>
              )}

              {pastListings.length > 0 && (
                <div style="margin-bottom:38px">
                  <p style="font-size:.74rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:#6b4e35;margin:0 0 18px">Past / Closed</p>
                  <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:20px">
                    {pastListings.map((l: any) => {
                      const duration = daysBetween(l.date_from, l.date_to);
                      const statusTone = l.status === 'filled'
                        ? 'background:rgba(110,84,56,.12);color:#2f5d45;border:1px solid rgba(110,84,56,.38);'
                        : 'background:#fdeeee;color:#b91c1c;border:1px solid #f7cfcf;';
                      return (
                        <div data-sit-card style="background:#fff;border:1px solid rgba(110,84,56,.22);border-radius:18px;padding:26px;box-shadow:0 1px 2px rgba(44,26,14,.04);display:flex;flex-direction:column;gap:11px;opacity:.7;transition:box-shadow .3s ease">
                          <span style={`display:inline-block;font-size:.68rem;font-weight:600;text-transform:uppercase;letter-spacing:.12em;padding:5px 13px;border-radius:50px;width:fit-content;${statusTone}`}>{l.status.charAt(0).toUpperCase() + l.status.slice(1)}</span>
                          <h3 style="font-family:'Marcellus',serif;font-size:1.18rem;color:#2c1a0e;line-height:1.3;margin:0">{l.title}</h3>
                          <p style="font-size:.86rem;color:#5c3d20;font-weight:600;margin:0">{formatDateLong(l.date_from)} — {formatDateLong(l.date_to)}</p>
                          <span style="display:inline-block;background:rgba(110,84,56,.12);color:#2f5d45;font-size:.74rem;font-weight:600;padding:5px 14px;border-radius:50px;width:fit-content;letter-spacing:.04em">{duration} day{duration !== 1 ? 's' : ''}</span>
                          <div style="display:flex;gap:10px;margin-top:8px;flex-wrap:wrap">
                            <a href={`/owner/listings/${l.id}/edit`} data-edit-btn style="display:inline-flex;align-items:center;justify-content:center;font-size:.74rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;text-decoration:none;padding:11px 22px;border-radius:50px;color:#5c3d20;background:#fff;border:1.5px solid rgba(110,84,56,.35);transition:background .2s, color .2s, border-color .2s">Edit</a>
                          </div>
                        </div>
                      );
                    })}
                  </div>
                </div>
              )}
            </>
          )}
        </div>

        <!-- ═══ MESSAGES TAB ═══ -->
        <div id="panel-messages" style="display:none">
          <div style="background:#fff;border:1px solid rgba(110,84,56,.22);border-radius:18px;padding:80px 48px;text-align:center;max-width:540px;margin:0 auto;box-shadow:0 1px 2px rgba(44,26,14,.04)">
            <span style="width:58px;height:58px;border-radius:16px;background:#faf6ee;border:1px solid rgba(110,84,56,.28);color:#6e5438;display:inline-flex;align-items:center;justify-content:center;margin-bottom:22px"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg></span>
            <h2 style="font-family:'Marcellus',serif;font-size:1.6rem;color:#2c1a0e;margin:0 0 12px">No messages yet</h2>
            <p style="font-size:.95rem;color:#6b4e35;line-height:1.7;margin:0">When a sitter applies for one of your sits, the conversation will appear here.</p>
          </div>
        </div>

        <!-- ═══ PROFILE TAB ═══ -->
        <div id="panel-profile" style="display:none">
          <div style="background:#fff;border:1px solid rgba(110,84,56,.22);border-radius:18px;padding:80px 48px;text-align:center;max-width:540px;margin:0 auto;box-shadow:0 1px 2px rgba(44,26,14,.04)">
            <span style="width:58px;height:58px;border-radius:16px;background:#faf6ee;border:1px solid rgba(110,84,56,.28);color:#6e5438;display:inline-flex;align-items:center;justify-content:center;margin-bottom:22px"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg></span>
            <h2 style="font-family:'Marcellus',serif;font-size:1.6rem;color:#2c1a0e;margin:0 0 12px">Your home &amp; pets</h2>
            <p style="font-size:.95rem;color:#6b4e35;line-height:1.7;margin:0 0 28px">Update your home photos, pet details and amenities. This information is reused across all your sit listings — you only set it up once.</p>
            <a href="/owner/edit" data-primary-btn style="display:inline-flex;align-items:center;justify-content:center;gap:8px;font-size:.82rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#fff;text-decoration:none;background:#2f5d45;border:1.5px solid #2f5d45;border-radius:50px;padding:16px 36px;box-shadow:0 6px 20px rgba(110,84,56,.28);transition:background .2s, border-color .2s, transform .12s">Set up home &amp; pets</a>
          </div>
        </div>

      </div>
    </main>

    <script>
      const TABS = ['dashboard', 'sits', 'messages', 'profile'];

      function switchTab(tab: string) {
        TABS.forEach(t => {
          const btn = document.getElementById('tab-' + t) as HTMLElement;
          const line = document.getElementById('line-' + t) as HTMLElement;
          const panel = document.getElementById('panel-' + t) as HTMLElement;
          const active = t === tab;
          if (btn) btn.style.color = active ? '#2f5d45' : '#8a6a4f';
          if (line) line.style.background = active ? '#2f5d45' : 'transparent';
          if (panel) panel.style.display = active ? 'block' : 'none';
        });
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }

      function copyUrl() {
        const input = document.getElementById('shareUrl') as HTMLInputElement;
        const btn = document.getElementById('copyBtn') as HTMLButtonElement;
        if (!input) return;
        input.select();
        navigator.clipboard?.writeText(input.value).then(() => {
          if (btn) { btn.textContent = 'Copied!'; setTimeout(() => { btn.textContent = 'Copy'; }, 2000); }
        });
      }

      // ── MESSAGE NOTIFICATIONS ──
      (function() {
        const seenIds = new Set<string>();
        let isFirst = true;

        function playNotifSound() {
          try {
            const ctx = new (window.AudioContext || (window as any).webkitAudioContext)();
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();
            osc.connect(gain);
            gain.connect(ctx.destination);
            osc.frequency.setValueAtTime(660, ctx.currentTime);
            osc.frequency.setValueAtTime(880, ctx.currentTime + 0.1);
            osc.type = 'sine';
            gain.gain.setValueAtTime(0.08, ctx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.4);
            osc.start(ctx.currentTime);
            osc.stop(ctx.currentTime + 0.4);
          } catch {}
        }

        function esc(str: string) {
          const d = document.createElement('div');
          d.textContent = str;
          return d.innerHTML;
        }

        function showToast(msg: any) {
          const container = document.getElementById('msgToasts');
          if (!container) return;
          const sender = msg.sender || {};
          const initial = (sender.name || '?').charAt(0).toUpperCase();
          const avatar = sender.profile_pic
            ? `<img src="${esc(sender.profile_pic)}" class="msg-toast-avatar" />`
            : `<div class="msg-toast-avatar-ph">${initial}</div>`;
          const toast = document.createElement('a');
          toast.href = `/messages/${msg.conversation_id}`;
          toast.className = 'msg-toast';
          toast.innerHTML = `${avatar}<div class="msg-toast-body"><div class="msg-toast-name">${esc(sender.name || 'Someone')}</div><div class="msg-toast-preview">${esc((msg.body || '').slice(0, 80))}</div></div>`;
          container.appendChild(toast);
          setTimeout(() => { toast.classList.add('toast-out'); setTimeout(() => toast.remove(), 300); }, 5000);
        }

        function updateBadge(count: number) {
          const badge = document.getElementById('navMsgBadge');
          if (!badge) return;
          if (count > 0) {
            badge.textContent = count > 99 ? '99+' : String(count);
            badge.style.display = 'inline-flex';
          } else {
            badge.style.display = 'none';
          }
        }

        async function checkUnread() {
          try {
            const res = await fetch('/api/messages/unread');
            const data = await res.json();
            updateBadge(data.count || 0);
            if (data.messages) {
              if (!isFirst) {
                const fresh = data.messages.filter((m: any) => !seenIds.has(m.id));
                if (fresh.length > 0) {
                  playNotifSound();
                  fresh.slice(0, 3).forEach(showToast);
                }
              }
              data.messages.forEach((m: any) => seenIds.add(m.id));
            }
            isFirst = false;
          } catch {}
        }

        checkUnread();
        setInterval(checkUnread, 8000);
      })();
    </script>

    <LoadingOverlay />
  </body>
</html>
