                          {profile.location}
                        </p>
                      )}
                      {profile.bio && <p style="font-size:.92rem;color:#6b4e35;line-height:1.6;margin:0 0 12px">{profile.bio.slice(0, 120)}{profile.bio.length > 120 ? '…' : ''}</p>}
