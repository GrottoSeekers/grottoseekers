      .overview-card a:hover { text-decoration: underline; }

      .share-card { margin-bottom: 32px; }
      .share-card h3 { font-family: "Playfair Display", serif; font-size: 1.2rem; color: var(--brown-dark); margin-bottom: 8px; }
      .share-card p { font-size: 0.9rem; color: var(--text-soft); margin-bottom: 16px; line-height: 1.6; }
      .share-url { display: flex; gap: 10px; }
      .share-url input {
        flex: 1; border: 1.5px solid rgba(44,26,14,0.15); border-radius: 6px; padding: 10px 14px;
        font-size: 0.9rem; font-family: "Lato", sans-serif; color: var(--text); background: var(--cream); outline: none;
      }
      .copy-btn {
        background: var(--gold); color: #fff; border: none; border-radius: 6px; padding: 10px 20px;
        font-size: 0.85rem; font-weight: 700; cursor: pointer; white-space: nowrap;
      }

      .no-profile {
        background: #fff; border-radius: 12px; padding: 80px 48px; text-align: center;
        box-shadow: 0 2px 16px rgba(44,26,14,0.06); max-width: 520px; margin: 0 auto;
      }
      .no-profile-icon { font-size: 3rem; margin-bottom: 20px; }
      .no-profile h2 { font-family: "Playfair Display", serif; font-size: 1.6rem; color: var(--brown-dark); margin-bottom: 12px; }
      .no-profile p { font-size: 0.95rem; color: var(--text-soft); line-height: 1.7; margin-bottom: 32px; }

      /* ── MY SITS TAB ──────────────────────────────────────── */
      .sits-header {
        display: flex; justify-content: space-between; align-items: flex-start;
        margin-bottom: 32px; gap: 20px;
      }
      .sits-heading {
        font-family: "Playfair Display", serif; font-size: 2rem;
        color: var(--brown-dark); margin-bottom: 8px;
      }
      .sits-sub { font-size: 0.95rem; color: var(--text-soft); line-height: 1.7; max-width: 500px; }

      .sits-empty {
        background: #fff; border-radius: 16px; padding: 80px 48px; text-align: center;
        box-shadow: 0 2px 12px rgba(44,26,14,0.05); max-width: 520px; margin: 0 auto;
      }
      .sits-empty-icon { font-size: 3rem; margin-bottom: 20px; }
      .sits-empty h2 { font-family: "Playfair Display", serif; font-size: 1.5rem; color: var(--brown-dark); margin-bottom: 12px; }
      .sits-empty p { font-size: 0.95rem; color: var(--text-soft); line-height: 1.7; margin-bottom: 24px; }

      .sits-group { margin-bottom: 32px; }
      .sits-group-label {
        font-size: 0.75rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
        color: var(--text-soft); margin-bottom: 16px;
      }

      .sits-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 20px;
      }

      .sit-card {
        background: #fff; border-radius: 16px; padding: 24px;
        box-shadow: 0 1px 6px rgba(44,26,14,0.06);
        transition: transform 0.2s, box-shadow 0.2s;
        display: flex; flex-direction: column; gap: 8px;
      }
      .sit-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 32px rgba(44,26,14,0.1);
      }
      .sit-card-past { opacity: 0.65; }

      .sit-card-status {
        display: inline-block; font-size: 0.7rem; font-weight: 700; text-transform: uppercase;
        letter-spacing: 0.08em; padding: 3px 10px; border-radius: 20px; width: fit-content;
      }
      .sit-card-status.active { background: #f0fdf4; color: #166534; }
      .sit-card-status.filled { background: #dbeafe; color: #1e40af; }
      .sit-card-status.cancelled { background: #fee2e2; color: #991b1b; }

      .sit-card-title {
        font-family: "Playfair Display", serif; font-size: 1.15rem;
        color: var(--brown-dark); line-height: 1.3;
      }
      .sit-card-dates { font-size: 0.85rem; color: var(--brown-mid); font-weight: 600; }
      .sit-card-duration {
        display: inline-block; background: rgba(200,150,62,0.1); color: var(--gold);
        font-size: 0.75rem; font-weight: 700; padding: 3px 12px; border-radius: 20px;
        width: fit-content;
      }
      .sit-card-desc {
        font-size: 0.85rem; color: var(--text-soft); line-height: 1.6;
        display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
      }
      .sit-card-actions { display: flex; gap: 10px; margin-top: 8px; }
      .sit-card-btn {
        font-size: 0.82rem; font-weight: 700; text-decoration: none;
        padding: 8px 18px; border-radius: 8px; letter-spacing: 0.03em;
        color: #fff; background: var(--gold); transition: background 0.2s;
      }
      .sit-card-btn:hover { background: var(--gold-light); }
      .sit-card-btn-alt {
        color: var(--text-soft); background: rgba(44,26,14,0.05);
      }
      .sit-card-btn-alt:hover { background: rgba(44,26,14,0.1); }

      @media (max-width: 768px) {
        nav { padding: 12px 20px; }
        .nav-right { display: none; }
        .toggle-btn { padding: 8px 16px; font-size: 0.82rem; }
        .burger { display: flex; }
        .dash-wrap { padding: 28px 20px; }
        .dash-grid { grid-template-columns: 1fr; }
        .stats-grid { grid-column: 1; flex-direction: row; }
        .overview-grid { grid-template-columns: 1fr; }
        .share-url { flex-direction: column; }
        .sits-header { flex-direction: column; }
        .sits-heading { font-size: 1.5rem; }
        .sits-grid { grid-template-columns: 1fr; }
        .no-profile { padding: 48px 24px; }
      }
    </style>
  </body>
</html>
