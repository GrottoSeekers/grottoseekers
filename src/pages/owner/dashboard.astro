      .sit-card-btn {
        font-size: 0.82rem; font-weight: 700; text-decoration: none;
        padding: 8px 18px; border-radius: 8px; letter-spacing: 0.03em;
        color: #fff; background: var(--gold); transition: background 0.2s;
      }
      .sit-card-btn:hover { background: var(--gold-light); }
      .sit-card-btn-alt {
        color: var(--text-soft); background: rgba(44,26,14,0.05);
