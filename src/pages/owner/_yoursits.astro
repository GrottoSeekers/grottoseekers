---
// "Your sits" on the owner dashboard's main tab: each open sit with who has
// applied, and quick links to view it, see applications or edit it.
interface Card {
  title: string;
  dates: string;
  duration: string;
  viewHref: string;
  editHref: string;
  appsHref: string;
  appsLabel: string;
  appsOn: boolean;
}
interface Props { cards: Card[] }
const { cards } = Astro.props;
const btn = "display:inline-flex;align-items:center;justify-content:center;gap:8px;font-family:'Montserrat',sans-serif;font-size:.72rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;border-radius:50px;padding:10px 18px;text-decoration:none;white-space:nowrap;";
const solid = btn + 'color:#fff;background:#2f5d45;border:1.5px solid #2f5d45;';
const ghost = btn + 'color:#2f5d45;background:#fff;border:1.5px solid rgba(110,84,56,.4);';
---
<div class="db-card" data-your-sits="1" style="background:#fff;border:1px solid rgba(110,84,56,.22);border-radius:18px;padding:26px;box-shadow:0 1px 2px rgba(44,26,14,.04)">
  <div style="display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap;margin-bottom:18px">
    <h3 style="font-family:'Marcellus',serif;font-size:1.3rem;color:#2c1a0e;margin:0">Your sits</h3>
    <a href="/owner/listings/new" style={solid}>+ Post a sit</a>
  </div>
  {cards.length === 0 ? (
    <p style="font-size:.92rem;color:#6b4e35;line-height:1.7;margin:0">You have no open sits. Post one with your dates and sitters can start applying.</p>
  ) : (
    <div style="display:flex;flex-direction:column;gap:12px">
      {cards.map((c) => (
        <div data-your-sit="1" style="display:flex;align-items:center;gap:16px;flex-wrap:wrap;padding:16px 18px;border:1px solid rgba(110,84,56,.2);border-radius:14px;background:#faf6ee">
          <div style="flex:1 1 220px;min-width:0">
            <a href={c.viewHref} style="font-family:'Marcellus',serif;font-size:1.08rem;color:#2c1a0e;text-decoration:none;display:block">{c.title}</a>
            <span style="font-size:.82rem;color:#6b4e35">{c.dates} · {c.duration}</span>
          </div>
          <a href={c.appsHref} data-apps-link="1" style={'display:inline-flex;align-items:center;gap:8px;padding:9px 14px;border-radius:50px;text-decoration:none;font-size:.8rem;font-weight:600;' + (c.appsOn ? 'background:rgba(47,93,69,.12);color:#2f5d45;border:1px solid rgba(47,93,69,.35)' : 'background:#fff;color:#8a6a4f;border:1px dashed rgba(110,84,56,.35)')}>{c.appsLabel} &rarr;</a>
          <span style="display:flex;gap:8px;flex-wrap:wrap">
            <a href={c.viewHref} style={ghost}>View sit</a>
            <a href={c.editHref} style={ghost}>Edit</a>
          </span>
        </div>
      ))}
    </div>
  )}
</div>
