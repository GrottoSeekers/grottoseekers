---
export const prerender = false;

import '../../styles/global.css';
import { getSession } from '../../lib/auth';
import { supabase } from '../../lib/supabase';

const session = await getSession(Astro.request);
if (!session) return Astro.redirect('/login');

const { data: profile } = await supabase
  .from('profiles')
  .select('*')
  .eq('user_id', session.userId)
  .single();

if (!profile) return Astro.redirect('/owner/create');

const heroImages: any[] = Array.isArray(profile.hero_images_json) ? profile.hero_images_json : [];
const aboutImages: any[] = Array.isArray(profile.about_images_json) ? profile.about_images_json : [];
const gallery: any[] = Array.isArray(profile.gallery_json) ? profile.gallery_json : [];
const pets: any[] = Array.isArray(profile.pets_json) ? profile.pets_json : [];
const amenities: string[] = Array.isArray(profile.amenities_json) ? profile.amenities_json : [];
const reviews: any[] = Array.isArray(profile.reviews_json) ? profile.reviews_json : [];
const h = (profile.headings_json ?? {}) as Record<string, string>;
const t = (profile.theme_json ?? {}) as Record<string, string>;

const saved = Astro.url.searchParams.get('saved');
const errorKey = Astro.url.searchParams.get('error') ?? '';
const detail = Astro.url.searchParams.get('detail');
const errorMap: Record<string, string> = {
  missing: 'Please fill in the required fields.',
  file_too_large: 'Image must be under 5 MB.',
  upload: `Upload error: ${detail ?? 'unknown'}`,
  server: 'Something went wrong. Please try again.',
};
const errorMsg = errorMap[errorKey] ?? '';
const savedMsg = saved ? 'Changes saved!' : '';

const allAmenities = [
  'WiFi', 'Parking', 'Garden', 'Pool', 'Gym', 'Air Conditioning',
  'Heating', 'Washer/Dryer', 'Dishwasher', 'TV/Streaming',
  'Workspace', 'Near Public Transport', 'Near Shops',
  'Rural/Countryside', 'Beach Nearby', 'Pet-Friendly Area',
];

const petTypes = ['Dog', 'Cat', 'Bird', 'Fish', 'Rabbit', 'Reptile', 'Horse', 'Other'];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>Edit profile — Grotto Sitters</title>
  </head>
  <body>
    <nav>
      <a href="/" class="nav-logo">Grotto <span>Sitters</span></a>
      <a href="/api/auth/logout" class="top-bar-logout">Log out</a>
    </nav>

    <main class="edit-wrap">
      <div class="section-inner">
        <header class="edit-header">
          <div>
            <p class="section-label">Owner Portal</p>
            <h1 class="section-title">Edit your profile</h1>
            <div class="divider"></div>
          </div>
          <a href={`/${profile.slug}`} target="_blank" class="btn-view">View public page →</a>
        </header>

        {errorMsg && <p class="toast toast-error">{errorMsg}</p>}
        {savedMsg && <p class="toast toast-success">{savedMsg}</p>}

        <div class="section-nav">
          <a href="#details">Details</a>
          <a href="#home">Home Photos</a>
          <a href="#pets">Pets</a>
          <a href="#amenities">Amenities</a>
          <a href="#gallery">Gallery</a>
          <a href="#looking-for">Looking For</a>
          <a href="#headings">Headings</a>
        </div>

        <!-- ── FULL PAGE PREVIEW ────────────────────── -->
        <div class="page-preview-wrap">
          <div class="page-preview-header">
            <h2>Page preview</h2>
            <a href={`/${profile.slug}`} target="_blank" class="preview-view-link">Open full page</a>
          </div>
          <div class="page-preview" style={`--pv-bg:${t.background || '#faf6ee'};--pv-accent:${t.accent || '#c8963e'};--pv-accent-light:${t.accent_light || '#e8b96a'};--pv-text:${t.text || '#2c1a0e'};--pv-text-soft:${t.text_soft || '#6b4e35'};`}>
            <!-- Hero -->
            <div class="pv-hero">
              {heroImages.length > 0 ? (
                <img src={heroImages[0].src} alt="" class="pv-hero-img" style={`object-position:${heroImages[0].pos}`} />
              ) : (
                <div class="pv-hero-img pv-hero-empty"></div>
              )}
              <div class="pv-hero-overlay"></div>
              <div class="pv-hero-content">
                {profile.location && <span class="pv-badge">{profile.location}</span>}
                <p class="pv-brand">Grotto <em>Sitters</em></p>
                <p class="pv-name">{profile.name}</p>
                {profile.tagline && <p class="pv-tagline">{profile.tagline}</p>}
                <span class="pv-btn">Get In Touch</span>
              </div>
            </div>

            <!-- About -->
            <div class="pv-section" style="background:var(--pv-bg);">
              <p class="pv-label">{h.about_label || 'About Our Home'}</p>
              <div class="pv-about-row">
                {aboutImages.length > 0 && <img src={aboutImages[0].src} alt="" class="pv-about-img" />}
                <div class="pv-about-text">
                  {profile.bio ? (
                    <p>{profile.bio.length > 100 ? profile.bio.slice(0, 100) + '...' : profile.bio}</p>
                  ) : (
                    <p class="pv-empty">No bio yet</p>
                  )}
                </div>
              </div>
            </div>

            <!-- Reviews -->
            {reviews.length > 0 && (
              <div class="pv-section" style="background:var(--pv-bg);">
                <p class="pv-label">{h.reviews_label || 'What Sitters Say'}</p>
                <div class="pv-reviews-row">
                  {reviews.slice(0, 3).map((r: any) => (
                    <div class="pv-review-card">
                      <span class="pv-stars">★★★★★</span>
                      <p>"{r.text.length > 50 ? r.text.slice(0, 50) + '...' : r.text}"</p>
                      <span class="pv-reviewer">— {r.name}</span>
                    </div>
                  ))}
                </div>
              </div>
            )}

            <!-- Pets -->
            {pets.length > 0 && (
              <div class="pv-section" style="background:var(--pv-bg);">
                <p class="pv-label">Meet the Pets</p>
                <div class="pv-pets-row">
                  {pets.slice(0, 4).map((pet: any) => (
                    <div class="pv-pet-chip">
                      {pet.photo_url && <img src={pet.photo_url} alt="" class="pv-pet-img" />}
                      <span>{pet.name}</span>
                    </div>
                  ))}
                </div>
              </div>
            )}

            <!-- Amenities -->
            {amenities.length > 0 && (
              <div class="pv-section" style="background:var(--pv-bg);">
                <p class="pv-label">Home Amenities</p>
                <div class="pv-amenities-row">
                  {amenities.slice(0, 6).map((a: string) => (
                    <span class="pv-amenity-tag">✓ {a}</span>
                  ))}
                </div>
              </div>
            )}

            <!-- Gallery -->
            {gallery.length > 0 && (
              <div class="pv-section pv-gallery-section">
                <p class="pv-label">{h.gallery_label || 'Our Home'}</p>
                <div class="pv-gallery-grid">
                  {gallery.slice(0, 8).map((img: any) => (
                    <div class="pv-gallery-item"><img src={img.src} alt="" /></div>
                  ))}
                </div>
              </div>
            )}

            <!-- Enquiry -->
            <div class="pv-section" style="background:var(--pv-bg);">
              <p class="pv-label">{h.enquiry_label || 'Get In Touch'}</p>
              <div class="pv-enquiry-mock">
                <div class="pv-mock-field"></div>
                <div class="pv-mock-field"></div>
                <div class="pv-mock-field pv-mock-tall"></div>
                <div class="pv-mock-btn">Send Enquiry</div>
              </div>
            </div>

            <!-- Footer -->
            <div class="pv-footer">
              <p>Grotto <em>Sitters</em></p>
              <span>{profile.name}</span>
            </div>
          </div>

          <!-- Colour strip under preview -->
          <form action="/api/profile/theme" method="POST" class="colour-strip" id="colours">
            <div class="colour-strip-row">
              <div class="colour-swatch">
                <input type="color" name="background" value={t.background || '#faf6ee'} class="colour-picker" />
                <span>Background</span>
              </div>
              <div class="colour-swatch">
                <input type="color" name="accent" value={t.accent || '#c8963e'} class="colour-picker" />
                <span>Accent</span>
              </div>
              <div class="colour-swatch">
                <input type="color" name="accent_light" value={t.accent_light || '#e8b96a'} class="colour-picker" />
                <span>Highlight</span>
              </div>
              <div class="colour-swatch">
                <input type="color" name="text" value={t.text || '#2c1a0e'} class="colour-picker" />
                <span>Text</span>
              </div>
              <div class="colour-swatch">
                <input type="color" name="text_soft" value={t.text_soft || '#6b4e35'} class="colour-picker" />
                <span>Soft text</span>
              </div>
            </div>
            <div class="colour-strip-actions">
              <button type="button" class="btn-reset-colours" id="resetColours">Reset</button>
            </div>
          </form>
        </div>

        <!-- ─── DETAILS ──────────────────────────────────── -->
        <section id="details" class="edit-section">
          <h2 class="edit-section-title">Details</h2>
          <form method="POST" action="/api/owner/update" enctype="multipart/form-data" class="edit-form">
            <div class="form-grid">
              <div class="field span-2">
                <label for="name">Your name <span class="req">*</span></label>
                <input type="text" id="name" name="name" value={profile.name} required />
              </div>
              <div class="field">
                <label for="location">Location</label>
                <input type="text" id="location" name="location" value={profile.location ?? ''} placeholder="e.g. Sydney, NSW" />
              </div>
              <div class="field">
                <label for="tagline">Tagline</label>
                <input type="text" id="tagline" name="tagline" value={profile.tagline ?? ''} placeholder="e.g. Cosy home with two friendly dogs" />
              </div>
              <div class="field">
                <label for="badge_text">Badge text</label>
                <input type="text" id="badge_text" name="badge_text" value={profile.badge_text ?? ''} placeholder="e.g. Available December 2026" />
              </div>
              <div class="field">
                <label for="profile_pic">Profile photo</label>
                <input type="file" id="profile_pic" name="profile_pic" accept="image/*" />
              </div>
              <div class="field span-2">
                <label for="bio">About your home</label>
                <textarea id="bio" name="bio" rows="6" placeholder="Tell sitters about your home, neighbourhood, and what makes it a great place to stay.">{profile.bio ?? ''}</textarea>
              </div>

              <div class="field span-2">
                <div class="contact-divider"><span>Where enquiries go</span></div>
              </div>
              <div class="field">
                <label for="contact_email">Enquiry email <span class="req">*</span></label>
                <input type="email" id="contact_email" name="contact_email" value={profile.contact_email ?? ''} placeholder="e.g. hello@example.com" required />
              </div>
              <div class="field">
                <label for="whatsapp_number">WhatsApp number</label>
                <input type="tel" id="whatsapp_number" name="whatsapp_number" value={profile.whatsapp_number ?? ''} placeholder="e.g. +447700900000" />
              </div>
            </div>

          </form>
        </section>

        <!-- ─── HOME PHOTOS ──────────────────────────────── -->
        <section id="home" class="edit-section">
          <h2 class="edit-section-title">Home Photos</h2>

          <h3 class="edit-sub-title">Main photos (hero banner)</h3>
          <div class="image-grid">
            {heroImages.map((img: any, i: number) => (
              <div class="image-thumb">
                <img src={img.src} alt="" />
                <form method="POST" action="/api/owner/images">
                  <input type="hidden" name="_action" value="delete" />
                  <input type="hidden" name="category" value="hero" />
                  <input type="hidden" name="index" value={String(i)} />
                  <button type="submit" class="thumb-delete">×</button>
                </form>
              </div>
            ))}
          </div>
          <form method="POST" action="/api/owner/images" enctype="multipart/form-data" class="upload-form" data-category="hero">
            <input type="hidden" name="_action" value="upload" />
            <input type="hidden" name="category" value="hero" />
            <div class="upload-row">
              <input type="file" name="files" accept="image/*" multiple class="file-input-multi" />
              <select name="pos">
                <option value="center">Centre</option>
                <option value="top">Top</option>
                <option value="bottom">Bottom</option>
              </select>
            </div>
            <div class="upload-preview"></div>
          </form>

          <h3 class="edit-sub-title" style="margin-top:32px;">Interior / lifestyle photos</h3>
          <div class="image-grid">
            {aboutImages.map((img: any, i: number) => (
              <div class="image-thumb">
                <img src={img.src} alt="" />
                <form method="POST" action="/api/owner/images">
                  <input type="hidden" name="_action" value="delete" />
                  <input type="hidden" name="category" value="about" />
                  <input type="hidden" name="index" value={String(i)} />
                  <button type="submit" class="thumb-delete">×</button>
                </form>
              </div>
            ))}
          </div>
          <form method="POST" action="/api/owner/images" enctype="multipart/form-data" class="upload-form" data-category="about">
            <input type="hidden" name="_action" value="upload" />
            <input type="hidden" name="category" value="about" />
            <div class="upload-row">
              <input type="file" name="files" accept="image/*" multiple class="file-input-multi" />
            </div>
            <div class="upload-preview"></div>
          </form>
        </section>

        <!-- ─── PETS ─────────────────────────────────────── -->
        <section id="pets" class="edit-section">
          <h2 class="edit-section-title">Your Pets</h2>

          {pets.length > 0 && (
            <div class="pet-list">
              {pets.map((pet: any, i: number) => (
                <div class="pet-card">
                  {pet.photo_url && <img src={pet.photo_url} alt={pet.name} class="pet-card-photo" />}
                  <div class="pet-card-info">
                    <h3>{pet.name}</h3>
                    <p class="pet-meta">{pet.type}{pet.breed ? ` · ${pet.breed}` : ''}{pet.age ? ` · ${pet.age}` : ''}</p>
                    {pet.temperament && <p class="pet-detail">Temperament: {pet.temperament}</p>}
                    {pet.special_needs && <p class="pet-detail">Special needs: {pet.special_needs}</p>}
                  </div>
                  <form method="POST" action="/api/owner/pets">
                    <input type="hidden" name="_action" value="delete" />
                    <input type="hidden" name="index" value={String(i)} />
                    <button type="submit" class="thumb-delete pet-delete">×</button>
                  </form>
                </div>
              ))}
            </div>
          )}

          <details class="add-pet-toggle">
            <summary class="btn-outline">+ Add a pet</summary>
            <form method="POST" action="/api/owner/pets" enctype="multipart/form-data" class="edit-form" style="margin-top:16px;">
              <input type="hidden" name="_action" value="add" />
              <div class="form-grid">
                <div class="field">
                  <label for="pet_name">Pet name <span class="req">*</span></label>
                  <input type="text" id="pet_name" name="pet_name" placeholder="e.g. Buddy" required />
                </div>
                <div class="field">
                  <label for="pet_type">Type <span class="req">*</span></label>
                  <select id="pet_type" name="pet_type" required>
                    <option value="">Select...</option>
                    {petTypes.map(t => <option value={t}>{t}</option>)}
                  </select>
                </div>
                <div class="field">
                  <label for="pet_breed">Breed</label>
                  <input type="text" id="pet_breed" name="pet_breed" placeholder="e.g. Golden Retriever" />
                </div>
                <div class="field">
                  <label for="pet_age">Age</label>
                  <input type="text" id="pet_age" name="pet_age" placeholder="e.g. 3 years" />
                </div>
                <div class="field span-2">
                  <label for="pet_temperament">Temperament</label>
                  <input type="text" id="pet_temperament" name="pet_temperament" placeholder="e.g. Friendly, loves walks, great with strangers" />
                </div>
                <div class="field span-2">
                  <label for="pet_special_needs">Special needs</label>
                  <textarea id="pet_special_needs" name="pet_special_needs" rows="3" placeholder="e.g. Needs medication twice daily, afraid of thunderstorms"></textarea>
                </div>
                <div class="field span-2">
                  <label for="pet_photo">Photo</label>
                  <input type="file" id="pet_photo" name="pet_photo" accept="image/*" />
                </div>
              </div>
              <button type="submit" class="btn-primary">Add pet</button>
            </form>
          </details>
        </section>

        <!-- ─── AMENITIES ────────────────────────────────── -->
        <section id="amenities" class="edit-section">
          <h2 class="edit-section-title">Amenities</h2>
          <p class="section-hint">Select what your home offers. This helps sitters know what to expect.</p>
          <form method="POST" action="/api/owner/update" class="edit-form">
            <input type="hidden" name="name" value={profile.name} />
            <div class="amenities-grid">
              {allAmenities.map(a => (
                <label class="amenity-check">
                  <input type="checkbox" name="amenities" value={a} checked={amenities.includes(a)} />
                  <span>{a}</span>
                </label>
              ))}
            </div>
          </form>
        </section>

        <!-- ─── GALLERY ──────────────────────────────────── -->
        <section id="gallery" class="edit-section">
          <h2 class="edit-section-title">Gallery</h2>
          <p class="section-hint">Additional photos of your home, garden, neighbourhood, or pets.</p>
          <div class="image-grid">
            {gallery.map((img: any, i: number) => (
              <div class="image-thumb">
                <img src={img.src} alt={img.alt} />
                <form method="POST" action="/api/owner/images">
                  <input type="hidden" name="_action" value="delete" />
                  <input type="hidden" name="category" value="gallery" />
                  <input type="hidden" name="index" value={String(i)} />
                  <button type="submit" class="thumb-delete">×</button>
                </form>
              </div>
            ))}
          </div>
          <form method="POST" action="/api/owner/images" enctype="multipart/form-data" class="upload-form" data-category="gallery">
            <input type="hidden" name="_action" value="upload" />
            <input type="hidden" name="category" value="gallery" />
            <div class="upload-row">
              <input type="file" name="files" accept="image/*" multiple class="file-input-multi" />
            </div>
            <div class="upload-preview"></div>
          </form>
        </section>

        <!-- ─── LOOKING FOR ──────────────────────────────── -->
        <section id="looking-for" class="edit-section">
          <h2 class="edit-section-title">What you're looking for</h2>
          <p class="section-hint">Describe the ideal sitter — experience, dates, expectations, house rules.</p>
          <form method="POST" action="/api/owner/update" class="edit-form">
            <input type="hidden" name="name" value={profile.name} />
            <div class="field">
              <textarea id="looking_for" name="looking_for" rows="6" placeholder="e.g. We're looking for an experienced sitter who's comfortable with large dogs. Must be happy staying in a rural area with limited public transport...">{profile.looking_for ?? ''}</textarea>
            </div>
          </form>
        </section>

        <!-- ─── HEADINGS ─────────────────────────────────── -->
        <section id="headings" class="edit-section">
          <h2 class="edit-section-title">Section Headings</h2>
          <p class="section-hint">Customise the labels and titles on your public page.</p>
          <form method="POST" action="/api/profile/headings" class="edit-form">
            <div class="form-grid">
              <div class="field">
                <label>About label</label>
                <input type="text" name="about_label" value={h.about_label ?? ''} placeholder="About Our Home" />
              </div>
              <div class="field">
                <label>About title</label>
                <input type="text" name="about_title" value={h.about_title ?? ''} placeholder="A great place to stay — for you and the pets." />
              </div>
              <div class="field">
                <label>Pets label</label>
                <input type="text" name="gallery_label" value={h.gallery_label ?? ''} placeholder="Meet the Pets" />
              </div>
              <div class="field">
                <label>Gallery label</label>
                <input type="text" name="platforms_label" value={h.platforms_label ?? ''} placeholder="Our Home" />
              </div>
              <div class="field">
                <label>Contact label</label>
                <input type="text" name="enquiry_label" value={h.enquiry_label ?? ''} placeholder="Get In Touch" />
              </div>
              <div class="field">
                <label>Contact title</label>
                <input type="text" name="enquiry_title" value={h.enquiry_title ?? ''} placeholder={`Contact ${profile.name}`} />
              </div>
            </div>
          </form>
        </section>

        <!-- ─── SAVE ALL ─────────────────────────────────── -->
        <div class="save-bar">
          <button type="button" id="save-all" class="btn-primary save-all-btn">Save changes</button>
        </div>
      </div>
    </main>

    <div class="tab-bar">
      <a href="/owner/dashboard" class="tab-bar-item">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
        <span>Home</span>
      </a>
      <a href="/owner/dashboard?tab=sits" class="tab-bar-item">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"></path></svg>
        <span>My Sits</span>
      </a>
      <a href="/messages" class="tab-bar-item">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
        <span>Inbox</span>
      </a>
      <a href="/owner/edit" class="tab-bar-item active">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
        <span>Profile</span>
      </a>
    </div>

    <style is:global>
      .upload-preview {
        display: flex; flex-wrap: wrap; gap: 8px; margin: 12px 0;
      }
      .upload-preview:empty { display: none; }
      .upload-preview-thumb {
        position: relative; width: 80px; height: 60px; border-radius: 6px;
        overflow: hidden; border: 2px solid rgba(200,150,62,0.3); flex-shrink: 0;
      }
      .upload-preview-thumb img {
        width: 100%; height: 100%; object-fit: cover; display: block;
      }
      .preview-remove {
        position: absolute; top: -6px; right: -6px; width: 22px; height: 22px;
        border-radius: 50%; background: rgba(185,28,28,0.9); color: #fff;
        border: 2px solid #fff; font-size: 12px; cursor: pointer;
        display: flex; align-items: center; justify-content: center; line-height: 1;
        padding: 0;
      }
      .preview-remove:hover { background: #991b1b; }
    </style>
    <style is:global>
