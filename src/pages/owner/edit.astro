---
export const prerender = false;
import { getSession } from '../../lib/auth';
import { supabase } from '../../lib/supabase';

const session = await getSession(Astro.request);
if (!session) return Astro.redirect('/login');

const { data: profile } = await supabase
  .from('profiles')
  .select('*')
  .eq('user_id', session.userId)
  .single();

if (!profile) return Astro.redirect('/owner/create');

const heroImages: any[] = Array.isArray(profile.hero_images_json) ? profile.hero_images_json : [];
const aboutImages: any[] = Array.isArray(profile.about_images_json) ? profile.about_images_json : [];
const gallery: any[] = Array.isArray(profile.gallery_json) ? profile.gallery_json : [];
const pets: any[] = Array.isArray(profile.pets_json) ? profile.pets_json : [];
const amenities: string[] = Array.isArray(profile.amenities_json) ? profile.amenities_json : [];
const h = (profile.headings_json ?? {}) as Record<string, string>;
const t = (profile.theme_json ?? {}) as Record<string, string>;
const handover = (profile.handover_json ?? {}) as Record<string, string>;
const houseNotes: Array<{label: string; value: string}> = Array.isArray(profile.house_notes_json) ? profile.house_notes_json : [];

const saved = Astro.url.searchParams.get('saved');
const errorKey = Astro.url.searchParams.get('error') ?? '';
const detail = Astro.url.searchParams.get('detail');
const errorMap: Record<string, string> = {
  missing: 'Please fill in the required fields.',
  file_too_large: 'Image must be under 5 MB.',
  upload: `Upload error: ${detail ?? 'unknown'}`,
  server: 'Something went wrong. Please try again.',
};
const errorMsg = errorMap[errorKey] ?? '';

const allAmenities = [
  'WiFi', 'Parking', 'Garden', 'Pool', 'Gym', 'Air Conditioning',
  'Heating', 'Washer/Dryer', 'Dishwasher', 'TV/Streaming',
  'Workspace', 'Near Public Transport', 'Near Shops',
  'Rural/Countryside', 'Beach Nearby', 'Pet-Friendly Area',
];

const pct = Math.round(([
  !!profile.name?.trim(),
  !!profile.location?.trim(),
  !!profile.tagline?.trim(),
  (profile.bio?.trim().length ?? 0) > 80,
  heroImages.length > 0,
  gallery.length >= 4,
  pets.length > 0,
  amenities.length >= 5,
  (profile.looking_for?.trim().length ?? 0) > 40,
  Object.keys(handover).length >= 6 && houseNotes.length >= 2,
].filter(Boolean).length / 10) * 100);

const defaultTheme = { background: '#faf6ee', accent: '#2f5d45', accent_light: '#c4ab8a', text: '#2c1a0e', text_soft: '#6b4e35' };
const pvBg = t.background || defaultTheme.background;
const pvAccent = t.accent || defaultTheme.accent;
const pvText = t.text || defaultTheme.text;
const pvTextSoft = t.text_soft || defaultTheme.text_soft;

const heroSrc = heroImages[0]?.src || '';
const aboutSrc = aboutImages[0]?.src || gallery[0]?.src || '';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="icon" type="image/png" href="/images/favicon.png" />
    <link rel="apple-touch-icon" href="/images/app-tile.png" />
    <meta property="og:image" content="/images/logo-tile.png" />
    <link href="https://fonts.googleapis.com/css2?family=Marcellus&family=Montserrat:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Lato:wght@400;700&display=swap" rel="stylesheet" />
    <title>Edit profile — MYAH</title>
    <style>
      body { margin: 0; background: #faf6ee; color: #2c1a0e; font-family: "Montserrat", sans-serif; min-height: 100vh; }
      * { box-sizing: border-box; }
      a { color: #2f5d45; }
      a:hover { color: #2c1a0e; }
      input::placeholder, textarea::placeholder { color: rgba(44,26,14,.35); }
      input[type="color"] { -webkit-appearance: none; appearance: none; padding: 2px; }
      input[type="color"]::-webkit-color-swatch-wrapper { padding: 0; }
      input[type="color"]::-webkit-color-swatch { border: none; border-radius: 50%; }
      @keyframes gs-ring { to { transform: rotate(360deg); } }
      @keyframes gs-pulse { 0%,100% { transform: scale(1); } 50% { transform: scale(1.05); } }
      @media (max-width: 960px) {
        [data-topnav] { padding: 14px 24px !important; }
        [data-pad] { padding: 32px 20px 140px !important; }
        [data-two-col] { grid-template-columns: minmax(0,1fr) !important; }
        [data-aside] { position: static !important; }
        [data-card] { padding: 26px 22px !important; }
        [data-field-row] { grid-template-columns: minmax(0,1fr) !important; }
        [data-savebar] { padding: 14px 20px !important; }
      }
    </style>
  </head>
  <body>
    <div style="min-height:100vh;display:flex;flex-direction:column;background:#faf6ee">

      <div id="loader" aria-hidden="true" style="position:fixed;inset:0;z-index:9999;background:rgba(250,246,238,.92);backdrop-filter:blur(8px);display:flex;align-items:center;justify-content:center;opacity:0;pointer-events:none;transition:opacity .25s ease">
        <div style="position:relative;width:132px;height:132px;display:flex;align-items:center;justify-content:center">
          <div style="position:absolute;inset:0;border-radius:50%;border:3px solid rgba(110,84,56,.18)"></div>
          <div style="position:absolute;inset:0;border-radius:50%;border:3px solid transparent;border-top-color:#2f5d45;border-right-color:rgba(110,84,56,.45);animation:gs-ring 1s linear infinite"></div>
          <img src="/images/logo-mark.png" alt="" style="width:74px;height:74px;object-fit:contain;animation:gs-pulse 1.8s ease-in-out infinite" />
        </div>
      </div>

      <nav data-topnav="1" style="display:flex;justify-content:space-between;align-items:center;padding:16px 48px;background:#fff;border-bottom:1px solid rgba(110,84,56,.2)">
        <a href="/" style="display:inline-flex;align-items:center;gap:14px;text-decoration:none;line-height:1;margin-left:-4px">
          <img src="/images/logo-mark.png" alt="" style="height:44px;width:44px;display:block;object-fit:contain" />
          <span style="display:flex;flex-direction:column;gap:5px;padding-left:14px;border-left:1px solid rgba(110,84,56,.4)">
            <span style="color:#2f5d45;line-height:1;font-family:'Montserrat',sans-serif;font-weight:500;font-size:1.35rem;letter-spacing:.28em">MYAH</span>
            <span style="font-family:'Lato',sans-serif;font-weight:700;font-size:.5rem;letter-spacing:.2em;text-transform:uppercase;color:#8a6a4f;line-height:1">Make Yourself At Home</span>
          </span>
        </a>
        <div style="display:flex;align-items:center;gap:22px">
          <a href="/owner/dashboard" style="display:inline-flex;align-items:center;gap:9px;font-size:.78rem;color:#6b4e35;text-decoration:none;font-weight:600;letter-spacing:.1em;text-transform:uppercase;transition:gap .2s, color .2s"
            onmouseover="this.style.gap='13px';this.style.color='#2f5d45'" onmouseout="this.style.gap='9px';this.style.color='#6b4e35'">&larr; Dashboard</a>
          <a href={`/${profile.slug}`} target="_blank" style="font-size:.76rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:#2f5d45;text-decoration:none;transition:color .2s"
            onmouseover="this.style.color='#2c1a0e'" onmouseout="this.style.color='#2f5d45'">View my page</a>
        </div>
      </nav>

      <main data-pad="1" style="flex:1;padding:52px 48px 140px">
        <div style="max-width:1180px;margin:0 auto">

          <div style="border-bottom:1px solid rgba(110,84,56,.3);padding-bottom:30px;margin-bottom:26px">
            <p style="font-size:.75rem;font-weight:600;letter-spacing:.2em;text-transform:uppercase;color:#6e5438;margin:0 0 16px;display:flex;align-items:center;gap:12px">
              <span style="width:26px;height:1px;background:#6e5438;display:block;flex-shrink:0"></span>MYAH owner
            </p>
            <h1 style="font-family:'Marcellus',serif;font-size:2.5rem;color:#2c1a0e;line-height:1.15;margin:0 0 18px">Edit your <em style="color:#2f5d45;">home</em></h1>
            <p style="color:#6b4e35;font-size:1rem;line-height:1.75;max-width:600px;margin:0">Your home, your pets, and what you need from a sitter. Everything here is what sitters read before they enquire &mdash; the preview on the right moves as you type.</p>
          </div>

          {errorMsg && (
            <div style="background:rgba(185,28,28,.08);border:1px solid rgba(185,28,28,.3);border-radius:12px;padding:14px 20px;margin-bottom:28px;color:#b91c1c;font-size:.92rem;line-height:1.6">{errorMsg}</div>
          )}
          {saved && (
            <div style="background:rgba(47,93,69,.08);border:1px solid rgba(47,93,69,.3);border-radius:12px;padding:14px 20px;margin-bottom:28px;color:#2f5d45;font-size:.92rem;line-height:1.6">Changes saved successfully.</div>
          )}

          <div style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:34px">
            {[
              {href:'#details', label:'Details'},
              {href:'#photos', label:'Home photos'},
              {href:'#pets', label:'Pets'},
              {href:'#amenities', label:'Amenities'},
              {href:'#looking-for', label:'Looking for'},
              {href:'#handover', label:'Handover'},
              {href:'#headings', label:'Headings'},
              {href:'#preview', label:'Colours'},
            ].map(j => (
              <a href={j.href} style="font-size:.74rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#6b4e35;text-decoration:none;padding:8px 16px;border-radius:50px;background:#fff;border:1px solid rgba(110,84,56,.28);transition:background .2s, color .2s, border-color .2s"
                onmouseover="this.style.background='rgba(110,84,56,.1)';this.style.color='#2f5d45';this.style.borderColor='rgba(110,84,56,.5)'"
                onmouseout="this.style.background='#fff';this.style.color='#6b4e35';this.style.borderColor='rgba(110,84,56,.28)'">{j.label}</a>
            ))}
          </div>

          <div data-two-col="1" style="display:grid;grid-template-columns:minmax(0,1.55fr) minmax(0,1fr);gap:28px;align-items:start">

            <div style="display:flex;flex-direction:column;gap:24px">

              <!-- 01 Details -->
              <section id="details" data-card="1" style="background:#fff;border:1px solid rgba(110,84,56,.22);border-radius:18px;padding:36px;box-shadow:0 1px 2px rgba(44,26,14,.04);transition:box-shadow .3s ease, border-color .3s ease">
                <div style="display:flex;align-items:baseline;gap:14px;margin:0 0 8px">
                  <span style="font-family:'Marcellus',serif;font-size:.92rem;color:#6e5438;letter-spacing:.08em">01</span>
                  <h2 style="font-family:'Marcellus',serif;font-size:1.3rem;color:#2c1a0e;margin:0">Details</h2>
                </div>
                <div style="width:40px;height:2px;background:#6e5438;margin:0 0 12px"></div>
                <p style="font-size:.9rem;color:#6b4e35;line-height:1.7;margin:0 0 28px;max-width:460px">Who you are, where you are, and a few words about the place a sitter would be staying in.</p>

                <div data-field-row="1" style="display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-bottom:24px">
                  <div>
                    <label for="name" style="display:block;font-size:.78rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#5c3d20;margin-bottom:10px">Your name <span style="color:#2f5d45">*</span></label>
                    <input id="name" type="text" required value={profile.name}
                      style="width:100%;border:1.5px solid rgba(44,26,14,.18);border-radius:10px;padding:13px 16px;font-size:.97rem;font-family:'Montserrat',sans-serif;color:#2c1a0e;background:#faf6ee;outline:none;transition:border-color .2s, box-shadow .2s"
                      onfocus="this.style.borderColor='#2f5d45';this.style.boxShadow='0 0 0 3px rgba(110,84,56,.15)'"
                      onblur="this.style.borderColor='rgba(44,26,14,.18)';this.style.boxShadow=''"
                      oninput="markDirty()" />
                  </div>
                  <div>
                    <label for="location" style="display:block;font-size:.78rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#5c3d20;margin-bottom:10px">Location</label>
                    <input id="location" type="text" value={profile.location ?? ''} placeholder="e.g. Bath, UK"
                      style="width:100%;border:1.5px solid rgba(44,26,14,.18);border-radius:10px;padding:13px 16px;font-size:.97rem;font-family:'Montserrat',sans-serif;color:#2c1a0e;background:#faf6ee;outline:none;transition:border-color .2s, box-shadow .2s"
                      onfocus="this.style.borderColor='#2f5d45';this.style.boxShadow='0 0 0 3px rgba(110,84,56,.15)'"
                      onblur="this.style.borderColor='rgba(44,26,14,.18)';this.style.boxShadow=''"
                      oninput="markDirty();updatePreview()" />
                  </div>
                </div>

                <div style="margin-bottom:24px">
                  <label for="tagline" style="display:block;font-size:.78rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#5c3d20;margin-bottom:10px">Tagline</label>
                  <input id="tagline" type="text" value={profile.tagline ?? ''} placeholder="e.g. Cosy Georgian townhouse with two easy dogs"
                    style="width:100%;border:1.5px solid rgba(44,26,14,.18);border-radius:10px;padding:13px 16px;font-size:.97rem;font-family:'Montserrat',sans-serif;color:#2c1a0e;background:#faf6ee;outline:none;transition:border-color .2s, box-shadow .2s"
                    onfocus="this.style.borderColor='#2f5d45';this.style.boxShadow='0 0 0 3px rgba(110,84,56,.15)'"
                    onblur="this.style.borderColor='rgba(44,26,14,.18)';this.style.boxShadow=''"
                    oninput="markDirty();updatePreview()" />
                </div>

                <div style="margin-bottom:26px">
                  <label for="bio" style="display:block;font-size:.78rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#5c3d20;margin-bottom:10px">About your home</label>
                  <textarea id="bio" rows="7" placeholder="The house, the neighbourhood, what a week here actually feels like."
                    style="width:100%;border:1.5px solid rgba(44,26,14,.18);border-radius:10px;padding:13px 16px;font-size:.97rem;font-family:'Montserrat',sans-serif;color:#2c1a0e;background:#faf6ee;outline:none;resize:vertical;line-height:1.7;transition:border-color .2s, box-shadow .2s"
                    onfocus="this.style.borderColor='#2f5d45';this.style.boxShadow='0 0 0 3px rgba(110,84,56,.15)'"
                    onblur="this.style.borderColor='rgba(44,26,14,.18)';this.style.boxShadow=''"
                    oninput="markDirty();updateBioCount();updatePreview()">{profile.bio ?? ''}</textarea>
                  <p id="bioCount" style="font-size:.82rem;color:#6b4e35;margin:8px 0 0;line-height:1.6">{(profile.bio?.length ?? 0)} characters — sitters see the first 130 on the preview card.</p>
                </div>

                <div style="border-top:1px solid rgba(44,26,14,.08);padding-top:26px">
                  <p style="font-size:.72rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:#6b4e35;margin:0 0 20px">Where enquiries go</p>
                  <div data-field-row="1" style="display:grid;grid-template-columns:1fr 1fr;gap:18px">
                    <div>
                      <label for="contact_email" style="display:block;font-size:.78rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#5c3d20;margin-bottom:10px">Enquiry email <span style="color:#2f5d45">*</span></label>
                      <input id="contact_email" type="email" required value={profile.contact_email ?? ''}
                        style="width:100%;border:1.5px solid rgba(44,26,14,.18);border-radius:10px;padding:13px 16px;font-size:.97rem;font-family:'Montserrat',sans-serif;color:#2c1a0e;background:#faf6ee;outline:none;transition:border-color .2s, box-shadow .2s"
                        onfocus="this.style.borderColor='#2f5d45';this.style.boxShadow='0 0 0 3px rgba(110,84,56,.15)'"
                        onblur="this.style.borderColor='rgba(44,26,14,.18)';this.style.boxShadow=''"
                        oninput="markDirty()" />
                    </div>
                    <div>
                      <label for="whatsapp_number" style="display:block;font-size:.78rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#5c3d20;margin-bottom:10px">WhatsApp number</label>
                      <input id="whatsapp_number" type="tel" value={profile.whatsapp_number ?? ''} placeholder="+447700900000"
                        style="width:100%;border:1.5px solid rgba(44,26,14,.18);border-radius:10px;padding:13px 16px;font-size:.97rem;font-family:'Montserrat',sans-serif;color:#2c1a0e;background:#faf6ee;outline:none;transition:border-color .2s, box-shadow .2s"
                        onfocus="this.style.borderColor='#2f5d45';this.style.boxShadow='0 0 0 3px rgba(110,84,56,.15)'"
                        onblur="this.style.borderColor='rgba(44,26,14,.18)';this.style.boxShadow=''"
                        oninput="markDirty()" />
                    </div>
                  </div>
                </div>
              </section>

              <!-- 02 Home Photos -->
              <section id="photos" data-card="1" style="background:#fff;border:1px solid rgba(110,84,56,.22);border-radius:18px;padding:36px;box-shadow:0 1px 2px rgba(44,26,14,.04)">
                <div style="display:flex;align-items:baseline;gap:14px;margin:0 0 8px">
                  <span style="font-family:'Marcellus',serif;font-size:.92rem;color:#6e5438;letter-spacing:.08em">02</span>
                  <h2 style="font-family:'Marcellus',serif;font-size:1.3rem;color:#2c1a0e;margin:0">Home photos</h2>
                </div>
                <div style="width:40px;height:2px;background:#6e5438;margin:0 0 24px"></div>

                {/* Banner photos */}
                <div style="padding-bottom:26px;margin-bottom:26px;border-bottom:1px solid rgba(44,26,14,.07)">
                  <div style="display:flex;align-items:baseline;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-bottom:6px">
                    <p style="font-size:.76rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:#5c3d20;margin:0">Banner photos</p>
                    <span style="font-size:.78rem;color:#6b4e35">{heroImages.length} {heroImages.length === 1 ? 'photo' : 'photos'}</span>
                  </div>
                  <p style="font-size:.86rem;color:#6b4e35;line-height:1.65;margin:0 0 16px;max-width:480px">The wide shots at the top of your page. Outside, the living room, the garden — whatever sells the place.</p>
                  <div style="display:flex;flex-wrap:wrap;gap:12px">
                    {heroImages.map((img: any, i: number) => (
                      <div style="position:relative;width:118px;height:88px;border-radius:10px;overflow:hidden;border:1px solid rgba(110,84,56,.25)">
                        <img src={img.src} alt="" style="width:100%;height:100%;object-fit:cover;display:block" />
                        {i === 0 && <span style="position:absolute;left:6px;bottom:6px;font-size:.58rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#fff;background:rgba(44,26,14,.62);padding:3px 9px;border-radius:50px">Cover</span>}
                        <form method="POST" action="/api/owner/images" style="display:inline">
                          <input type="hidden" name="_action" value="delete" />
                          <input type="hidden" name="category" value="hero" />
                          <input type="hidden" name="index" value={String(i)} />
                          <button type="submit" title="Remove photo" style="position:absolute;top:6px;right:6px;width:23px;height:23px;border-radius:50%;background:rgba(44,26,14,.6);color:#fff;border:none;font-size:14px;line-height:1;cursor:pointer;display:flex;align-items:center;justify-content:center;padding:0">&times;</button>
                        </form>
                      </div>
                    ))}
                    <label style="width:118px;height:88px;border-radius:10px;border:1.5px dashed rgba(110,84,56,.5);background:#faf6ee;color:#2f5d45;font-family:'Montserrat',sans-serif;font-size:.74rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:background .25s ease, border-color .25s ease"
                      onmouseover="this.style.background='rgba(110,84,56,.12)';this.style.borderColor='#2f5d45'"
                      onmouseout="this.style.background='#faf6ee';this.style.borderColor='rgba(110,84,56,.5)'">
                      + Add
                      <input type="file" accept="image/*" multiple data-upload-cat="hero" style="display:none" onchange="markDirty();queueFiles(this,'hero')" />
                    </label>
                  </div>
                  <div data-preview-for="hero" style="display:flex;flex-wrap:wrap;gap:10px;margin-top:10px"></div>
                </div>

                {/* Interior photos */}
                <div style="padding-bottom:26px;margin-bottom:26px;border-bottom:1px solid rgba(44,26,14,.07)">
                  <div style="display:flex;align-items:baseline;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-bottom:6px">
                    <p style="font-size:.76rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:#5c3d20;margin:0">Interior &amp; lifestyle</p>
                    <span style="font-size:.78rem;color:#6b4e35">{aboutImages.length} {aboutImages.length === 1 ? 'photo' : 'photos'}</span>
                  </div>
                  <p style="font-size:.86rem;color:#6b4e35;line-height:1.65;margin:0 0 16px;max-width:480px">Smaller photos beside your About text.</p>
                  <div style="display:flex;flex-wrap:wrap;gap:12px">
                    {aboutImages.map((img: any, i: number) => (
                      <div style="position:relative;width:118px;height:88px;border-radius:10px;overflow:hidden;border:1px solid rgba(110,84,56,.25)">
                        <img src={img.src} alt="" style="width:100%;height:100%;object-fit:cover;display:block" />
                        <form method="POST" action="/api/owner/images" style="display:inline">
                          <input type="hidden" name="_action" value="delete" />
                          <input type="hidden" name="category" value="about" />
                          <input type="hidden" name="index" value={String(i)} />
                          <button type="submit" title="Remove" style="position:absolute;top:6px;right:6px;width:23px;height:23px;border-radius:50%;background:rgba(44,26,14,.6);color:#fff;border:none;font-size:14px;line-height:1;cursor:pointer;display:flex;align-items:center;justify-content:center;padding:0">&times;</button>
                        </form>
                      </div>
                    ))}
                    <label style="width:118px;height:88px;border-radius:10px;border:1.5px dashed rgba(110,84,56,.5);background:#faf6ee;color:#2f5d45;font-family:'Montserrat',sans-serif;font-size:.74rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:background .25s ease, border-color .25s ease"
                      onmouseover="this.style.background='rgba(110,84,56,.12)';this.style.borderColor='#2f5d45'"
                      onmouseout="this.style.background='#faf6ee';this.style.borderColor='rgba(110,84,56,.5)'">
                      + Add
                      <input type="file" accept="image/*" multiple data-upload-cat="about" style="display:none" onchange="markDirty();queueFiles(this,'about')" />
                    </label>
                  </div>
                  <div data-preview-for="about" style="display:flex;flex-wrap:wrap;gap:10px;margin-top:10px"></div>
                </div>

                {/* Gallery */}
                <div>
                  <div style="display:flex;align-items:baseline;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-bottom:6px">
                    <p style="font-size:.76rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:#5c3d20;margin:0">Gallery</p>
                    <span style="font-size:.78rem;color:#6b4e35">{gallery.length} {gallery.length === 1 ? 'photo' : 'photos'}</span>
                  </div>
                  <p style="font-size:.86rem;color:#6b4e35;line-height:1.65;margin:0 0 16px;max-width:480px">The grid further down — rooms, garden, neighbourhood.</p>
                  <div style="display:flex;flex-wrap:wrap;gap:12px">
                    {gallery.map((img: any, i: number) => (
                      <div style="position:relative;width:118px;height:88px;border-radius:10px;overflow:hidden;border:1px solid rgba(110,84,56,.25)">
                        <img src={img.src} alt="" style="width:100%;height:100%;object-fit:cover;display:block" />
                        <form method="POST" action="/api/owner/images" style="display:inline">
                          <input type="hidden" name="_action" value="delete" />
                          <input type="hidden" name="category" value="gallery" />
                          <input type="hidden" name="index" value={String(i)} />
                          <button type="submit" title="Remove" style="position:absolute;top:6px;right:6px;width:23px;height:23px;border-radius:50%;background:rgba(44,26,14,.6);color:#fff;border:none;font-size:14px;line-height:1;cursor:pointer;display:flex;align-items:center;justify-content:center;padding:0">&times;</button>
                        </form>
                      </div>
                    ))}
                    <label style="width:118px;height:88px;border-radius:10px;border:1.5px dashed rgba(110,84,56,.5);background:#faf6ee;color:#2f5d45;font-family:'Montserrat',sans-serif;font-size:.74rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:background .25s ease, border-color .25s ease"
                      onmouseover="this.style.background='rgba(110,84,56,.12)';this.style.borderColor='#2f5d45'"
                      onmouseout="this.style.background='#faf6ee';this.style.borderColor='rgba(110,84,56,.5)'">
                      + Add
                      <input type="file" accept="image/*" multiple data-upload-cat="gallery" style="display:none" onchange="markDirty();queueFiles(this,'gallery')" />
                    </label>
                  </div>
                  <div data-preview-for="gallery" style="display:flex;flex-wrap:wrap;gap:10px;margin-top:10px"></div>
                </div>
              </section>

              <!-- 03 Pets -->
              <section id="pets" data-card="1" style="background:#fff;border:1px solid rgba(110,84,56,.22);border-radius:18px;padding:36px;box-shadow:0 1px 2px rgba(44,26,14,.04)">
                <div style="display:flex;align-items:baseline;gap:14px;margin:0 0 8px">
                  <span style="font-family:'Marcellus',serif;font-size:.92rem;color:#6e5438;letter-spacing:.08em">03</span>
                  <h2 style="font-family:'Marcellus',serif;font-size:1.3rem;color:#2c1a0e;margin:0">Your pets</h2>
                </div>
                <div style="width:40px;height:2px;background:#6e5438;margin:0 0 12px"></div>
                <p style="font-size:.9rem;color:#6b4e35;line-height:1.7;margin:0 0 24px;max-width:500px">Add each pet with their quirks, routine and any medication, so a sitter knows exactly what to expect.</p>

                {pets.length > 0 && (
                  <div style="display:flex;flex-direction:column;gap:14px;margin-bottom:24px">
                    {pets.map((pet: any, i: number) => (
                      <div style="display:flex;gap:18px;align-items:flex-start;background:#faf6ee;border:1px solid rgba(110,84,56,.2);border-radius:14px;padding:20px 22px">
                        {pet.photo_url && <img src={pet.photo_url} alt="" style="width:74px;height:74px;border-radius:12px;object-fit:cover;flex-shrink:0" />}
                        <div style="flex:1;min-width:0">
                          <p style="font-family:'Marcellus',serif;font-size:1.1rem;color:#2c1a0e;margin:0 0 4px">{pet.name}</p>
                          <p style="font-size:.82rem;color:#2f5d45;font-weight:600;margin:0 0 8px">{[pet.type, pet.breed, pet.age].filter(Boolean).join(' · ')}</p>
                          {pet.temperament && <p style="font-size:.86rem;color:#6b4e35;line-height:1.6;margin:0">{pet.temperament}</p>}
                          {pet.special_needs && <p style="font-size:.84rem;color:#2f5d45;font-weight:700;line-height:1.6;margin:8px 0 0">Special needs: {pet.special_needs}</p>}
                        </div>
                        <form method="POST" action="/api/owner/pets" style="display:inline">
                          <input type="hidden" name="_action" value="delete" />
                          <input type="hidden" name="index" value={String(i)} />
                          <button type="submit" title="Remove pet" style="width:26px;height:26px;border-radius:50%;background:rgba(44,26,14,.08);color:#6b4e35;border:none;font-size:15px;line-height:1;cursor:pointer;display:flex;align-items:center;justify-content:center;flex-shrink:0;padding:0">&times;</button>
                        </form>
                      </div>
                    ))}
                  </div>
                )}

                <div id="addPetPanel" style="display:none;background:#faf6ee;border:1px dashed rgba(110,84,56,.45);border-radius:14px;padding:24px 26px;margin-bottom:16px">
                  <p style="font-size:.76rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:#5c3d20;margin:0 0 18px">New pet</p>
                  <div data-field-row="1" style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px">
                    <input id="petName" type="text" placeholder="Name — e.g. Solomon"
                      style="width:100%;border:1.5px solid rgba(44,26,14,.18);border-radius:10px;padding:12px 15px;font-size:.94rem;font-family:'Montserrat',sans-serif;color:#2c1a0e;background:#fff;outline:none;transition:border-color .2s, box-shadow .2s"
                      onfocus="this.style.borderColor='#2f5d45';this.style.boxShadow='0 0 0 3px rgba(110,84,56,.15)'"
                      onblur="this.style.borderColor='rgba(44,26,14,.18)';this.style.boxShadow=''" />
                    <select id="petType" style="width:100%;border:1.5px solid rgba(44,26,14,.18);border-radius:10px;padding:12px 15px;font-size:.94rem;font-family:'Montserrat',sans-serif;color:#2c1a0e;background:#fff;outline:none">
                      <option>Dog</option><option>Cat</option><option>Bird</option><option>Rabbit</option><option>Horse</option><option>Other</option>
                    </select>
                  </div>
                  <div data-field-row="1" style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px">
                    <input id="petBreed" type="text" placeholder="Breed — e.g. Labrador"
                      style="width:100%;border:1.5px solid rgba(44,26,14,.18);border-radius:10px;padding:12px 15px;font-size:.94rem;font-family:'Montserrat',sans-serif;color:#2c1a0e;background:#fff;outline:none;transition:border-color .2s, box-shadow .2s"
                      onfocus="this.style.borderColor='#2f5d45';this.style.boxShadow='0 0 0 3px rgba(110,84,56,.15)'"
                      onblur="this.style.borderColor='rgba(44,26,14,.18)';this.style.boxShadow=''" />
                    <input id="petAge" type="text" placeholder="Age — e.g. 9 years"
                      style="width:100%;border:1.5px solid rgba(44,26,14,.18);border-radius:10px;padding:12px 15px;font-size:.94rem;font-family:'Montserrat',sans-serif;color:#2c1a0e;background:#fff;outline:none;transition:border-color .2s, box-shadow .2s"
                      onfocus="this.style.borderColor='#2f5d45';this.style.boxShadow='0 0 0 3px rgba(110,84,56,.15)'"
                      onblur="this.style.borderColor='rgba(44,26,14,.18)';this.style.boxShadow=''" />
                  </div>
                  <input id="petTemperament" type="text" placeholder="Temperament — e.g. Gentle, loves a long walk, wary of strangers at first"
                    style="width:100%;border:1.5px solid rgba(44,26,14,.18);border-radius:10px;padding:12px 15px;font-size:.94rem;font-family:'Montserrat',sans-serif;color:#2c1a0e;background:#fff;outline:none;margin-bottom:16px;transition:border-color .2s, box-shadow .2s"
                    onfocus="this.style.borderColor='#2f5d45';this.style.boxShadow='0 0 0 3px rgba(110,84,56,.15)'"
                    onblur="this.style.borderColor='rgba(44,26,14,.18)';this.style.boxShadow=''" />
                  <textarea id="petNeeds" rows="3" placeholder="Special needs — medication, anxieties, anything a sitter must know"
                    style="width:100%;border:1.5px solid rgba(44,26,14,.18);border-radius:10px;padding:12px 15px;font-size:.94rem;font-family:'Montserrat',sans-serif;color:#2c1a0e;background:#fff;outline:none;resize:vertical;line-height:1.65;margin-bottom:18px;transition:border-color .2s, box-shadow .2s"
                    onfocus="this.style.borderColor='#2f5d45';this.style.boxShadow='0 0 0 3px rgba(110,84,56,.15)'"
                    onblur="this.style.borderColor='rgba(44,26,14,.18)';this.style.boxShadow=''"></textarea>
                  <div style="display:flex;align-items:center;gap:16px;flex-wrap:wrap">
                    <button type="button" onclick="submitPet()"
                      style="font-family:'Montserrat',sans-serif;font-size:.78rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#fff;background:#2f5d45;border:1.5px solid #2f5d45;border-radius:50px;box-shadow:0 6px 20px rgba(110,84,56,.28);padding:13px 28px;cursor:pointer;transition:background .25s ease, transform .15s ease"
                      onmouseover="this.style.background='#3e7a5b';this.style.transform='translateY(-2px)'"
                      onmouseout="this.style.background='#2f5d45';this.style.transform=''">Add pet</button>
                    <button type="button" onclick="toggleAddPet()"
                      style="font-family:'Montserrat',sans-serif;font-size:.76rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#6b4e35;background:none;border:none;cursor:pointer;padding:6px 2px;transition:color .2s"
                      onmouseover="this.style.color='#2c1a0e'" onmouseout="this.style.color='#6b4e35'">Cancel</button>
                  </div>
                </div>

                <button type="button" id="addPetBtn" onclick="toggleAddPet()"
                  style="font-family:'Montserrat',sans-serif;font-size:.76rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#2f5d45;background:#fff;border:1.5px solid rgba(110,84,56,.45);border-radius:50px;padding:13px 28px;cursor:pointer;transition:background .25s ease, border-color .25s ease, transform .15s ease"
                  onmouseover="this.style.background='rgba(110,84,56,.1)';this.style.borderColor='#2f5d45';this.style.transform='translateY(-1px)'"
                  onmouseout="this.style.background='#fff';this.style.borderColor='rgba(110,84,56,.45)';this.style.transform=''">+ Add a pet</button>
              </section>

              <!-- 04 Amenities -->
              <section id="amenities" data-card="1" style="background:#fff;border:1px solid rgba(110,84,56,.22);border-radius:18px;padding:36px;box-shadow:0 1px 2px rgba(44,26,14,.04)">
                <div style="display:flex;align-items:baseline;gap:14px;margin:0 0 8px">
                  <span style="font-family:'Marcellus',serif;font-size:.92rem;color:#6e5438;letter-spacing:.08em">04</span>
                  <h2 style="font-family:'Marcellus',serif;font-size:1.3rem;color:#2c1a0e;margin:0">Amenities</h2>
                </div>
                <div style="width:40px;height:2px;background:#6e5438;margin:0 0 12px"></div>
                <p id="amenityCount" style="font-size:.9rem;color:#6b4e35;line-height:1.7;margin:0 0 22px;max-width:500px">{amenities.length} of {allAmenities.length} selected. Sitters filter on these, so tick everything that genuinely applies.</p>
                <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(168px,1fr));gap:10px" id="amenitiesGrid">
                  {allAmenities.map(a => {
                    const on = amenities.includes(a);
                    return (
                      <button type="button" data-amenity={a}
                        onclick="toggleAmenity(this)"
                        style={`display:flex;align-items:center;gap:9px;text-align:left;font-family:'Montserrat',sans-serif;font-size:.88rem;padding:12px 15px;border-radius:10px;cursor:pointer;transition:background .2s ease, border-color .2s ease, color .2s ease;${on ? 'background:rgba(110,84,56,.12);border:1.5px solid rgba(110,84,56,.5);color:#2c1a0e;' : 'background:#faf6ee;border:1.5px solid rgba(44,26,14,.1);color:#6b4e35;'}`}>
                        <span style={`font-size:.68rem;flex-shrink:0;${on ? 'color:#2f5d45;' : 'color:rgba(44,26,14,.2);'}`}>✓</span>{a}
                      </button>
                    );
                  })}
                </div>
              </section>

              <!-- 05 Looking for -->
              <section id="looking-for" data-card="1" style="background:#fff;border:1px solid rgba(110,84,56,.22);border-radius:18px;padding:36px;box-shadow:0 1px 2px rgba(44,26,14,.04)">
                <div style="display:flex;align-items:baseline;gap:14px;margin:0 0 8px">
                  <span style="font-family:'Marcellus',serif;font-size:.92rem;color:#6e5438;letter-spacing:.08em">05</span>
                  <h2 style="font-family:'Marcellus',serif;font-size:1.3rem;color:#2c1a0e;margin:0">What you're looking for</h2>
                </div>
                <div style="width:40px;height:2px;background:#6e5438;margin:0 0 12px"></div>
                <p style="font-size:.9rem;color:#6b4e35;line-height:1.7;margin:0 0 22px;max-width:500px">Describe the ideal sitter &mdash; experience, expectations, house rules. Specific beats polite.</p>
                <textarea id="looking_for" rows="6" placeholder="e.g. Someone comfortable with a large dog, happy in a rural spot with no bus route, and around the house most of the day."
                  style="width:100%;border:1.5px solid rgba(44,26,14,.18);border-radius:10px;padding:13px 16px;font-size:.97rem;font-family:'Montserrat',sans-serif;color:#2c1a0e;background:#faf6ee;outline:none;resize:vertical;line-height:1.7;transition:border-color .2s, box-shadow .2s"
                  onfocus="this.style.borderColor='#2f5d45';this.style.boxShadow='0 0 0 3px rgba(110,84,56,.15)'"
                  onblur="this.style.borderColor='rgba(44,26,14,.18)';this.style.boxShadow=''"
                  oninput="markDirty()">{profile.looking_for ?? ''}</textarea>
              </section>

              <!-- 06 Handover -->
              <section id="handover" data-card="1" style="background:#fff;border:1px solid rgba(110,84,56,.22);border-radius:18px;padding:36px;box-shadow:0 1px 2px rgba(44,26,14,.04)">
                <div style="display:flex;align-items:baseline;gap:14px;margin:0 0 8px">
                  <span style="font-family:'Marcellus',serif;font-size:.92rem;color:#6e5438;letter-spacing:.08em">06</span>
                  <h2 style="font-family:'Marcellus',serif;font-size:1.3rem;color:#2c1a0e;margin:0">Handover details</h2>
                </div>
                <div style="width:40px;height:2px;background:#6e5438;margin:0 0 16px"></div>
                <div style="display:flex;align-items:flex-start;gap:13px;background:rgba(110,84,56,.1);border:1px solid rgba(110,84,56,.32);border-radius:12px;padding:16px 18px;margin-bottom:26px;max-width:560px">
                  <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#2f5d45" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;margin-top:2px"><rect x="4" y="10" width="16" height="11" rx="2"></rect><path d="M8 10V7a4 4 0 0 1 8 0v3"></path></svg>
                  <p style="font-size:.9rem;color:#5c3d20;line-height:1.65;margin:0">Private. None of this appears on your public page or in browse &mdash; it&rsquo;s released to one sitter only, the moment you confirm them for a sit.</p>
                </div>

                <div data-field-row="1" style="display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-bottom:24px">
                  {[
                    {key:'address', label:'Full address', placeholder:'House name, street, postcode', wide:true},
                    {key:'access', label:'Parking & access', placeholder:'Where a sitter puts the car', wide:false},
                    {key:'wifi_name', label:'Wifi network', placeholder:'Network name', wide:false},
                    {key:'wifi_pass', label:'Wifi password', placeholder:'Password', wide:false},
                    {key:'vet', label:'Vet practice', placeholder:'Practice name · phone', wide:true},
                    {key:'vet_ooh', label:'Out-of-hours vet', placeholder:'Practice name · phone', wide:true},
                    {key:'neighbour', label:'Neighbour with a key', placeholder:'Name · phone', wide:false},
                    {key:'mobile', label:'Your mobile', placeholder:'Number a sitter can reach you on', wide:false},
                  ].map(f => (
                    <div style={f.wide ? 'grid-column:1/-1' : ''}>
                      <label style={`display:block;font-size:.78rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#5c3d20;margin-bottom:10px`}>{f.label}</label>
                      <input type="text" name={`handover_${f.key}`} value={handover[f.key] ?? ''} placeholder={f.placeholder}
                        style="width:100%;border:1.5px solid rgba(44,26,14,.18);border-radius:10px;padding:13px 16px;font-size:.95rem;font-family:'Montserrat',sans-serif;color:#2c1a0e;background:#faf6ee;outline:none;transition:border-color .2s, box-shadow .2s"
                        onfocus="this.style.borderColor='#2f5d45';this.style.boxShadow='0 0 0 3px rgba(110,84,56,.15)'"
                        onblur="this.style.borderColor='rgba(44,26,14,.18)';this.style.boxShadow=''"
                        oninput="markDirty()" />
                    </div>
                  ))}
                </div>

                <div style="border-top:1px solid rgba(44,26,14,.08);padding-top:26px">
                  <p style="font-size:.72rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:#6b4e35;margin:0 0 6px">House notes</p>
                  <p style="font-size:.86rem;color:#6b4e35;line-height:1.65;margin:0 0 18px;max-width:500px">The small things a sitter can't guess &mdash; bin day, the gate that sticks, where the logs are.</p>
                  <div id="houseNotesList" style="display:flex;flex-direction:column;gap:12px;margin-bottom:18px">
                    {houseNotes.map((n, i) => (
                      <div style="display:flex;gap:12px;align-items:center;background:#faf6ee;border:1px solid rgba(110,84,56,.2);border-radius:12px;padding:14px 16px">
                        <span style="font-size:.74rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#2f5d45;width:100px;flex-shrink:0">{n.label}</span>
                        <span style="flex:1;min-width:0;font-size:.92rem;color:#6b4e35;line-height:1.6">{n.value}</span>
                        <button type="button" onclick={`removeNote(${i})`} title="Remove note"
                          style="width:24px;height:24px;border-radius:50%;background:rgba(44,26,14,.08);color:#6b4e35;border:none;font-size:14px;line-height:1;cursor:pointer;display:flex;align-items:center;justify-content:center;flex-shrink:0;padding:0">&times;</button>
                      </div>
                    ))}
                  </div>
                  <div data-field-row="1" style="display:grid;grid-template-columns:.7fr 1.6fr;gap:16px;margin-bottom:16px">
                    <input id="noteLabel" type="text" placeholder="Label — e.g. Bins"
                      style="width:100%;border:1.5px solid rgba(44,26,14,.18);border-radius:10px;padding:12px 15px;font-size:.93rem;font-family:'Montserrat',sans-serif;color:#2c1a0e;background:#faf6ee;outline:none;transition:border-color .2s, box-shadow .2s"
                      onfocus="this.style.borderColor='#2f5d45';this.style.boxShadow='0 0 0 3px rgba(110,84,56,.15)'"
                      onblur="this.style.borderColor='rgba(44,26,14,.18)';this.style.boxShadow=''" />
                    <input id="noteValue" type="text" placeholder="What a sitter needs to know"
                      style="width:100%;border:1.5px solid rgba(44,26,14,.18);border-radius:10px;padding:12px 15px;font-size:.93rem;font-family:'Montserrat',sans-serif;color:#2c1a0e;background:#faf6ee;outline:none;transition:border-color .2s, box-shadow .2s"
                      onfocus="this.style.borderColor='#2f5d45';this.style.boxShadow='0 0 0 3px rgba(110,84,56,.15)'"
                      onblur="this.style.borderColor='rgba(44,26,14,.18)';this.style.boxShadow=''" />
                  </div>
                  <button type="button" onclick="addNote()"
                    style="font-family:'Montserrat',sans-serif;font-size:.76rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#2f5d45;background:#fff;border:1.5px solid rgba(110,84,56,.45);border-radius:50px;padding:12px 26px;cursor:pointer;transition:background .25s ease, border-color .25s ease, transform .15s ease"
                    onmouseover="this.style.background='rgba(110,84,56,.1)';this.style.borderColor='#2f5d45';this.style.transform='translateY(-1px)'"
                    onmouseout="this.style.background='#fff';this.style.borderColor='rgba(110,84,56,.45)';this.style.transform=''">Add note</button>
                </div>
              </section>

              <!-- 07 Section headings -->
              <section id="headings" data-card="1" style="background:#fff;border:1px solid rgba(110,84,56,.22);border-radius:18px;padding:36px;box-shadow:0 1px 2px rgba(44,26,14,.04)">
                <div style="display:flex;align-items:baseline;gap:14px;margin:0 0 8px">
                  <span style="font-family:'Marcellus',serif;font-size:.92rem;color:#6e5438;letter-spacing:.08em">07</span>
                  <h2 style="font-family:'Marcellus',serif;font-size:1.3rem;color:#2c1a0e;margin:0">Section headings</h2>
                </div>
                <div style="width:40px;height:2px;background:#6e5438;margin:0 0 12px"></div>
                <p style="font-size:.9rem;color:#6b4e35;line-height:1.7;margin:0 0 26px;max-width:500px">Leave anything blank to keep the wording shown.</p>
                <div style="display:flex;flex-direction:column;gap:26px">
                  {[
                    {title:'About section', where:'Your bio text and photos.', labelKey:'about_label', titleKey:'about_title', labelPh:'About Our Home', titlePh:'A great place to stay — for you and the pets.'},
                    {title:'Pets section', where:'The row of pet cards.', labelKey:'pets_label', titleKey:'pets_title', labelPh:'Meet the Pets', titlePh:'Who you would be looking after'},
                    {title:'Gallery section', where:'The photo grid.', labelKey:'gallery_label', titleKey:'gallery_title', labelPh:'Our Home', titlePh:'Room by room'},
                    {title:'Contact section', where:'The enquiry form at the bottom.', labelKey:'enquiry_label', titleKey:'enquiry_title', labelPh:'Get In Touch', titlePh:`Contact ${profile.name || 'us'}`},
                  ].map(hg => (
                    <div>
                      <p style="font-size:.76rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:#5c3d20;margin:0 0 4px">{hg.title}</p>
                      <p style="font-size:.84rem;color:#6b4e35;line-height:1.6;margin:0 0 14px">{hg.where}</p>
                      <div data-field-row="1" style="display:grid;grid-template-columns:1fr 1.4fr;gap:16px">
                        <input type="text" name={hg.labelKey} value={h[hg.labelKey] ?? ''} placeholder={hg.labelPh}
                          style="width:100%;border:1.5px solid rgba(44,26,14,.18);border-radius:10px;padding:12px 15px;font-size:.93rem;font-family:'Montserrat',sans-serif;color:#2c1a0e;background:#faf6ee;outline:none;transition:border-color .2s, box-shadow .2s"
                          onfocus="this.style.borderColor='#2f5d45';this.style.boxShadow='0 0 0 3px rgba(110,84,56,.15)'"
                          onblur="this.style.borderColor='rgba(44,26,14,.18)';this.style.boxShadow=''"
                          oninput="markDirty()" />
                        <input type="text" name={hg.titleKey} value={h[hg.titleKey] ?? ''} placeholder={hg.titlePh}
                          style="width:100%;border:1.5px solid rgba(44,26,14,.18);border-radius:10px;padding:12px 15px;font-size:.93rem;font-family:'Montserrat',sans-serif;color:#2c1a0e;background:#faf6ee;outline:none;transition:border-color .2s, box-shadow .2s"
                          onfocus="this.style.borderColor='#2f5d45';this.style.boxShadow='0 0 0 3px rgba(110,84,56,.15)'"
                          onblur="this.style.borderColor='rgba(44,26,14,.18)';this.style.boxShadow=''"
                          oninput="markDirty()" />
                      </div>
                    </div>
                  ))}
                </div>
              </section>

              <div style="display:flex;align-items:center;gap:20px;padding-bottom:20px">
                <button type="button" onclick="saveAll()"
                  style="font-family:'Montserrat',sans-serif;font-size:.82rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#fff;background:#2f5d45;border:1.5px solid #2f5d45;border-radius:50px;box-shadow:0 6px 20px rgba(110,84,56,.28);padding:16px 36px;cursor:pointer;white-space:nowrap;transition:background .25s ease, transform .15s ease, box-shadow .25s ease"
                  onmouseover="this.style.background='#3e7a5b';this.style.transform='translateY(-2px)';this.style.boxShadow='0 12px 28px rgba(110,84,56,.36)'"
                  onmouseout="this.style.background='#2f5d45';this.style.transform='';this.style.boxShadow='0 6px 20px rgba(110,84,56,.28)'"
                  id="saveBtn">Save changes</button>
                <a href="/owner/dashboard"
                  style="font-size:.8rem;color:#6b4e35;text-decoration:none;letter-spacing:.1em;text-transform:uppercase;font-weight:600;transition:color .2s"
                  onmouseover="this.style.color='#2c1a0e'" onmouseout="this.style.color='#6b4e35'">Back to dashboard</a>
              </div>
            </div>

            <!-- Right aside: preview + colours + strength -->
            <aside data-aside="1" id="preview" style="position:sticky;top:28px;display:flex;flex-direction:column;gap:18px">
              <div style="background:#fff;border:1px solid rgba(110,84,56,.22);border-radius:18px;overflow:hidden;box-shadow:0 1px 2px rgba(44,26,14,.04)">
                <div style="padding:18px 22px;border-bottom:1px solid rgba(110,84,56,.2);display:flex;align-items:center;justify-content:space-between;gap:12px">
                  <p style="font-size:.7rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:#6e5438;margin:0">Page preview</p>
                  <a href={`/${profile.slug}`} target="_blank"
                    style="display:inline-flex;align-items:center;gap:7px;font-size:.7rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#2f5d45;text-decoration:none;transition:gap .2s, color .2s"
                    onmouseover="this.style.gap='11px';this.style.color='#2c1a0e'" onmouseout="this.style.gap='7px';this.style.color='#2f5d45'">Open &rarr;</a>
                </div>

                <div style="display:flex;align-items:center;gap:10px;padding:9px 14px;background:#faf6ee;border-bottom:1px solid rgba(110,84,56,.18)">
                  <span style="display:flex;gap:5px;flex-shrink:0">
                    <span style="width:8px;height:8px;border-radius:50%;background:rgba(44,26,14,.16);display:block"></span>
                    <span style="width:8px;height:8px;border-radius:50%;background:rgba(44,26,14,.16);display:block"></span>
                    <span style="width:8px;height:8px;border-radius:50%;background:rgba(44,26,14,.16);display:block"></span>
                  </span>
                  <span id="pvUrl" style="flex:1;min-width:0;font-size:.7rem;color:#6b4e35;background:#fff;border:1px solid rgba(44,26,14,.08);border-radius:50px;padding:5px 12px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">myahsits.com/{profile.slug}</span>
                </div>

                <div id="pvBody" style={`background:${pvBg};transition:background .3s ease`}>
                  <div style="position:relative;height:186px;overflow:hidden">
                    {heroSrc ? (
                      <img src={heroSrc} alt="" style="width:100%;height:100%;object-fit:cover;display:block" />
                    ) : (
                      <div style="width:100%;height:100%;background:linear-gradient(135deg,#2c1a0e,#4a3525)"></div>
                    )}
                    <div style="position:absolute;inset:0;background:rgba(44,26,14,.52)"></div>
                    <div style="position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:16px;gap:6px">
                      {profile.location && <span id="pvBadge" style="font-size:.55rem;background:rgba(255,255,255,.18);color:#fff;padding:4px 11px;border-radius:50px;font-weight:700;letter-spacing:.07em">{profile.location}</span>}
                      <p style="font-family:'Montserrat',sans-serif;font-weight:500;letter-spacing:.28em;font-size:1.35rem;color:#fff;line-height:1;margin:4px 0 0">MYAH</p>
                      <p id="pvName" style="font-size:.72rem;color:rgba(255,255,255,.9);font-weight:600;letter-spacing:.08em;margin:0">{profile.name}</p>
                      <p id="pvTagline" style={`font-size:.62rem;color:rgba(255,255,255,.7);margin:0;${!profile.tagline ? 'font-style:italic;opacity:.6;' : ''}`}>{profile.tagline || 'Your one-line description'}</p>
                      <span id="pvBtn" style={`display:inline-block;margin-top:6px;background:${pvAccent};color:#fff;font-size:.55rem;font-weight:600;padding:6px 15px;border-radius:6px;letter-spacing:.07em;text-transform:uppercase`}>Get In Touch</span>
                    </div>
                  </div>

                  <div style="padding:18px 20px">
                    <p style={`font-size:.58rem;font-weight:600;letter-spacing:.13em;text-transform:uppercase;margin:0 0 9px;color:${pvAccent}`}>About Our Home</p>
                    <div style="display:flex;gap:12px;align-items:flex-start">
                      {aboutSrc && <img src={aboutSrc} alt="" style="width:62px;height:62px;border-radius:10px;object-fit:cover;flex-shrink:0" />}
                      <p id="pvBio" style={`font-size:.66rem;line-height:1.65;margin:0;color:${pvTextSoft};${!profile.bio?.trim() ? 'font-style:italic;opacity:.5;' : ''}`}>
                        {profile.bio?.trim() ? (profile.bio.length > 130 ? profile.bio.slice(0, 130) + '…' : profile.bio) : 'No description yet'}
                      </p>
                    </div>
                  </div>

                  {pets.length > 0 && (
                    <div style="padding:0 20px 18px">
                      <p style={`font-size:.58rem;font-weight:600;letter-spacing:.13em;text-transform:uppercase;margin:0 0 9px;color:${pvAccent}`}>Meet the Pets</p>
                      <div style="display:flex;flex-wrap:wrap;gap:8px">
                        {pets.slice(0, 4).map((p: any) => (
                          <span style={`display:flex;align-items:center;gap:6px;padding:5px 10px;border-radius:6px;font-size:.6rem;font-weight:600;background:rgba(110,84,56,.14);color:${pvText};`}>
                            {p.photo_url && <img src={p.photo_url} alt="" style="width:24px;height:24px;border-radius:50%;object-fit:cover" />}{p.name}
                          </span>
                        ))}
                      </div>
                    </div>
                  )}

                  {amenities.length > 0 && (
                    <div style="padding:0 20px 18px">
                      <p style={`font-size:.58rem;font-weight:600;letter-spacing:.13em;text-transform:uppercase;margin:0 0 9px;color:${pvAccent}`}>Home Amenities</p>
                      <div style="display:flex;flex-wrap:wrap;gap:6px">
                        {amenities.slice(0, 6).map((a: string) => (
                          <span style={`font-size:.55rem;padding:3px 8px;border-radius:4px;font-weight:600;background:rgba(110,84,56,.12);color:${pvTextSoft};`}>✓ {a}</span>
                        ))}
                      </div>
                    </div>
                  )}

                  {gallery.length > 0 && (
                    <div style="padding:0 20px 18px">
                      <p style={`font-size:.58rem;font-weight:600;letter-spacing:.13em;text-transform:uppercase;margin:0 0 9px;color:${pvAccent}`}>Our Home</p>
                      <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:4px">
                        {gallery.slice(0, 8).map((img: any) => (
                          <div style="aspect-ratio:1;border-radius:4px;overflow:hidden">
                            <img src={img.src} alt="" style="width:100%;height:100%;object-fit:cover;display:block" />
                          </div>
                        ))}
                      </div>
                    </div>
                  )}

                  <div style={`padding:12px 20px;display:flex;justify-content:space-between;align-items:center;background:${pvText};`}>
                    <p style="font-family:'Montserrat',sans-serif;font-weight:500;letter-spacing:.24em;font-size:.68rem;margin:0;color:rgba(255,255,255,.75)">MYAH</p>
                    <span style="font-size:.6rem;color:rgba(255,255,255,.45)">{profile.name}</span>
                  </div>
                </div>

                <div style="padding:18px 20px 20px;background:#fff;border-top:1px solid rgba(110,84,56,.2)">
                  <div style="display:flex;gap:14px;flex-wrap:wrap;justify-content:center;margin-bottom:14px">
                    {[
                      {key:'background', label:'Background', val: t.background || '#faf6ee'},
                      {key:'accent', label:'Accent', val: t.accent || '#2f5d45'},
                      {key:'accent_light', label:'Highlight', val: t.accent_light || '#c4ab8a'},
                      {key:'text', label:'Text', val: t.text || '#2c1a0e'},
                      {key:'text_soft', label:'Soft text', val: t.text_soft || '#6b4e35'},
                    ].map(sw => (
                      <label style="display:flex;flex-direction:column;align-items:center;gap:6px;cursor:pointer">
                        <input type="color" name={sw.key} value={sw.val}
                          style="width:38px;height:38px;border:2px solid rgba(44,26,14,.15);border-radius:50%;cursor:pointer;background:#faf6ee;transition:border-color .2s, transform .15s"
                          onmouseover="this.style.borderColor='#2f5d45';this.style.transform='scale(1.08)'"
                          onmouseout="this.style.borderColor='rgba(44,26,14,.15)';this.style.transform=''"
                          oninput="markDirty();updateColour(this)" />
                        <span style="font-size:.64rem;font-weight:600;color:#6b4e35;letter-spacing:.03em">{sw.label}</span>
                      </label>
                    ))}
                  </div>
                  <div style="display:flex;justify-content:center">
                    <button type="button" onclick="resetColours()"
                      style="font-family:'Montserrat',sans-serif;font-size:.72rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#6b4e35;background:none;border:1.5px solid rgba(44,26,14,.15);border-radius:50px;padding:9px 22px;cursor:pointer;transition:border-color .2s, color .2s"
                      onmouseover="this.style.borderColor='#2f5d45';this.style.color='#2c1a0e'"
                      onmouseout="this.style.borderColor='rgba(44,26,14,.15)';this.style.color='#6b4e35'">Reset colours</button>
                  </div>
                </div>
              </div>

              <div style="background:#faf6ee;border:1px solid rgba(110,84,56,.28);border-radius:18px;padding:22px 24px">
                <p style="font-size:.7rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:#6e5438;margin:0 0 14px">Profile strength</p>
                <div style="height:7px;border-radius:50px;background:rgba(44,26,14,.08);overflow:hidden;margin-bottom:12px">
                  <div id="strengthBar" style={`height:100%;width:${pct}%;border-radius:50px;background:linear-gradient(90deg,#2f5d45,#c4ab8a);transition:width .4s ease`}></div>
                </div>
                <p id="strengthText" style="font-size:.86rem;color:#6b4e35;line-height:1.65;margin:0">
                  {pct === 100
                    ? 'Complete. Sitters get the whole picture before they write to you — that is what gets good applicants.'
                    : `${pct}% complete. Keep adding details to attract better applicants.`}
                </p>
              </div>
            </aside>
          </div>
        </div>
      </main>

      <!-- Floating save bar -->
      <div data-savebar="1" id="saveBar" style="position:fixed;left:0;right:0;bottom:0;z-index:40;padding:16px 48px;background:rgba(255,255,255,.96);backdrop-filter:blur(10px);border-top:1px solid rgba(110,84,56,.28);box-shadow:0 -6px 24px rgba(44,26,14,.06);transition:transform .3s ease, opacity .3s ease;transform:translateY(100%);opacity:0;pointer-events:none">
        <div style="max-width:1180px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap">
          <p style="font-size:.88rem;color:#6b4e35;margin:0;line-height:1.5">Unsaved changes &mdash; sitters still see the old version.</p>
          <button type="button" onclick="saveAll()"
            style="font-family:'Montserrat',sans-serif;font-size:.82rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#fff;background:#2f5d45;border:1.5px solid #2f5d45;border-radius:50px;padding:16px 36px;cursor:pointer;white-space:nowrap;box-shadow:0 6px 20px rgba(110,84,56,.28);transition:background .25s ease, transform .15s ease"
            onmouseover="this.style.background='#3e7a5b';this.style.transform='translateY(-2px)'"
            onmouseout="this.style.background='#2f5d45';this.style.transform=''"
            id="saveBarBtn">Save changes</button>
        </div>
      </div>
    </div>

    <script define:vars={{ houseNotes }}>
      const DEFAULT_THEME = { background: '#faf6ee', accent: '#2f5d45', accent_light: '#c4ab8a', text: '#2c1a0e', text_soft: '#6b4e35' };
      const COLOUR_TO_CSS = { background: '--pv-bg', accent: '--pv-accent', text: '--pv-text', text_soft: '--pv-text-soft', accent_light: '--pv-ahl' };

      const loader = document.getElementById('loader');
      const saveBar = document.getElementById('saveBar');
      const saveBtn = document.getElementById('saveBtn');
      const saveBarBtn = document.getElementById('saveBarBtn');
      const pvBody = document.getElementById('pvBody');

      let dirty = false;
      const uploadQueues = new Map();
      let localNotes = [...houseNotes];

      function showLoader() {
        if (!loader) return;
        loader.style.opacity = '1';
        loader.style.pointerEvents = 'all';
      }
      function hideLoader() {
        if (!loader) return;
        loader.style.opacity = '0';
        loader.style.pointerEvents = 'none';
      }

      function markDirty() {
        if (!dirty) {
          dirty = true;
          saveBar.style.transform = 'translateY(0)';
          saveBar.style.opacity = '1';
          saveBar.style.pointerEvents = 'all';
        }
      }
      function markSaved() {
        dirty = false;
        saveBar.style.transform = 'translateY(100%)';
        saveBar.style.opacity = '0';
        saveBar.style.pointerEvents = 'none';
      }

      document.querySelectorAll('a[href]').forEach(a => {
        const h = a.getAttribute('href') || '';
        if (h.startsWith('#') || h.startsWith('http')) return;
        a.addEventListener('click', e => { if (e.metaKey || e.ctrlKey || e.shiftKey) return; showLoader(); });
      });

      function updateBioCount() {
        const bio = document.getElementById('bio');
        const count = document.getElementById('bioCount');
        if (bio && count) count.textContent = bio.value.length + ' characters — sitters see the first 130 on the preview card.';
      }

      function updatePreview() {
        const nameEl = document.getElementById('name');
        const taglineEl = document.getElementById('tagline');
        const bioEl = document.getElementById('bio');
        const locationEl = document.getElementById('location');

        const pvName = document.getElementById('pvName');
        const pvTagline = document.getElementById('pvTagline');
        const pvBio = document.getElementById('pvBio');
        const pvBadge = document.getElementById('pvBadge');

        if (pvName && nameEl) pvName.textContent = nameEl.value || '';
        if (pvTagline && taglineEl) pvTagline.textContent = taglineEl.value || 'Your one-line description';
        if (pvBio && bioEl) {
          const bio = bioEl.value.trim();
          pvBio.textContent = bio ? (bio.length > 130 ? bio.slice(0, 130) + '…' : bio) : 'No description yet';
        }
        if (pvBadge && locationEl) pvBadge.textContent = locationEl.value || '';
      }

      function updateColour(input) {
        if (!pvBody) return;
        const cssVar = COLOUR_TO_CSS[input.name];
        if (cssVar) pvBody.style.setProperty(cssVar, input.value);
        const pvBtn = document.getElementById('pvBtn');
        if (input.name === 'accent' && pvBtn) pvBtn.style.background = input.value;
      }

      function resetColours() {
        document.querySelectorAll('input[type="color"]').forEach(input => {
          const key = input.name;
          if (DEFAULT_THEME[key]) {
            input.value = DEFAULT_THEME[key];
            if (pvBody) {
              const cssVar = COLOUR_TO_CSS[key];
              if (cssVar) pvBody.style.setProperty(cssVar, DEFAULT_THEME[key]);
            }
            if (key === 'accent') {
              const pvBtn = document.getElementById('pvBtn');
              if (pvBtn) pvBtn.style.background = DEFAULT_THEME[key];
            }
          }
        });
        markDirty();
      }

      function toggleAmenity(btn) {
        const label = btn.getAttribute('data-amenity');
        const on = btn.style.background.includes('rgba(110,84,56,.12)') || btn.style.background.includes('rgba(110,84,56, .12)');
        if (on) {
          btn.style.background = '#faf6ee';
          btn.style.border = '1.5px solid rgba(44,26,14,.1)';
          btn.style.color = '#6b4e35';
          btn.querySelector('span').style.color = 'rgba(44,26,14,.2)';
        } else {
          btn.style.background = 'rgba(110,84,56,.12)';
          btn.style.border = '1.5px solid rgba(110,84,56,.5)';
          btn.style.color = '#2c1a0e';
          btn.querySelector('span').style.color = '#2f5d45';
        }
        const count = document.querySelectorAll('#amenitiesGrid button[style*="rgba(110,84,56,.12)"]').length;
        const amenityCount = document.getElementById('amenityCount');
        if (amenityCount) amenityCount.textContent = count + ' of 16 selected. Sitters filter on these, so tick everything that genuinely applies.';
        markDirty();
      }

      function toggleAddPet() {
        const panel = document.getElementById('addPetPanel');
        const btn = document.getElementById('addPetBtn');
        if (!panel || !btn) return;
        const showing = panel.style.display !== 'none';
        panel.style.display = showing ? 'none' : 'block';
        btn.style.display = showing ? '' : 'none';
      }

      function submitPet() {
        const name = document.getElementById('petName')?.value.trim();
        if (!name) return;
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = '/api/owner/pets';
        const fields = {
          _action: 'add',
          pet_name: name,
          pet_type: document.getElementById('petType')?.value || 'Dog',
          pet_breed: document.getElementById('petBreed')?.value || '',
          pet_age: document.getElementById('petAge')?.value || '',
          pet_temperament: document.getElementById('petTemperament')?.value || '',
          pet_special_needs: document.getElementById('petNeeds')?.value || '',
        };
        for (const [k, v] of Object.entries(fields)) {
          const i = document.createElement('input');
          i.type = 'hidden'; i.name = k; i.value = v;
          form.appendChild(i);
        }
        document.body.appendChild(form);
        showLoader();
        form.submit();
      }

      function addNote() {
        const label = document.getElementById('noteLabel')?.value.trim();
        const value = document.getElementById('noteValue')?.value.trim();
        if (!label || !value) return;
        localNotes.push({ label, value });
        document.getElementById('noteLabel').value = '';
        document.getElementById('noteValue').value = '';
        renderNotes();
        markDirty();
      }

      function removeNote(i) {
        localNotes.splice(i, 1);
        renderNotes();
        markDirty();
      }

      function renderNotes() {
        const container = document.getElementById('houseNotesList');
        if (!container) return;
        container.innerHTML = localNotes.map((n, i) => `
          <div style="display:flex;gap:12px;align-items:center;background:#faf6ee;border:1px solid rgba(110,84,56,.2);border-radius:12px;padding:14px 16px">
            <span style="font-size:.74rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#2f5d45;width:100px;flex-shrink:0">${n.label}</span>
            <span style="flex:1;min-width:0;font-size:.92rem;color:#6b4e35;line-height:1.6">${n.value}</span>
            <button type="button" onclick="removeNote(${i})" title="Remove note" style="width:24px;height:24px;border-radius:50%;background:rgba(44,26,14,.08);color:#6b4e35;border:none;font-size:14px;line-height:1;cursor:pointer;display:flex;align-items:center;justify-content:center;flex-shrink:0;padding:0">&times;</button>
          </div>
        `).join('');
      }

      function queueFiles(input, cat) {
        const existing = uploadQueues.get(cat) || [];
        Array.from(input.files || []).forEach(f => existing.push(f));
        uploadQueues.set(cat, existing);
        const previewContainer = document.querySelector(`[data-preview-for="${cat}"]`);
        if (previewContainer) {
          previewContainer.innerHTML = '';
          existing.forEach(f => {
            const thumb = document.createElement('div');
            thumb.style.cssText = 'position:relative;width:80px;height:60px;border-radius:8px;overflow:hidden;border:1px solid rgba(110,84,56,.3)';
            const img = document.createElement('img');
            img.src = URL.createObjectURL(f);
            img.style.cssText = 'width:100%;height:100%;object-fit:cover;display:block';
            thumb.appendChild(img);
            previewContainer.appendChild(thumb);
          });
        }
        input.value = '';
      }

      function compressImage(file, maxDim, quality) {
        return new Promise(resolve => {
          const img = new Image();
          img.onload = () => {
            let { width, height } = img;
            if (width > maxDim || height > maxDim) {
              const r = Math.min(maxDim / width, maxDim / height);
              width = Math.round(width * r); height = Math.round(height * r);
            }
            const c = document.createElement('canvas');
            c.width = width; c.height = height;
            const ctx = c.getContext('2d');
            if (!ctx) { resolve(file); return; }
            ctx.drawImage(img, 0, 0, width, height);
            c.toBlob(b => {
              resolve(b ? new File([b], file.name.replace(/\.[^.]+$/, '.jpg'), { type: 'image/jpeg' }) : file);
            }, 'image/jpeg', quality);
          };
          img.onerror = () => resolve(file);
          img.src = URL.createObjectURL(file);
        });
      }

      function getSelectedAmenities() {
        return Array.from(document.querySelectorAll('#amenitiesGrid button')).filter(btn => {
          return btn.style.background.includes('rgba(110,84,56,.12)') || getComputedStyle(btn).backgroundColor === 'rgba(110, 84, 56, 0.12)';
        }).map(btn => btn.getAttribute('data-amenity'));
      }

      function getHandoverData() {
        const data = {};
        document.querySelectorAll('[name^="handover_"]').forEach(input => {
          const key = input.name.replace('handover_', '');
          data[key] = input.value;
        });
        return data;
      }

      function getHeadingsData() {
        const data = {};
        document.querySelectorAll('#headings input[name]').forEach(input => {
          data[input.name] = input.value;
        });
        return data;
      }

      async function saveAll() {
        const btn = document.getElementById('saveBtn');
        const barBtn = document.getElementById('saveBarBtn');
        [btn, barBtn].forEach(b => { if (b) { b.disabled = true; b.textContent = 'Saving…'; } });
        showLoader();
        const errors = [];

        try {
          const fd = new FormData();
          fd.set('name', document.getElementById('name')?.value ?? '');
          fd.set('location', document.getElementById('location')?.value ?? '');
          fd.set('tagline', document.getElementById('tagline')?.value ?? '');
          fd.set('bio', document.getElementById('bio')?.value ?? '');
          fd.set('contact_email', document.getElementById('contact_email')?.value ?? '');
          fd.set('whatsapp_number', document.getElementById('whatsapp_number')?.value ?? '');
          fd.set('looking_for', document.getElementById('looking_for')?.value ?? '');
          getSelectedAmenities().forEach(a => fd.append('amenities', a));
          fd.set('handover_json', JSON.stringify(getHandoverData()));
          fd.set('house_notes_json', JSON.stringify(localNotes));

          const r1 = await fetch('/api/owner/update', { method: 'POST', body: fd });
          if (!r1.ok && r1.url.includes('error=')) errors.push('Failed to save details.');

          for (const [cat, files] of uploadQueues.entries()) {
            if (!files.length) continue;
            [btn, barBtn].forEach(b => { if (b) b.textContent = `Uploading ${cat}…`; });
            const maxDim = cat === 'hero' ? 1600 : 1000;
            const photoFd = new FormData();
            photoFd.set('_action', 'upload');
            photoFd.set('category', cat);
            const compressed = await Promise.all(files.map(f => compressImage(f, maxDim, 0.82)));
            compressed.forEach(f => photoFd.append('files', f, f.name));
            const r = await fetch('/api/owner/images', { method: 'POST', body: photoFd });
            if (!r.ok) errors.push(`Failed to upload ${cat} photos.`);
            else uploadQueues.set(cat, []);
          }

          [btn, barBtn].forEach(b => { if (b) b.textContent = 'Saving headings…'; });
          const headingsData = new FormData();
          Object.entries(getHeadingsData()).forEach(([k, v]) => headingsData.set(k, v));
          const r2 = await fetch('/api/profile/headings', { method: 'POST', body: headingsData });
          if (!r2.ok) errors.push('Failed to save headings.');

          [btn, barBtn].forEach(b => { if (b) b.textContent = 'Saving colours…'; });
          const themeData = new FormData();
          document.querySelectorAll('input[type="color"]').forEach(input => themeData.set(input.name, input.value));
          const r3 = await fetch('/api/profile/theme', { method: 'POST', body: themeData });
          if (!r3.ok) errors.push('Failed to save colours.');

          hideLoader();
          if (errors.length) {
            alert(errors.join('\n'));
            [btn, barBtn].forEach(b => { if (b) { b.disabled = false; b.textContent = 'Save changes'; } });
          } else {
            window.location.href = '/owner/edit?saved=1';
          }
        } catch {
          hideLoader();
          [btn, barBtn].forEach(b => { if (b) { b.disabled = false; b.textContent = 'Save changes'; } });
          alert('Something went wrong. Please try again.');
        }
      }
    </script>
  </body>
</html>
