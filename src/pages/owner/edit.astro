    <script>
      function compressImage(file: File, maxW: number, maxH: number, quality: number): Promise<File> {
        return new Promise((resolve, reject) => {
          const img = new Image();
          img.onload = () => {
            let { width, height } = img;
            if (width > maxW || height > maxH) {
              const r = Math.min(maxW / width, maxH / height);
              width = Math.round(width * r);
              height = Math.round(height * r);
            }
            const c = document.createElement('canvas');
            c.width = width; c.height = height;
            const ctx = c.getContext('2d');
            if (!ctx) { resolve(file); return; }
            ctx.drawImage(img, 0, 0, width, height);
            c.toBlob(
              (blob) => {
                if (!blob) { resolve(file); return; }
                resolve(new File([blob], file.name.replace(/\.[^.]+$/, '.jpg'), { type: 'image/jpeg' }));
              },
              'image/jpeg', quality,
            );
          };
          img.onerror = () => reject(new Error('Failed to load image'));
          img.src = URL.createObjectURL(file);
        });
      }

      const pendingFiles = new Map<HTMLFormElement, File[]>();

      function renderPreview(form: HTMLFormElement) {
        const files = pendingFiles.get(form) ?? [];
        const previewEl = form.querySelector<HTMLElement>('.upload-preview');
        const countEl = form.querySelector<HTMLElement>('.file-count');

        if (previewEl) {
          previewEl.innerHTML = '';
          previewEl.style.cssText = files.length ? 'display:flex;flex-wrap:wrap;gap:8px;margin:12px 0' : 'display:none';
          files.forEach((file, idx) => {
            const thumb = document.createElement('div');
            thumb.className = 'upload-preview-thumb';
            thumb.style.cssText = 'position:relative;width:80px;height:60px;border-radius:6px;overflow:hidden;border:2px solid rgba(200,150,62,0.3);flex-shrink:0';
            const img = document.createElement('img');
            img.src = URL.createObjectURL(file);
            img.style.cssText = 'width:100%;height:100%;object-fit:cover;display:block';
            thumb.appendChild(img);
            const removeBtn = document.createElement('button');
            removeBtn.type = 'button';
            removeBtn.className = 'preview-remove';
            removeBtn.innerHTML = '&times;';
            removeBtn.style.cssText = 'position:absolute;top:-6px;right:-6px;width:22px;height:22px;border-radius:50%;background:rgba(185,28,28,0.9);color:#fff;border:2px solid #fff;font-size:12px;cursor:pointer;display:flex;align-items:center;justify-content:center;line-height:1;padding:0';
            removeBtn.addEventListener('click', () => {
              files.splice(idx, 1);
              pendingFiles.set(form, files);
              renderPreview(form);
            });
            thumb.appendChild(removeBtn);
            previewEl.appendChild(thumb);
          });
        }

        if (countEl) countEl.textContent = files.length > 0 ? `${files.length} photo${files.length > 1 ? 's' : ''} selected` : '';
      }

      document.querySelectorAll<HTMLInputElement>('.file-input-multi').forEach(input => {
        input.addEventListener('change', () => {
          const form = input.closest<HTMLFormElement>('form');
          if (!form || !input.files) return;
          const existing = pendingFiles.get(form) ?? [];
          existing.push(...Array.from(input.files));
          pendingFiles.set(form, existing);
          input.value = '';
          renderPreview(form);
        });
      });

      document.querySelectorAll<HTMLFormElement>('#details form, #amenities form, #looking-for form, #headings form, #colours').forEach(f => {
        f.addEventListener('submit', e => e.preventDefault());
      });

      document.getElementById('save-all')?.addEventListener('click', async () => {
        const btn = document.getElementById('save-all') as HTMLButtonElement;
        btn.disabled = true;
        btn.textContent = 'Saving…';
        const errors: string[] = [];

        try {
          const fd = new FormData();
          fd.set('name', (document.getElementById('name') as HTMLInputElement)?.value ?? '');
          fd.set('location', (document.getElementById('location') as HTMLInputElement)?.value ?? '');
          fd.set('tagline', (document.getElementById('tagline') as HTMLInputElement)?.value ?? '');
          fd.set('badge_text', (document.getElementById('badge_text') as HTMLInputElement)?.value ?? '');
          fd.set('bio', (document.getElementById('bio') as HTMLTextAreaElement)?.value ?? '');
          fd.set('contact_email', (document.getElementById('contact_email') as HTMLInputElement)?.value ?? '');
          fd.set('whatsapp_number', (document.getElementById('whatsapp_number') as HTMLInputElement)?.value ?? '');
          fd.set('looking_for', (document.getElementById('looking_for') as HTMLTextAreaElement)?.value ?? '');
          document.querySelectorAll<HTMLInputElement>('#amenities input[name="amenities"]:checked').forEach(cb => {
            fd.append('amenities', cb.value);
          });

          const picInput = document.getElementById('profile_pic') as HTMLInputElement;
          if (picInput?.files?.[0]) {
            const compressed = await compressImage(picInput.files[0], 1200, 1200, 0.85);
            fd.set('profile_pic', compressed, compressed.name);
          }

          const r1 = await fetch('/api/owner/update', { method: 'POST', body: fd });
          if (r1.url.includes('error=')) errors.push('Failed to save details.');

          for (const [form, files] of pendingFiles.entries()) {
            if (files.length === 0) continue;
            const category = form.dataset.category;
            if (!category) continue;
            btn.textContent = `Uploading ${category} photos…`;
            const maxDim = category === 'hero' ? 1600 : 1000;
            const photoFd = new FormData();
            photoFd.set('_action', 'upload');
            photoFd.set('category', category);
            const posSelect = form.querySelector<HTMLSelectElement>('[name="pos"]');
            if (posSelect) photoFd.set('pos', posSelect.value);
            const compressed = await Promise.all(files.map(f => compressImage(f, maxDim, maxDim, 0.82)));
            for (const file of compressed) photoFd.append('files', file, file.name);
            const r = await fetch('/api/owner/images', { method: 'POST', body: photoFd });
            if (r.url.includes('error=')) errors.push(`Failed to upload ${category} photos.`);
          }

          btn.textContent = 'Saving headings…';
          const headingsForm = document.querySelector<HTMLFormElement>('#headings form');
          if (headingsForm) {
            const r2 = await fetch('/api/profile/headings', { method: 'POST', body: new FormData(headingsForm) });
            if (r2.url.includes('error=')) errors.push('Failed to save headings.');
          }

          btn.textContent = 'Saving colours…';
          const themeForm = document.getElementById('colours') as HTMLFormElement;
          if (themeForm) {
            const r3 = await fetch('/api/profile/theme', { method: 'POST', body: new FormData(themeForm) });
            if (r3.url.includes('error=')) errors.push('Failed to save colours.');
          }

          if (errors.length > 0) {
            alert(errors.join('\n'));
            btn.disabled = false;
            btn.textContent = 'Save changes';
          } else {
            window.location.href = '/owner/edit?saved=1';
          }
        } catch {
          btn.disabled = false;
          btn.textContent = 'Save changes';
          alert('Something went wrong. Please try again.');
        }
      });

      const colourVarMap: Record<string, string> = {
        background: '--pv-bg', accent: '--pv-accent', accent_light: '--pv-accent-light',
        text: '--pv-text', text_soft: '--pv-text-soft',
      };
      const pvEl = document.querySelector<HTMLElement>('.page-preview');
      if (pvEl) {
        document.querySelectorAll<HTMLInputElement>('.colour-picker').forEach(picker => {
          picker.addEventListener('input', () => {
            const v = colourVarMap[picker.name];
            if (v) pvEl.style.setProperty(v, picker.value);
          });
        });
      }

      document.getElementById('resetColours')?.addEventListener('click', () => {
        const defaults: Record<string, string> = {
          background: '#faf6ee', accent: '#c8963e', accent_light: '#e8b96a',
          text: '#2c1a0e', text_soft: '#6b4e35',
        };
        for (const [key, val] of Object.entries(defaults)) {
          const input = document.querySelector<HTMLInputElement>(`input[name="${key}"]`);
          if (input) input.value = val;
          if (pvEl) {
            const v = colourVarMap[key];
            if (v) pvEl.style.setProperty(v, val);
          }
        }
      });
    </script>
  </body>
