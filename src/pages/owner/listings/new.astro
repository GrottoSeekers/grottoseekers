---
export const prerender = false;

import '../../../styles/global.css';
import { getSession } from '../../../lib/auth';
import { supabase } from '../../../lib/supabase';

const session = await getSession(Astro.request);
if (!session) return Astro.redirect('/login');

const { data: profile } = await supabase
  .from('profiles')
  .select('id, name, pets_json')
  .eq('user_id', session.userId)
  .single();

if (!profile) return Astro.redirect('/owner/create');

const pets: any[] = Array.isArray(profile.pets_json) ? profile.pets_json : [];

const error = Astro.url.searchParams.get('error');
const detail = Astro.url.searchParams.get('detail');
const errorMap: Record<string, string> = {
  missing: 'Please fill in all required fields.',
  dates: 'End date must be after start date.',
  server: detail ? `Something went wrong: ${detail}` : 'Something went wrong. Please try again.',
};
const errorMsg = errorMap[error ?? ''] ?? '';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Lato:wght@300;400;700&display=swap" rel="stylesheet" />
    <title>New listing — Grotto Sitters</title>
  </head>
  <body>
    <nav>
      <a href="/" class="nav-logo">Grotto <span>Sitters</span></a>
      <div class="nav-right">
        <a href="/owner/dashboard" class="nav-back">&larr; Dashboard</a>
        <a href="/api/auth/logout" class="nav-logout">Log out</a>
      </div>
    </nav>

    <main class="create-wrap">
      <div class="create-card">
        <p class="section-label">New Listing</p>
        <h1 class="section-title">Post a sit</h1>
        <div class="divider"></div>
        <p class="create-intro">
          Your home details and pets from your profile will be shown
          automatically. Just add the dates and any specifics for this sit.
        </p>

        {pets.length === 0 && (
          <div class="hint-box">
            You haven't added any pets yet.
            <a href="/owner/edit#pets">Add your pets first &rarr;</a>
          </div>
        )}

        {errorMsg && <p class="create-error">{errorMsg}</p>}

        <form method="POST" action="/api/owner/listings" class="create-form">
          <input type="hidden" name="_action" value="create" />

          <div class="field">
            <label for="title">Title <span class="req">*</span></label>
            <input type="text" id="title" name="title" placeholder="e.g. 2 weeks in Sydney with 2 friendly dogs" required />
            <p class="field-hint">A short summary sitters will see when browsing.</p>
          </div>

          <div class="date-row">
            <div class="field">
              <label for="date_from">From <span class="req">*</span></label>
              <input type="date" id="date_from" name="date_from" required />
            </div>
            <div class="field">
              <label for="date_to">To <span class="req">*</span></label>
              <input type="date" id="date_to" name="date_to" required />
            </div>
          </div>

          <div class="field">
            <label for="description">Details</label>
            <textarea id="description" name="description" rows="6" placeholder="Anything specific to this sit — daily routine, special instructions, house rules, what sitters should know."></textarea>
          </div>

          <button type="submit" class="btn-primary" style="width:100%;margin-top:8px;">Post listing</button>
        </form>
      </div>
    </main>

    <style>
      body { min-height: 100vh; display: flex; flex-direction: column; background: var(--cream); }
      nav {
        position: static; border-bottom: 1px solid rgba(200,150,62,0.2); padding: 18px 48px;
        display: flex; justify-content: space-between; align-items: center;
      }
      .nav-right { display: flex; align-items: center; gap: 20px; }
      .nav-back { font-size: 0.85rem; color: var(--text-soft); text-decoration: none; font-weight: 600; }
      .nav-back:hover { color: var(--gold); }
      .nav-logout { font-size: 0.8rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--gold); text-decoration: none; }

      .create-wrap { flex: 1; display: flex; justify-content: center; padding: 60px 24px; }
      .create-card {
        background: #fff; border-radius: 12px; padding: 48px; width: 100%; max-width: 560px;
        box-shadow: 0 4px 32px rgba(44,26,14,0.08); align-self: flex-start;
      }
      .create-intro { font-size: 0.95rem; color: var(--text-soft); line-height: 1.6; margin-bottom: 24px; }
      .create-error { background: #fef2f2; color: #b91c1c; border: 1px solid #fecaca; border-radius: 6px; padding: 12px 16px; font-size: 0.9rem; margin-bottom: 20px; }
      .create-form { display: flex; flex-direction: column; gap: 20px; }

      .hint-box {
        background: #fffbeb; border: 1px solid #fde68a; border-radius: 8px;
        padding: 14px 18px; font-size: 0.9rem; color: #92400e; margin-bottom: 20px; line-height: 1.6;
      }
      .hint-box a { color: var(--gold); font-weight: 700; text-decoration: none; }
      .hint-box a:hover { text-decoration: underline; }

      .field { display: flex; flex-direction: column; gap: 6px; }
      .field label { font-size: 0.85rem; font-weight: 700; letter-spacing: 0.06em; color: var(--brown-mid); text-transform: uppercase; }
      .req { color: var(--gold); }
      .field input[type="text"], .field input[type="date"], .field textarea {
        border: 1.5px solid rgba(44,26,14,0.2); border-radius: 6px; padding: 11px 14px;
        font-size: 1rem; font-family: "Lato", sans-serif; color: var(--text); background: var(--cream);
        outline: none; transition: border-color 0.2s;
      }
      .field input:focus, .field textarea:focus { border-color: var(--gold); }
      .field textarea { resize: vertical; }
      .field-hint { font-size: 0.78rem; color: var(--text-soft); }

      .date-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }

      @media (max-width: 768px) {
        nav { padding: 14px 24px; }
        .create-wrap { padding: 32px 16px; }
        .create-card { padding: 32px 24px; }
        .date-row { grid-template-columns: 1fr; }
      }
    </style>
  </body>
</html>
