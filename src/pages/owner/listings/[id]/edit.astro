---
export const prerender = false;

import '../../../../styles/global.css';
import { getSession } from '../../../../lib/auth';
import { supabase } from '../../../../lib/supabase';

const session = await getSession(Astro.request);
if (!session) return Astro.redirect('/login');

const { id } = Astro.params;

const { data: profile } = await supabase
  .from('profiles')
  .select('id')
  .eq('user_id', session.userId)
  .single();

if (!profile) return Astro.redirect('/owner/create');

const { data: listing } = await supabase
  .from('listings')
  .select('*')
  .eq('id', id)
  .eq('profile_id', profile.id)
  .single();

if (!listing) return Astro.redirect('/owner/dashboard');

const error = Astro.url.searchParams.get('error');
const errorMap: Record<string, string> = {
  missing: 'Please fill in all required fields.',
  dates: 'End date must be after start date.',
  server: 'Something went wrong. Please try again.',
};
const errorMsg = errorMap[error ?? ''] ?? '';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Lato:wght@300;400;700&display=swap" rel="stylesheet" />
    <title>Edit listing — Grotto Sitters</title>
  </head>
  <body>
    <nav>
      <a href="/" class="nav-logo">Grotto <span>Sitters</span></a>
      <div class="nav-right">
        <a href="/owner/dashboard" class="nav-back">&larr; Dashboard</a>
        <a href="/api/auth/logout" class="nav-logout">Log out</a>
      </div>
    </nav>

    <main class="create-wrap">
      <div class="create-card">
        <p class="section-label">Edit Listing</p>
        <h1 class="section-title">{listing.title}</h1>
        <div class="divider"></div>

        {errorMsg && <p class="create-error">{errorMsg}</p>}

        <form method="POST" action="/api/owner/listings" class="create-form">
          <input type="hidden" name="_action" value="update" />
          <input type="hidden" name="listing_id" value={listing.id} />

          <div class="field">
            <label for="title">Title <span class="req">*</span></label>
            <input type="text" id="title" name="title" value={listing.title} required />
          </div>

          <div class="date-row">
            <div class="field">
              <label for="date_from">From <span class="req">*</span></label>
              <input type="date" id="date_from" name="date_from" value={listing.date_from} required />
            </div>
            <div class="field">
              <label for="date_to">To <span class="req">*</span></label>
              <input type="date" id="date_to" name="date_to" value={listing.date_to} required />
            </div>
          </div>

          <div class="field">
            <label for="status">Status</label>
            <select id="status" name="status">
              <option value="active" selected={listing.status === 'active'}>Active</option>
              <option value="filled" selected={listing.status === 'filled'}>Filled</option>
              <option value="cancelled" selected={listing.status === 'cancelled'}>Cancelled</option>
            </select>
          </div>

          <div class="field">
            <label for="description">Details</label>
            <textarea id="description" name="description" rows="6">{listing.description ?? ''}</textarea>
          </div>

          <button type="submit" class="btn-primary" style="width:100%;margin-top:8px;">Save changes</button>
        </form>

        <div class="danger-zone">
          <h3>Delete this listing</h3>
          <p>This cannot be undone.</p>
          <form method="POST" action="/api/owner/listings" onsubmit="return confirm('Delete this listing?')">
            <input type="hidden" name="_action" value="delete" />
            <input type="hidden" name="listing_id" value={listing.id} />
            <button type="submit" class="btn-danger">Delete listing</button>
          </form>
        </div>
      </div>
    </main>

    <style>
      body { min-height: 100vh; display: flex; flex-direction: column; background: var(--cream); }
      nav {
        position: static; border-bottom: 1px solid rgba(200,150,62,0.2); padding: 18px 48px;
        display: flex; justify-content: space-between; align-items: center;
      }
      .nav-right { display: flex; align-items: center; gap: 20px; }
      .nav-back { font-size: 0.85rem; color: var(--text-soft); text-decoration: none; font-weight: 600; }
      .nav-back:hover { color: var(--gold); }
      .nav-logout { font-size: 0.8rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--gold); text-decoration: none; }

      .create-wrap { flex: 1; display: flex; justify-content: center; padding: 60px 24px; }
      .create-card {
        background: #fff; border-radius: 12px; padding: 48px; width: 100%; max-width: 560px;
        box-shadow: 0 4px 32px rgba(44,26,14,0.08); align-self: flex-start;
      }
      .create-error { background: #fef2f2; color: #b91c1c; border: 1px solid #fecaca; border-radius: 6px; padding: 12px 16px; font-size: 0.9rem; margin-bottom: 20px; }
      .create-form { display: flex; flex-direction: column; gap: 20px; }

      .field { display: flex; flex-direction: column; gap: 6px; }
      .field label { font-size: 0.85rem; font-weight: 700; letter-spacing: 0.06em; color: var(--brown-mid); text-transform: uppercase; }
      .req { color: var(--gold); }
      .field input[type="text"], .field input[type="date"], .field textarea, .field select {
        border: 1.5px solid rgba(44,26,14,0.2); border-radius: 6px; padding: 11px 14px;
        font-size: 1rem; font-family: "Lato", sans-serif; color: var(--text); background: var(--cream);
        outline: none; transition: border-color 0.2s;
      }
      .field input:focus, .field textarea:focus, .field select:focus { border-color: var(--gold); }
      .field textarea { resize: vertical; }

      .date-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }

      .danger-zone {
        margin-top: 40px; padding-top: 32px; border-top: 1px solid rgba(185,28,28,0.15);
      }
      .danger-zone h3 { font-size: 0.95rem; color: #b91c1c; margin-bottom: 6px; }
      .danger-zone p { font-size: 0.85rem; color: var(--text-soft); margin-bottom: 16px; }
      .btn-danger {
        background: #b91c1c; color: #fff; border: none; border-radius: 8px;
        padding: 10px 24px; font-size: 0.85rem; font-weight: 700; cursor: pointer;
        letter-spacing: 0.04em;
      }
      .btn-danger:hover { background: #991b1b; }

      @media (max-width: 768px) {
        nav { padding: 14px 24px; }
        .create-wrap { padding: 32px 16px; }
        .create-card { padding: 32px 24px; }
        .date-row { grid-template-columns: 1fr; }
      }
    </style>
  </body>
</html>
