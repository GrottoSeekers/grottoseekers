    .mosaic-item.mosaic-tall { grid-row: span 1; }
    .features-section { padding: 60px 0; }
    .features-grid { grid-template-columns: 1fr; gap: 16px; }
    .cta-content h2 { font-size: 2.2rem; }
    .ed-stats { gap: 20px; flex-wrap: wrap; }
