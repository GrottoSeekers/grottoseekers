---
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Grotto Sitters — Create a stunning profile page that showcases your pet sitting experience and wins you more clients." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Lato:wght@300;400;700&display=swap" rel="stylesheet" />
    <title>Grotto Sitters — Beautiful profiles for professional pet sitters</title>
  </head>
  <body>

    <!-- ── NAV ──────────────────────────────────────────────────── -->
    <header class="site-header" id="siteHeader">
      <a href="/" class="nav-logo">Grotto <span>Sitters</span></a>
      <nav class="header-nav">
        <a href="#how-it-works">How it works</a>
        <a href="#example">See an example</a>
        <a href="/login" class="nav-login">Log in</a>
        <a href="/signup" class="btn-primary btn-sm">Get started</a>
      </nav>
      <button class="burger" id="burger" aria-label="Menu">
        <span></span><span></span><span></span>
      </button>
    </header>

    <div class="mobile-menu" id="mobileMenu">
      <a href="#how-it-works" class="mm-link">How it works</a>
      <a href="#example" class="mm-link">See an example</a>
      <a href="/login" class="mm-link">Log in</a>
      <a href="/signup" class="mm-cta btn-primary">Get started</a>
    </div>

    <!-- ── HERO ──────────────────────────────────────────────────── -->
    <section class="hero">
      <div class="hero-image-wrap">
        <img src="/images/slideshow-cockapoo-window.jpeg" alt="Cockapoo by the window" class="hero-slide active" />
        <img src="/images/slideshow-dogs-couch.jpeg" alt="Two dogs relaxing on the couch" class="hero-slide" />
        <img src="/images/slideshow-labrador-puppy.jpeg" alt="Labrador puppy" class="hero-slide" />
        <img src="/images/slideshow-spaniel-walk.jpeg" alt="Spaniel on a walk" class="hero-slide" />
        <img src="/images/slideshow-dogs-lake.jpeg" alt="Dogs by the lake" class="hero-slide" />
        <img src="/images/slideshow-springer-beach.jpeg" alt="Springer spaniel on the beach" class="hero-slide" />
        <img src="/images/slideshow-garden-conservatory.jpeg" alt="Beautiful garden conservatory" class="hero-slide" />
        <img src="/images/slideshow-cat-bag.jpeg" alt="Cat in a paper bag" class="hero-slide" />
        <img src="/images/slideshow-living-room.jpeg" alt="Bright living room" class="hero-slide" />
        <img src="/images/slideshow-sunset-palms.jpeg" alt="Sunset with palm trees" class="hero-slide" />
        <img src="/images/slideshow-ocean-sunset.jpeg" alt="Ocean sunset from the balcony" class="hero-slide" />
        <img src="/images/slideshow-spaniel-bed.jpeg" alt="Spaniel cosy in bed" class="hero-slide" />
        <div class="hero-gradient"></div>
      </div>
      <div class="hero-text">
        <p class="eyebrow reveal">For professional pet sitters</p>
        <h1 class="reveal reveal-delay-1">
          Your pet sitting business,<br />
          <em>beautifully showcased.</em>
        </h1>
        <p class="hero-body reveal reveal-delay-2">
          One link. Your bio, photos, reviews, and booking form — all in one stunning profile that pet owners love.
        </p>
        <div class="hero-actions reveal reveal-delay-3">
          <a href="/signup" class="btn-primary">Create your profile — it's free</a>
        </div>
      </div>
    </section>

    <!-- ── HOW IT WORKS ───────────────────────────────────────────── -->
    <section id="how-it-works" class="steps-section">
      <div class="container">
        <p class="label reveal">Simple &amp; fast</p>
        <h2 class="h2 reveal">Up and running in minutes</h2>
        <div class="steps-grid">
          <div class="step reveal">
            <div class="step-num">01</div>
            <h3>Create an account</h3>
            <p>Sign up with your email. No credit card required.</p>
          </div>
          <div class="step-arrow reveal">→</div>
          <div class="step reveal">
            <div class="step-num">02</div>
            <h3>Build your profile</h3>
            <p>Add your bio, photos, and reviews from any platform you sit on.</p>
          </div>
          <div class="step-arrow reveal">→</div>
          <div class="step reveal">
            <div class="step-num">03</div>
            <h3>Share your link</h3>
            <p>Send <strong>grottositters.com/yourname</strong> to any pet owner. That's it.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ── LIVE EXAMPLE ───────────────────────────────────────────── -->
    <section id="example" class="example-section">
      <div class="container">
        <p class="label reveal">Live example</p>
        <h2 class="h2 reveal">Meet Callum &amp; Niamh</h2>
        <p class="section-sub reveal">The first profile on Grotto Sitters — experienced house and pet sitters who have looked after pets and homes all over the world.</p>
      </div>

      <div class="editorial-grid">
        <div class="editorial-left reveal">
          <div class="ed-collage">
            <img src="/images/callum-niamh-boat.jpg" alt="Callum and Niamh on a boat" class="ed-col-img ed-col-wide" style="object-position:center 30%;" />
            <img src="/images/alfie-1.jpg" alt="Alfie the cockapoo" class="ed-col-img" style="object-position:center 20%;" />
            <img src="/images/callum-niamh-event.jpg" alt="Callum and Niamh" class="ed-col-img" style="object-position:center 15%;" />
            <img src="/images/solomon-2.jpg" alt="Solomon the labradoodle" class="ed-col-img ed-col-wide" style="object-position:center 25%;" />
            <img src="/images/bailey-1.jpg" alt="Bailey" class="ed-col-img" style="object-position:center 20%;" />
            <img src="/images/callum-niamh-dinner.jpg" alt="Callum and Niamh at dinner" class="ed-col-img" style="object-position:center 25%;" />
          </div>
        </div>
        <div class="editorial-right reveal reveal-delay-1">
          <div class="ed-badge">Experienced sitters worldwide</div>
          <h3 class="ed-name">Callum &amp; Niamh</h3>
          <p class="ed-tagline">Experienced house &amp; pet sitters available worldwide — passionate about caring for pets and homes wherever they go.</p>
          <blockquote class="ed-quote">
            "We treat every sit like it's our own home — daily walks, feeding routines, garden care, and plenty of love for your animals."
          </blockquote>
          <div class="ed-stats">
            <div class="ed-stat">
              <span class="ed-stat-num">40+</span>
              <span class="ed-stat-label">Five-star reviews</span>
            </div>
            <div class="ed-stat">
              <span class="ed-stat-num">★ 5.0</span>
              <span class="ed-stat-label">Average rating</span>
            </div>
          </div>
          <a href="/callumandniamh" class="btn-primary" target="_blank">View full profile →</a>
        </div>
      </div>

      <!-- Review strip -->
      <div class="reviews-strip">
        <div class="review-strip-card reveal">
          <div class="rsc-stars">★★★★★</div>
          <p>"Super lovely couple who took great care of our cat Rocco! Regular updates, spotless apartment on return. Rocco was extremely happy when we got home."</p>
          <cite>— Jess &amp; Sam · Grotto Sitters</cite>
        </div>
        <div class="review-strip-card reveal reveal-delay-1">
          <div class="rsc-stars">★★★★★</div>
          <p>"We couldn't have asked for better pet sitters — reliable, trustworthy, and incredibly caring. They left our home spotless and exceeded every expectation."</p>
          <cite>— Libby · Grotto Sitters</cite>
        </div>
        <div class="review-strip-card reveal reveal-delay-2">
          <div class="rsc-stars">★★★★★</div>
          <p>"Callum and Niamh have looked after Solomon for four years. They are reliable, trustworthy, and clearly care about his wellbeing. I couldn't recommend them highly enough."</p>
          <cite>— Thomas James · Grotto Sitters</cite>
        </div>
      </div>
    </section>

    <!-- ── PET GALLERY MOSAIC ─────────────────────────────────────── -->
    <section class="mosaic-section">
      <div class="mosaic">
        <div class="mosaic-item mosaic-tall reveal">
          <img src="/images/travis-2.jpg" alt="Travis the Vizsla" />
        </div>
        <div class="mosaic-item reveal reveal-delay-1">
          <img src="/images/chester-1.jpg" alt="Chester the cocker spaniel" />
        </div>
        <div class="mosaic-item reveal reveal-delay-2">
          <img src="/images/solomon-1.jpg" alt="Solomon the labradoodle" />
        </div>
        <div class="mosaic-item mosaic-tall reveal reveal-delay-1">
          <img src="/images/zeus-1.jpg" alt="Zeus the Weimaraner" />
        </div>
        <div class="mosaic-item reveal reveal-delay-2">
          <img src="/images/alfie-1.jpg" alt="Alfie the cockapoo" />
        </div>
        <div class="mosaic-item reveal reveal-delay-3">
          <img src="/images/solomon-4.jpg" alt="Solomon in the snow" />
        </div>
        <div class="mosaic-item reveal">
          <img src="/images/orca-1.jpg" alt="Orca" />
        </div>
        <div class="mosaic-item reveal reveal-delay-1">
          <img src="/images/bailey-3.jpg" alt="Bailey" />
        </div>
      </div>
      <div class="mosaic-caption reveal">
        <p>Every sit tells a story</p>
      </div>
    </section>

    <!-- ── FEATURES ───────────────────────────────────────────────── -->
    <section class="features-section">
      <div class="container">
        <p class="label reveal">What you get</p>
        <h2 class="h2 reveal">Everything your clients need to say yes</h2>
        <div class="features-grid">
          <div class="feature reveal">
            <div class="feature-icon">🌐</div>
            <h3>Your own URL</h3>
            <p>A clean, shareable link at <strong>grottositters.com/yourname</strong> — professional and memorable.</p>
          </div>
          <div class="feature reveal reveal-delay-1">
            <div class="feature-icon">⭐</div>
            <h3>Review showcase</h3>
            <p>Add your best reviews from any platform, or write them in directly.</p>
          </div>
          <div class="feature reveal reveal-delay-2">
            <div class="feature-icon">📸</div>
            <h3>Photo gallery</h3>
            <p>A beautiful scrollable gallery of pets you've cared for — your best marketing asset.</p>
          </div>
          <div class="feature reveal">
            <div class="feature-icon">✉️</div>
            <h3>Enquiry form</h3>
            <p>Pet owners can reach you directly from your page — no emails to chase, no back-and-forth.</p>
          </div>
          <div class="feature reveal reveal-delay-1">
            <div class="feature-icon">📱</div>
            <h3>Mobile perfect</h3>
            <p>Looks stunning on every device — because most of your clients are on their phones.</p>
          </div>
          <div class="feature reveal reveal-delay-2">
            <div class="feature-icon">🔒</div>
            <h3>Fully yours</h3>
            <p>Your profile, your brand. Update it any time from your dashboard.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ── FINAL CTA ──────────────────────────────────────────────── -->
    <section class="cta-section">
      <div class="cta-bg">
        <img src="/images/callum-niamh-airport.jpg" alt="" />
        <div class="cta-overlay"></div>
      </div>
      <div class="cta-content reveal">
        <p class="eyebrow" style="color:var(--gold-light)">Join Grotto Sitters</p>
        <h2>Ready to impress every<br /><em>client from the first click?</em></h2>
        <p class="cta-body">Create your profile for free. It takes less than five minutes and lasts a lifetime.</p>
        <a href="/signup" class="btn-primary btn-lg">Create your profile — it's free</a>
        <p class="cta-login">Already have an account? <a href="/login">Log in</a></p>
      </div>
    </section>

    <!-- ── FOOTER ─────────────────────────────────────────────────── -->
    <footer>
      <div class="footer-inner">
        <div class="footer-top">
          <div class="footer-brand">
            <h2>Grotto <span>Sitters</span></h2>
            <p>Beautiful profile pages for professional house and pet sitters worldwide.</p>
          </div>
          <div class="footer-links">
            <h4>Platform</h4>
            <ul>
              <li><a href="/signup">Create a profile</a></li>
              <li><a href="/login">Log in</a></li>
              <li><a href="/dashboard">Dashboard</a></li>
            </ul>
          </div>
          <div class="footer-links">
            <h4>Example profile</h4>
            <ul>
              <li><a href="/callumandniamh">Callum &amp; Niamh</a></li>
            </ul>
          </div>
        </div>
        <div class="footer-bottom">
          <span>&copy; {new Date().getFullYear()} Grotto Sitters</span>
          <span>Made with &#128062; for pet lovers everywhere</span>
        </div>
      </div>
    </footer>

  </body>
</html>

<style>
  /* ── BASE ──────────────────────────────────────────────────────── */
  .container { max-width: 1100px; margin: 0 auto; padding: 0 48px; }
  .label { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: var(--gold); margin-bottom: 14px; display: block; }
  .h2 { font-family: "Playfair Display", serif; font-size: 2.6rem; color: var(--brown-dark); line-height: 1.2; margin-bottom: 16px; }
  .section-sub { color: var(--text-soft); font-size: 1rem; line-height: 1.75; max-width: 560px; margin-bottom: 56px; }
  .eyebrow { font-size: 0.8rem; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: var(--gold-light); margin-bottom: 20px; display: block; }
  .btn-sm { padding: 10px 22px; font-size: 0.8rem; }
  .btn-lg { padding: 18px 52px; font-size: 1rem; }

  /* ── SCROLL REVEAL ─────────────────────────────────────────────── */
  .reveal { opacity: 0; transform: translateY(24px); transition: opacity 0.7s ease, transform 0.7s ease; }
  .reveal.visible { opacity: 1; transform: none; }
  .reveal-delay-1 { transition-delay: 0.12s; }
  .reveal-delay-2 { transition-delay: 0.24s; }
  .reveal-delay-3 { transition-delay: 0.36s; }

  /* ── HEADER ────────────────────────────────────────────────────── */
  .site-header {
    position: fixed; top: 0; left: 0; right: 0; z-index: 200;
    padding: 20px 48px;
    display: flex; justify-content: space-between; align-items: center;
    transition: background 0.3s, box-shadow 0.3s, padding 0.3s;
  }
  .site-header.scrolled {
    background: rgba(250,246,238,0.97);
    backdrop-filter: blur(12px);
    box-shadow: 0 1px 0 rgba(200,150,62,0.15);
    padding: 14px 48px;
  }
  .header-nav { display: flex; align-items: center; gap: 32px; }
  .header-nav a:not(.btn-primary) {
    font-size: 0.82rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
    color: rgba(255,255,255,0.9); text-decoration: none; transition: color 0.2s;
  }
  .site-header.scrolled .header-nav a:not(.btn-primary) { color: var(--brown-mid); }
  .header-nav a:not(.btn-primary):hover { color: var(--gold); }
  .nav-logo { font-family: "Playfair Display", serif; font-size: 1.4rem; color: #fff; letter-spacing: 0.02em; text-decoration: none; transition: color 0.3s; }
  .nav-logo span { color: var(--gold); }
  .site-header.scrolled .nav-logo { color: var(--brown-dark); }
  .burger { display: none; background: none; border: none; cursor: pointer; flex-direction: column; gap: 5px; padding: 4px; }
  .burger span { display: block; width: 24px; height: 2px; background: #fff; transition: background 0.3s; border-radius: 2px; }
  .site-header.scrolled .burger span { background: var(--brown-dark); }

  /* MOBILE MENU */
  .mobile-menu {
    display: none;
    position: fixed; inset: 0; z-index: 190;
    background: #fff;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 32px;
  }
  .mobile-menu.open { display: flex; }
  .mm-link { font-size: 1.3rem; font-family: "Playfair Display", serif; color: var(--brown-dark); text-decoration: none; }
  .mm-cta { margin-top: 8px; }

  /* ── HERO ──────────────────────────────────────────────────────── */
  .hero {
    min-height: 100vh;
    display: grid;
    grid-template-columns: 1fr 1fr;
    position: relative;
    overflow: hidden;
  }
  .hero-image-wrap {
    grid-column: 1; grid-row: 1;
    position: relative;
    min-height: 100vh;
    overflow: hidden;
    background: var(--brown-dark);
  }
  .hero-slide {
    position: absolute; inset: 0;
    width: 100%; height: 100%; object-fit: cover; object-position: center 30%;
    opacity: 0;
    transition: opacity 1.2s ease-in-out;
  }
  .hero-slide.active { opacity: 1; }
  .hero-gradient {
    position: absolute; inset: 0;
    background: linear-gradient(to right, rgba(44,26,14,0.35) 0%, rgba(44,26,14,0) 60%),
                linear-gradient(to top, rgba(44,26,14,0.5) 0%, transparent 40%);
  }
  .hero-text {
    grid-column: 2; grid-row: 1;
    display: flex; flex-direction: column; justify-content: center;
    padding: 140px 64px 80px 60px;
    background: var(--cream);
  }
  .hero-text h1 {
    font-family: "Playfair Display", serif;
    font-size: 3.4rem;
    color: var(--brown-dark);
    line-height: 1.12;
    margin-bottom: 24px;
  }
  .hero-text h1 em { color: var(--gold); font-style: italic; }
  .hero-body { color: var(--text-soft); font-size: 1.05rem; line-height: 1.75; margin-bottom: 36px; max-width: 420px; }
  .hero-actions { display: flex; flex-direction: column; gap: 14px; align-items: flex-start; }

  /* ── STEPS ─────────────────────────────────────────────────────── */
  .steps-section { padding: 100px 0; background: #fff; }
  .steps-grid { display: flex; align-items: flex-start; gap: 0; margin-top: 56px; }
  .step { flex: 1; padding: 0 32px; }
  .step:first-child { padding-left: 0; }
  .step:last-child { padding-right: 0; }
  .step-num { font-family: "Playfair Display", serif; font-size: 3.5rem; color: var(--gold-pale); font-weight: 700; line-height: 1; margin-bottom: 16px; }
  .step h3 { font-family: "Playfair Display", serif; font-size: 1.15rem; color: var(--brown-dark); margin-bottom: 10px; }
  .step p { color: var(--text-soft); font-size: 0.9rem; line-height: 1.7; }
  .step p strong { color: var(--gold); font-weight: 700; }
  .step-arrow { font-size: 1.6rem; color: var(--gold-pale); padding-top: 48px; flex-shrink: 0; }

  /* ── EXAMPLE / EDITORIAL ───────────────────────────────────────── */
  .example-section { padding: 100px 0 0; background: var(--cream); }
  .example-section .container { padding-bottom: 60px; }
  .editorial-grid {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 0; max-width: 1300px; margin: 0 auto;
    padding: 0 48px;
  }
  .editorial-left { position: relative; padding: 0 48px 0 0; }
  .ed-collage {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }
  .ed-col-img {
    width: 100%; display: block; border-radius: 10px;
    object-fit: cover; aspect-ratio: 1;
  }
  .ed-col-wide {
    grid-column: span 2;
    aspect-ratio: 2 / 1;
  }
  .editorial-right { padding: 20px 0 60px 48px; display: flex; flex-direction: column; gap: 24px; justify-content: center; }
  .ed-badge { display: inline-block; background: var(--gold-pale); color: var(--brown-mid); padding: 8px 18px; border-radius: 50px; font-size: 0.78rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; width: fit-content; }
  .ed-name { font-family: "Playfair Display", serif; font-size: 2rem; color: var(--brown-dark); line-height: 1.15; }
  .ed-tagline { color: var(--text-soft); font-size: 0.95rem; line-height: 1.7; }
  .ed-quote { border-left: 3px solid var(--gold); margin: 0; padding: 16px 24px; background: var(--warm-white); border-radius: 0 8px 8px 0; }
  .ed-quote p, .ed-quote { font-style: italic; color: var(--text-soft); font-size: 0.95rem; line-height: 1.75; }
  .ed-stats { display: flex; gap: 32px; padding: 20px 0; border-top: 1px solid rgba(200,150,62,0.15); border-bottom: 1px solid rgba(200,150,62,0.15); }
  .ed-stat { display: flex; flex-direction: column; gap: 4px; }
  .ed-stat-num { font-family: "Playfair Display", serif; font-size: 1.8rem; color: var(--gold); font-weight: 700; line-height: 1; }
  .ed-stat-label { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-soft); }

  .reviews-strip { background: var(--brown-dark); padding: 60px 48px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .review-strip-card { padding: 28px 32px; border: 1px solid rgba(255,255,255,0.08); border-radius: 12px; }
  .rsc-stars { color: var(--gold); font-size: 0.9rem; margin-bottom: 14px; }
  .review-strip-card p { color: rgba(255,255,255,0.82); font-size: 0.88rem; line-height: 1.75; font-style: italic; margin-bottom: 16px; }
  .review-strip-card cite { font-size: 0.78rem; font-weight: 700; color: var(--gold-light); letter-spacing: 0.04em; font-style: normal; }

  /* ── MOSAIC ────────────────────────────────────────────────────── */
  .mosaic-section { position: relative; background: var(--cream); }
  .mosaic { display: grid; grid-template-columns: repeat(4, 1fr); grid-template-rows: 200px 200px; gap: 4px; }
  .mosaic-item { overflow: hidden; background: var(--gold-pale); }
  .mosaic-item img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.5s ease; }
  .mosaic-item:hover img { transform: scale(1.06); }
  .mosaic-tall { grid-row: span 2; }
  .mosaic-caption { text-align: center; padding: 32px; }
  .mosaic-caption p { font-family: "Playfair Display", serif; font-size: 1.1rem; color: var(--text-soft); font-style: italic; }

  /* ── FEATURES ──────────────────────────────────────────────────── */
  .features-section { padding: 100px 0; background: var(--warm-white); }
  .features-section .h2 { margin-bottom: 56px; }
  .features-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; }
  .feature { background: #fff; border-radius: 14px; padding: 36px 28px; box-shadow: 0 2px 20px rgba(44,26,14,0.05); transition: transform 0.2s, box-shadow 0.2s; }
  .feature:hover { transform: translateY(-4px); box-shadow: 0 12px 40px rgba(44,26,14,0.1); }
  .feature-icon { font-size: 2.2rem; margin-bottom: 20px; }
  .feature h3 { font-family: "Playfair Display", serif; font-size: 1.15rem; color: var(--brown-dark); margin-bottom: 10px; }
  .feature p { color: var(--text-soft); font-size: 0.9rem; line-height: 1.7; }
  .feature p strong { color: var(--gold); font-weight: 700; }

  /* ── CTA ───────────────────────────────────────────────────────── */
  .cta-section { position: relative; min-height: 560px; display: flex; align-items: center; justify-content: center; text-align: center; padding: 100px 48px; overflow: hidden; }
  .cta-bg { position: absolute; inset: 0; }
  .cta-bg img { width: 100%; height: 100%; object-fit: cover; object-position: center 30%; }
  .cta-overlay { position: absolute; inset: 0; background: rgba(44,26,14,0.72); }
  .cta-content { position: relative; z-index: 2; max-width: 660px; }
  .cta-content h2 { font-family: "Playfair Display", serif; font-size: 3.2rem; color: #fff; line-height: 1.15; margin-bottom: 20px; }
  .cta-content h2 em { color: var(--gold); font-style: italic; }
  .cta-body { color: rgba(255,255,255,0.8); font-size: 1.05rem; line-height: 1.7; margin-bottom: 36px; }
  .cta-login { margin-top: 20px; font-size: 0.88rem; color: rgba(255,255,255,0.6); }
  .cta-login a { color: var(--gold-light); font-weight: 700; text-decoration: none; }
  .cta-login a:hover { text-decoration: underline; }

  /* ── RESPONSIVE ────────────────────────────────────────────────── */
  @media (max-width: 1024px) {
    .hero { grid-template-columns: 1fr; grid-template-rows: 60vh auto; }
    .hero-image-wrap { grid-column: 1; grid-row: 1; min-height: 60vh; }
    .hero-gradient { background: rgba(44,26,14,0.5); }
    .hero-text { grid-column: 1; grid-row: 2; padding: 60px 48px; }
    .hero-text h1 { font-size: 2.8rem; }
    .editorial-grid { grid-template-columns: 1fr; padding: 0 48px; }
    .editorial-right { padding: 40px 0; }
    .editorial-left { padding: 0; }
  }

  @media (max-width: 768px) {
    .site-header { padding: 16px 24px; }
    .site-header.scrolled { padding: 12px 24px; }
    .header-nav { display: none; }
    .burger { display: flex; }
    .container { padding: 0 24px; }
    .hero-text { padding: 48px 24px; }
    .hero-text h1 { font-size: 2.2rem; }
    .steps-section { padding: 60px 0; }
    .steps-grid { flex-direction: column; gap: 32px; }
    .step { padding: 0; }
    .step-arrow { padding-top: 0; transform: rotate(90deg); align-self: center; }
    .example-section { padding: 60px 0 0; }
    .editorial-grid { padding: 0 24px; }
    .reviews-strip { grid-template-columns: 1fr; padding: 48px 24px; gap: 16px; }
    .mosaic { grid-template-columns: repeat(2, 1fr); grid-template-rows: repeat(4, 140px); }
    .mosaic-item.mosaic-tall { grid-row: span 1; }
