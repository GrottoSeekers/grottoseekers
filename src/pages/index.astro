<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="MYAH — One platform for house & pet sitters and home owners. Create your profile, share your link, and connect." />
  <link rel="icon" href="/images/favicon.png" />
  <link rel="apple-touch-icon" href="/images/app-tile.png" />
  <meta property="og:image" content="/images/logo-tile.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Marcellus&family=Montserrat:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Lato:wght@400;700&display=swap" rel="stylesheet" />
  <title>MYAH</title>
  <style>
    body { margin:0; background:#faf6ee; color:#2c1a0e; font-family:"Montserrat",sans-serif; overflow-x:hidden; }
    * { box-sizing:border-box; }
    a { color:#2f5d45; }
    @keyframes gs-ring { to { transform:rotate(360deg); } }
    @keyframes gs-pulse { 0%,100% { transform:scale(1); } 50% { transform:scale(1.05); } }
  </style>
</head>
<body>

  <!-- Loading overlay -->
  <div data-loader="1" aria-hidden="true" style="position:fixed;inset:0;z-index:9999;background:rgba(250,246,238,.92);backdrop-filter:blur(8px);display:flex;align-items:center;justify-content:center;opacity:0;pointer-events:none;transition:opacity .25s ease">
    <div style="position:relative;width:132px;height:132px;display:flex;align-items:center;justify-content:center">
      <div style="position:absolute;inset:0;border-radius:50%;border:3px solid rgba(110,84,56,.18)"></div>
      <div style="position:absolute;inset:0;border-radius:50%;border:3px solid transparent;border-top-color:#2f5d45;border-right-color:rgba(110,84,56,.45);animation:gs-ring 1s linear infinite"></div>
      <img src="/images/logo-mark.png" alt="" style="width:74px;height:74px;object-fit:contain;animation:gs-pulse 1.8s ease-in-out infinite" />
    </div>
  </div>

  <!-- Header -->
  <header data-site-header="1" style="position:fixed;top:0;left:0;right:0;z-index:210;padding:20px 48px;display:flex;justify-content:space-between;align-items:center;gap:40px;transition:background .3s, box-shadow .3s, padding .3s">
    <a href="/" style="font-family:'Montserrat',sans-serif;font-weight:500;font-size:1.4rem;color:#fff;text-decoration:none;white-space:nowrap;flex-shrink:0;display:inline-flex;align-items:center;gap:14px;line-height:1;margin-left:-4px;letter-spacing:.28em" data-nav-logo="1">
      <img data-logo-img="1" src="/images/logo-mark-white.png" alt="" style="height:46px;width:46px;flex-shrink:0;display:block;object-fit:contain" />
      <span style="display:flex;flex-direction:column;gap:5px;padding-left:14px;border-left:1px solid rgba(110,84,56,.4)">
        <span data-logo-word="1" style="color:#e9e0d2;line-height:1">MYAH</span>
        <span data-logo-tag="1" style="font-family:'Lato',sans-serif;font-weight:700;font-size:.5rem;letter-spacing:.2em;text-transform:uppercase;color:rgba(255,255,255,.82);line-height:1;text-shadow:0 1px 8px rgba(44,26,14,.55)">Make Yourself At Home</span>
      </span>
    </a>
    <nav data-header-nav="1" style="display:flex;align-items:center;gap:32px;flex-wrap:nowrap">
      <a href="#how-it-works" data-nav-link="1" style="font-size:.82rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#fff;text-decoration:none;transition:color .2s;text-shadow:0 1px 8px rgba(44,26,14,.55);white-space:nowrap;flex-shrink:0">How it works</a>
      <a href="#example" data-nav-link="1" style="font-size:.82rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#fff;text-decoration:none;transition:color .2s;text-shadow:0 1px 8px rgba(44,26,14,.55);white-space:nowrap;flex-shrink:0">See an example</a>
      <a href="/listings" data-nav-link="1" style="font-size:.82rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#fff;text-decoration:none;transition:color .2s;text-shadow:0 1px 8px rgba(44,26,14,.55);white-space:nowrap;flex-shrink:0">Browse sits</a>
      <a href="/login" data-nav-link="1" style="font-size:.82rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#fff;text-decoration:none;transition:color .2s;text-shadow:0 1px 8px rgba(44,26,14,.55);white-space:nowrap;flex-shrink:0">Log in</a>
      <a href="/signup" id="header-signup-btn" style="display:inline-flex;align-items:center;justify-content:center;gap:8px;font-size:.78rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#fff;text-decoration:none;background:#2f5d45;border:1.5px solid #2f5d45;border-radius:50px;padding:13px 28px;cursor:pointer;box-shadow:0 4px 14px rgba(44,26,14,.18);white-space:nowrap;flex-shrink:0;transition:background .2s, border-color .2s, transform .12s">Get started</a>
    </nav>
    <button data-burger="1" aria-label="Menu" style="display:none;background:none;border:none;cursor:pointer;flex-direction:column;gap:5px;padding:4px;z-index:215">
      <span data-burger-bar="1" style="display:block;width:24px;height:2px;background:#fff;border-radius:2px;transition:background .3s"></span>
      <span data-burger-bar="1" style="display:block;width:24px;height:2px;background:#fff;border-radius:2px;transition:background .3s"></span>
      <span data-burger-bar="1" style="display:block;width:24px;height:2px;background:#fff;border-radius:2px;transition:background .3s"></span>
    </button>
  </header>

  <!-- Mobile overlay -->
  <div data-mm-overlay="1" style="position:fixed;inset:0;z-index:190;background:rgba(0,0,0,.45);opacity:0;visibility:hidden;transition:opacity .3s ease, visibility .3s ease"></div>

  <!-- Mobile drawer -->
  <div data-mobile-menu="1" style="position:fixed;top:0;right:0;bottom:0;width:320px;max-width:85vw;z-index:200;background:#fff;display:flex;flex-direction:column;transform:translateX(100%);transition:transform .35s cubic-bezier(.4,0,.2,1);box-shadow:-8px 0 40px rgba(0,0,0,.12)">
    <div style="display:flex;justify-content:space-between;align-items:center;padding:20px 24px;border-bottom:1px solid rgba(44,26,14,.08);flex-shrink:0">
      <a href="/" style="font-family:'Montserrat',sans-serif;font-weight:500;font-size:1.25rem;color:#2c1a0e;text-decoration:none;letter-spacing:.28em">MYAH</a>
      <button data-mm-close="1" aria-label="Close menu" style="width:36px;height:36px;border-radius:50%;border:1px solid rgba(44,26,14,.12);background:#fff;display:flex;align-items:center;justify-content:center;cursor:pointer;color:#2c1a0e">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M15 5L5 15M5 5l10 10" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
      </button>
    </div>
    <div style="flex:1;overflow-y:auto;padding:12px 0">
      <a href="#how-it-works" data-mm-item="1" style="display:flex;align-items:center;gap:16px;padding:16px 24px;text-decoration:none;color:#2c1a0e">
        <span style="width:40px;height:40px;border-radius:10px;background:#faf6ee;display:flex;align-items:center;justify-content:center;flex-shrink:0;color:#2f5d45"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"></circle><path d="M12 6v6l4 2"></path></svg></span>
        <span style="flex:1;display:flex;flex-direction:column;gap:2px"><span style="font-size:.95rem;font-weight:600;color:#2c1a0e">How it works</span><span style="font-size:.78rem;color:#6b4e35">Get started in minutes</span></span>
        <span style="font-size:1.4rem;color:rgba(44,26,14,.2);font-weight:300">›</span>
      </a>
      <a href="#example" data-mm-item="1" style="display:flex;align-items:center;gap:16px;padding:16px 24px;text-decoration:none;color:#2c1a0e">
        <span style="width:40px;height:40px;border-radius:10px;background:#faf6ee;display:flex;align-items:center;justify-content:center;flex-shrink:0;color:#2f5d45"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><path d="m21 15-5-5L5 21"></path></svg></span>
        <span style="flex:1;display:flex;flex-direction:column;gap:2px"><span style="font-size:.95rem;font-weight:600;color:#2c1a0e">See an example</span><span style="font-size:.78rem;color:#6b4e35">View a live profile</span></span>
        <span style="font-size:1.4rem;color:rgba(44,26,14,.2);font-weight:300">›</span>
      </a>
      <a href="/listings" data-mm-item="1" style="display:flex;align-items:center;gap:16px;padding:16px 24px;text-decoration:none;color:#2c1a0e">
        <span style="width:40px;height:40px;border-radius:10px;background:#faf6ee;display:flex;align-items:center;justify-content:center;flex-shrink:0;color:#2f5d45"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg></span>
        <span style="flex:1;display:flex;flex-direction:column;gap:2px"><span style="font-size:.95rem;font-weight:600;color:#2c1a0e">Browse sits</span><span style="font-size:.78rem;color:#6b4e35">Find homes that need a sitter</span></span>
        <span style="font-size:1.4rem;color:rgba(44,26,14,.2);font-weight:300">›</span>
      </a>
      <div style="height:1px;background:rgba(44,26,14,.08);margin:8px 24px"></div>
      <a href="/login" data-mm-item="1" style="display:flex;align-items:center;gap:16px;padding:16px 24px;text-decoration:none;color:#2c1a0e">
        <span style="width:40px;height:40px;border-radius:10px;background:#faf6ee;display:flex;align-items:center;justify-content:center;flex-shrink:0;color:#2f5d45"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path><polyline points="10 17 15 12 10 7"></polyline><line x1="15" y1="12" x2="3" y2="12"></line></svg></span>
        <span style="flex:1;display:flex;flex-direction:column;gap:2px"><span style="font-size:.95rem;font-weight:600;color:#2c1a0e">Log in</span><span style="font-size:.78rem;color:#6b4e35">Access your dashboard</span></span>
        <span style="font-size:1.4rem;color:rgba(44,26,14,.2);font-weight:300">›</span>
      </a>
    </div>
    <div style="padding:20px 24px;border-top:1px solid rgba(44,26,14,.08);flex-shrink:0">
      <a href="/signup" data-mm-item="1" style="display:inline-flex;align-items:center;justify-content:center;gap:8px;font-size:.76rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#fff;text-decoration:none;background:#2f5d45;border:1.5px solid #2f5d45;border-radius:50px;padding:13px 24px;cursor:pointer;white-space:nowrap;box-shadow:0 6px 20px rgba(110,84,56,.28);transition:background .2s, border-color .2s, transform .12s;width:100%">Sign up for free</a>
    </div>
  </div>

  <!-- Hero -->
  <section data-hero="1" style="min-height:100vh;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);position:relative;overflow:hidden">
    <div data-hero-photo="1" style="grid-column:1;grid-row:1;position:relative;min-height:100vh;overflow:hidden;background:#2c1a0e">
      <img data-hero-slide="1" src="/images/slideshow-cockapoo-window.jpeg" alt="Cockapoo by the window" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 30%;opacity:1;transition:opacity 1.2s ease-in-out" />
      <img data-hero-slide="1" src="/images/slideshow-dogs-couch.jpeg" alt="Two dogs relaxing on the couch" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 30%;opacity:0;transition:opacity 1.2s ease-in-out" />
      <img data-hero-slide="1" src="/images/slideshow-labrador-puppy.jpeg" alt="Labrador puppy" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 30%;opacity:0;transition:opacity 1.2s ease-in-out" />
      <img data-hero-slide="1" src="/images/slideshow-spaniel-walk.jpeg" alt="Spaniel on a walk" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 30%;opacity:0;transition:opacity 1.2s ease-in-out" />
      <img data-hero-slide="1" src="/images/slideshow-springer-beach.jpeg" alt="Springer spaniel on the beach" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 30%;opacity:0;transition:opacity 1.2s ease-in-out" />
      <img data-hero-slide="1" src="/images/slideshow-cat-bag.jpeg" alt="Cat in a paper bag" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 30%;opacity:0;transition:opacity 1.2s ease-in-out" />
      <img data-hero-slide="1" src="/images/slideshow-living-room.jpeg" alt="Bright living room" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 30%;opacity:0;transition:opacity 1.2s ease-in-out" />
      <img data-hero-slide="1" src="/images/slideshow-ocean-sunset.jpeg" alt="Ocean sunset from the balcony" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 30%;opacity:0;transition:opacity 1.2s ease-in-out" />
      <img data-hero-slide="1" src="/images/slideshow-spaniel-bed.jpeg" alt="Spaniel cosy in bed" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 30%;opacity:0;transition:opacity 1.2s ease-in-out" />
      <div style="position:absolute;inset:0;background:linear-gradient(to right, rgba(44,26,14,.35) 0%, rgba(44,26,14,0) 60%), linear-gradient(to top, rgba(44,26,14,.5) 0%, transparent 40%)"></div>
    </div>
    <div data-hero-copy="1" style="grid-column:2;grid-row:1;display:flex;flex-direction:column;justify-content:center;padding:150px 64px 90px 60px;background:#faf6ee">
      <p style="font-size:.75rem;font-weight:600;letter-spacing:.2em;text-transform:uppercase;color:#6e5438;margin:0 0 24px;display:flex;align-items:center;gap:12px"><span style="width:26px;height:1px;background:#6e5438;display:block;flex-shrink:0"></span>For sitters &amp; home owners</p>
      <h1 class="hero-h1" style="font-family:'Marcellus',serif;font-size:3.5rem;color:#2c1a0e;line-height:1.1;margin:0 0 26px">House &amp; pet sitting<br /><em style="color:#2f5d45;">made simple.</em></h1>
      <p style="color:#6b4e35;font-size:1.08rem;line-height:1.8;margin:0 0 32px;max-width:440px">One platform for house &amp; pet sitters and home owners. Create your profile, share your link, and connect — all in one place.</p>
      <ul style="list-style:none;padding:0;margin:0 0 36px;display:flex;flex-direction:column;gap:12px">
        <li style="font-size:.93rem;color:#2c1a0e;line-height:1.6;padding-left:28px;position:relative"><span style="position:absolute;left:0;top:2px;width:18px;height:18px;border-radius:50%;background:#2f5d45;color:#fff;font-size:.62rem;font-weight:600;display:flex;align-items:center;justify-content:center;line-height:1">✓</span>Your own page at <strong style="color:#2f5d45;font-weight:600">myahsits.com/yourname</strong></li>
        <li style="font-size:.93rem;color:#2c1a0e;line-height:1.6;padding-left:28px;position:relative"><span style="position:absolute;left:0;top:2px;width:18px;height:18px;border-radius:50%;background:#2f5d45;color:#fff;font-size:.62rem;font-weight:600;display:flex;align-items:center;justify-content:center;line-height:1">✓</span>Free to join, live in five minutes</li>
      </ul>
      <div style="display:flex;align-items:center;gap:20px;flex-wrap:wrap">
        <a href="/signup" id="hero-cta" style="display:inline-flex;align-items:center;justify-content:center;gap:8px;font-size:.82rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#fff;text-decoration:none;background:#2f5d45;border:1.5px solid #2f5d45;border-radius:50px;padding:16px 36px;cursor:pointer;white-space:nowrap;box-shadow:0 6px 20px rgba(110,84,56,.28);transition:background .2s, border-color .2s, transform .12s">Sign up for free today</a>
        <a href="#example" style="display:inline-flex;align-items:center;gap:9px;font-size:.8rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#5c3d20;text-decoration:none;border-bottom:1px solid rgba(110,84,56,.5);padding-bottom:4px;transition:color .2s, border-color .2s">See an example →</a>
      </div>
    </div>
  </section>

  <!-- Sitters & owners -->
  <section style="padding:100px 0;background:#fff">
    <div class="section-inner" style="max-width:1100px;margin:0 auto;padding:0 48px">
      <div style="display:flex;flex-direction:column;align-items:center;text-align:center">
        <p style="font-size:.75rem;font-weight:600;letter-spacing:.2em;text-transform:uppercase;color:#6e5438;margin:0 0 14px;display:block">Two sides, one platform</p>
