      [data-burger] { min-height:44px; min-width:44px; }
      [data-mm-item] { min-height:44px; }
    }
  </style>

  <script>
    // Hero slideshow
    const slides = document.querySelectorAll('[data-hero-slide]');
    let slideIdx = 0;
    if (slides.length > 1) {
      setInterval(() => {
        (slides[slideIdx] as HTMLElement).style.opacity = '0';
        slideIdx = (slideIdx + 1) % slides.length;
        (slides[slideIdx] as HTMLElement).style.opacity = '1';
      }, 4500);
    }

    // Header scroll
    const header = document.querySelector('[data-site-header]') as HTMLElement | null;
    const logoImg = document.querySelector('[data-logo-img]') as HTMLImageElement | null;
    const logoWord = document.querySelector('[data-logo-word]') as HTMLElement | null;
    const logoTag = document.querySelector('[data-logo-tag]') as HTMLElement | null;
    const navLinks = document.querySelectorAll('[data-nav-link]');
    const burgerBars = document.querySelectorAll('[data-burger-bar]');

    function onScroll() {
      const on = window.scrollY > 60 || window.innerWidth <= 1000;
      if (!header) return;
      header.style.background = on ? 'rgba(250,246,238,0.97)' : 'transparent';
      header.style.backdropFilter = on ? 'blur(12px)' : 'none';
      header.style.boxShadow = on ? '0 1px 0 rgba(110,84,56,0.15)' : 'none';
      header.style.padding = on ? '14px 48px' : '20px 48px';
      if (logoImg) logoImg.src = on ? '/images/logo-mark.png' : '/images/logo-mark-white.png';
      if (logoWord) logoWord.style.color = on ? '#6e5438' : '#e9e0d2';
      if (logoTag) {
        logoTag.style.color = on ? '#8a6a4f' : 'rgba(255,255,255,.82)';
        logoTag.style.textShadow = on ? 'none' : '0 1px 8px rgba(44,26,14,.55)';
      }
      navLinks.forEach(a => {
        (a as HTMLElement).style.color = on ? '#5c3d20' : '#fff';
        (a as HTMLElement).style.textShadow = on ? 'none' : '0 1px 8px rgba(44,26,14,.55)';
      });
      burgerBars.forEach(b => {
        (b as HTMLElement).style.background = on ? '#2c1a0e' : '#fff';
      });
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    onScroll();

    // Mobile drawer
    const burger = document.querySelector('[data-burger]') as HTMLElement | null;
    const drawer = document.querySelector('[data-mobile-menu]') as HTMLElement | null;
    const mmOverlay = document.querySelector('[data-mm-overlay]') as HTMLElement | null;
    const mmClose = document.querySelector('[data-mm-close]') as HTMLElement | null;

    function setDrawer(open: boolean) {
      if (!drawer || !mmOverlay) return;
      drawer.style.transform = open ? 'translateX(0)' : 'translateX(100%)';
      mmOverlay.style.opacity = open ? '1' : '0';
      mmOverlay.style.visibility = open ? 'visible' : 'hidden';
    }
    burger?.addEventListener('click', () => setDrawer(true));
    mmClose?.addEventListener('click', () => setDrawer(false));
    mmOverlay?.addEventListener('click', () => setDrawer(false));
    document.querySelectorAll('[data-mm-item]').forEach(a => a.addEventListener('click', () => setDrawer(false)));

    // Loading overlay
    const loader = document.querySelector('[data-loader]') as HTMLElement | null;
    let hideTimer: ReturnType<typeof setTimeout>;
    function showLoader() {
      if (!loader) return;
      loader.style.opacity = '1';
      loader.style.pointerEvents = 'all';
      clearTimeout(hideTimer);
      hideTimer = setTimeout(() => {
        if (loader) { loader.style.opacity = '0'; loader.style.pointerEvents = 'none'; }
      }, 1600);
    }
    document.querySelectorAll('form').forEach(f => f.addEventListener('submit', e => { e.preventDefault(); showLoader(); }));
    document.querySelectorAll<HTMLAnchorElement>('a[href]').forEach(el => {
      const href = el.getAttribute('href') || '';
      if (href.startsWith('#') || href.startsWith('http') || href.startsWith('mailto') || href.startsWith('tel') || el.target === '_blank') return;
      el.addEventListener('click', e => { if ((e as MouseEvent).metaKey || (e as MouseEvent).ctrlKey || (e as MouseEvent).shiftKey) return; showLoader(); });
    });
    window.addEventListener('pageshow', e => { if (e.persisted && loader) { loader.style.opacity = '0'; loader.style.pointerEvents = 'none'; } });
  </script>
