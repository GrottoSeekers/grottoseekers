    footer a[href="#privacy"]:hover, footer a[href="#terms"]:hover { color:#c4ab8a !important; }

    /* ── Mobile 1000px ────────────────────────────────────────────────── */
    @media (max-width:1000px) {
      [data-header-nav] { display:none !important; }
