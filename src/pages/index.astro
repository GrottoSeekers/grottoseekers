---
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Grotto Sitters — The platform that connects trusted house & pet sitters with home owners. Create a stunning profile page in minutes." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>Grotto Sitters — Trusted house & pet sitting</title>
  </head>
  <body>

    <!-- ── NAV ──────────────────────────────────────────────────── -->
    <header class="site-header" id="siteHeader">
      <a href="/" class="nav-logo">Grotto <span>Sitters</span></a>
      <nav class="header-nav">
        <a href="#how-it-works">How it works</a>
        <a href="#example">See an example</a>
        <a href="/listings">Browse sits</a>
        <a href="/login" class="nav-login">Log in</a>
        <a href="/signup" class="btn-primary btn-sm">Get started</a>
      </nav>
      <button class="burger" id="burger" aria-label="Menu">
        <span></span><span></span><span></span>
      </button>
    </header>

    <div class="mm-overlay" id="mmOverlay"></div>
    <div class="mobile-menu" id="mobileMenu">
      <div class="mm-header">
        <a href="/" class="mm-logo">Grotto <span>Sitters</span></a>
        <button class="mm-close" id="mmClose" aria-label="Close menu">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
            <path d="M15 5L5 15M5 5l10 10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </button>
      </div>
      <div class="mm-body">
        <a href="#how-it-works" class="mm-item">
          <div class="mm-item-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
          </div>
          <div class="mm-item-text">
            <span class="mm-item-title">How it works</span>
            <span class="mm-item-desc">Get started in minutes</span>
          </div>
          <span class="mm-chevron">&#8250;</span>
        </a>
        <a href="#example" class="mm-item">
          <div class="mm-item-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
          </div>
          <div class="mm-item-text">
            <span class="mm-item-title">See an example</span>
            <span class="mm-item-desc">View a live profile</span>
          </div>
          <span class="mm-chevron">&#8250;</span>
        </a>
        <a href="/listings" class="mm-item">
          <div class="mm-item-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          </div>
          <div class="mm-item-text">
            <span class="mm-item-title">Browse sits</span>
            <span class="mm-item-desc">Find homes that need a sitter</span>
          </div>
          <span class="mm-chevron">&#8250;</span>
        </a>
        <div class="mm-divider"></div>
        <a href="/login" class="mm-item">
          <div class="mm-item-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
          </div>
          <div class="mm-item-text">
            <span class="mm-item-title">Log in</span>
            <span class="mm-item-desc">Access your dashboard</span>
          </div>
          <span class="mm-chevron">&#8250;</span>
        </a>
      </div>
      <div class="mm-footer">
        <a href="/signup" class="btn-primary mm-cta">Get started free</a>
        <p class="mm-footer-note">First 3 months free, then just &pound;4.99/mo</p>
      </div>
    </div>

    <!-- ── HERO ──────────────────────────────────────────────────── -->
    <section class="hero">
      <div class="hero-image-wrap">
        <img src="/images/slideshow-cockapoo-window.jpeg" alt="Cockapoo by the window" class="hero-slide active" />
        <img src="/images/slideshow-dogs-couch.jpeg" alt="Two dogs relaxing on the couch" class="hero-slide" />
        <img src="/images/slideshow-labrador-puppy.jpeg" alt="Labrador puppy" class="hero-slide" />
        <img src="/images/slideshow-spaniel-walk.jpeg" alt="Spaniel on a walk" class="hero-slide" />
        <img src="/images/slideshow-dogs-lake.jpeg" alt="Dogs by the lake" class="hero-slide" />
        <img src="/images/slideshow-springer-beach.jpeg" alt="Springer spaniel on the beach" class="hero-slide" />
        <img src="/images/slideshow-garden-conservatory.jpeg" alt="Beautiful garden conservatory" class="hero-slide" />
        <img src="/images/slideshow-cat-bag.jpeg" alt="Cat in a paper bag" class="hero-slide" />
        <img src="/images/slideshow-living-room.jpeg" alt="Bright living room" class="hero-slide" />
        <img src="/images/slideshow-sunset-palms.jpeg" alt="Sunset with palm trees" class="hero-slide" />
        <img src="/images/slideshow-ocean-sunset.jpeg" alt="Ocean sunset from the balcony" class="hero-slide" />
        <img src="/images/slideshow-spaniel-bed.jpeg" alt="Spaniel cosy in bed" class="hero-slide" />
        <div class="hero-gradient"></div>
      </div>
      <div class="hero-text">
        <p class="eyebrow reveal">For house &amp; pet sitters &amp; home owners</p>
        <h1 class="reveal reveal-delay-1">
          Trusted house &amp; pet<br />
          <em>sitting made simple.</em>
        </h1>
        <p class="hero-body reveal reveal-delay-2">
          One platform for house &amp; pet sitters and home owners. Create your profile, share your link, and connect — all in one place.
        </p>
        <div class="hero-actions reveal reveal-delay-3">
          <a href="/signup" class="btn-primary">Get started free</a>
          <p class="hero-sub-note">First 3 months free, then just &pound;4.99/month.</p>
        </div>
      </div>
    </section>

    <!-- ── FOR SITTERS & OWNERS ─────────────────────────────────────── -->
    <section class="dual-section">
      <div class="container">
        <p class="label reveal">Two sides, one platform</p>
        <h2 class="h2 reveal">Built for sitters <em>&amp;</em> owners</h2>
        <div class="dual-grid">
          <div class="dual-card reveal">
            <div class="dual-icon">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            </div>
            <h3 class="dual-title">For sitters</h3>
            <p class="dual-desc">Showcase everything that makes you a great sitter — in one beautiful, shareable page.</p>
            <ul class="dual-list">
              <li>Create a stunning profile with your bio, photos &amp; experience</li>
              <li>Collect and display five-star reviews from owners</li>
              <li>Share one link — <strong>grottositters.com/yourname</strong></li>
              <li>Get enquiries straight to your inbox or WhatsApp</li>
              <li>Browse available sits and apply directly</li>
            </ul>
            <a href="/signup" class="dual-cta">Get started as a sitter &rarr;</a>
          </div>
          <div class="dual-card dual-card-alt reveal reveal-delay-1">
            <div class="dual-icon">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            </div>
            <h3 class="dual-title">For owners</h3>
            <p class="dual-desc">List your home and pets so trusted sitters can find you — and you can find them.</p>
            <ul class="dual-list">
              <li>Create a profile for your home with photos &amp; details</li>
              <li>Add your pets — breed, temperament &amp; special needs</li>
              <li>Post sit listings with dates you need covered</li>
              <li>Sitters browse &amp; apply — you pick the perfect match</li>
              <li>Receive enquiries via email or WhatsApp</li>
            </ul>
            <a href="/signup" class="dual-cta">Get started as an owner &rarr;</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ── HOW IT WORKS ───────────────────────────────────────────── -->
    <section id="how-it-works" class="steps-section">
      <div class="container">
        <p class="label reveal">Simple &amp; fast</p>
        <h2 class="h2 reveal">Up and running in minutes</h2>
        <div class="steps-grid">
          <div class="step reveal">
            <div class="step-num">01</div>
            <h3>Create an account</h3>
            <p>Sign up as a house &amp; pet sitter or home owner. No credit card required.</p>
          </div>
          <div class="step-arrow reveal">→</div>
          <div class="step reveal">
            <div class="step-num">02</div>
            <h3>Build your page</h3>
            <p>Add your bio, photos, reviews, and everything that makes you stand out.</p>
          </div>
          <div class="step-arrow reveal">→</div>
          <div class="step reveal">
            <div class="step-num">03</div>
            <h3>Share your link</h3>
            <p>Send <strong>grottositters.com/yourname</strong> to connect instantly. That's it.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ── LIVE EXAMPLE ───────────────────────────────────────────── -->
    <section id="example" class="example-section">
      <div class="container">
        <p class="label reveal">Live example</p>
        <h2 class="h2 reveal">Meet Callum &amp; Niamh</h2>
        <p class="section-sub reveal">See what a Grotto Sitters profile looks like — experienced house &amp; pet sitters who have looked after homes and animals all over the world.</p>
      </div>

      <div class="editorial-grid">
        <div class="editorial-left reveal">
          <div class="ed-collage">
            <img src="/images/callum-niamh-boat.jpg" alt="Callum and Niamh on a boat" class="ed-col-img ed-col-wide" style="object-position:center 30%;" />
            <img src="/images/alfie-1.jpg" alt="Alfie the cockapoo" class="ed-col-img" style="object-position:center 20%;" />
            <img src="/images/callum-niamh-event.jpg" alt="Callum and Niamh" class="ed-col-img" style="object-position:center 15%;" />
            <img src="/images/solomon-2.jpg" alt="Solomon the labradoodle" class="ed-col-img ed-col-wide" style="object-position:center 25%;" />
            <img src="/images/bailey-1.jpg" alt="Bailey" class="ed-col-img" style="object-position:center 20%;" />
            <img src="/images/callum-niamh-dinner.jpg" alt="Callum and Niamh at dinner" class="ed-col-img" style="object-position:center 25%;" />
          </div>
        </div>
        <div class="editorial-right reveal reveal-delay-1">
          <div class="ed-badge">Experienced sitters worldwide</div>
          <h3 class="ed-name">Callum &amp; Niamh</h3>
          <p class="ed-tagline">Experienced house &amp; pet sitters available worldwide — passionate about caring for homes and animals wherever they go.</p>
          <blockquote class="ed-quote">
            "We treat every sit like it's our own home — daily walks, feeding routines, garden care, and plenty of love for your animals."
          </blockquote>
          <div class="ed-stats">
            <div class="ed-stat">
              <span class="ed-stat-num">40+</span>
              <span class="ed-stat-label">Five-star reviews</span>
            </div>
            <div class="ed-stat">
              <span class="ed-stat-num">★ 5.0</span>
              <span class="ed-stat-label">Average rating</span>
            </div>
          </div>
          <a href="/callumandniamh" class="btn-primary" target="_blank">View full profile →</a>
        </div>
      </div>

      <!-- Review strip -->
      <div class="reviews-strip">
        <div class="review-strip-card reveal">
          <div class="rsc-stars">★★★★★</div>
          <p>"Super lovely couple who took great care of our cat Rocco! Regular updates, spotless apartment on return. Rocco was extremely happy when we got home."</p>
          <cite>— Jess &amp; Sam · Grotto Sitters</cite>
        </div>
        <div class="review-strip-card reveal reveal-delay-1">
          <div class="rsc-stars">★★★★★</div>
          <p>"We couldn't have asked for better pet sitters — reliable, trustworthy, and incredibly caring. They left our home spotless and exceeded every expectation."</p>
          <cite>— Libby · Grotto Sitters</cite>
        </div>
        <div class="review-strip-card reveal reveal-delay-2">
          <div class="rsc-stars">★★★★★</div>
          <p>"Callum and Niamh have looked after Solomon for four years. They are reliable, trustworthy, and clearly care about his wellbeing. I couldn't recommend them highly enough."</p>
          <cite>— Thomas James · Grotto Sitters</cite>
        </div>
      </div>
    </section>

    <!-- ── PET GALLERY MOSAIC ─────────────────────────────────────── -->
    <section class="mosaic-section">
      <div class="mosaic">
        <div class="mosaic-item mosaic-tall reveal">
          <img src="/images/travis-1.jpg" alt="Travis the Vizsla" style="object-position:center 15%;" />
        </div>
        <div class="mosaic-item reveal reveal-delay-1">
          <img src="/images/chester-1.jpg" alt="Chester the cocker spaniel" />
        </div>
        <div class="mosaic-item reveal reveal-delay-2">
          <img src="/images/solomon-1.jpg" alt="Solomon the labradoodle" />
        </div>
        <div class="mosaic-item mosaic-tall reveal reveal-delay-1">
          <img src="/images/zeus-1.jpg" alt="Zeus the Weimaraner" />
        </div>
        <div class="mosaic-item reveal reveal-delay-2">
          <img src="/images/alfie-1.jpg" alt="Alfie the cockapoo" />
        </div>
        <div class="mosaic-item reveal reveal-delay-3">
          <img src="/images/solomon-4.jpg" alt="Solomon in the snow" />
        </div>
        <div class="mosaic-item reveal">
          <img src="/images/orca-3.jpg" alt="Orca" style="object-position:center 25%;" />
        </div>
        <div class="mosaic-item reveal reveal-delay-1">
          <img src="/images/bailey-3.jpg" alt="Bailey" />
        </div>
      </div>
      <div class="mosaic-caption reveal">
        <p>Every sit tells a story</p>
      </div>
    </section>

    <!-- ── FEATURES ───────────────────────────────────────────────── -->
    <section class="features-section">
      <div class="container">
        <p class="label reveal">What you get</p>
        <h2 class="h2 reveal">Everything you need in one place</h2>
        <div class="features-grid">
          <div class="feature reveal">
            <div class="feature-icon">🌐</div>
            <h3>Your own URL</h3>
            <p>A clean, shareable link at <strong>grottositters.com/yourname</strong> — professional and memorable.</p>
          </div>
          <div class="feature reveal reveal-delay-1">
            <div class="feature-icon">⭐</div>
            <h3>Reviews &amp; trust</h3>
            <p>Showcase your best reviews from any platform — build trust before you even speak.</p>
          </div>
          <div class="feature reveal reveal-delay-2">
            <div class="feature-icon">📸</div>
            <h3>Photo gallery</h3>
            <p>Show off the homes you've cared for, the pets you've loved, or your own home — a gallery that tells your story.</p>
          </div>
          <div class="feature reveal">
            <div class="feature-icon">✉️</div>
            <h3>Built-in enquiries</h3>
            <p>Visitors can reach you directly from your page via email or WhatsApp — no back-and-forth.</p>
          </div>
          <div class="feature reveal reveal-delay-1">
            <div class="feature-icon">📱</div>
            <h3>Mobile perfect</h3>
            <p>Looks stunning on every device — because most people are on their phones.</p>
          </div>
          <div class="feature reveal reveal-delay-2">
            <div class="feature-icon">🔒</div>
            <h3>Fully yours</h3>
            <p>Your page, your colours, your content. Update it any time from your dashboard.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ── FINAL CTA ──────────────────────────────────────────────── -->
    <section class="cta-section">
      <div class="cta-bg">
        <img src="/images/callum-niamh-airport.jpg" alt="" />
        <div class="cta-overlay"></div>
      </div>
      <div class="cta-content reveal">
        <p class="eyebrow" style="color:var(--gold-light)">Join Grotto Sitters</p>
        <h2>Ready to create your<br /><em>perfect page?</em></h2>
        <p class="cta-body">Whether you're a house &amp; pet sitter or a home owner looking for one — get started free for 3 months. It takes less than five minutes.</p>
        <a href="/signup" class="btn-primary btn-lg">Start your free trial</a>
        <p class="cta-login">Already have an account? <a href="/login">Log in</a></p>
      </div>
    </section>

    <!-- ── FOOTER ─────────────────────────────────────────────────── -->
    <footer>
      <div class="footer-inner">
        <div class="footer-top">
          <div class="footer-brand">
            <h2>Grotto <span>Sitters</span></h2>
            <p>Connecting trusted house &amp; pet sitters with home owners worldwide.</p>
          </div>
          <div class="footer-links">
            <h4>Platform</h4>
            <ul>
              <li><a href="/signup">Get started</a></li>
              <li><a href="/login">Log in</a></li>
              <li><a href="/dashboard">Dashboard</a></li>
              <li><a href="/listings">Browse sits</a></li>
            </ul>
          </div>
          <div class="footer-links">
            <h4>Example profile</h4>
            <ul>
              <li><a href="/callumandniamh">Callum &amp; Niamh</a></li>
            </ul>
          </div>
        </div>
        <div class="footer-bottom">
          <span>&copy; {new Date().getFullYear()} Grotto Sitters</span>
          <span>Made with &#128062; for house &amp; pet sitters everywhere</span>
        </div>
      </div>
    </footer>

  </body>
</html>

<style>
  /* ── BASE ──────────────────────────────────────────────────────── */
  .container { max-width: 1100px; margin: 0 auto; padding: 0 48px; }
  .label { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: var(--gold); margin-bottom: 14px; display: block; }
  .h2 { font-family: "Playfair Display", serif; font-size: 2.6rem; color: var(--brown-dark); line-height: 1.2; margin-bottom: 16px; }
  .section-sub { color: var(--text-soft); font-size: 1rem; line-height: 1.75; max-width: 560px; margin-bottom: 56px; }
  .eyebrow { font-size: 0.8rem; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: var(--gold-light); margin-bottom: 20px; display: block; }
  .btn-sm { padding: 10px 22px; font-size: 0.8rem; }
  .btn-lg { padding: 18px 52px; font-size: 1rem; }

  /* ── SCROLL REVEAL ─────────────────────────────────────────────── */
  .reveal { opacity: 0; transform: translateY(24px); transition: opacity 0.7s ease, transform 0.7s ease; }
  .reveal.visible { opacity: 1; transform: none; }
  .reveal-delay-1 { transition-delay: 0.12s; }
  .reveal-delay-2 { transition-delay: 0.24s; }
  .reveal-delay-3 { transition-delay: 0.36s; }

  /* ── HEADER ────────────────────────────────────────────────────── */
  .site-header {
    position: fixed; top: 0; left: 0; right: 0; z-index: 210;
    padding: 20px 48px;
    display: flex; justify-content: space-between; align-items: center;
    transition: background 0.3s, box-shadow 0.3s, padding 0.3s;
  }
  .site-header.scrolled {
    background: rgba(250,246,238,0.97);
    backdrop-filter: blur(12px);
    box-shadow: 0 1px 0 rgba(200,150,62,0.15);
    padding: 14px 48px;
  }
  .header-nav { display: flex; align-items: center; gap: 32px; }
  .header-nav a:not(.btn-primary) {
    font-size: 0.82rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
    color: rgba(255,255,255,0.9); text-decoration: none; transition: color 0.2s;
  }
  .site-header.scrolled .header-nav a:not(.btn-primary) { color: var(--brown-mid); }
  .header-nav a:not(.btn-primary):hover { color: var(--gold); }
  .nav-logo {
    font-family: "Playfair Display", serif; font-size: 1.4rem; color: #fff;
    letter-spacing: 0.02em; text-decoration: none; transition: color 0.3s;
    white-space: nowrap; flex-shrink: 0;
  }
  .nav-logo span { color: var(--gold); }
  .site-header.scrolled .nav-logo { color: var(--brown-dark); }
  .burger { display: none; background: none; border: none; cursor: pointer; flex-direction: column; gap: 5px; padding: 4px; z-index: 215; }
  .burger span { display: block; width: 24px; height: 2px; background: #fff; transition: background 0.3s; border-radius: 2px; }
  .site-header.scrolled .burger span { background: var(--brown-dark); }

  /* MOBILE MENU — Airbnb-style slide-out drawer */
  .mm-overlay {
    position: fixed; inset: 0; z-index: 190;
    background: rgba(0,0,0,0.45);
    opacity: 0; visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }
  .mm-overlay.open { opacity: 1; visibility: visible; }

  .mobile-menu {
    position: fixed; top: 0; right: 0; bottom: 0;
    width: 320px; max-width: 85vw;
    z-index: 200;
    background: #fff;
    display: flex; flex-direction: column;
    transform: translateX(100%);
    transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: -8px 0 40px rgba(0,0,0,0.12);
  }
  .mobile-menu.open { transform: translateX(0); }

  .mm-header {
    display: flex; justify-content: space-between; align-items: center;
    padding: 20px 24px; border-bottom: 1px solid rgba(44,26,14,0.08);
    flex-shrink: 0;
  }
  .mm-logo {
    font-family: "Playfair Display", serif; font-size: 1.25rem;
    color: var(--brown-dark); text-decoration: none;
  }
  .mm-logo span { color: var(--gold); }
  .mm-close {
    width: 36px; height: 36px; border-radius: 50%;
    border: 1px solid rgba(44,26,14,0.12); background: #fff;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer; color: var(--brown-dark); transition: background 0.2s;
  }
  .mm-close:hover { background: var(--cream); }

  .mm-body {
    flex: 1; overflow-y: auto; padding: 12px 0;
  }
  .mm-item {
    display: flex; align-items: center; gap: 16px;
    padding: 16px 24px; text-decoration: none; color: var(--text);
    transition: background 0.15s;
  }
  .mm-item:hover { background: rgba(200,150,62,0.05); }
  .mm-item:active { background: rgba(200,150,62,0.1); }
  .mm-item-icon {
    width: 40px; height: 40px; border-radius: 10px;
    background: var(--cream); display: flex; align-items: center;
