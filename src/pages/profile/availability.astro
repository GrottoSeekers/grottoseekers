---
export const prerender = false;

import { getSession } from '../../lib/auth';
import { supabase } from '../../lib/supabase';

const session = await getSession(Astro.request);
if (!session) return Astro.redirect('/login');

const { data: profile } = await supabase
  .from('profiles')
  .select('*')
  .eq('user_id', session.userId)
  .single();

if (!profile) return Astro.redirect('/profile/create');

// Load saved availability days (stored as JSON object { "YYYY-MM-DD": "free"|"maybe" })
let savedDays: Record<string, string> = {};
try {
  if (profile.availability_json && typeof profile.availability_json === 'object') {
    savedDays = profile.availability_json as Record<string, string>;
  }
} catch (_) {}

// Load saved preferences
let savedPrefs: { lengths: string[]; pets: string[]; notice: string } = {
  lengths: [],
  pets: [],
  notice: 'Any time',
};
try {
  if (profile.availability_prefs_json && typeof profile.availability_prefs_json === 'object') {
    const p = profile.availability_prefs_json as any;
    savedPrefs = {
      lengths: Array.isArray(p.lengths) ? p.lengths : [],
      pets: Array.isArray(p.pets) ? p.pets : [],
      notice: typeof p.notice === 'string' ? p.notice : 'Any time',
    };
  }
} catch (_) {}

const sitCount = (profile.sits_count ?? profile.reviews_count ?? 0) as number;
const displayName = (profile.display_name ?? profile.full_name ?? 'You') as string;
const location = (profile.location ?? '') as string;
const avatarUrl = (profile.avatar_url ?? '') as string;

// Count open sits for the "matching sits" link
let matchCount = 0;
try {
  const { count } = await supabase
    .from('listings')
    .select('id', { count: 'exact', head: true })
    .eq('status', 'active');
  matchCount = count ?? 0;
} catch (_) {}
