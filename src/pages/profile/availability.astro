  <!-- Save bar -->
  <div id="saveBar" style="position:fixed;left:0;right:0;bottom:0;z-index:40;padding:16px 48px;background:rgba(255,255,255,.96);backdrop-filter:blur(10px);border-top:1px solid rgba(110,84,56,.28);box-shadow:0 -6px 24px rgba(44,26,14,.06);transition:transform .3s ease, opacity .3s ease;transform:translateY(100%);opacity:0;pointer-events:none">
    <div style="max-width:1180px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap">
      <p id="saveBarText" style="font-size:.88rem;color:#6b4e35;margin:0;line-height:1.5">0 days marked free — not saved yet.</p>
      <button
        type="button"
        onclick="saveAvailability()"
        id="saveBtn"
        style="font-family:'Montserrat',sans-serif;font-size:.82rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#fff;background:#2f5d45;border:1.5px solid #2f5d45;border-radius:50px;padding:16px 36px;cursor:pointer;white-space:nowrap;box-shadow:0 6px 20px rgba(110,84,56,.28);transition:background .25s ease, border-color .25s ease, transform .15s ease">
        Save availability
      </button>
    </div>
  </div>

</div>

<script define:vars={{ initialDays: savedDays, matchCount }}>
const MONTH_NAMES = ['January','February','March','April','May','June','July','August','September','October','November','December'];
const WEEKDAYS = ['M','T','W','T','F','S','S'];

let days = { ...initialDays };
let brush = 'free';
let offset = 0;
let dragging = false;
let dirty = false;

const now = new Date();
const BASE_YEAR = now.getFullYear();
const BASE_MONTH = now.getMonth();

function isoKey(y, m, d) {
  return y + '-' + String(m + 1).padStart(2,'0') + '-' + String(d).padStart(2,'0');
}

function fmtKey(k) {
  const [,m,d] = k.split('-').map(Number);
  return d + ' ' + MONTH_NAMES[m - 1].slice(0,3);
}

function paint(k) {
  if (brush === 'clear') delete days[k];
  else days[k] = brush;
  dirty = true;
  renderCalendar();
  updateAside();
  updateSaveBar();
}

function setBrush(b) {
  brush = b;
  document.querySelectorAll('[data-brush]').forEach(btn => {
    const active = btn.getAttribute('data-brush') === b;
    btn.style.background = active ? 'rgba(110,84,56,.14)' : '#fff';
    btn.style.color = active ? '#2f5d45' : '#6b4e35';
    btn.style.borderColor = active ? 'rgba(110,84,56,.5)' : 'rgba(44,26,14,.1)';
  });
}

function shiftOffset(delta) {
  offset += delta;
  renderCalendar();
}

function buildMonthCells(year, monthIdx) {
  const first = new Date(year, monthIdx, 1);
  const startDow = (first.getDay() + 6) % 7;
  const total = new Date(year, monthIdx + 1, 0).getDate();
  const cells = [];
  for (let i = 0; i < startDow; i++) cells.push(null);
  for (let d = 1; d <= total; d++) cells.push({ day: d, k: isoKey(year, monthIdx, d) });
  return cells;
}

function renderCalendar() {
  const base = new Date(BASE_YEAR, BASE_MONTH + offset, 1);
  const y1 = base.getFullYear(), m1 = base.getMonth();
  const base2 = new Date(y1, m1 + 1, 1);
  const y2 = base2.getFullYear(), m2 = base2.getMonth();

  const ml1 = MONTH_NAMES[m1] + ' ' + y1;
  const ml2 = MONTH_NAMES[m2] + ' ' + y2;

  document.getElementById('rangeLabel').textContent =
    MONTH_NAMES[m1].slice(0,3) + ' — ' + MONTH_NAMES[m2].slice(0,3) + ' ' + y2;

  const grid = document.getElementById('calGrid');
  grid.innerHTML = [[y1,m1,ml1],[y2,m2,ml2]].map(([y,m,label]) => {
    const cells = buildMonthCells(y, m);
    const dayBtns = cells.map(c => {
      if (!c) return `<div style="height:34px;visibility:hidden"></div>`;
      const v = days[c.k];
      let style = 'height:34px;border-radius:8px;font-family:\'Montserrat\',sans-serif;font-size:.8rem;font-weight:600;cursor:pointer;transition:background .15s ease, color .15s ease, border-color .15s ease;width:100%;';
      if (v === 'free') style += 'background:#2f5d45;color:#fff;border:1.5px solid #2f5d45;';
      else if (v === 'maybe') style += 'background:rgba(110,84,56,.22);color:#5c3d20;border:1.5px solid rgba(110,84,56,.4);';
      else style += 'background:#faf6ee;color:#6b4e35;border:1.5px solid rgba(44,26,14,.08);';
      return `<button type="button" data-day="${c.k}" style="${style}" onmousedown="startDrag('${c.k}')" onmouseenter="onEnter('${c.k}')">${c.day}</button>`;
    }).join('');
    const wds = WEEKDAYS.map(w => `<span style="text-align:center;font-size:.64rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:#8a6a4f">${w}</span>`).join('');
    return `<div>
      <p style="font-family:'Marcellus',serif;font-size:1.12rem;color:#2c1a0e;margin:0 0 14px">${label}</p>
      <div style="display:grid;grid-template-columns:repeat(7,1fr);gap:5px;margin-bottom:8px">${wds}</div>
      <div style="display:grid;grid-template-columns:repeat(7,1fr);gap:5px">${dayBtns}</div>
    </div>`;
  }).join('');
}

function startDrag(k) {
  dragging = true;
  paint(k);
}

function onEnter(k) {
  if (dragging) paint(k);
}

document.addEventListener('mouseup', () => { dragging = false; });

function getStretches() {
  const keys = Object.keys(days).filter(k => days[k] === 'free').sort();
  const runs = [];
  let run = [];
  const dn = k => Math.round(new Date(k + 'T00:00:00').getTime() / 86400000);
  keys.forEach(k => {
    if (run.length && dn(k) - dn(run[run.length-1]) !== 1) { runs.push(run); run = []; }
    run.push(k);
  });
  if (run.length) runs.push(run);
  return runs.sort((a,b) => b.length - a.length);
}

function updateAside() {
  const stretches = getStretches().slice(0,3);
  const freeCount = Object.values(days).filter(v => v === 'free').length;
  const longest = stretches[0] ? stretches[0].length : 0;

  // Stretches list
  const sl = document.getElementById('stretchList');
  const se = document.getElementById('stretchEmpty');
  if (!stretches.length) {
    sl.innerHTML = '';
    se.style.display = '';
  } else {
    se.style.display = 'none';
    sl.innerHTML = stretches.map(run => {
      const pill = run.length >= 14 ? 'Long sit' : run.length >= 7 ? 'A week+' : 'Short';
      const pillStyle = run.length >= 14
        ? 'background:#2f5d45;color:#fff;'
        : 'background:rgba(110,84,56,.14);color:#2f5d45;';
      return `<div style="display:flex;align-items:center;justify-content:space-between;gap:14px;background:#faf6ee;border:1px solid rgba(110,84,56,.22);border-radius:12px;padding:14px 16px">
        <div style="min-width:0">
          <p style="font-size:.92rem;font-weight:600;color:#2c1a0e;margin:0 0 3px">${fmtKey(run[0])} — ${fmtKey(run[run.length-1])}</p>
          <p style="font-size:.8rem;color:#6b4e35;margin:0">${run.length} ${run.length === 1 ? 'day' : 'days'}</p>
        </div>
        <span style="font-size:.68rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase;padding:5px 12px;border-radius:50px;white-space:nowrap;flex-shrink:0;${pillStyle}">${pill}</span>
      </div>`;
    }).join('');
  }

  // Card pill
  const pill = document.getElementById('cardPill');
  if (freeCount) {
    pill.textContent = 'Available ' + (longest >= 14 ? 'for long sits' : 'for short sits') + ' · ' + freeCount + ' days marked';
    pill.style.background = 'rgba(110,84,56,.14)';
    pill.style.color = '#2f5d45';
  } else {
    pill.textContent = 'No dates set';
    pill.style.background = 'rgba(44,26,14,.07)';
    pill.style.color = '#6b4e35';
  }

  // Match line
  document.getElementById('matchLine').textContent = freeCount
    ? 'Owners searching those dates see this badge on your card, and you appear in their filtered results.'
    : 'Without dates your card shows nothing here, and date filters skip you entirely.';

  // Match count link
  document.getElementById('matchCountLink').textContent = (freeCount ? matchCount + ' open sits' : 'Browse all open sits') + ' →';
}

function updateSaveBar() {
  const bar = document.getElementById('saveBar');
  const freeCount = Object.values(days).filter(v => v === 'free').length;
  document.getElementById('saveBarText').textContent = freeCount + ' days marked free — not saved yet.';
  if (dirty) {
    bar.style.transform = 'translateY(0)';
    bar.style.opacity = '1';
    bar.style.pointerEvents = 'all';
  }
}

function togglePref(btn) {
  const multi = btn.getAttribute('data-pref-multi') === '1';
  const field = btn.getAttribute('data-pref-field');
  const container = btn.parentElement;
  if (multi) {
    const isOn = btn.style.background.includes('#2f5d45');
    btn.style.background = isOn ? '#faf6ee' : '#2f5d45';
    btn.style.color = isOn ? '#5c3d20' : '#fff';
    btn.style.borderColor = isOn ? 'rgba(110,84,56,.32)' : '#2f5d45';
  } else {
    container.querySelectorAll('[data-pref-field="' + field + '"]').forEach(b => {
      b.style.background = '#faf6ee';
      b.style.color = '#5c3d20';
      b.style.borderColor = 'rgba(110,84,56,.32)';
    });
    btn.style.background = '#2f5d45';
    btn.style.color = '#fff';
    btn.style.borderColor = '#2f5d45';
  }
  dirty = true;
  updateSaveBar();
}

async function saveAvailability() {
  const btn = document.getElementById('saveBtn');
  btn.textContent = 'Saving…';
  btn.disabled = true;

  const prefs = { lengths: [], pets: [], notice: 'Any time' };
  document.querySelectorAll('[data-pref-field="lengths"]').forEach(b => {
    if (b.style.background.includes('#2f5d45')) prefs.lengths.push(b.getAttribute('data-pref-value'));
  });
  document.querySelectorAll('[data-pref-field="pets"]').forEach(b => {
    if (b.style.background.includes('#2f5d45')) prefs.pets.push(b.getAttribute('data-pref-value'));
  });
  document.querySelectorAll('[data-pref-field="notice"]').forEach(b => {
    if (b.style.background.includes('#2f5d45')) prefs.notice = b.getAttribute('data-pref-value');
  });

  try {
    await fetch('/api/profile/availability', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ days, prefs }),
    });
    dirty = false;
    const bar = document.getElementById('saveBar');
    bar.style.transform = 'translateY(100%)';
    bar.style.opacity = '0';
    bar.style.pointerEvents = 'none';
    btn.textContent = 'Saved';
  } catch (e) {
    btn.textContent = 'Save availability';
  }
  btn.disabled = false;
}

// Init
renderCalendar();
updateAside();

// Loader on nav
const loader = document.querySelector('[data-loader]');
document.querySelectorAll('a[href]').forEach(a => {
  const href = a.getAttribute('href') || '';
  if (href.startsWith('#') || href.startsWith('http') || !loader) return;
  a.addEventListener('click', e => {
    if (e.metaKey || e.ctrlKey || e.shiftKey) return;
    loader.style.opacity = '1';
    loader.style.pointerEvents = 'all';
    setTimeout(() => { loader.style.opacity = '0'; loader.style.pointerEvents = 'none'; }, 1600);
  });
});
</script>
</body>
</html>
