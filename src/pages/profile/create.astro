---
export const prerender = false;

import '../../styles/global.css';
import { getSession } from '../../lib/auth';
import { supabase } from '../../lib/supabase';

const session = await getSession(Astro.request);
if (!session) return Astro.redirect('/login');

const { data: existing } = await supabase
  .from('profiles')
  .select('slug')
  .eq('user_id', session.userId)
  .single();

if (existing) return Astro.redirect('/dashboard');

const errorMap: Record<string, string> = {
  missing:      'Please fill in your name and URL.',
  slug_taken:   'That URL is already taken — try another.',
  slug_invalid: 'URL can only contain lowercase letters, numbers, and hyphens.',
  server:       'Something went wrong. Please try again.',
};
const errorKey = Astro.url.searchParams.get('error') ?? '';
const errorMsg = errorMap[errorKey] ?? '';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Lato:wght@300;400;700&display=swap" rel="stylesheet" />
    <title>Create your profile — Grotto Sitters</title>
  </head>
  <body>
    <nav>
      <a href="/" class="nav-logo">Grotto <span>Sitters</span></a>
      <div class="nav-right">
        <span class="nav-email">{session.email}</span>
        <a href="/api/auth/logout" class="nav-logout">Log out</a>
      </div>
    </nav>

    <main class="create-wrap">
      <div class="section-inner">
        <header class="create-header">
          <p class="section-label">Sitter Portal</p>
          <h1 class="section-title">Create your profile</h1>
          <div class="divider"></div>
          <p class="create-intro">Fill in your details below. You can add photos, reviews, and more from your dashboard once your profile is live.</p>
        </header>

        {errorMsg && (
          <div class="error-banner">{errorMsg}</div>
        )}

        <form action="/api/profile/create" method="POST" class="create-form">
          <div class="form-section">
            <h2>Your details</h2>

            <div class="field">
              <label for="name">Your name <span class="req">*</span></label>
              <input type="text" id="name" name="name" placeholder="e.g. Callum & Niamh" required autocomplete="name" />
              <p class="field-hint">This is how you'll appear on your profile.</p>
            </div>

            <div class="field">
              <label for="slug">Your profile URL <span class="req">*</span></label>
              <div class="slug-wrap">
                <span class="slug-prefix">grottositters.com/</span>
                <input type="text" id="slug" name="slug" placeholder="yourname" required pattern="^[a-z0-9]+(?:-[a-z0-9]+)*$" />
              </div>
              <p class="field-hint">Lowercase letters, numbers, and hyphens only. This can't be changed later.</p>
            </div>

            <div class="field">
              <label for="tagline">Tagline</label>
              <input type="text" id="tagline" name="tagline" placeholder="e.g. Experienced pet sitters based in London" />
              <p class="field-hint">A one-line description shown under your name.</p>
            </div>

            <div class="field">
              <label for="profile_pic">Profile photo URL</label>
              <input type="url" id="profile_pic" name="profile_pic" placeholder="https://..." />
              <p class="field-hint">Paste the URL of a photo. You can add more images later.</p>
            </div>

            <div class="field">
              <label for="bio">About you</label>
              <textarea id="bio" name="bio" rows="6" placeholder="Tell pet owners about yourselves — your experience, the services you offer, and what makes you great sitters."></textarea>
              <p class="field-hint">Use blank lines to separate paragraphs.</p>
            </div>
          </div>

          <div class="form-actions">
            <button type="submit" class="btn-primary btn-submit">Create my profile →</button>
            <a href="/dashboard" class="cancel-link">Cancel</a>
          </div>
        </form>
      </div>
    </main>

    <script>
      const nameInput = document.getElementById('name') as HTMLInputElement;
      const slugInput = document.getElementById('slug') as HTMLInputElement;
      let slugEdited = false;

      slugInput?.addEventListener('input', () => { slugEdited = true; });

      nameInput?.addEventListener('input', () => {
        if (slugEdited) return;
        slugInput.value = nameInput.value
          .toLowerCase()
          .replace(/[^a-z0-9\s-]/g, '')
          .trim()
          .replace(/\s+/g, '-')
          .replace(/-+/g, '-');
      });
    </script>

    <style>
      body { min-height: 100vh; display: flex; flex-direction: column; background: var(--cream); }

      nav {
        position: static;
        border-bottom: 1px solid rgba(200,150,62,0.2);
        padding: 18px 48px;
        display: flex; justify-content: space-between; align-items: center;
      }
      .nav-right { display: flex; align-items: center; gap: 20px; }
      .nav-email { font-size: 0.85rem; color: var(--text-soft); }
      .nav-logout {
        font-size: 0.8rem; font-weight: 700; letter-spacing: 0.1em;
        text-transform: uppercase; color: var(--gold); text-decoration: none;
      }
      .nav-logout:hover { color: var(--brown-dark); }

      .create-wrap { flex: 1; padding: 60px 48px; }
      .create-header { margin-bottom: 40px; }
      .create-intro { color: var(--text-soft); font-size: 0.95rem; line-height: 1.7; max-width: 560px; margin-top: 16px; }

      .error-banner {
        background: #fef2f2; border: 1px solid #fecaca; border-radius: 8px;
        padding: 14px 18px; color: #b91c1c; font-size: 0.9rem;
        margin-bottom: 24px; max-width: 680px;
      }

      .create-form { max-width: 680px; }

      .form-section {
        background: #fff; border-radius: 12px; padding: 36px;
        box-shadow: 0 2px 16px rgba(44,26,14,0.06); margin-bottom: 24px;
      }
      .form-section h2 {
        font-family: "Playfair Display", serif; font-size: 1.15rem;
        color: var(--brown-dark); margin-bottom: 28px;
        padding-bottom: 16px; border-bottom: 1px solid rgba(44,26,14,0.08);
      }

      .field { margin-bottom: 24px; }
      .field:last-child { margin-bottom: 0; }
      label { display: block; font-size: 0.85rem; font-weight: 700; color: var(--brown-dark); margin-bottom: 8px; letter-spacing: 0.02em; }
      .req { color: var(--gold); }

      input[type="text"], input[type="url"], textarea {
        width: 100%; box-sizing: border-box;
        border: 1.5px solid rgba(44,26,14,0.15); border-radius: 8px;
        padding: 12px 16px; font-size: 0.95rem; font-family: "Lato", sans-serif;
        color: var(--text); background: var(--cream); outline: none;
        transition: border-color 0.2s;
      }
      input:focus, textarea:focus { border-color: var(--gold); }
      textarea { resize: vertical; line-height: 1.6; }

      .slug-wrap { display: flex; align-items: center; border: 1.5px solid rgba(44,26,14,0.15); border-radius: 8px; overflow: hidden; background: var(--cream); transition: border-color 0.2s; }
      .slug-wrap:focus-within { border-color: var(--gold); }
      .slug-prefix { padding: 12px 14px; font-size: 0.88rem; color: var(--text-soft); background: rgba(44,26,14,0.04); border-right: 1px solid rgba(44,26,14,0.1); white-space: nowrap; flex-shrink: 0; }
      .slug-wrap input { border: none; border-radius: 0; background: transparent; }
      .slug-wrap input:focus { border-color: transparent; }

      .field-hint { font-size: 0.8rem; color: var(--text-soft); margin-top: 6px; line-height: 1.5; }

      .form-actions { display: flex; align-items: center; gap: 24px; }
      .btn-submit { padding: 14px 36px; font-size: 0.95rem; }
      .cancel-link { font-size: 0.85rem; color: var(--text-soft); text-decoration: none; }
      .cancel-link:hover { color: var(--brown-dark); }

      @media (max-width: 768px) {
        nav { padding: 14px 24px; }
        .nav-email { display: none; }
        .create-wrap { padding: 40px 24px; }
        .form-section { padding: 24px; }
        .slug-prefix { font-size: 0.78rem; padding: 12px 10px; }
      }
    </style>
  </body>
</html>
