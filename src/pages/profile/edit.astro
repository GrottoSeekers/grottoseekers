---
export const prerender = false;

import { getSession } from '../../lib/auth';
import { supabase } from '../../lib/supabase';

const session = await getSession(Astro.request);
if (!session) return Astro.redirect('/login');

const { data: profile } = await supabase
  .from('profiles')
  .select('*')
  .eq('user_id', session.userId)
  .single();

if (!profile) return Astro.redirect('/profile/create');

const heroImages: any[] = Array.isArray(profile.hero_images_json) ? profile.hero_images_json : [];
const aboutImages: any[] = Array.isArray(profile.about_images_json) ? profile.about_images_json : [];
const gallery: any[] = Array.isArray(profile.gallery_json) ? profile.gallery_json : [];
const reviews: any[] = Array.isArray(profile.reviews_json) ? profile.reviews_json : [];
const platforms: any[] = Array.isArray(profile.platforms_json) ? profile.platforms_json : [];
const reviewRequests: any[] = Array.isArray(profile.review_requests_json) ? profile.review_requests_json : [];
const h = (profile.headings_json ?? {}) as Record<string, string>;
const t = (profile.theme_json ?? {}) as Record<string, string>;

const saved = Astro.url.searchParams.get('saved');
const newToken = Astro.url.searchParams.get('new_token') ?? '';
const errorKey = Astro.url.searchParams.get('error') ?? '';
const detail = Astro.url.searchParams.get('detail');
const errorMap: Record<string, string> = {
  missing:        'Please fill in the required fields.',
  file_too_large: 'Image must be under 5 MB.',
  upload:         `Upload error: ${detail ?? 'unknown'}`,
  server:         'Something went wrong. Please try again.',
};
const errorMsg = errorMap[errorKey] ?? '';
const savedMsg = saved ? 'Changes saved!' : '';

const strengthItems = [
  profile.bio,
  heroImages.length > 0,
  gallery.length > 0,
  reviews.length > 0,
  platforms.length > 0,
  profile.theme_json && Object.keys(profile.theme_json).length > 0,
  profile.badge_text,
  (profile.about_images_json ?? []).length > 0,
];
const strengthPct = Math.round((strengthItems.filter(Boolean).length / strengthItems.length) * 100);
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" href="/images/favicon.png" />
  <link rel="apple-touch-icon" href="/images/app-tile.png" />
  <meta property="og:image" content="/images/logo-tile.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Marcellus&family=Montserrat:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Lato:wght@400;700&display=swap" rel="stylesheet" />
  <title>Edit your profile — MYAH</title>
  <style>
    body { margin:0; background:#faf6ee; color:#2c1a0e; font-family:"Montserrat",sans-serif; min-height:100vh; }
    * { box-sizing:border-box; }
    a { color:#2f5d45; }
    a:hover { color:#2c1a0e; }
    input::placeholder, textarea::placeholder { color:rgba(44,26,14,.35); }
    input[type="color"] { -webkit-appearance:none; appearance:none; padding:2px; }
    input[type="color"]::-webkit-color-swatch-wrapper { padding:0; }
    input[type="color"]::-webkit-color-swatch { border:none; border-radius:50%; }
    @keyframes gs-ring { to { transform:rotate(360deg); } }
    @keyframes gs-pulse { 0%,100% { transform:scale(1); } 50% { transform:scale(1.05); } }
    @media (max-width:960px) {
      [data-topnav] { padding:14px 24px !important; }
      [data-pad] { padding:32px 20px 90px !important; }
      [data-two-col] { grid-template-columns:minmax(0,1fr) !important; }
      [data-aside] { position:static !important; }
      [data-card] { padding:26px 22px !important; }
      [data-field-row] { grid-template-columns:minmax(0,1fr) !important; }
      [data-save-bar] { padding:14px 24px !important; }
    }
    input:focus, textarea:focus { border-color:#2f5d45 !important; box-shadow:0 0 0 3px rgba(110,84,56,.15) !important; outline:none; }
    [data-card]:hover { box-shadow:0 10px 34px rgba(44,26,14,.08) !important; border-color:rgba(110,84,56,.4) !important; }
    [data-back]:hover { color:#2f5d45 !important; gap:13px !important; }
    [data-save-btn]:hover { background:#3e7a5b !important; border-color:#3e7a5b !important; transform:translateY(-2px) !important; box-shadow:0 12px 28px rgba(110,84,56,.36) !important; }
    [data-save-btn]:active { transform:translateY(0) scale(.98) !important; }
    [data-jump-link]:hover { background:rgba(110,84,56,.1) !important; color:#2f5d45 !important; border-color:rgba(110,84,56,.5) !important; }
    [data-type-btn]:hover { background:rgba(110,84,56,.12) !important; border-color:#2f5d45 !important; }
    [data-add-btn]:hover { background:rgba(110,84,56,.1) !important; border-color:#2f5d45 !important; transform:translateY(-1px) !important; }
    [data-del-btn]:hover { background:#b91c1c !important; color:#fff !important; }
    [data-img-thumb]:hover { transform:translateY(-2px); box-shadow:0 8px 20px rgba(44,26,14,.14); }
    [data-upload-zone]:hover { border-color:#2f5d45 !important; background:rgba(110,84,56,.07) !important; }
    [data-colour-swatch]:hover { border-color:#2f5d45 !important; transform:scale(1.08) !important; }
    [data-reset-btn]:hover { border-color:#2f5d45 !important; color:#2c1a0e !important; }
    [data-copy-btn]:hover { background:#3e7a5b !important; border-color:#3e7a5b !important; transform:translateY(-2px) !important; }
    [data-gen-btn]:hover { background:rgba(110,84,56,.1) !important; border-color:#2f5d45 !important; transform:translateY(-1px) !important; }
    .upload-preview { display:flex; flex-wrap:wrap; gap:8px; margin:12px 0; }
    .upload-preview:empty { display:none; }
  </style>
</head>
<body>
<div style="min-height:100vh;display:flex;flex-direction:column;background:#faf6ee">

  <div data-loader="1" aria-hidden="true" style="position:fixed;inset:0;z-index:9999;background:rgba(250,246,238,.92);backdrop-filter:blur(8px);display:flex;align-items:center;justify-content:center;opacity:0;pointer-events:none;transition:opacity .25s ease">
    <div style="position:relative;width:132px;height:132px;display:flex;align-items:center;justify-content:center">
      <div style="position:absolute;inset:0;border-radius:50%;border:3px solid rgba(110,84,56,.18)"></div>
      <div style="position:absolute;inset:0;border-radius:50%;border:3px solid transparent;border-top-color:#2f5d45;border-right-color:rgba(110,84,56,.45);animation:gs-ring 1s linear infinite"></div>
      <img src="/images/logo-mark.png" alt="" style="width:74px;height:74px;object-fit:contain;animation:gs-pulse 1.8s ease-in-out infinite" />
    </div>
  </div>

  <nav data-topnav="1" style="display:flex;justify-content:space-between;align-items:center;padding:16px 48px;background:#fff;border-bottom:1px solid rgba(110,84,56,.2)">
    <a href="/" style="display:inline-flex;align-items:center;gap:14px;text-decoration:none;line-height:1;margin-left:-4px;font-family:'Montserrat',sans-serif;font-weight:500;font-size:1.35rem;letter-spacing:.28em">
      <img src="/images/logo-mark.png" alt="" style="height:44px;width:44px;display:block;object-fit:contain" />
      <span style="display:flex;flex-direction:column;gap:5px;padding-left:14px;border-left:1px solid rgba(110,84,56,.4)">
        <span style="color:#2f5d45;line-height:1">MYAH</span>
        <span style="font-family:'Lato',sans-serif;font-weight:700;font-size:.5rem;letter-spacing:.2em;text-transform:uppercase;color:#6e5438;line-height:1">Make Yourself At Home</span>
      </span>
    </a>
    <div style="display:flex;align-items:center;gap:22px">
      <a data-back="1" href="/dashboard" style="display:inline-flex;align-items:center;gap:9px;font-size:.78rem;color:#6b4e35;text-decoration:none;font-weight:600;letter-spacing:.1em;text-transform:uppercase;transition:gap .2s, color .2s">&larr; Dashboard</a>
      <a href={`/${profile.slug}`} target="_blank" style="font-size:.76rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:#2f5d45;text-decoration:none;transition:color .2s">View my page</a>
    </div>
  </nav>

  <main data-pad="1" style="flex:1;padding:52px 48px 140px">
    <div style="max-width:1180px;margin:0 auto">

      <div style="border-bottom:1px solid rgba(110,84,56,.3);padding-bottom:30px;margin-bottom:26px">
        <p style="font-size:.75rem;font-weight:600;letter-spacing:.2em;text-transform:uppercase;color:#6e5438;margin:0 0 16px;display:flex;align-items:center;gap:12px"><span style="width:26px;height:1px;background:#6e5438;display:block;flex-shrink:0"></span>MYAH sitter</p>
        <h1 style="font-family:'Marcellus',serif;font-size:2.5rem;color:#2c1a0e;line-height:1.15;margin:0 0 18px">Edit your <em style="color:#2f5d45;">profile</em></h1>
        <p style="color:#6b4e35;font-size:1rem;line-height:1.75;max-width:600px;margin:0">Everything here updates your public page. Make your changes, then hit &ldquo;Save changes&rdquo; at the bottom.</p>
      </div>

      {savedMsg && (
        <div id="savedBanner" style="background:#f0fdf4;border:1px solid #bbf7d0;border-radius:10px;padding:14px 18px;color:#166534;font-size:.9rem;font-weight:600;margin-bottom:28px;transition:opacity .3s">{savedMsg}</div>
      )}
      {errorMsg && (
        <div style="background:#fef2f2;border:1px solid #fecaca;border-radius:10px;padding:14px 18px;color:#b91c1c;font-size:.9rem;margin-bottom:28px">{errorMsg}</div>
      )}

      <!-- Jump links -->
      <div style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:34px">
        {['Name & bio', 'Photos', 'Reviews', 'Other profiles', 'Headings'].map(label => (
          <a data-jump-link="1" href={`#${label.toLowerCase().replace(/[^a-z]/g,'-').replace(/-+/g,'-')}`} style="font-size:.74rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#6b4e35;text-decoration:none;padding:8px 16px;border-radius:50px;background:#fff;border:1px solid rgba(110,84,56,.28);transition:background .2s, color .2s, border-color .2s">{label}</a>
        ))}
        <a data-jump-link="1" href="#preview" style="font-size:.74rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#6b4e35;text-decoration:none;padding:8px 16px;border-radius:50px;background:#fff;border:1px solid rgba(110,84,56,.28);transition:background .2s, color .2s, border-color .2s">Colours</a>
      </div>

      <div data-two-col="1" style="display:grid;grid-template-columns:minmax(0,1.55fr) minmax(0,1fr);gap:28px;align-items:start">

        <!-- LEFT COLUMN -->
        <div style="display:flex;flex-direction:column;gap:24px">

          <!-- 01: Name & bio -->
          <section id="name-bio" data-card="1" style="background:#fff;border:1px solid rgba(110,84,56,.22);border-radius:18px;padding:36px;box-shadow:0 1px 2px rgba(44,26,14,.04);transition:box-shadow .3s ease, border-color .3s ease;scroll-margin-top:24px">
            <div style="display:flex;align-items:baseline;gap:14px;margin:0 0 8px">
              <span style="font-family:'Marcellus',serif;font-size:.92rem;color:#6e5438;letter-spacing:.08em">01</span>
              <h2 style="font-family:'Marcellus',serif;font-size:1.3rem;color:#2c1a0e;margin:0">Your name &amp; bio</h2>
            </div>
            <div style="width:40px;height:2px;background:#6e5438;margin:0 0 12px"></div>
            <p style="font-size:.9rem;color:#6b4e35;line-height:1.7;margin:0 0 28px;max-width:460px">The basics &mdash; your name, one line under it, and the text pet owners read when they land on your page.</p>

            <form id="detailsForm" action="/api/profile/update" method="POST" enctype="multipart/form-data">

              <div style="margin-bottom:26px">
                <span style="display:block;font-size:.78rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#5c3d20;margin-bottom:12px">Profile type</span>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;max-width:420px">
                  <button data-type-btn="1" data-type="solo" type="button" style={`display:flex;flex-direction:column;align-items:center;justify-content:center;gap:9px;font-family:'Montserrat',sans-serif;padding:18px 12px;border-radius:14px;cursor:pointer;transition:background .25s ease, border-color .25s ease;${profile.account_type !== 'joint' ? 'background:rgba(110,84,56,.12);border:1.5px solid #2f5d45;color:#2c1a0e;' : 'background:#faf6ee;border:1.5px solid rgba(44,26,14,.14);color:#5c3d20;'}`}>
                    <span style="font-size:1.3rem;line-height:1">🧍</span>
                    <span style="font-size:.85rem;font-weight:600">Solo sitter</span>
                  </button>
                  <button data-type-btn="1" data-type="joint" type="button" style={`display:flex;flex-direction:column;align-items:center;justify-content:center;gap:9px;font-family:'Montserrat',sans-serif;padding:18px 12px;border-radius:14px;cursor:pointer;transition:background .25s ease, border-color .25s ease;${profile.account_type === 'joint' ? 'background:rgba(110,84,56,.12);border:1.5px solid #2f5d45;color:#2c1a0e;' : 'background:#faf6ee;border:1.5px solid rgba(44,26,14,.14);color:#5c3d20;'}`}>
                    <span style="font-size:1.3rem;line-height:1">🧑‍🤝‍🧑</span>
                    <span style="font-size:.85rem;font-weight:600">Joint / couple</span>
                  </button>
                </div>
                <input type="hidden" id="accountTypeField" name="account_type" value={profile.account_type ?? 'solo'} />
                <p style="font-size:.82rem;color:#6b4e35;margin:12px 0 0;line-height:1.6">Changes the default wording on your page &mdash; &ldquo;Book Us Today&rdquo; vs &ldquo;Book Me Today&rdquo;.</p>
              </div>

              <div style="margin-bottom:24px">
                <label for="nameField" style="display:block;font-size:.78rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#5c3d20;margin-bottom:10px">Your name <span style="color:#2f5d45">*</span></label>
                <input type="text" id="nameField" name="name" required value={profile.name} style="width:100%;border:1.5px solid rgba(44,26,14,.18);border-radius:10px;padding:13px 16px;font-size:.97rem;font-family:'Montserrat',sans-serif;color:#2c1a0e;background:#faf6ee;outline:none;transition:border-color .2s, box-shadow .2s" />
              </div>

              <div style="margin-bottom:24px">
                <label for="taglineField" style="display:block;font-size:.78rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#5c3d20;margin-bottom:10px">Short description</label>
                <input type="text" id="taglineField" name="tagline" value={profile.tagline ?? ''} placeholder="e.g. Experienced pet sitters based in Bath" style="width:100%;border:1.5px solid rgba(44,26,14,.18);border-radius:10px;padding:13px 16px;font-size:.97rem;font-family:'Montserrat',sans-serif;color:#2c1a0e;background:#faf6ee;outline:none;transition:border-color .2s, box-shadow .2s" />
                <p style="font-size:.82rem;color:#6b4e35;margin:8px 0 0;line-height:1.6">One line under your name on the banner.</p>
              </div>

              <div style="margin-bottom:24px">
                <label for="badgeField" style="display:block;font-size:.78rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#5c3d20;margin-bottom:10px">Highlight badge</label>
                <input type="text" id="badgeField" name="badge_text" value={profile.badge_text ?? ''} placeholder="e.g. 5★ rated on TrustedHousesitters" style="width:100%;border:1.5px solid rgba(44,26,14,.18);border-radius:10px;padding:13px 16px;font-size:.97rem;font-family:'Montserrat',sans-serif;color:#2c1a0e;background:#faf6ee;outline:none;transition:border-color .2s, box-shadow .2s" />
                <p style="font-size:.82rem;color:#6b4e35;margin:8px 0 0;line-height:1.6">A small pill on your banner photo. Leave blank to hide it.</p>
              </div>

              <div style="margin-bottom:26px">
                <label for="bioField" style="display:block;font-size:.78rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#5c3d20;margin-bottom:10px">About you</label>
                <textarea id="bioField" name="bio" rows="7" placeholder="Your experience, what you offer, and why pets settle with you." style="width:100%;border:1.5px solid rgba(44,26,14,.18);border-radius:10px;padding:13px 16px;font-size:.97rem;font-family:'Montserrat',sans-serif;color:#2c1a0e;background:#faf6ee;outline:none;resize:vertical;line-height:1.7;transition:border-color .2s, box-shadow .2s">{profile.bio ?? ''}</textarea>
                <p id="bioCount" style="font-size:.82rem;color:#6b4e35;margin:8px 0 0;line-height:1.6">{(profile.bio ?? '').length} characters</p>
              </div>

              <div style="margin-bottom:30px">
                <span style="display:block;font-size:.78rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#5c3d20;margin-bottom:12px">Profile photo</span>
                <div style="display:flex;align-items:center;gap:18px;flex-wrap:wrap">
                  {profile.profile_pic ? (
                    <img src={profile.profile_pic} alt={profile.name} style="width:74px;height:74px;border-radius:50%;object-fit:cover;border:2px solid rgba(110,84,56,.35);flex-shrink:0" />
                  ) : (
                    <div style="width:74px;height:74px;border-radius:50%;flex-shrink:0;background:#faf6ee;border:2px dashed rgba(110,84,56,.4);display:flex;align-items:center;justify-content:center;font-family:'Marcellus',serif;font-size:1.5rem;color:#6e5438">{(profile.name || '?').charAt(0)}</div>
                  )}
                  <div style="position:relative">
                    <input type="file" name="profile_pic" accept="image/*" id="picInput" style="position:absolute;inset:0;opacity:0;cursor:pointer;z-index:2;width:100%;height:100%" />
                    <button data-upload-zone="1" type="button" style="display:inline-flex;align-items:center;gap:10px;font-family:'Montserrat',sans-serif;font-size:.78rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#5c3d20;background:#faf6ee;border:1.5px dashed rgba(110,84,56,.5);border-radius:50px;padding:13px 26px;cursor:pointer;pointer-events:none;transition:background .25s ease, border-color .25s ease, color .25s ease">{profile.profile_pic ? 'Change photo' : 'Upload photo'}</button>
                  </div>
                </div>
                <p style="font-size:.82rem;color:#6b4e35;margin:12px 0 0;line-height:1.6">JPG or PNG, up to 5&nbsp;MB.</p>
              </div>

              <div style="border-top:1px solid rgba(44,26,14,.08);padding-top:26px">
                <p style="font-size:.72rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:#6b4e35;margin:0 0 20px">Where enquiries go</p>
                <div data-field-row="1" style="display:grid;grid-template-columns:1fr 1fr;gap:18px">
                  <div>
                    <label for="emailField" style="display:block;font-size:.78rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#5c3d20;margin-bottom:10px">Enquiry email <span style="color:#2f5d45">*</span></label>
                    <input type="email" id="emailField" name="contact_email" required value={profile.contact_email ?? ''} placeholder="hello@example.com" style="width:100%;border:1.5px solid rgba(44,26,14,.18);border-radius:10px;padding:13px 16px;font-size:.97rem;font-family:'Montserrat',sans-serif;color:#2c1a0e;background:#faf6ee;outline:none;transition:border-color .2s, box-shadow .2s" />
                  </div>
                  <div>
                    <label for="waField" style="display:block;font-size:.78rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#5c3d20;margin-bottom:10px">WhatsApp number</label>
                    <input type="tel" id="waField" name="whatsapp_number" value={profile.whatsapp_number ?? ''} placeholder="+447700900000" style="width:100%;border:1.5px solid rgba(44,26,14,.18);border-radius:10px;padding:13px 16px;font-size:.97rem;font-family:'Montserrat',sans-serif;color:#2c1a0e;background:#faf6ee;outline:none;transition:border-color .2s, box-shadow .2s" />
                  </div>
                </div>
                <p style="font-size:.82rem;color:#6b4e35;margin:12px 0 0;line-height:1.6">Neither is shown publicly. With a number set, a WhatsApp button appears on your page.</p>
              </div>
            </form>
          </section>

          <!-- 02: Photos -->
          <section id="photos" data-card="1" style="background:#fff;border:1px solid rgba(110,84,56,.22);border-radius:18px;padding:36px;box-shadow:0 1px 2px rgba(44,26,14,.04);transition:box-shadow .3s ease, border-color .3s ease;scroll-margin-top:24px">
            <div style="display:flex;align-items:baseline;gap:14px;margin:0 0 8px">
              <span style="font-family:'Marcellus',serif;font-size:.92rem;color:#6e5438;letter-spacing:.08em">02</span>
              <h2 style="font-family:'Marcellus',serif;font-size:1.3rem;color:#2c1a0e;margin:0">Photos</h2>
            </div>
            <div style="width:40px;height:2px;background:#6e5438;margin:0 0 24px"></div>

            {(['hero', 'about', 'gallery'] as const).map((cat, ci) => {
              const imgs = cat === 'hero' ? heroImages : cat === 'about' ? aboutImages : gallery;
              const titles = ['Banner photos', 'Photos beside your bio', 'Gallery'];
              const descs = [
                'The full-width photos at the top of your page, cycling as a slideshow. Wide landscape shots work best.',
                'A small slideshow next to your About text. You with pets, at a sit, around the house.',
                'The grid further down — pets you have looked after, places you have stayed.'
              ];
              return (
                <div style={`padding-bottom:26px;${ci < 2 ? 'margin-bottom:26px;border-bottom:1px solid rgba(44,26,14,.07);' : ''}`}>
                  <div style="display:flex;align-items:baseline;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-bottom:6px">
                    <p style="font-size:.76rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:#5c3d20;margin:0">{titles[ci]}</p>
                    <span style="font-size:.78rem;color:#6b4e35">{imgs.length} photo{imgs.length !== 1 ? 's' : ''}</span>
                  </div>
                  <p style="font-size:.86rem;color:#6b4e35;line-height:1.65;margin:0 0 16px;max-width:480px">{descs[ci]}</p>
                  <div style="display:flex;flex-wrap:wrap;gap:12px">
                    {imgs.map((img: any, i: number) => (
                      <div data-img-thumb="1" style="position:relative;width:118px;height:88px;border-radius:10px;overflow:hidden;border:1px solid rgba(110,84,56,.25);transition:transform .2s ease, box-shadow .2s ease">
                        <img src={img.src} alt="" style="width:100%;height:100%;object-fit:cover;display:block" />
                        {cat === 'hero' && i === 0 && <span style="position:absolute;left:6px;bottom:6px;font-size:.58rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#fff;background:rgba(44,26,14,.62);padding:3px 9px;border-radius:50px">Cover</span>}
                        <form action="/api/profile/images" method="POST" style="display:contents">
                          <input type="hidden" name="_action" value="delete" />
                          <input type="hidden" name="category" value={cat} />
                          <input type="hidden" name="index" value={String(i)} />
                          <button data-del-btn="1" type="submit" title="Remove photo" style="position:absolute;top:6px;right:6px;width:23px;height:23px;border-radius:50%;background:rgba(44,26,14,.6);color:#fff;border:none;font-size:14px;line-height:1;cursor:pointer;display:flex;align-items:center;justify-content:center;padding:0;transition:background .2s ease">&times;</button>
                        </form>
                      </div>
                    ))}
                    <label style="width:118px;height:88px;border-radius:10px;border:1.5px dashed rgba(110,84,56,.5);background:#faf6ee;color:#2f5d45;font-family:'Montserrat',sans-serif;font-size:.74rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:background .25s ease, border-color .25s ease;position:relative">
                      + Add
                      <input type="file" data-upload-cat={cat} accept="image/*" multiple style="position:absolute;inset:0;opacity:0;cursor:pointer;z-index:2;width:100%;height:100%" />
                    </label>
                  </div>
                  <div class="upload-preview" data-preview-for={cat}></div>
                </div>
              );
            })}
          </section>

          <!-- 03: Reviews -->
          <section id="reviews" data-card="1" style="background:#fff;border:1px solid rgba(110,84,56,.22);border-radius:18px;padding:36px;box-shadow:0 1px 2px rgba(44,26,14,.04);transition:box-shadow .3s ease, border-color .3s ease;scroll-margin-top:24px">
            <div style="display:flex;align-items:baseline;gap:14px;margin:0 0 8px">
              <span style="font-family:'Marcellus',serif;font-size:.92rem;color:#6e5438;letter-spacing:.08em">03</span>
              <h2 style="font-family:'Marcellus',serif;font-size:1.3rem;color:#2c1a0e;margin:0">Reviews</h2>
            </div>
            <div style="width:40px;height:2px;background:#6e5438;margin:0 0 12px"></div>
            <p style="font-size:.9rem;color:#6b4e35;line-height:1.7;margin:0 0 24px;max-width:500px">Reviews are written by the pet owners themselves. Generate a link, send it to them, and their words land straight on your page.</p>

            {reviews.length > 0 && (
              <div style="display:flex;flex-direction:column;gap:14px;margin-bottom:26px">
                {reviews.map((r: any, i: number) => (
                  <div style="display:flex;gap:18px;align-items:flex-start;background:#faf6ee;border:1px solid rgba(110,84,56,.2);border-radius:14px;padding:20px 22px">
                    <div style="flex:1;min-width:0">
                      <p style="font-size:.94rem;color:#2c1a0e;line-height:1.7;font-style:italic;margin:0 0 8px">&ldquo;{r.text}&rdquo;</p>
                      <p style="font-size:.8rem;color:#2f5d45;font-weight:600;margin:0">&mdash; {r.name}</p>
                    </div>
                    <form action="/api/profile/reviews" method="POST" style="display:contents">
                      <input type="hidden" name="_action" value="delete" />
                      <input type="hidden" name="index" value={String(i)} />
                      <button data-del-btn="1" type="submit" title="Remove review" style="width:26px;height:26px;border-radius:50%;background:rgba(44,26,14,.08);color:#6b4e35;border:none;font-size:15px;line-height:1;cursor:pointer;display:flex;align-items:center;justify-content:center;flex-shrink:0;padding:0;transition:background .2s ease, color .2s ease">&times;</button>
                    </form>
                  </div>
                ))}
              </div>
            )}

            <div style="background:#faf6ee;border:1px dashed rgba(110,84,56,.45);border-radius:14px;padding:24px 26px">
              <p style="font-size:.76rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:#5c3d20;margin:0 0 14px">Request a review</p>
              {newToken && (
                <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:16px">
                  <input readonly type="text" id="reviewUrlInput" value={`https://myahsits.com/review/${newToken}`} style="flex:1;min-width:0;border:1.5px solid rgba(110,84,56,.35);border-radius:10px;padding:12px 14px;font-size:.86rem;font-family:'Montserrat',sans-serif;color:#5c3d20;background:#fff;outline:none" />
                  <button data-copy-btn="1" type="button" id="copyReviewBtn" style="font-family:'Montserrat',sans-serif;font-size:.78rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#fff;background:#2f5d45;border:1.5px solid #2f5d45;border-radius:50px;box-shadow:0 6px 20px rgba(110,84,56,.28);padding:13px 28px;cursor:pointer;white-space:nowrap;transition:background .25s ease, border-color .25s ease, transform .15s ease">Copy</button>
                </div>
              )}
              <form action="/api/profile/review-request" method="POST">
                <button data-gen-btn="1" type="submit" style="display:inline-flex;align-items:center;gap:9px;font-family:'Montserrat',sans-serif;font-size:.76rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#2f5d45;background:#fff;border:1.5px solid rgba(110,84,56,.45);border-radius:50px;padding:12px 26px;cursor:pointer;transition:background .25s ease, border-color .25s ease, transform .15s ease">Generate review link</button>
              </form>
            </div>

            {reviewRequests.filter((r: any) => r.status === 'pending').length > 0 && (
              <div style="margin-top:24px">
                <p style="font-size:.74rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:#5c3d20;margin:0 0 12px">Pending review links</p>
                <div style="display:flex;flex-direction:column;gap:10px">
                  {reviewRequests.filter((r: any) => r.status === 'pending').map((req: any) => (
                    <div style="display:flex;align-items:center;gap:14px;background:#faf6ee;border:1px solid rgba(110,84,56,.2);border-radius:12px;padding:14px 18px">
                      <div style="flex:1;min-width:0">
                        <p style="font-size:.84rem;color:#5c3d20;font-weight:600;margin:0 0 3px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">myahsits.com/review/{req.token}</p>
                        <p style="font-size:.76rem;color:#6b4e35;margin:0">Created {new Date(req.created_at).toLocaleDateString('en-GB', { day:'numeric', month:'short', year:'numeric' })}</p>
                      </div>
                      <button type="button" data-copy-url={`https://myahsits.com/review/${req.token}`} style="font-size:.72rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#2f5d45;background:#fff;border:1px solid rgba(110,84,56,.35);border-radius:50px;padding:8px 18px;cursor:pointer;white-space:nowrap;font-family:'Montserrat',sans-serif;transition:background .2s, border-color .2s" onclick="navigator.clipboard.writeText(this.dataset.copyUrl);this.textContent='Copied!';setTimeout(()=>this.textContent='Copy',2000)">Copy</button>
                    </div>
                  ))}
                </div>
              </div>
            )}
          </section>

          <!-- 04: Other profiles -->
          <section id="other-profiles" data-card="1" style="background:#fff;border:1px solid rgba(110,84,56,.22);border-radius:18px;padding:36px;box-shadow:0 1px 2px rgba(44,26,14,.04);transition:box-shadow .3s ease, border-color .3s ease;scroll-margin-top:24px">
            <div style="display:flex;align-items:baseline;gap:14px;margin:0 0 8px">
              <span style="font-family:'Marcellus',serif;font-size:.92rem;color:#6e5438;letter-spacing:.08em">04</span>
              <h2 style="font-family:'Marcellus',serif;font-size:1.3rem;color:#2c1a0e;margin:0">Your other profiles</h2>
            </div>
            <div style="width:40px;height:2px;background:#6e5438;margin:0 0 12px"></div>
            <p style="font-size:.9rem;color:#6b4e35;line-height:1.7;margin:0 0 24px;max-width:500px">Sitting sites, socials, anywhere else owners can check you out. These show as cards near the bottom of your page.</p>

            {platforms.length > 0 && (
              <div style="display:flex;flex-direction:column;gap:12px;margin-bottom:24px">
                {platforms.map((plat: any, i: number) => (
                  <div style="display:flex;align-items:center;gap:16px;background:#faf6ee;border:1px solid rgba(110,84,56,.2);border-radius:14px;padding:16px 20px">
                    <span style="width:38px;height:38px;border-radius:50%;background:#2f5d45;color:#fff;font-family:'Marcellus',serif;font-size:1.05rem;display:flex;align-items:center;justify-content:center;flex-shrink:0">{plat.name.charAt(0).toUpperCase()}</span>
                    <div style="flex:1;min-width:0">
                      <p style="font-size:.95rem;font-weight:700;color:#2c1a0e;margin:0 0 3px">{plat.name}</p>
                      <p style="font-size:.82rem;color:#6b4e35;margin:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{plat.url}</p>
                    </div>
                    <form action="/api/profile/platforms" method="POST" style="display:contents">
                      <input type="hidden" name="_action" value="delete" />
                      <input type="hidden" name="index" value={String(i)} />
                      <button data-del-btn="1" type="submit" title="Remove link" style="width:26px;height:26px;border-radius:50%;background:rgba(44,26,14,.08);color:#6b4e35;border:none;font-size:15px;line-height:1;cursor:pointer;display:flex;align-items:center;justify-content:center;flex-shrink:0;padding:0;transition:background .2s ease, color .2s ease">&times;</button>
                    </form>
                  </div>
                ))}
              </div>
            )}

            <form action="/api/profile/platforms" method="POST">
              <input type="hidden" name="_action" value="add" />
              <div data-field-row="1" style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:18px">
                <input type="text" name="name" placeholder="Site name — e.g. Instagram" style="width:100%;border:1.5px solid rgba(44,26,14,.18);border-radius:10px;padding:13px 16px;font-size:.95rem;font-family:'Montserrat',sans-serif;color:#2c1a0e;background:#faf6ee;outline:none;transition:border-color .2s, box-shadow .2s" />
                <input type="url" name="url" placeholder="https://instagram.com/yourname" style="width:100%;border:1.5px solid rgba(44,26,14,.18);border-radius:10px;padding:13px 16px;font-size:.95rem;font-family:'Montserrat',sans-serif;color:#2c1a0e;background:#faf6ee;outline:none;transition:border-color .2s, box-shadow .2s" />
              </div>
              <button data-add-btn="1" type="submit" style="font-family:'Montserrat',sans-serif;font-size:.76rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#2f5d45;background:#fff;border:1.5px solid rgba(110,84,56,.45);border-radius:50px;padding:12px 26px;cursor:pointer;transition:background .25s ease, border-color .25s ease, transform .15s ease">Add site</button>
            </form>
          </section>

          <!-- 05: Headings -->
          <section id="headings" data-card="1" style="background:#fff;border:1px solid rgba(110,84,56,.22);border-radius:18px;padding:36px;box-shadow:0 1px 2px rgba(44,26,14,.04);transition:box-shadow .3s ease, border-color .3s ease;scroll-margin-top:24px">
            <div style="display:flex;align-items:baseline;gap:14px;margin:0 0 8px">
              <span style="font-family:'Marcellus',serif;font-size:.92rem;color:#6e5438;letter-spacing:.08em">05</span>
              <h2 style="font-family:'Marcellus',serif;font-size:1.3rem;color:#2c1a0e;margin:0">Section headings</h2>
            </div>
            <div style="width:40px;height:2px;background:#6e5438;margin:0 0 12px"></div>
            <p style="font-size:.9rem;color:#6b4e35;line-height:1.7;margin:0 0 26px;max-width:500px">Every section has a small label and a big title. Leave anything blank to keep the wording shown.</p>

            <form id="headingsForm" action="/api/profile/headings" method="POST">
              <div style="display:flex;flex-direction:column;gap:26px">
                {[
                  { title:'About section', where:'Your bio text and photos.', labelName:'about_label', labelPh: profile.account_type === 'joint' ? 'Who We Are' : 'Who I Am', titleName:'about_title', titlePh:'A home away from home — for you and your pets.' },
                  { title:'Reviews section', where:'Your review cards.', labelName:'reviews_label', labelPh:'What Pet Owners Say', titleName:'reviews_title', titlePh:'Leave blank to show your review count' },
                  { title:'Gallery section', where:'The photo grid.', labelName:'gallery_label', labelPh: profile.account_type === 'joint' ? "Pets We've Loved" : "Pets I've Loved", titleName:'gallery_title', titlePh: profile.account_type === 'joint' ? 'Our Sits' : 'My Sits' },
                  { title:'Contact section', where:'The enquiry form at the bottom.', labelName:'enquiry_label', labelPh:'Get In Touch', titleName:'enquiry_title', titlePh:`Book ${profile.name}` },
                ].map(hg => (
                  <div>
                    <p style="font-size:.76rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:#5c3d20;margin:0 0 4px">{hg.title}</p>
                    <p style="font-size:.84rem;color:#6b4e35;line-height:1.6;margin:0 0 14px">{hg.where}</p>
                    <div data-field-row="1" style="display:grid;grid-template-columns:1fr 1.4fr;gap:16px">
                      <input type="text" name={hg.labelName} value={h[hg.labelName] ?? ''} placeholder={hg.labelPh} style="width:100%;border:1.5px solid rgba(44,26,14,.18);border-radius:10px;padding:12px 15px;font-size:.93rem;font-family:'Montserrat',sans-serif;color:#2c1a0e;background:#faf6ee;outline:none;transition:border-color .2s, box-shadow .2s" />
                      <input type="text" name={hg.titleName} value={h[hg.titleName] ?? ''} placeholder={hg.titlePh} style="width:100%;border:1.5px solid rgba(44,26,14,.18);border-radius:10px;padding:12px 15px;font-size:.93rem;font-family:'Montserrat',sans-serif;color:#2c1a0e;background:#faf6ee;outline:none;transition:border-color .2s, box-shadow .2s" />
                    </div>
                  </div>
                ))}
              </div>
            </form>
          </section>

          <div style="display:flex;align-items:center;gap:24px;flex-wrap:wrap;padding-bottom:40px">
            <button data-save-btn="1" id="saveAllBtn" type="button" style="display:inline-flex;align-items:center;justify-content:center;gap:8px;font-size:.82rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#fff;background:#2f5d45;border:1.5px solid #2f5d45;border-radius:50px;box-shadow:0 6px 20px rgba(110,84,56,.28);padding:16px 36px;cursor:pointer;font-family:'Montserrat',sans-serif;white-space:nowrap;transition:background .25s ease, border-color .25s ease, transform .15s ease">Save changes</button>
            <a href="/dashboard" style="font-size:.8rem;color:#6b4e35;text-decoration:none;letter-spacing:.1em;text-transform:uppercase;font-weight:600;transition:color .2s">Back to dashboard</a>
          </div>
        </div>

        <!-- RIGHT ASIDE -->
        <aside data-aside="1" id="preview" style="position:sticky;top:28px;display:flex;flex-direction:column;gap:18px">
          <!-- Page preview -->
          <div style="background:#fff;border:1px solid rgba(110,84,56,.22);border-radius:18px;overflow:hidden;box-shadow:0 1px 2px rgba(44,26,14,.04)">
            <div style="padding:18px 22px;border-bottom:1px solid rgba(110,84,56,.2);display:flex;align-items:center;justify-content:space-between;gap:12px">
              <p style="font-size:.7rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:#6e5438;margin:0">Page preview</p>
              <a href={`/${profile.slug}`} target="_blank" style="display:inline-flex;align-items:center;gap:7px;font-size:.7rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#2f5d45;text-decoration:none;transition:gap .2s, color .2s">Open &rarr;</a>
            </div>
            <div style="display:flex;align-items:center;gap:10px;padding:9px 14px;background:#faf6ee;border-bottom:1px solid rgba(110,84,56,.18)">
              <span style="display:flex;gap:5px;flex-shrink:0">
                <span style="width:8px;height:8px;border-radius:50%;background:rgba(44,26,14,.16);display:block"></span>
                <span style="width:8px;height:8px;border-radius:50%;background:rgba(44,26,14,.16);display:block"></span>
                <span style="width:8px;height:8px;border-radius:50%;background:rgba(44,26,14,.16);display:block"></span>
              </span>
              <span style="flex:1;min-width:0;font-size:.7rem;color:#6b4e35;background:#fff;border:1px solid rgba(44,26,14,.08);border-radius:50px;padding:5px 12px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">myahsits.com/{profile.slug}</span>
            </div>
            <div id="pvBody" style={`background:${t.background || '#faf6ee'};transition:background .3s ease`}>
              <div style="position:relative;height:186px;overflow:hidden">
                {heroImages.length > 0 ? (
                  <img src={heroImages[0].src} alt="" style="width:100%;height:100%;object-fit:cover;display:block" />
                ) : (
                  <div style="width:100%;height:100%;background:linear-gradient(135deg,#2c1a0e 0%,#4a3525 100%)"></div>
                )}
                <div style="position:absolute;inset:0;background:rgba(44,26,14,.52)"></div>
                <div style="position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:16px;gap:6px">
                  {profile.badge_text && <span style="font-size:.55rem;background:rgba(255,255,255,.18);color:#fff;padding:4px 11px;border-radius:50px;font-weight:700;letter-spacing:.07em">{profile.badge_text}</span>}
                  <p style="font-family:'Montserrat',sans-serif;font-weight:500;letter-spacing:.28em;font-size:1.35rem;color:#fff;line-height:1;margin:4px 0 0">MYAH</p>
                  <p style="font-size:.72rem;color:rgba(255,255,255,.9);font-weight:600;letter-spacing:.08em;margin:0">{profile.name}</p>
                  <span id="pvBtn" style={`display:inline-block;margin-top:6px;background:${t.accent || '#2f5d45'};color:#fff;font-size:.55rem;font-weight:600;padding:6px 15px;border-radius:6px;letter-spacing:.07em;text-transform:uppercase`}>{profile.account_type === 'joint' ? 'Book Us Today' : 'Book Me Today'}</span>
                </div>
              </div>
              <div style="padding:18px 20px">
                <p style={`font-size:.58rem;font-weight:600;letter-spacing:.13em;text-transform:uppercase;margin:0 0 9px;color:${t.accent || '#2f5d45'}`}>{h.about_label || (profile.account_type === 'joint' ? 'Who We Are' : 'Who I Am')}</p>
                <div style="display:flex;gap:12px;align-items:flex-start">
                  {aboutImages.length > 0 && <img src={aboutImages[0].src} alt="" style="width:62px;height:62px;border-radius:10px;object-fit:cover;flex-shrink:0" />}
                  <p style={`font-size:.66rem;line-height:1.65;margin:0;color:${t.text_soft || '#6b4e35'}`}>{profile.bio ? (profile.bio.length > 130 ? profile.bio.slice(0, 130) + '…' : profile.bio) : 'No bio yet'}</p>
                </div>
              </div>
              {reviews.length > 0 && (
                <div style="padding:0 20px 18px">
                  <p style={`font-size:.58rem;font-weight:600;letter-spacing:.13em;text-transform:uppercase;margin:0 0 9px;color:${t.accent || '#2f5d45'}`}>What Pet Owners Say</p>
                  <div style="display:flex;gap:8px">
                    {reviews.slice(0, 2).map((r: any) => (
                      <div style={`flex:1;min-width:0;border-radius:8px;padding:10px;background:rgba(255,255,255,.55);border:1px solid rgba(44,26,14,.12)`}>
                        <span style={`display:block;margin-bottom:4px;font-size:.5rem;color:${t.accent || '#2f5d45'}`}>★★★★★</span>
                        <p style={`font-size:.58rem;line-height:1.5;font-style:italic;margin:0 0 5px;color:${t.text_soft || '#6b4e35'}`}>&ldquo;{r.text.length > 52 ? r.text.slice(0, 52) + '…' : r.text}&rdquo;</p>
                        <span style={`font-size:.52rem;font-weight:700;color:${t.accent || '#2f5d45'}`}>&mdash; {r.name.split(',')[0]}</span>
                      </div>
                    ))}
                  </div>
                </div>
              )}
              {gallery.length > 0 && (
                <div style="padding:0 20px 18px">
                  <p style={`font-size:.58rem;font-weight:600;letter-spacing:.13em;text-transform:uppercase;margin:0 0 9px;color:${t.accent || '#2f5d45'}`}>{h.gallery_label || (profile.account_type === 'joint' ? "Pets We've Loved" : "Pets I've Loved")}</p>
                  <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:4px">
                    {gallery.slice(0, 8).map((img: any) => (
                      <div style="aspect-ratio:1;border-radius:4px;overflow:hidden"><img src={img.src} alt="" style="width:100%;height:100%;object-fit:cover;display:block" /></div>
                    ))}
                  </div>
                </div>
              )}
              <div style="padding:0 20px 20px">
                <p style={`font-size:.58rem;font-weight:600;letter-spacing:.13em;text-transform:uppercase;margin:0 0 9px;color:${t.accent || '#2f5d45'}`}>Get In Touch</p>
                <div style="display:flex;flex-direction:column;gap:5px;max-width:210px">
                  <div style="height:17px;background:rgba(44,26,14,.05);border:1px solid rgba(44,26,14,.09);border-radius:3px"></div>
                  <div style="height:17px;background:rgba(44,26,14,.05);border:1px solid rgba(44,26,14,.09);border-radius:3px"></div>
                  <div style="height:30px;background:rgba(44,26,14,.05);border:1px solid rgba(44,26,14,.09);border-radius:3px"></div>
                  <div style={`text-align:center;padding:6px;border-radius:4px;font-size:.52rem;font-weight:700;color:#fff;background:${t.accent || '#2f5d45'}`}>Send Enquiry</div>
                </div>
              </div>
              <div style={`padding:12px 20px;display:flex;justify-content:space-between;align-items:center;background:${t.text || '#2c1a0e'}`}>
                <p style="font-family:'Montserrat',sans-serif;font-weight:500;letter-spacing:.24em;font-size:.68rem;margin:0;color:rgba(255,255,255,.75)">MYAH</p>
                <span style="font-size:.6rem;color:rgba(255,255,255,.45)">{profile.name}</span>
              </div>
            </div>

            <!-- Colour swatches -->
            <div style="padding:18px 20px 20px;background:#fff;border-top:1px solid rgba(110,84,56,.2)">
              <form id="coloursForm" action="/api/profile/theme" method="POST">
                <div style="display:flex;gap:14px;flex-wrap:wrap;justify-content:center;margin-bottom:14px">
                  {[
                    { name:'background', label:'Background', val: t.background || '#faf6ee' },
                    { name:'accent', label:'Accent', val: t.accent || '#2f5d45' },
                    { name:'accent_light', label:'Highlight', val: t.accent_light || '#3a7356' },
                    { name:'text', label:'Text', val: t.text || '#2c1a0e' },
                    { name:'text_soft', label:'Soft text', val: t.text_soft || '#6b4e35' },
                  ].map(sw => (
                    <label style="display:flex;flex-direction:column;align-items:center;gap:6px;cursor:pointer">
                      <input data-colour-swatch="1" type="color" name={sw.name} value={sw.val} style="width:38px;height:38px;border:2px solid rgba(44,26,14,.15);border-radius:50%;cursor:pointer;background:#faf6ee;transition:border-color .2s, transform .15s" />
                      <span style="font-size:.64rem;font-weight:600;color:#6b4e35;letter-spacing:.03em">{sw.label}</span>
                    </label>
                  ))}
                </div>
                <div style="display:flex;justify-content:center">
                  <button data-reset-btn="1" id="resetColoursBtn" type="button" style="font-family:'Montserrat',sans-serif;font-size:.72rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#6b4e35;background:none;border:1.5px solid rgba(44,26,14,.15);border-radius:50px;padding:9px 22px;cursor:pointer;transition:border-color .2s, color .2s">Reset colours</button>
                </div>
              </form>
            </div>
          </div>

          <!-- Profile strength -->
          <div style="background:#faf6ee;border:1px solid rgba(110,84,56,.28);border-radius:18px;padding:22px 24px">
            <p style="font-size:.7rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:#6e5438;margin:0 0 14px">Profile strength</p>
            <div style="height:7px;border-radius:50px;background:rgba(44,26,14,.08);overflow:hidden;margin-bottom:12px">
              <div style={`height:100%;width:${strengthPct}%;border-radius:50px;background:linear-gradient(90deg,#2f5d45,#c4ab8a);transition:width .4s ease`}></div>
            </div>
            <p style="font-size:.86rem;color:#6b4e35;line-height:1.65;margin:0">
              {strengthPct === 100
                ? 'Everything is filled in. Owners see a complete page — that is the version that gets replies.'
                : `${strengthPct}% complete. ${gallery.length < 4 ? 'A fuller gallery is the quickest win.' : reviews.length < 2 ? 'One more review would round it out.' : 'Add a little more to each section.'}`}
            </p>
          </div>
        </aside>
      </div>
    </div>
  </main>

  <!-- Floating save bar -->
  <div data-save-bar="1" id="saveBar" style="position:fixed;left:0;right:0;bottom:0;z-index:40;padding:16px 48px;background:rgba(255,255,255,.96);backdrop-filter:blur(10px);border-top:1px solid rgba(110,84,56,.28);box-shadow:0 -6px 24px rgba(44,26,14,.06);transform:translateY(100%);opacity:0;pointer-events:none;transition:transform .3s ease, opacity .3s ease">
    <div style="max-width:1180px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap">
      <p style="font-size:.88rem;color:#6b4e35;margin:0;line-height:1.5">Unsaved changes — your public page still shows the old version.</p>
      <button data-save-btn="1" id="saveBarBtn" type="button" style="font-family:'Montserrat',sans-serif;font-size:.82rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#fff;background:#2f5d45;border:1.5px solid #2f5d45;border-radius:50px;padding:16px 36px;cursor:pointer;white-space:nowrap;box-shadow:0 6px 20px rgba(110,84,56,.28);transition:background .25s ease, border-color .25s ease, transform .15s ease">Save changes</button>
    </div>
  </div>
</div>

<script>
  // Loading overlay
  const loader = document.querySelector('[data-loader]') as HTMLElement | null;
  function showLoader() {
    if (!loader) return;
    loader.style.opacity = '1';
    loader.style.pointerEvents = 'all';
  }
  document.querySelectorAll('a[href]').forEach(a => {
    const href = a.getAttribute('href') || '';
    if (href.startsWith('#') || href.startsWith('http') || href.startsWith('mailto') || href.startsWith('tel')) return;
    a.addEventListener('click', (e) => {
      if ((e as MouseEvent).metaKey || (e as MouseEvent).ctrlKey || (e as MouseEvent).shiftKey) return;
      showLoader();
    });
  });
  window.addEventListener('pageshow', e => {
    if (e.persisted && loader) { loader.style.opacity = '0'; loader.style.pointerEvents = 'none'; }
  });

  // Dismiss saved banner
  const savedBanner = document.getElementById('savedBanner');
  if (savedBanner) setTimeout(() => { savedBanner.style.opacity = '0'; setTimeout(() => savedBanner.remove(), 300); }, 3000);

  // Type picker
  document.querySelectorAll('[data-type-btn]').forEach(btn => {
    btn.addEventListener('click', () => {
      const type = (btn as HTMLElement).dataset.typeBt || (btn as HTMLElement).getAttribute('data-type') || '';
      document.querySelectorAll('[data-type-btn]').forEach(b => {
        const on = b === btn;
        (b as HTMLElement).style.background = on ? 'rgba(110,84,56,.12)' : '#faf6ee';
        (b as HTMLElement).style.borderColor = on ? '#2f5d45' : 'rgba(44,26,14,.14)';
        (b as HTMLElement).style.color = on ? '#2c1a0e' : '#5c3d20';
      });
      (document.getElementById('accountTypeField') as HTMLInputElement).value = type;
      markDirty();
    });
  });

  // Bio character count
  const bioField = document.getElementById('bioField') as HTMLTextAreaElement | null;
  const bioCount = document.getElementById('bioCount');
  bioField?.addEventListener('input', () => {
    if (bioCount) bioCount.textContent = bioField.value.length + ' characters';
    markDirty();
  });
  ['nameField','taglineField','badgeField','emailField','waField'].forEach(id => {
    document.getElementById(id)?.addEventListener('input', markDirty);
  });

  // Save bar
  const saveBar = document.getElementById('saveBar') as HTMLElement | null;
  let isDirty = false;
  function markDirty() {
    if (!isDirty) {
      isDirty = true;
      if (saveBar) { saveBar.style.transform = 'translateY(0)'; saveBar.style.opacity = '1'; saveBar.style.pointerEvents = 'auto'; }
    }
  }

  // Colour preview
  const pvBody = document.getElementById('pvBody');
  const pvBtn = document.getElementById('pvBtn');
  const colourVarMap: Record<string, string> = {
    background: 'background', accent: 'accent', text: 'text', text_soft: 'text_soft', accent_light: 'accent_light'
  };
  document.querySelectorAll<HTMLInputElement>('#coloursForm input[type="color"]').forEach(picker => {
    picker.addEventListener('input', () => {
      markDirty();
      if (picker.name === 'background' && pvBody) pvBody.style.background = picker.value;
      if (picker.name === 'accent' && pvBtn) pvBtn.style.background = picker.value;
    });
  });

  // Reset colours
  document.getElementById('resetColoursBtn')?.addEventListener('click', () => {
    const defaults: Record<string, string> = {
      background: '#faf6ee', accent: '#2f5d45', accent_light: '#3a7356',
      text: '#2c1a0e', text_soft: '#6b4e35'
    };
    document.querySelectorAll<HTMLInputElement>('#coloursForm input[type="color"]').forEach(p => {
      p.value = defaults[p.name] || p.value;
      p.dispatchEvent(new Event('input'));
    });
    markDirty();
  });

  // Copy review URL
  const copyReviewBtn = document.getElementById('copyReviewBtn');
  const reviewUrlInput = document.getElementById('reviewUrlInput') as HTMLInputElement | null;
  copyReviewBtn?.addEventListener('click', () => {
    navigator.clipboard?.writeText(reviewUrlInput?.value ?? '').then(() => {
      copyReviewBtn.textContent = 'Copied!';
      setTimeout(() => { copyReviewBtn.textContent = 'Copy'; }, 2000);
    });
  });

  // Image upload previews
  function compressImage(file: File, maxW: number, maxH: number, q: number): Promise<File> {
    return new Promise(resolve => {
      const img = new Image();
      img.onload = () => {
        let { width, height } = img;
        if (width > maxW || height > maxH) {
          const ratio = Math.min(maxW/width, maxH/height);
          width = Math.round(width * ratio);
          height = Math.round(height * ratio);
        }
        const canvas = document.createElement('canvas');
        canvas.width = width; canvas.height = height;
        const ctx = canvas.getContext('2d');
        if (!ctx) { resolve(file); return; }
        ctx.drawImage(img, 0, 0, width, height);
        canvas.toBlob(blob => {
          if (!blob) { resolve(file); return; }
          resolve(new File([blob], file.name.replace(/\.[^.]+$/, '.jpg'), { type:'image/jpeg' }));
        }, 'image/jpeg', q);
      };
      img.onerror = () => resolve(file);
      img.src = URL.createObjectURL(file);
    });
  }

  const uploadQueues = new Map<string, File[]>();
  document.querySelectorAll<HTMLInputElement>('input[data-upload-cat]').forEach(input => {
    input.addEventListener('change', async () => {
      const cat = input.dataset.uploadCat!;
      if (!input.files || !input.files.length) return;
      const files = Array.from(input.files);
      input.value = '';
      const existing = uploadQueues.get(cat) ?? [];
      existing.push(...files);
      uploadQueues.set(cat, existing);
      markDirty();

      const previewEl = document.querySelector<HTMLElement>(`[data-preview-for="${cat}"]`);
      if (previewEl) {
        previewEl.innerHTML = '';
        for (const f of existing) {
          const thumb = document.createElement('div');
          thumb.style.cssText = 'position:relative;width:80px;height:60px;border-radius:6px;overflow:hidden;border:2px solid rgba(47,93,69,.3);flex-shrink:0';
          const img = document.createElement('img');
          img.src = URL.createObjectURL(f);
          img.style.cssText = 'width:100%;height:100%;object-fit:cover;display:block';
          thumb.appendChild(img);
          previewEl.appendChild(thumb);
        }
      }
    });
  });

  // Save all
  async function saveAll() {
    const btn1 = document.getElementById('saveAllBtn') as HTMLButtonElement | null;
    const btn2 = document.getElementById('saveBarBtn') as HTMLButtonElement | null;
    [btn1, btn2].forEach(b => { if (b) { b.disabled = true; b.textContent = 'Saving…'; } });
    const errors: string[] = [];

    try {
      // Details
      const detailsForm = document.getElementById('detailsForm') as HTMLFormElement;
      if (detailsForm) {
        const fd = new FormData(detailsForm);
        const picInput = document.getElementById('picInput') as HTMLInputElement | null;
        if (picInput?.files?.[0]) {
          const compressed = await compressImage(picInput.files[0], 1200, 1200, 0.85);
          fd.set('profile_pic', compressed, compressed.name);
        }
        const r = await fetch('/api/profile/update', { method:'POST', body:fd });
        if (r.url.includes('error=')) errors.push('Failed to save details.');
      }

      // Photos
      for (const [cat, files] of uploadQueues.entries()) {
        if (!files.length) continue;
        [btn1, btn2].forEach(b => { if (b) b.textContent = `Uploading ${cat} photos…`; });
        const maxDim = cat === 'hero' ? 1600 : 1000;
        const photoFd = new FormData();
        photoFd.set('_action', 'upload');
        photoFd.set('category', cat);
        const compressed = await Promise.all(files.map(f => compressImage(f, maxDim, maxDim, 0.82)));
        for (const file of compressed) photoFd.append('files', file, file.name);
        const r = await fetch('/api/profile/images', { method:'POST', body:photoFd });
        if (r.url.includes('error=')) errors.push(`Failed to upload ${cat} photos.`);
      }

      // Headings
      const headingsForm = document.getElementById('headingsForm') as HTMLFormElement | null;
      if (headingsForm) {
        [btn1, btn2].forEach(b => { if (b) b.textContent = 'Saving headings…'; });
        const r = await fetch('/api/profile/headings', { method:'POST', body:new FormData(headingsForm) });
        if (r.url.includes('error=')) errors.push('Failed to save headings.');
      }

      // Colours
      const coloursForm = document.getElementById('coloursForm') as HTMLFormElement | null;
      if (coloursForm) {
        [btn1, btn2].forEach(b => { if (b) b.textContent = 'Saving colours…'; });
        const r = await fetch('/api/profile/theme', { method:'POST', body:new FormData(coloursForm) });
        if (r.url.includes('error=')) errors.push('Failed to save colours.');
      }

      if (errors.length > 0) {
        alert(errors.join('\n'));
        [btn1, btn2].forEach(b => { if (b) { b.disabled = false; b.textContent = 'Save changes'; } });
      } else {
        window.location.href = '/profile/edit?saved=1';
      }
    } catch {
      [btn1, btn2].forEach(b => { if (b) { b.disabled = false; b.textContent = 'Save changes'; } });
      alert('Something went wrong. Please try again.');
    }
  }

  document.getElementById('saveAllBtn')?.addEventListener('click', saveAll);
  document.getElementById('saveBarBtn')?.addEventListener('click', saveAll);
</script>
</body>
</html>
