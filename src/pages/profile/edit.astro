---
export const prerender = false;

import '../../styles/global.css';
import { getSession } from '../../lib/auth';
import { supabase } from '../../lib/supabase';

const session = await getSession(Astro.request);
if (!session) return Astro.redirect('/login');

const { data: profile } = await supabase
  .from('profiles')
  .select('*')
  .eq('user_id', session.userId)
  .single();

if (!profile) return Astro.redirect('/profile/create');

const heroImages: any[] = Array.isArray(profile.hero_images_json) ? profile.hero_images_json : [];
const aboutImages: any[] = Array.isArray(profile.about_images_json) ? profile.about_images_json : [];
const gallery: any[] = Array.isArray(profile.gallery_json) ? profile.gallery_json : [];
const reviews: any[] = Array.isArray(profile.reviews_json) ? profile.reviews_json : [];
const platforms: any[] = Array.isArray(profile.platforms_json) ? profile.platforms_json : [];

const reviewRequests: any[] = Array.isArray(profile.review_requests_json) ? profile.review_requests_json : [];
const h = (profile.headings_json ?? {}) as Record<string, string>;
const t = (profile.theme_json ?? {}) as Record<string, string>;

const saved = Astro.url.searchParams.get('saved');
const newToken = Astro.url.searchParams.get('new_token') ?? '';
const errorKey = Astro.url.searchParams.get('error') ?? '';
const detail = Astro.url.searchParams.get('detail');
const errorMap: Record<string, string> = {
  missing:        'Please fill in the required fields.',
  file_too_large: 'Image must be under 5 MB.',
  upload:         `Upload error: ${detail ?? 'unknown'}`,
  server:         'Something went wrong. Please try again.',
};
const errorMsg = errorMap[errorKey] ?? '';
const savedMsg = saved ? 'Changes saved!' : '';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Lato:wght@300;400;700&display=swap" rel="stylesheet" />
    <title>Edit your profile — Grotto Sitters</title>
  </head>
  <body>
    <nav>
      <a href="/" class="nav-logo">Grotto <span>Sitters</span></a>
      <div class="nav-right">
        <span class="nav-email">{session.email}</span>
        <a href="/api/auth/logout" class="nav-logout">Log out</a>
      </div>
    </nav>

    <main class="edit-wrap">
      <div class="section-inner">
        <header class="edit-header">
          <div>
            <p class="section-label">Sitter Portal</p>
            <h1 class="section-title">Edit your profile</h1>
            <div class="divider"></div>
            <p class="edit-intro">Everything you change here updates your public page. Hit "Save" on each section after making changes.</p>
          </div>
          <div class="header-actions">
            <a href="/dashboard" class="btn-back">Dashboard</a>
            <a href={`/${profile.slug}`} target="_blank" class="btn-primary btn-sm">View my page</a>
          </div>
        </header>

        {savedMsg && <div class="success-banner" id="success-banner">{savedMsg}</div>}
        {errorMsg && <div class="error-banner">{errorMsg}</div>}

        <!-- Jump-to links -->
        <div class="section-nav">
          <a href="#details">Name & bio</a>
          <a href="#hero">Banner photos</a>
          <a href="#about">Bio photos</a>
          <a href="#gallery">Gallery</a>
          <a href="#reviews">Reviews</a>
          <a href="#platforms">Other profiles</a>
          <a href="#headings">Headings</a>
        </div>

        <!-- ── FULL PAGE PREVIEW ────────────────────── -->
        <div class="page-preview-wrap">
          <div class="page-preview-header">
            <h2>Page preview</h2>
            <a href={`/${profile.slug}`} target="_blank" class="preview-view-link">Open full page</a>
          </div>
          <div class="page-preview" style={`--pv-bg:${t.background || '#faf6ee'};--pv-accent:${t.accent || '#c8963e'};--pv-accent-light:${t.accent_light || '#e8b96a'};--pv-text:${t.text || '#2c1a0e'};--pv-text-soft:${t.text_soft || '#6b4e35'};`}>
            <!-- Hero -->
            <div class="pv-hero">
              {heroImages.length > 0 ? (
                <img src={heroImages[0].src} alt="" class="pv-hero-img" style={`object-position:${heroImages[0].pos}`} />
              ) : (
                <div class="pv-hero-img pv-hero-empty"></div>
              )}
              <div class="pv-hero-overlay"></div>
              <div class="pv-hero-content">
                {profile.badge_text && <span class="pv-badge">{profile.badge_text}</span>}
                <p class="pv-brand">Grotto <em>Sitters</em></p>
                <p class="pv-name">{profile.name}</p>
                {profile.tagline && <p class="pv-tagline">{profile.tagline}</p>}
                <span class="pv-btn">Book {profile.account_type === 'joint' ? 'Us' : 'Me'} Today</span>
              </div>
            </div>

            <!-- About -->
            <div class="pv-section" style="background:var(--pv-bg);">
              <p class="pv-label">{h.about_label || (profile.account_type === 'joint' ? 'Who We Are' : 'Who I Am')}</p>
              <div class="pv-about-row">
                {aboutImages.length > 0 && <img src={aboutImages[0].src} alt="" class="pv-about-img" />}
                <div class="pv-about-text">
                  {profile.bio ? (
                    <p>{profile.bio.length > 100 ? profile.bio.slice(0, 100) + '...' : profile.bio}</p>
                  ) : (
                    <p class="pv-empty">No bio yet</p>
                  )}
                </div>
              </div>
            </div>

            <!-- Reviews -->
            {reviews.length > 0 && (
              <div class="pv-section" style="background:var(--pv-bg);">
                <p class="pv-label">{h.reviews_label || 'What Pet Owners Say'}</p>
                <div class="pv-reviews-row">
                  {reviews.slice(0, 3).map((r: any) => (
                    <div class="pv-review-card">
                      <span class="pv-stars">★★★★★</span>
                      <p>"{r.text.length > 50 ? r.text.slice(0, 50) + '...' : r.text}"</p>
                      <span class="pv-reviewer">— {r.name}</span>
                    </div>
                  ))}
                </div>
              </div>
            )}

            <!-- Gallery -->
            {gallery.length > 0 && (
              <div class="pv-section pv-gallery-section">
                <p class="pv-label">{h.gallery_label || (profile.account_type === 'joint' ? "Pets We've Loved" : "Pets I've Loved")}</p>
                <div class="pv-gallery-grid">
                  {gallery.slice(0, 8).map((img: any) => (
                    <div class="pv-gallery-item"><img src={img.src} alt="" /></div>
                  ))}
                </div>
              </div>
            )}

            <!-- Platforms -->
            {platforms.length > 0 && (
              <div class="pv-section" style="background:var(--pv-bg);">
                <p class="pv-label">{h.platforms_label || (profile.account_type === 'joint' ? 'Find Us Online' : 'Find Me Online')}</p>
                <div class="pv-platforms-row">
                  {platforms.map((p: any) => (
                    <div class="pv-platform-chip">
                      <span class="pv-platform-letter">{p.name.charAt(0).toUpperCase()}</span>
                      <span>{p.name}</span>
                    </div>
                  ))}
                </div>
              </div>
            )}

            <!-- Enquiry -->
            <div class="pv-section" style="background:var(--pv-bg);">
              <p class="pv-label">{h.enquiry_label || 'Get In Touch'}</p>
              <div class="pv-enquiry-mock">
                <div class="pv-mock-field"></div>
                <div class="pv-mock-field"></div>
                <div class="pv-mock-field pv-mock-tall"></div>
                <div class="pv-mock-btn">Send Enquiry</div>
              </div>
            </div>

            <!-- Footer -->
            <div class="pv-footer">
              <p>Grotto <em>Sitters</em></p>
              <span>{profile.name}</span>
            </div>
          </div>

          <!-- Colour strip under preview -->
          <form action="/api/profile/theme" method="POST" class="colour-strip" id="colours">
            <div class="colour-strip-row">
              <div class="colour-swatch">
                <input type="color" name="background" value={t.background || '#faf6ee'} class="colour-picker" />
                <span>Background</span>
              </div>
              <div class="colour-swatch">
                <input type="color" name="accent" value={t.accent || '#c8963e'} class="colour-picker" />
                <span>Accent</span>
              </div>
              <div class="colour-swatch">
                <input type="color" name="accent_light" value={t.accent_light || '#e8b96a'} class="colour-picker" />
                <span>Highlight</span>
              </div>
              <div class="colour-swatch">
                <input type="color" name="text" value={t.text || '#2c1a0e'} class="colour-picker" />
                <span>Text</span>
              </div>
              <div class="colour-swatch">
                <input type="color" name="text_soft" value={t.text_soft || '#6b4e35'} class="colour-picker" />
                <span>Soft text</span>
              </div>
            </div>
            <div class="colour-strip-actions">
              <button type="submit" class="btn-primary btn-sm">Save colours</button>
              <button type="button" class="btn-reset-colours" id="resetColours">Reset</button>
            </div>
          </form>
        </div>

        <!-- ─────────────────────────────────────────── -->
        <!-- 1. NAME & BIO                               -->
        <!-- ─────────────────────────────────────────── -->
        <section class="edit-card" id="details">
          <h2>Your name & bio</h2>
          <p class="card-desc">The basics — your name, a short description, and the text pet owners read when they visit your page.</p>
          <form action="/api/profile/update" method="POST" enctype="multipart/form-data" class="edit-form" id="details-form">
            <div class="field">
              <label>Profile type</label>
              <div class="type-toggle">
                <label class="type-option">
                  <input type="radio" name="account_type" value="solo" checked={profile.account_type !== 'joint'} />
                  <div class="type-card">
                    <span class="type-icon">👤</span>
                    <span class="type-label">Solo sitter</span>
                  </div>
                </label>
                <label class="type-option">
                  <input type="radio" name="account_type" value="joint" checked={profile.account_type === 'joint'} />
                  <div class="type-card">
                    <span class="type-icon">👥</span>
                    <span class="type-label">Joint / couple</span>
                  </div>
                </label>
              </div>
              <p class="field-hint">Changes default wording on your page (e.g. "Book me" vs "Book us").</p>
            </div>
            <div class="field">
              <label for="name">Your name <span class="req">*</span></label>
              <input type="text" id="name" name="name" value={profile.name} required />
              <p class="field-hint">This is the name shown at the top of your page.</p>
            </div>
            <div class="field">
              <label for="tagline">Short description</label>
              <input type="text" id="tagline" name="tagline" value={profile.tagline ?? ''} placeholder="e.g. Experienced pet sitters based in London" />
              <p class="field-hint">One line that appears under your name on the banner.</p>
            </div>
            <div class="field">
              <label for="badge_text">Highlight badge</label>
              <input type="text" id="badge_text" name="badge_text" value={profile.badge_text ?? ''} placeholder="e.g. 5★ rated on TrustedHouseSitters" />
              <p class="field-hint">A small badge shown on your banner photo. Great for awards or ratings. Leave blank to hide it.</p>
            </div>
            <div class="field">
              <label for="bio">About you</label>
              <textarea id="bio" name="bio" rows="8" placeholder="Tell pet owners about yourselves — your experience, the services you offer, and what makes you great sitters.">{profile.bio ?? ''}</textarea>
              <p class="field-hint">This text appears in the "About" section of your page. Leave a blank line between paragraphs.</p>
            </div>
            <div class="field">
              <label>Profile photo</label>
              <div class="pic-row">
                {profile.profile_pic && <img src={profile.profile_pic} alt={profile.name} class="current-pic" />}
                <div class="file-upload-wrap">
                  <input type="file" name="profile_pic" accept="image/*" class="file-input" />
                  <div class="file-upload-label">
                    <span class="file-upload-icon">📷</span>
                    <span class="file-upload-text">{profile.profile_pic ? 'Change photo' : 'Upload photo'}</span>
                  </div>
                </div>
              </div>
              <p class="field-hint">A photo of you shown on your dashboard. JPG or PNG, max 5 MB.</p>
            </div>

            <div class="contact-divider">
              <span>Where enquiries go</span>
            </div>

            <div class="field">
              <label for="contact_email">Enquiry email <span class="req">*</span></label>
              <input type="email" id="contact_email" name="contact_email" value={profile.contact_email ?? ''} placeholder="e.g. hello@example.com" required />
              <p class="field-hint">Pet owners' enquiries from your page are sent here. This is never shown publicly.</p>
            </div>
            <div class="field">
              <label for="whatsapp_number">WhatsApp number</label>
              <input type="tel" id="whatsapp_number" name="whatsapp_number" value={profile.whatsapp_number ?? ''} placeholder="e.g. +447700900000" />
              <p class="field-hint">Include country code. If set, a "Message on WhatsApp" button appears on your page. Leave blank to hide it.</p>
            </div>

            <div class="form-actions">
              <button type="submit" class="btn-primary btn-sm">Save</button>
            </div>
          </form>
        </section>

        <!-- ─────────────────────────────────────────── -->
        <!-- 3. BANNER PHOTOS                            -->
        <!-- ─────────────────────────────────────────── -->
        <section class="edit-card" id="hero">
          <h2>Banner photos</h2>
          <p class="card-desc">These are the big, full-width photos pet owners see first when they open your page. They cycle through as a slideshow. Use wide landscape photos for the best result.</p>
          {heroImages.length > 0 ? (
            <div class="image-grid">
              {heroImages.map((img: any, i: number) => (
                <div class="image-thumb">
                  <img src={img.src} alt={`Banner ${i + 1}`} />
                  <form action="/api/profile/images" method="POST" class="delete-form">
                    <input type="hidden" name="_action" value="delete" />
                    <input type="hidden" name="category" value="hero" />
                    <input type="hidden" name="index" value={String(i)} />
                    <button type="submit" class="delete-btn" title="Remove this photo">&times;</button>
                  </form>
                </div>
              ))}
            </div>
          ) : (
            <p class="empty-hint">No banner photos yet. Add one below to make your page stand out.</p>
          )}

          <form action="/api/profile/images" method="POST" enctype="multipart/form-data" class="upload-form" data-category="hero">
            <input type="hidden" name="_action" value="upload" />
            <input type="hidden" name="category" value="hero" />
            <div class="upload-row">
              <div class="file-upload-wrap upload-wide">
                <input type="file" name="files" accept="image/*" multiple required class="file-input" />
                <div class="file-upload-label">
                  <span class="file-upload-icon">🖼️</span>
                  <span class="file-upload-text">Choose photos</span>
                </div>
              </div>
              <select name="pos" class="pos-select" title="Focus point">
                <option value="center">Centre</option>
                <option value="top">Top</option>
                <option value="bottom">Bottom</option>
              </select>
            </div>
            <div class="upload-preview" data-for="hero"></div>
            <p class="field-hint">Select as many photos as you like. The focus point applies to all photos in this batch.</p>
            <button type="submit" class="btn-primary btn-sm upload-save-btn" style="display:none;">Save photos</button>
          </form>
        </section>

        <!-- ─────────────────────────────────────────── -->
        <!-- 3. BIO PHOTOS                               -->
        <!-- ─────────────────────────────────────────── -->
        <section class="edit-card" id="about">
          <h2>Photos next to your bio</h2>
          <p class="card-desc">These appear beside your "About" text as a small slideshow. Good options: photos of you with pets, at a sit, or around the house.</p>
          {aboutImages.length > 0 ? (
            <div class="image-grid">
              {aboutImages.map((img: any, i: number) => (
                <div class="image-thumb">
                  <img src={img.src} alt={img.alt || `Bio photo ${i + 1}`} />
                  <form action="/api/profile/images" method="POST" class="delete-form">
                    <input type="hidden" name="_action" value="delete" />
                    <input type="hidden" name="category" value="about" />
                    <input type="hidden" name="index" value={String(i)} />
                    <button type="submit" class="delete-btn" title="Remove this photo">&times;</button>
                  </form>
                </div>
              ))}
            </div>
          ) : (
            <p class="empty-hint">No photos here yet. These really help pet owners get to know you.</p>
          )}

          <form action="/api/profile/images" method="POST" enctype="multipart/form-data" class="upload-form" data-category="about">
            <input type="hidden" name="_action" value="upload" />
            <input type="hidden" name="category" value="about" />
            <div class="upload-row">
              <div class="file-upload-wrap upload-wide">
                <input type="file" name="files" accept="image/*" multiple required class="file-input" />
                <div class="file-upload-label">
                  <span class="file-upload-icon">📸</span>
                  <span class="file-upload-text">Choose photos</span>
                </div>
              </div>
            </div>
            <div class="upload-preview" data-for="about"></div>
            <button type="submit" class="btn-primary btn-sm upload-save-btn" style="display:none;">Save photos</button>
          </form>
        </section>

        <!-- ─────────────────────────────────────────── -->
        <!-- 4. GALLERY                                  -->
        <!-- ─────────────────────────────────────────── -->
        <section class="edit-card" id="gallery">
          <h2>Photo gallery</h2>
          <p class="card-desc">A grid of your best photos further down your page. Show off the pets you've looked after, places you've stayed, or anything that makes you a great sitter.</p>
          {gallery.length > 0 ? (
            <div class="image-grid">
              {gallery.map((img: any, i: number) => (
                <div class="image-thumb">
                  <img src={img.src} alt={img.alt || `Gallery photo ${i + 1}`} />
                  <form action="/api/profile/images" method="POST" class="delete-form">
                    <input type="hidden" name="_action" value="delete" />
                    <input type="hidden" name="category" value="gallery" />
                    <input type="hidden" name="index" value={String(i)} />
                    <button type="submit" class="delete-btn" title="Remove this photo">&times;</button>
                  </form>
                </div>
              ))}
            </div>
          ) : (
            <p class="empty-hint">No gallery photos yet. This section won't show on your page until you add some.</p>
          )}

          <form action="/api/profile/images" method="POST" enctype="multipart/form-data" class="upload-form" data-category="gallery">
            <input type="hidden" name="_action" value="upload" />
            <input type="hidden" name="category" value="gallery" />
            <div class="upload-row">
              <div class="file-upload-wrap upload-wide">
                <input type="file" name="files" accept="image/*" multiple required class="file-input" />
                <div class="file-upload-label">
                  <span class="file-upload-icon">📷</span>
                  <span class="file-upload-text">Choose photos</span>
                </div>
              </div>
            </div>
            <div class="upload-preview" data-for="gallery"></div>
            <button type="submit" class="btn-primary btn-sm upload-save-btn" style="display:none;">Save photos</button>
          </form>
        </section>

        <!-- ─────────────────────────────────────────── -->
        <!-- 5. REVIEWS                                  -->
        <!-- ─────────────────────────────────────────── -->
        <section class="edit-card" id="reviews">
          <h2>Reviews</h2>
          <p class="card-desc">Reviews are written by real pet owners. Generate a unique link and send it to a pet owner — they'll fill in the review themselves. This section won't show on your page until you have at least one.</p>
          {reviews.length > 0 && (
            <div class="item-list">
              {reviews.map((rev: any, i: number) => (
                <div class="item-card">
                  <div class="item-content">
                    <p class="item-quote">&ldquo;{rev.text}&rdquo;</p>
                    <p class="item-meta">&mdash; {rev.name}</p>
                  </div>
                  <form action="/api/profile/reviews" method="POST" class="delete-form">
                    <input type="hidden" name="_action" value="delete" />
                    <input type="hidden" name="index" value={String(i)} />
                    <button type="submit" class="delete-btn" title="Remove this review">&times;</button>
                  </form>
                </div>
              ))}
            </div>
          )}

          {reviews.length === 0 && !newToken && (
            <p class="empty-hint">No reviews yet. Generate a link below and send it to a pet owner to request one.</p>
          )}

          <!-- Generate new review link -->
          <div class="add-form">
            <h3>Request a review</h3>
            <p class="card-desc" style="margin-bottom:16px;">Click the button below to generate a unique link. Send it to a pet owner and they'll be able to write a review for you.</p>

            {newToken && (
              <div class="new-link-box">
                <p class="new-link-label">Your new review link (copy and send to a pet owner):</p>
                <div class="share-url">
                  <input type="text" readonly value={`https://grottositters.com/review/${newToken}`} id="reviewUrl" class="review-link-input" />
                  <button type="button" onclick="copyReviewUrl()" class="btn-primary btn-sm copy-review-btn">Copy</button>
                </div>
              </div>
            )}

            <form action="/api/profile/review-request" method="POST">
              <button type="submit" class="btn-primary btn-sm">Generate review link</button>
            </form>
          </div>

          <!-- Pending requests -->
          {reviewRequests.filter((r: any) => r.status === 'pending').length > 0 && (
            <div class="pending-requests">
              <h3>Pending review links</h3>
              <p class="card-desc">These links have been generated but haven't been used yet. Send them to your pet owners.</p>
              <div class="item-list">
                {reviewRequests.filter((r: any) => r.status === 'pending').map((req: any) => (
                  <div class="item-card pending-card">
                    <div class="item-content">
                      <p class="item-meta pending-url">grottositters.com/review/{req.token}</p>
                      <p class="item-desc">Created {new Date(req.created_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}</p>
                    </div>
                    <button type="button" class="btn-copy-small" data-url={`https://grottositters.com/review/${req.token}`} onclick={`navigator.clipboard.writeText(this.dataset.url);this.textContent='Copied!';setTimeout(()=>this.textContent='Copy',2000)`}>Copy</button>
                  </div>
                ))}
              </div>
            </div>
          )}
        </section>

        <!-- ─────────────────────────────────────────── -->
        <!-- 6. OTHER PROFILES                           -->
        <!-- ─────────────────────────────────────────── -->
        <section class="edit-card" id="platforms">
          <h2>Your profiles &amp; social media</h2>
          <p class="card-desc">Link to your profiles on pet sitting websites, social media, or anywhere else pet owners can find you. These show as clickable cards on your page. This section won't show until you add at least one.</p>
          {platforms.length > 0 && (
            <div class="item-list">
              {platforms.map((plat: any, i: number) => (
                <div class="item-card">
                  <div class="item-content">
                    <p class="item-title">{plat.name}</p>
                    <p class="item-meta">{plat.url}</p>
                    {plat.description && <p class="item-desc">{plat.description}</p>}
                  </div>
                  <form action="/api/profile/platforms" method="POST" class="delete-form">
                    <input type="hidden" name="_action" value="delete" />
                    <input type="hidden" name="index" value={String(i)} />
                    <button type="submit" class="delete-btn" title="Remove this link">&times;</button>
                  </form>
                </div>
              ))}
            </div>
          )}

          <form action="/api/profile/platforms" method="POST" class="add-form">
            <h3>Add a site</h3>
            <input type="hidden" name="_action" value="add" />
            <div class="field">
              <label>Site name <span class="req">*</span></label>
              <input type="text" name="name" required placeholder="e.g. Instagram, Rover, TikTok" />
            </div>
            <div class="field">
              <label>Link <span class="req">*</span></label>
              <input type="url" name="url" required placeholder="https://instagram.com/yourname" />
