    <script>
      function compressImage(file: File, maxW: number, maxH: number, quality: number): Promise<File> {
        return new Promise((resolve, reject) => {
          const img = new Image();
          img.onload = () => {
            let { width, height } = img;
            if (width > maxW || height > maxH) {
              const r = Math.min(maxW / width, maxH / height);
              width = Math.round(width * r);
              height = Math.round(height * r);
            }
            const c = document.createElement('canvas');
            c.width = width; c.height = height;
            const ctx = c.getContext('2d');
            if (!ctx) { resolve(file); return; }
            ctx.drawImage(img, 0, 0, width, height);
            c.toBlob(
              (blob) => {
                if (!blob) { resolve(file); return; }
                resolve(new File([blob], file.name.replace(/\.[^.]+$/, '.jpg'), { type: 'image/jpeg' }));
              },
              'image/jpeg', quality,
            );
          };
          img.onerror = () => reject(new Error('Failed to load image'));
          img.src = URL.createObjectURL(file);
        });
      }

      const pendingFiles = new Map<HTMLFormElement, File[]>();

      function renderPreview(form: HTMLFormElement) {
        const files = pendingFiles.get(form) ?? [];
        const previewEl = form.querySelector<HTMLElement>('.upload-preview');
        const saveBtn = form.querySelector<HTMLButtonElement>('.upload-save-btn');
        const label = form.querySelector<HTMLElement>('.file-upload-text');

        if (previewEl) {
          previewEl.innerHTML = '';
          Object.assign(previewEl.style, { display: files.length ? 'flex' : 'none', flexWrap: 'wrap', gap: '8px', margin: '12px 0' });
          files.forEach((file, idx) => {
            const thumb = document.createElement('div');
            Object.assign(thumb.style, {
              position: 'relative', width: '80px', height: '60px', borderRadius: '6px',
              overflow: 'hidden', border: '2px solid rgba(200,150,62,0.3)', flexShrink: '0',
            });
            const img = document.createElement('img');
            img.src = URL.createObjectURL(file);
            Object.assign(img.style, { width: '100%', height: '100%', objectFit: 'cover', display: 'block' });
            thumb.appendChild(img);
            const removeBtn = document.createElement('button');
            removeBtn.type = 'button';
            removeBtn.innerHTML = '&times;';
            Object.assign(removeBtn.style, {
              position: 'absolute', top: '-6px', right: '-6px', width: '22px', height: '22px',
              borderRadius: '50%', background: 'rgba(185,28,28,0.9)', color: '#fff',
              border: '2px solid #fff', fontSize: '12px', cursor: 'pointer',
              display: 'flex', alignItems: 'center', justifyContent: 'center', lineHeight: '1',
            });
            removeBtn.addEventListener('click', () => {
              files.splice(idx, 1);
              pendingFiles.set(form, files);
              renderPreview(form);
            });
            thumb.appendChild(removeBtn);
            previewEl.appendChild(thumb);
          });
        }

        if (saveBtn) saveBtn.style.display = files.length > 0 ? 'inline-block' : 'none';
        if (label) label.textContent = files.length > 0 ? `${files.length} photo${files.length > 1 ? 's' : ''} selected` : 'Choose photos';
      }

      document.querySelectorAll('.file-input').forEach(input => {
        input.addEventListener('change', () => {
          const fi = input as HTMLInputElement;
          const form = fi.closest<HTMLFormElement>('form');
          if (!form) return;

          if (form.classList.contains('upload-form') && fi.files && fi.files.length > 0) {
            const existing = pendingFiles.get(form) ?? [];
            existing.push(...Array.from(fi.files));
            pendingFiles.set(form, existing);
            fi.value = '';
            renderPreview(form);
          } else {
            const label = fi.closest('.file-upload-wrap')?.querySelector('.file-upload-text');
            if (fi.files?.[0] && label) label.textContent = fi.files[0].name;
          }
        });
      });

      document.querySelectorAll<HTMLFormElement>('form[enctype="multipart/form-data"]').forEach(form => {
        form.addEventListener('submit', async (e) => {
          if (form.classList.contains('upload-form')) {
            const files = pendingFiles.get(form) ?? [];
            if (files.length === 0) return;

            e.preventDefault();
            const btn = form.querySelector<HTMLButtonElement>('.upload-save-btn');
            const origText = btn?.textContent ?? '';
            if (btn) { btn.disabled = true; btn.textContent = `Uploading ${files.length} photo${files.length > 1 ? 's' : ''}…`; }

            try {
              const maxDim = form.dataset.category === 'hero' ? 1600 : 1000;
              const fd = new FormData();
              fd.set('_action', 'upload');
              fd.set('category', form.querySelector<HTMLInputElement>('[name="category"]')!.value);
              const posSelect = form.querySelector<HTMLSelectElement>('[name="pos"]');
              if (posSelect) fd.set('pos', posSelect.value);

              const compressed = await Promise.all(files.map(f => compressImage(f, maxDim, maxDim, 0.82)));
              for (const file of compressed) {
                fd.append('files', file, file.name);
              }

              const res = await fetch(form.action, { method: 'POST', body: fd, redirect: 'follow' });
              window.location.href = res.url;
            } catch {
              if (btn) { btn.disabled = false; btn.textContent = origText; }
              alert('Upload failed. Please try again.');
            }
          } else {
            const fileInput = form.querySelector<HTMLInputElement>('input[type="file"]');
            const file = fileInput?.files?.[0];
            if (!file) return;

            e.preventDefault();
            const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
            const origText = btn?.textContent ?? '';
            if (btn) { btn.disabled = true; btn.textContent = 'Saving…'; }

            try {
              const compressed = await compressImage(file, 1200, 1200, 0.85);
              const fd = new FormData(form);
              fd.set(fileInput!.name, compressed, compressed.name);
              const res = await fetch(form.action, { method: 'POST', body: fd, redirect: 'follow' });
              window.location.href = res.url;
            } catch {
              if (btn) { btn.disabled = false; btn.textContent = origText; }
              alert('Upload failed. Please try again.');
            }
          }
        });
      });

      const banner = document.getElementById('success-banner');
      if (banner) setTimeout(() => { banner.style.opacity = '0'; setTimeout(() => banner.remove(), 300); }, 3000);

      function copyReviewUrl() {
        const input = document.getElementById('reviewUrl') as HTMLInputElement;
        input?.select();
        navigator.clipboard?.writeText(input?.value ?? '').then(() => {
          const btn = document.querySelector('.copy-review-btn') as HTMLButtonElement;
          if (btn) { btn.textContent = 'Copied!'; setTimeout(() => { btn.textContent = 'Copy'; }, 2000); }
        });
      }
      (window as any).copyReviewUrl = copyReviewUrl;

      const colourVarMap: Record<string, string> = {
        background: '--pv-bg', accent: '--pv-accent', accent_light: '--pv-accent-light',
        text: '--pv-text', text_soft: '--pv-text-soft',
      };
      const pvEl = document.querySelector<HTMLElement>('.page-preview');
      if (pvEl) {
        document.querySelectorAll<HTMLInputElement>('.colour-picker').forEach(picker => {
          picker.addEventListener('input', () => {
            const v = colourVarMap[picker.name];
            if (v) pvEl.style.setProperty(v, picker.value);
          });
        });
      }

      document.getElementById('resetColours')?.addEventListener('click', () => {
        const defaults: Record<string, string> = {
          background: '#faf6ee', accent: '#c8963e', accent_light: '#e8b96a',
          text: '#2c1a0e', text_soft: '#6b4e35',
        };
        for (const [key, val] of Object.entries(defaults)) {
          const input = document.querySelector<HTMLInputElement>(`input[name="${key}"]`);
          if (input) input.value = val;
          if (pvEl) {
            const v = colourVarMap[key];
            if (v) pvEl.style.setProperty(v, val);
          }
        }
      });
    </script>

