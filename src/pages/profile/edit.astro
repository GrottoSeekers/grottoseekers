---
export const prerender = false;

import '../../styles/global.css';
import { getSession } from '../../lib/auth';
import { supabase } from '../../lib/supabase';

const session = await getSession(Astro.request);
if (!session) return Astro.redirect('/login');

const { data: profile } = await supabase
  .from('profiles')
  .select('*')
  .eq('user_id', session.userId)
  .single();

if (!profile) return Astro.redirect('/profile/create');

const heroImages: any[] = Array.isArray(profile.hero_images_json) ? profile.hero_images_json : [];
const aboutImages: any[] = Array.isArray(profile.about_images_json) ? profile.about_images_json : [];
const gallery: any[] = Array.isArray(profile.gallery_json) ? profile.gallery_json : [];
const reviews: any[] = Array.isArray(profile.reviews_json) ? profile.reviews_json : [];
const platforms: any[] = Array.isArray(profile.platforms_json) ? profile.platforms_json : [];

const h = (profile.headings_json ?? {}) as Record<string, string>;
const t = (profile.theme_json ?? {}) as Record<string, string>;

const saved = Astro.url.searchParams.get('saved');
const errorKey = Astro.url.searchParams.get('error') ?? '';
const detail = Astro.url.searchParams.get('detail');
const errorMap: Record<string, string> = {
  missing:        'Please fill in the required fields.',
  file_too_large: 'Image must be under 5 MB.',
  upload:         `Upload error: ${detail ?? 'unknown'}`,
  server:         'Something went wrong. Please try again.',
};
const errorMsg = errorMap[errorKey] ?? '';
const savedMsg = saved ? 'Changes saved!' : '';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Lato:wght@300;400;700&display=swap" rel="stylesheet" />
    <title>Edit your profile — Grotto Sitters</title>
  </head>
  <body>
    <nav>
      <a href="/" class="nav-logo">Grotto <span>Sitters</span></a>
      <div class="nav-right">
        <span class="nav-email">{session.email}</span>
        <a href="/api/auth/logout" class="nav-logout">Log out</a>
      </div>
    </nav>

    <main class="edit-wrap">
      <div class="section-inner">
        <header class="edit-header">
          <div>
            <p class="section-label">Sitter Portal</p>
            <h1 class="section-title">Edit your profile</h1>
            <div class="divider"></div>
            <p class="edit-intro">Everything you change here updates your public page. Hit "Save" on each section after making changes.</p>
          </div>
          <div class="header-actions">
            <a href="/dashboard" class="btn-back">Dashboard</a>
            <a href={`/${profile.slug}`} target="_blank" class="btn-primary btn-sm">View my page</a>
          </div>
        </header>

        {savedMsg && <div class="success-banner" id="success-banner">{savedMsg}</div>}
        {errorMsg && <div class="error-banner">{errorMsg}</div>}

        <!-- Jump-to links -->
        <div class="section-nav">
          <a href="#details">Name & bio</a>
          <a href="#colours">Colours</a>
          <a href="#hero">Banner photos</a>
          <a href="#about">Bio photos</a>
          <a href="#gallery">Gallery</a>
          <a href="#reviews">Reviews</a>
          <a href="#platforms">Other profiles</a>
          <a href="#headings">Headings</a>
        </div>

        <!-- ─────────────────────────────────────────── -->
        <!-- 1. NAME & BIO                               -->
        <!-- ─────────────────────────────────────────── -->
        <section class="edit-card" id="details">
          <h2>Your name & bio</h2>
          <p class="card-desc">The basics — your name, a short description, and the text pet owners read when they visit your page.</p>
          <form action="/api/profile/update" method="POST" enctype="multipart/form-data" class="edit-form" id="details-form">
            <div class="field">
              <label for="name">Your name <span class="req">*</span></label>
              <input type="text" id="name" name="name" value={profile.name} required />
              <p class="field-hint">This is the name shown at the top of your page.</p>
            </div>
            <div class="field">
              <label for="tagline">Short description</label>
              <input type="text" id="tagline" name="tagline" value={profile.tagline ?? ''} placeholder="e.g. Experienced pet sitters based in London" />
              <p class="field-hint">One line that appears under your name on the banner.</p>
            </div>
            <div class="field">
              <label for="badge_text">Highlight badge</label>
              <input type="text" id="badge_text" name="badge_text" value={profile.badge_text ?? ''} placeholder="e.g. 5★ rated on TrustedHouseSitters" />
              <p class="field-hint">A small badge shown on your banner photo. Great for awards or ratings. Leave blank to hide it.</p>
            </div>
            <div class="field">
              <label for="bio">About you</label>
              <textarea id="bio" name="bio" rows="8" placeholder="Tell pet owners about yourselves — your experience, the services you offer, and what makes you great sitters.">{profile.bio ?? ''}</textarea>
              <p class="field-hint">This text appears in the "About" section of your page. Leave a blank line between paragraphs.</p>
            </div>
            <div class="field">
              <label>Profile photo</label>
              <div class="pic-row">
                {profile.profile_pic && <img src={profile.profile_pic} alt={profile.name} class="current-pic" />}
                <div class="file-upload-wrap">
                  <input type="file" name="profile_pic" accept="image/*" class="file-input" />
                  <div class="file-upload-label">
                    <span class="file-upload-icon">📷</span>
                    <span class="file-upload-text">{profile.profile_pic ? 'Change photo' : 'Upload photo'}</span>
                  </div>
                </div>
              </div>
              <p class="field-hint">A photo of you shown on your dashboard. JPG or PNG, max 5 MB.</p>
            </div>
            <div class="form-actions">
              <button type="submit" class="btn-primary btn-sm">Save</button>
            </div>
          </form>
        </section>

        <!-- ─────────────────────────────────────────── -->
        <!-- 2. COLOURS                                  -->
        <!-- ─────────────────────────────────────────── -->
        <section class="edit-card" id="colours">
          <h2>Colours</h2>
          <p class="card-desc">Pick the colours for your public page. Leave any blank to use the default Grotto Sitters colours. Click the colour circle to open a picker.</p>
          <form action="/api/profile/theme" method="POST" class="edit-form">
            <div class="colour-grid">
              <div class="colour-field">
                <label>Background</label>
                <div class="colour-input-row">
                  <input type="color" name="background" value={t.background || '#faf6ee'} class="colour-picker" />
                  <span class="colour-label">Page background</span>
                </div>
              </div>
              <div class="colour-field">
                <label>Main accent</label>
                <div class="colour-input-row">
                  <input type="color" name="accent" value={t.accent || '#c8963e'} class="colour-picker" />
                  <span class="colour-label">Buttons, links, stars</span>
                </div>
              </div>
              <div class="colour-field">
                <label>Light accent</label>
                <div class="colour-input-row">
                  <input type="color" name="accent_light" value={t.accent_light || '#e8b96a'} class="colour-picker" />
                  <span class="colour-label">Hover effects, highlights</span>
                </div>
              </div>
              <div class="colour-field">
                <label>Text colour</label>
                <div class="colour-input-row">
                  <input type="color" name="text" value={t.text || '#2c1a0e'} class="colour-picker" />
                  <span class="colour-label">Headings & body text</span>
                </div>
              </div>
              <div class="colour-field">
                <label>Soft text colour</label>
                <div class="colour-input-row">
                  <input type="color" name="text_soft" value={t.text_soft || '#6b4e35'} class="colour-picker" />
                  <span class="colour-label">Hints, captions, labels</span>
                </div>
              </div>
            </div>
            <div class="form-actions" style="display:flex;gap:12px;align-items:center;">
              <button type="submit" class="btn-primary btn-sm">Save colours</button>
              <button type="button" class="btn-reset-colours" id="resetColours">Reset to defaults</button>
            </div>
          </form>
        </section>

        <!-- ─────────────────────────────────────────── -->
        <!-- 3. BANNER PHOTOS                            -->
        <!-- ─────────────────────────────────────────── -->
        <section class="edit-card" id="hero">
          <h2>Banner photos</h2>
          <p class="card-desc">These are the big, full-width photos pet owners see first when they open your page. They cycle through as a slideshow. Use wide landscape photos for the best result.</p>

          {heroImages.length > 0 ? (
            <div class="image-grid">
              {heroImages.map((img: any, i: number) => (
                <div class="image-thumb">
                  <img src={img.src} alt={`Banner ${i + 1}`} />
                  <form action="/api/profile/images" method="POST" class="delete-form">
                    <input type="hidden" name="_action" value="delete" />
                    <input type="hidden" name="category" value="hero" />
                    <input type="hidden" name="index" value={String(i)} />
                    <button type="submit" class="delete-btn" title="Remove this photo">&times;</button>
                  </form>
                </div>
              ))}
            </div>
          ) : (
            <p class="empty-hint">No banner photos yet. Add one below to make your page stand out.</p>
          )}

          <form action="/api/profile/images" method="POST" enctype="multipart/form-data" class="upload-form" data-category="hero">
            <input type="hidden" name="_action" value="upload" />
            <input type="hidden" name="category" value="hero" />
            <div class="upload-row">
              <div class="file-upload-wrap upload-wide">
                <input type="file" name="file" accept="image/*" required class="file-input" />
                <div class="file-upload-label">
                  <span class="file-upload-icon">🖼️</span>
                  <span class="file-upload-text">Choose a photo</span>
                </div>
              </div>
              <select name="pos" class="pos-select" title="Focus point">
                <option value="center">Centre</option>
                <option value="top">Top</option>
                <option value="bottom">Bottom</option>
              </select>
              <button type="submit" class="btn-primary btn-sm">Upload</button>
            </div>
            <p class="field-hint">The focus point decides which part of the photo stays visible when the screen is narrow (e.g. on a phone).</p>
          </form>
        </section>

        <!-- ─────────────────────────────────────────── -->
        <!-- 3. BIO PHOTOS                               -->
        <!-- ─────────────────────────────────────────── -->
        <section class="edit-card" id="about">
          <h2>Photos next to your bio</h2>
          <p class="card-desc">These appear beside your "About" text as a small slideshow. Good options: photos of you with pets, at a sit, or around the house.</p>

          {aboutImages.length > 0 ? (
            <div class="image-grid">
              {aboutImages.map((img: any, i: number) => (
                <div class="image-thumb">
                  <img src={img.src} alt={img.alt || `Bio photo ${i + 1}`} />
                  <form action="/api/profile/images" method="POST" class="delete-form">
                    <input type="hidden" name="_action" value="delete" />
                    <input type="hidden" name="category" value="about" />
                    <input type="hidden" name="index" value={String(i)} />
                    <button type="submit" class="delete-btn" title="Remove this photo">&times;</button>
                  </form>
                </div>
              ))}
            </div>
          ) : (
            <p class="empty-hint">No photos here yet. These really help pet owners get to know you.</p>
          )}

          <form action="/api/profile/images" method="POST" enctype="multipart/form-data" class="upload-form" data-category="about">
            <input type="hidden" name="_action" value="upload" />
            <input type="hidden" name="category" value="about" />
            <div class="upload-row">
              <div class="file-upload-wrap upload-wide">
                <input type="file" name="file" accept="image/*" required class="file-input" />
                <div class="file-upload-label">
                  <span class="file-upload-icon">📸</span>
                  <span class="file-upload-text">Choose a photo</span>
                </div>
              </div>
              <button type="submit" class="btn-primary btn-sm">Upload</button>
            </div>
          </form>
        </section>

        <!-- ─────────────────────────────────────────── -->
        <!-- 4. GALLERY                                  -->
        <!-- ─────────────────────────────────────────── -->
        <section class="edit-card" id="gallery">
          <h2>Photo gallery</h2>
          <p class="card-desc">A grid of your best photos further down your page. Show off the pets you've looked after, places you've stayed, or anything that makes you a great sitter.</p>

          {gallery.length > 0 ? (
            <div class="image-grid">
              {gallery.map((img: any, i: number) => (
                <div class="image-thumb">
                  <img src={img.src} alt={img.alt || `Gallery photo ${i + 1}`} />
                  <form action="/api/profile/images" method="POST" class="delete-form">
                    <input type="hidden" name="_action" value="delete" />
                    <input type="hidden" name="category" value="gallery" />
                    <input type="hidden" name="index" value={String(i)} />
                    <button type="submit" class="delete-btn" title="Remove this photo">&times;</button>
                  </form>
                </div>
              ))}
            </div>
          ) : (
            <p class="empty-hint">No gallery photos yet. This section won't show on your page until you add some.</p>
          )}

          <form action="/api/profile/images" method="POST" enctype="multipart/form-data" class="upload-form" data-category="gallery">
            <input type="hidden" name="_action" value="upload" />
            <input type="hidden" name="category" value="gallery" />
            <div class="upload-row">
              <div class="file-upload-wrap upload-wide">
                <input type="file" name="file" accept="image/*" required class="file-input" />
                <div class="file-upload-label">
                  <span class="file-upload-icon">📷</span>
                  <span class="file-upload-text">Choose a photo</span>
                </div>
              </div>
              <button type="submit" class="btn-primary btn-sm">Upload</button>
            </div>
          </form>
        </section>

        <!-- ─────────────────────────────────────────── -->
        <!-- 5. REVIEWS                                  -->
        <!-- ─────────────────────────────────────────── -->
        <section class="edit-card" id="reviews">
          <h2>Reviews</h2>
          <p class="card-desc">Copy in reviews from pet owners or other platforms. These appear as scrollable cards on your page. This section won't show until you add at least one.</p>

          {reviews.length > 0 && (
            <div class="item-list">
              {reviews.map((rev: any, i: number) => (
                <div class="item-card">
                  <div class="item-content">
                    <p class="item-quote">&ldquo;{rev.text}&rdquo;</p>
                    <p class="item-meta">&mdash; {rev.name}{rev.platform ? ` on ${rev.platform}` : ''}</p>
                  </div>
                  <form action="/api/profile/reviews" method="POST" class="delete-form">
                    <input type="hidden" name="_action" value="delete" />
                    <input type="hidden" name="index" value={String(i)} />
                    <button type="submit" class="delete-btn" title="Remove this review">&times;</button>
                  </form>
                </div>
              ))}
            </div>
          )}

          <form action="/api/profile/reviews" method="POST" class="add-form">
            <h3>Add a review</h3>
            <input type="hidden" name="_action" value="add" />
            <div class="field">
              <label>What did they say? <span class="req">*</span></label>
              <textarea name="text" rows="3" required placeholder="Paste or type the review here"></textarea>
            </div>
            <div class="field-row">
              <div class="field">
                <label>Their name <span class="req">*</span></label>
                <input type="text" name="name" required placeholder="e.g. Sarah M." />
              </div>
              <div class="field">
                <label>Where was the review?</label>
                <input type="text" name="platform" placeholder="e.g. TrustedHouseSitters" />
                <p class="field-hint">The website or app they left the review on.</p>
              </div>
            </div>
            <button type="submit" class="btn-primary btn-sm">Add review</button>
          </form>
        </section>

        <!-- ─────────────────────────────────────────── -->
        <!-- 6. OTHER PROFILES                           -->
        <!-- ─────────────────────────────────────────── -->
        <section class="edit-card" id="platforms">
          <h2>Your profiles on other sites</h2>
          <p class="card-desc">Link to your profiles on pet sitting websites like Rover or TrustedHouseSitters. These show as clickable cards on your page so pet owners can check your reviews there. This section won't show until you add at least one.</p>

          {platforms.length > 0 && (
            <div class="item-list">
              {platforms.map((plat: any, i: number) => (
                <div class="item-card">
                  <div class="item-content">
                    <p class="item-title">{plat.emoji} {plat.name}</p>
                    <p class="item-meta">{plat.url}</p>
                    {plat.description && <p class="item-desc">{plat.description}</p>}
                  </div>
                  <form action="/api/profile/platforms" method="POST" class="delete-form">
                    <input type="hidden" name="_action" value="delete" />
                    <input type="hidden" name="index" value={String(i)} />
                    <button type="submit" class="delete-btn" title="Remove this link">&times;</button>
                  </form>
                </div>
              ))}
            </div>
          )}

          <form action="/api/profile/platforms" method="POST" class="add-form">
            <h3>Add a site</h3>
            <input type="hidden" name="_action" value="add" />
            <div class="field-row">
              <div class="field">
                <label>Site name <span class="req">*</span></label>
                <input type="text" name="name" required placeholder="e.g. TrustedHouseSitters" />
              </div>
              <div class="field field-sm">
                <label>Icon</label>
                <input type="text" name="emoji" placeholder="🏠" maxlength="4" />
              </div>
            </div>
            <div class="field">
              <label>Link to your profile <span class="req">*</span></label>
              <input type="url" name="url" required placeholder="https://www.trustedhousesitters.com/your-profile" />
              <p class="field-hint">Copy the full URL from your browser when you're on your profile page.</p>
            </div>
            <div class="field">
              <label>Short note</label>
              <input type="text" name="description" placeholder="e.g. 10 five-star reviews" />
              <p class="field-hint">A quick summary pet owners will see on the card.</p>
            </div>
            <button type="submit" class="btn-primary btn-sm">Add site</button>
          </form>
        </section>

        <!-- ─────────────────────────────────────────── -->
        <!-- 7. CUSTOMISE HEADINGS                       -->
        <!-- ─────────────────────────────────────────── -->
        <section class="edit-card" id="headings">
          <h2>Customise section headings</h2>
          <p class="card-desc">Each section on your page has a small label and a big title. You can change them here to match your style. Leave any field blank to keep the default.</p>
          <form action="/api/profile/headings" method="POST" class="edit-form">
            <div class="headings-group">
              <h3 class="headings-group-title">About section</h3>
              <p class="headings-group-where">The section with your bio text and photos.</p>
              <div class="field-row">
                <div class="field">
                  <label>Small label</label>
                  <input type="text" name="about_label" value={h.about_label ?? ''} placeholder="Who We Are" />
                </div>
                <div class="field">
                  <label>Big title</label>
                  <input type="text" name="about_title" value={h.about_title ?? ''} placeholder="A home away from home — for you and your pets." />
                </div>
              </div>
            </div>
            <div class="headings-group">
              <h3 class="headings-group-title">Reviews section</h3>
              <p class="headings-group-where">The section showing your review cards.</p>
              <div class="field-row">
                <div class="field">
                  <label>Small label</label>
                  <input type="text" name="reviews_label" value={h.reviews_label ?? ''} placeholder="What Pet Owners Say" />
                </div>
                <div class="field">
                  <label>Big title</label>
                  <input type="text" name="reviews_title" value={h.reviews_title ?? ''} placeholder="Leave blank to auto-show your review count" />
                </div>
              </div>
            </div>
            <div class="headings-group">
              <h3 class="headings-group-title">Gallery section</h3>
              <p class="headings-group-where">The photo grid section.</p>
              <div class="field-row">
                <div class="field">
                  <label>Small label</label>
                  <input type="text" name="gallery_label" value={h.gallery_label ?? ''} placeholder="Pets We've Loved" />
                </div>
                <div class="field">
                  <label>Big title</label>
                  <input type="text" name="gallery_title" value={h.gallery_title ?? ''} placeholder="Our Sits" />
                </div>
              </div>
            </div>
            <div class="headings-group">
              <h3 class="headings-group-title">Other profiles section</h3>
              <p class="headings-group-where">The cards linking to your profiles on other sites.</p>
              <div class="field-row">
                <div class="field">
                  <label>Small label</label>
                  <input type="text" name="platforms_label" value={h.platforms_label ?? ''} placeholder="Find Us Online" />
                </div>
                <div class="field">
                  <label>Big title</label>
                  <input type="text" name="platforms_title" value={h.platforms_title ?? ''} placeholder="Verified Profiles" />
                </div>
              </div>
            </div>
            <div class="headings-group">
              <h3 class="headings-group-title">Contact section</h3>
              <p class="headings-group-where">The enquiry form at the bottom of your page.</p>
              <div class="field-row">
                <div class="field">
                  <label>Small label</label>
                  <input type="text" name="enquiry_label" value={h.enquiry_label ?? ''} placeholder="Get In Touch" />
                </div>
                <div class="field">
                  <label>Big title</label>
                  <input type="text" name="enquiry_title" value={h.enquiry_title ?? ''} placeholder={`Book ${profile.name}`} />
                </div>
              </div>
            </div>
            <div class="form-actions">
              <button type="submit" class="btn-primary btn-sm">Save headings</button>
            </div>
          </form>
        </section>

      </div>
    </main>

    <script>
      function compressImage(file: File, maxW: number, maxH: number, quality: number): Promise<File> {
        return new Promise((resolve, reject) => {
          const img = new Image();
          img.onload = () => {
            let { width, height } = img;
            if (width > maxW || height > maxH) {
              const r = Math.min(maxW / width, maxH / height);
              width = Math.round(width * r);
              height = Math.round(height * r);
            }
            const c = document.createElement('canvas');
            c.width = width; c.height = height;
            const ctx = c.getContext('2d');
            if (!ctx) { resolve(file); return; }
            ctx.drawImage(img, 0, 0, width, height);
            c.toBlob(
              (blob) => {
                if (!blob) { resolve(file); return; }
                resolve(new File([blob], file.name.replace(/\.[^.]+$/, '.jpg'), { type: 'image/jpeg' }));
              },
              'image/jpeg', quality,
            );
          };
          img.onerror = () => reject(new Error('Failed to load image'));
          img.src = URL.createObjectURL(file);
        });
      }

      document.querySelectorAll('.file-input').forEach(input => {
        input.addEventListener('change', () => {
          const fi = input as HTMLInputElement;
          const label = fi.closest('.file-upload-wrap')?.querySelector('.file-upload-text');
          if (fi.files?.[0] && label) label.textContent = fi.files[0].name;
        });
      });

      document.querySelectorAll<HTMLFormElement>('form[enctype="multipart/form-data"]').forEach(form => {
        form.addEventListener('submit', async (e) => {
          const fileInput = form.querySelector<HTMLInputElement>('input[type="file"]');
          const file = fileInput?.files?.[0];
          if (!file) return;

          e.preventDefault();
          const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
          const origText = btn?.textContent ?? '';
          if (btn) { btn.disabled = true; btn.textContent = 'Uploading…'; }

          try {
            const maxDim = form.dataset.category === 'hero' ? 1920 : 1200;
            const compressed = await compressImage(file, maxDim, maxDim, 0.85);
            const fd = new FormData(form);
            const fieldName = fileInput!.name;
            fd.set(fieldName, compressed, compressed.name);
            const res = await fetch(form.action, { method: 'POST', body: fd, redirect: 'follow' });
            window.location.href = res.url;
          } catch {
            if (btn) { btn.disabled = false; btn.textContent = origText; }
            alert('Upload failed. Please try again.');
          }
        });
      });

      const banner = document.getElementById('success-banner');
      if (banner) setTimeout(() => { banner.style.opacity = '0'; setTimeout(() => banner.remove(), 300); }, 3000);

      document.getElementById('resetColours')?.addEventListener('click', () => {
        const defaults: Record<string, string> = {
          background: '#faf6ee', accent: '#c8963e', accent_light: '#e8b96a',
          text: '#2c1a0e', text_soft: '#6b4e35',
        };
        for (const [key, val] of Object.entries(defaults)) {
          const input = document.querySelector<HTMLInputElement>(`input[name="${key}"]`);
          if (input) input.value = val;
        }
      });
    </script>

