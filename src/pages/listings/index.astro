<script define:vars={{ listings }}>
  const ALL = listings;
  let state = { q: '', place: 'all', pet: 'all', len: 'any', sort: 'soonest' };

  const grid = document.getElementById('grid');
  const empty = document.getElementById('emptyState');
  const countLabel = document.getElementById('countLabel');

  function chipStyle(on) {
    return on
      ? 'font-family:\'Montserrat\',sans-serif;font-size:.78rem;font-weight:700;letter-spacing:.06em;padding:9px 18px;border-radius:50px;cursor:pointer;transition:background .2s, color .2s, border-color .2s;background:#2f5d45;color:#fff;border:1.5px solid #2f5d45;'
      : 'font-family:\'Montserrat\',sans-serif;font-size:.78rem;font-weight:700;letter-spacing:.06em;padding:9px 18px;border-radius:50px;cursor:pointer;transition:background .2s, color .2s, border-color .2s;background:#fff;color:#5c3d20;border:1.5px solid rgba(110,84,56,.35);';
  }

  function render() {
    const { q, place, pet, len, sort } = state;
    const needle = q.trim().toLowerCase();
    let rows = ALL.filter(s => {
      if (needle && !(s.title + ' ' + s.owner + ' ' + s.pets + ' ' + s.location + ' ' + s.description).toLowerCase().includes(needle)) return false;
      if (place !== 'all') {
        const loc = (s.location || '').toLowerCase();
        if (place === 'UK' && !loc.includes('uk') && !loc.includes('england') && !loc.includes('scotland') && !loc.includes('wales') && !loc.includes('bath') && !loc.includes('edinburgh') && !loc.includes('london') && !loc.includes('manchester') && !loc.includes('peak')) return false;
        if (place === 'AU' && !loc.includes('au') && !loc.includes('australia') && !loc.includes('sydney') && !loc.includes('byron') && !loc.includes('bondi')) return false;
      }
      if (pet !== 'all') {
        const types = (s.petTypes || []).join(' ');
        if (!types.includes(pet)) return false;
      }
      if (len === 'week' && s.days > 7) return false;
      if (len === 'fortnight' && (s.days <= 7 || s.days > 14)) return false;
      if (len === 'long' && s.days <= 14) return false;
      return true;
    });

    if (sort === 'longest') rows = [...rows].sort((a, b) => b.days - a.days);
    else if (sort === 'shortest') rows = [...rows].sort((a, b) => a.days - b.days);

    if (countLabel) {
      countLabel.textContent = rows.length === ALL.length
        ? ALL.length + ' sits available'
        : rows.length + ' of ' + ALL.length + ' sits';
    }

    if (!grid || !empty) return;
    if (rows.length === 0) {
      grid.style.display = 'none';
      empty.style.display = 'block';
      return;
    }
    empty.style.display = 'none';
    grid.style.display = 'grid';
    grid.innerHTML = rows.map(sit => `
      <a href="/listings/${sit.id}" class="sit-card" style="background:#fff;border:1px solid rgba(110,84,56,.22);border-radius:18px;padding:28px;text-decoration:none;color:inherit;box-shadow:0 1px 2px rgba(44,26,14,.04);display:flex;flex-direction:column;gap:18px;transition:transform .3s ease, box-shadow .3s ease, border-color .3s ease">
        <div style="display:flex;gap:16px;align-items:flex-start">
          ${sit.pic ? `<img src="${sit.pic}" alt="${sit.owner}" style="width:54px;height:54px;border-radius:50%;object-fit:cover;flex-shrink:0;border:2px solid rgba(110,84,56,.35)" />` : `<div style="width:54px;height:54px;border-radius:50%;flex-shrink:0;border:2px solid rgba(110,84,56,.35);background:#faf6ee;display:flex;align-items:center;justify-content:center;font-family:'Marcellus',serif;font-size:1.4rem;color:#6e5438">${(sit.owner || '?').charAt(0)}</div>`}
          <div style="flex:1;min-width:0">
            <h3 style="font-family:'Marcellus',serif;font-size:1.2rem;color:#2c1a0e;margin:0 0 4px;line-height:1.3">${sit.title}</h3>
            <p style="margin:0;font-size:.84rem;color:#2f5d45;font-weight:600;letter-spacing:.02em">${sit.owner}</p>
          </div>
          <span style="flex-shrink:0;background:rgba(110,84,56,.12);color:#2f5d45;font-weight:600;padding:5px 12px;border-radius:50px;font-size:.74rem;letter-spacing:.06em;white-space:nowrap">${sit.duration}</span>
        </div>
        <div style="display:flex;flex-direction:column;gap:9px;font-size:.85rem;color:#6b4e35">
          ${sit.location ? `<span style="display:flex;align-items:center;gap:9px"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#2f5d45" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>${sit.location}</span>` : ''}
          <span style="display:flex;align-items:center;gap:9px"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#2f5d45" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0"><rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M3 10h18M8 3v4M16 3v4"></path></svg>${sit.dates}</span>
          ${sit.pets ? `<span style="display:flex;align-items:center;gap:9px"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#2f5d45" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0"><circle cx="8" cy="9" r="2.2"></circle><circle cx="16" cy="9" r="2.2"></circle><circle cx="12" cy="15.5" r="3"></circle></svg>${sit.pets}</span>` : ''}
        </div>
        ${sit.description ? `<p style="margin:0;padding-top:16px;border-top:1px solid rgba(44,26,14,.08);font-size:.9rem;color:#6b4e35;line-height:1.7">${sit.description.length > 120 ? sit.description.slice(0, 120) + '…' : sit.description}</p>` : ''}
        <span style="margin-top:auto;font-size:.76rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:#2f5d45;display:flex;align-items:center;gap:8px">View sit →</span>
      </a>
    `).join('');
  }

  // Length chips
  document.querySelectorAll('.len-chip').forEach(btn => {
    btn.addEventListener('click', () => {
      state.len = btn.dataset.len;
      document.querySelectorAll('.len-chip').forEach(b => { (b as HTMLElement).style.cssText = chipStyle(b.dataset.len === state.len); });
      render();
    });
  });

  document.getElementById('q')?.addEventListener('input', e => { state.q = (e.target as HTMLInputElement).value; render(); });
  document.getElementById('place')?.addEventListener('change', e => { state.place = (e.target as HTMLSelectElement).value; render(); });
  document.getElementById('pet')?.addEventListener('change', e => { state.pet = (e.target as HTMLSelectElement).value; render(); });
  document.getElementById('sort')?.addEventListener('change', e => { state.sort = (e.target as HTMLSelectElement).value; render(); });
  document.getElementById('clearBtn')?.addEventListener('click', () => {
    state = { q: '', place: 'all', pet: 'all', len: 'any', sort: 'soonest' };
    (document.getElementById('q') as HTMLInputElement).value = '';
    (document.getElementById('place') as HTMLSelectElement).value = 'all';
    (document.getElementById('pet') as HTMLSelectElement).value = 'all';
    (document.getElementById('sort') as HTMLSelectElement).value = 'soonest';
    document.querySelectorAll('.len-chip').forEach(b => { (b as HTMLElement).style.cssText = chipStyle(b.dataset.len === 'any'); });
    render();
  });

  // Loading overlay
  const loader = document.querySelector('[data-loader]') as HTMLElement | null;
  document.querySelectorAll('a[href]').forEach(a => {
    const href = a.getAttribute('href') || '';
    if (href.startsWith('#') || href.startsWith('http') || href.startsWith('mailto') || href.startsWith('tel')) return;
    a.addEventListener('click', (e: Event) => {
      if ((e as MouseEvent).metaKey || (e as MouseEvent).ctrlKey || (e as MouseEvent).shiftKey) return;
      if (loader) { loader.style.opacity = '1'; loader.style.pointerEvents = 'all'; }
    });
  });
  window.addEventListener('pageshow', e => {
    if (e.persisted && loader) { loader.style.opacity = '0'; loader.style.pointerEvents = 'none'; }
  });

  // Initial render
  render();
</script>
</body>
</html>
