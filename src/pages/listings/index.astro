---
export const prerender = false;

import { getSession } from '../../lib/auth';
import { supabase } from '../../lib/supabase';

const session = await getSession(Astro.request);

const { data: rawListings } = await supabase
  .from('listings')
  .select('id, title, description, date_from, date_to, profiles!inner(name, location, slug, profile_pic, pets_json, hero_images_json)')
  .eq('status', 'active')
  .gte('date_to', new Date().toISOString().slice(0, 10))
  .order('date_from', { ascending: true });

function daysBetween(from: string, to: string) {
  const ms = new Date(to + 'T00:00:00').getTime() - new Date(from + 'T00:00:00').getTime();
  return Math.ceil(ms / 86400000);
}

function fmtDate(d: string) {
  return new Date(d + 'T00:00:00').toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
}

const listings = (rawListings ?? []).map((l: any) => {
  const lp = l.profiles;
  const pets: any[] = Array.isArray(lp?.pets_json) ? lp.pets_json : [];
  const hero: any[] = Array.isArray(lp?.hero_images_json) ? lp.hero_images_json : [];
  const days = daysBetween(l.date_from, l.date_to);
  return {
    id: l.id,
    title: l.title,
    description: l.description || '',
    owner: lp?.name || '',
    location: lp?.location || '',
    slug: lp?.slug || '',
    pic: lp?.profile_pic || '',
    heroImg: hero.length > 0 ? hero[0].src : '',
    pets: pets.map((p: any) => p.name + (p.type ? ' (' + p.type + ')' : '')).join(', '),
    petTypes: pets.map((p: any) => (p.type || '').toLowerCase()),
    dates: fmtDate(l.date_from) + ' — ' + fmtDate(l.date_to),
    dateFrom: l.date_from,
    days,
    duration: days + (days === 1 ? ' day' : ' days'),
  };
});
