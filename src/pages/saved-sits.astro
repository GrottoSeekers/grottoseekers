---
export const prerender = false;

import { getSession } from '../lib/auth';
import { supabase } from '../lib/supabase';

const session = await getSession(Astro.request);
if (!session) return Astro.redirect('/login');

const { data: profileData } = await supabase
  .from('profiles')
  .select('id, name, profile_type')
  .eq('user_id', session.userId)
  .single();
const profile = profileData as any;

let savedSits: any[] = [];
try {
  const { data } = await supabase
    .from('saved_sits')
    .select('id, created_at, listing_id, listings(id, title, description, date_from, date_to, status, profiles!inner(name, location, slug, avatar_url, hero_images_json, pets_json))')
    .eq('user_id', session.userId)
    .order('created_at', { ascending: false });
  savedSits = (data ?? []).map((s: any) => ({ ...s, listing: s.listings }));
} catch { /* table may not exist yet */ }

function fmt(d: string) {
  return new Date(d + 'T00:00:00').toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });
}
function fmtAgo(d: string) {
  const ms = Date.now() - new Date(d).getTime();
  const days = Math.floor(ms / 86400000);
  if (days === 0) return 'today';
  if (days === 1) return 'yesterday';
  if (days < 7) return `${days} days ago`;
  if (days < 14) return '1 week ago';
  return `${Math.floor(days / 7)} weeks ago`;
}
---

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Saved sits — MYAH</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Marcellus&family=Montserrat:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Lato:wght@400;700&display=swap" rel="stylesheet" />
<style>
  body { margin:0; background:#faf6ee; color:#2c1a0e; font-family:"Montserrat",sans-serif; min-height:100vh; }
  * { box-sizing:border-box; }
  a { color:#2f5d45; }
  a:hover { color:#2c1a0e; }
  @keyframes gs-ring { to { transform:rotate(360deg); } }
  @keyframes gs-pulse { 0%,100% { transform:scale(1); } 50% { transform:scale(1.05); } }
  @media (max-width:1000px) {
    [data-topnav] { padding:14px 24px !important; }
    [data-pad] { padding:34px 20px 80px !important; }
    [data-two-col] { grid-template-columns:minmax(0,1fr) !important; }
    [data-aside] { position:static !important; }
    [data-cards] { grid-template-columns:minmax(0,1fr) !important; }
  }
</style>
</head>
<body>
<div style="min-height:100vh;display:flex;flex-direction:column;background:#faf6ee">

  <div data-loader="1" aria-hidden="true" style="position:fixed;inset:0;z-index:9999;background:rgba(250,246,238,.92);backdrop-filter:blur(8px);display:flex;align-items:center;justify-content:center;opacity:0;pointer-events:none;transition:opacity .25s ease">
    <div style="position:relative;width:132px;height:132px;display:flex;align-items:center;justify-content:center">
      <div style="position:absolute;inset:0;border-radius:50%;border:3px solid rgba(110,84,56,.18)"></div>
      <div style="position:absolute;inset:0;border-radius:50%;border:3px solid transparent;border-top-color:#2f5d45;border-right-color:rgba(110,84,56,.45);animation:gs-ring 1s linear infinite"></div>
      <img src="/images/logo-mark.png" alt="" style="width:74px;height:74px;object-fit:contain;animation:gs-pulse 1.8s ease-in-out infinite" />
    </div>
  </div>

  <nav data-topnav="1" style="display:flex;justify-content:space-between;align-items:center;padding:16px 48px;background:#fff;border-bottom:1px solid rgba(110,84,56,.2)">
    <a href="/" style="display:inline-flex;align-items:center;gap:14px;text-decoration:none;line-height:1;margin-left:-4px">
      <img src="/images/logo-mark.png" alt="" style="height:44px;width:44px;display:block;object-fit:contain" />
      <span style="display:flex;flex-direction:column;gap:5px;padding-left:14px;border-left:1px solid rgba(110,84,56,.4)">
        <span style="color:#2f5d45;font-family:'Montserrat',sans-serif;font-weight:500;font-size:1.35rem;letter-spacing:.28em;line-height:1">MYAH</span>
        <span style="font-family:'Lato',sans-serif;font-weight:700;font-size:.5rem;letter-spacing:.2em;text-transform:uppercase;color:#6e5438;line-height:1">Make Yourself At Home</span>
      </span>
    </a>
    <div style="display:flex;align-items:center;gap:22px">
      <a href="/listings" style="display:inline-flex;align-items:center;gap:9px;font-size:.78rem;color:#6b4e35;text-decoration:none;font-weight:600;letter-spacing:.1em;text-transform:uppercase;transition:gap .2s,color .2s"
        onmouseover="this.style.gap='13px';this.style.color='#2f5d45'" onmouseout="this.style.gap='9px';this.style.color='#6b4e35'">&larr; Browse sits</a>
      <a href="/dashboard" style="font-size:.76rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:#2f5d45;text-decoration:none;transition:color .2s"
        onmouseover="this.style.color='#2c1a0e'" onmouseout="this.style.color='#2f5d45'">Dashboard</a>
    </div>
  </nav>

  <main data-pad="1" style="flex:1;padding:52px 48px 90px">
    <div style="max-width:1180px;margin:0 auto">

      <div style="border-bottom:1px solid rgba(110,84,56,.3);padding-bottom:30px;margin-bottom:26px">
        <p style="font-size:.75rem;font-weight:600;letter-spacing:.2em;text-transform:uppercase;color:#6e5438;margin:0 0 16px;display:flex;align-items:center;gap:12px">
          <span style="width:26px;height:1px;background:#6e5438;display:block;flex-shrink:0"></span>MYAH sitter
        </p>
        <h1 style="font-family:'Marcellus',serif;font-size:2.5rem;color:#2c1a0e;line-height:1.15;margin:0 0 18px">Sits you <em style="color:#2f5d45;">liked</em></h1>
        <p style="color:#6b4e35;font-size:1rem;line-height:1.75;max-width:620px;margin:0">
          {savedSits.length > 0 ? `${savedSits.length} sit${savedSits.length === 1 ? '' : 's'} saved. Check back often — dates fill fast.` : 'Heart a sit while browsing and it shows up here for you to revisit.'}
        </p>
      </div>

      <div data-two-col="1" style="display:grid;grid-template-columns:minmax(0,1.6fr) minmax(0,1fr);gap:28px;align-items:start">

        <div>
          <div style="display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-bottom:22px">
            <div style="display:flex;gap:9px;flex-wrap:wrap">
              {[
                { key: 'all', label: 'All', count: savedSits.length },
                { key: 'open', label: 'Still open', count: savedSits.filter((s: any) => s.listing?.status === 'active').length },
              ].map(f => (
                <button type="button" data-filter={f.key} onclick={`setFilter('${f.key}')`}
                  style={`display:inline-flex;align-items:center;gap:9px;font-family:'Montserrat',sans-serif;font-size:.78rem;font-weight:700;letter-spacing:.08em;padding:11px 20px;border-radius:50px;cursor:pointer;transition:background .25s ease,color .25s ease,border-color .25s ease;${f.key === 'all' ? 'background:#2f5d45;color:#fff;border:1.5px solid #2f5d45;' : 'background:#fff;color:#5c3d20;border:1.5px solid rgba(110,84,56,.32);'}`}>
                  {f.label}
                  <span style={`font-size:.7rem;padding:2px 8px;border-radius:50px;${f.key === 'all' ? 'background:rgba(255,255,255,.25);color:#fff;' : 'background:rgba(110,84,56,.14);color:#2f5d45;'}`}>{f.count}</span>
                </button>
              ))}
            </div>
            <a href="/listings" style="font-size:.76rem;font-weight:600;letter-spacing:.11em;text-transform:uppercase;color:#2f5d45;text-decoration:none;display:inline-flex;align-items:center;gap:8px;transition:gap .2s,color .2s"
              onmouseover="this.style.gap='12px';this.style.color='#2c1a0e'" onmouseout="this.style.gap='8px';this.style.color='#2f5d45'">Find more &rarr;</a>
          </div>

          {savedSits.length === 0 ? (
            <div style="background:#fff;border:1px dashed rgba(110,84,56,.45);border-radius:18px;padding:44px 40px">
              <p style="font-family:'Marcellus',serif;font-size:1.3rem;color:#2c1a0e;margin:0 0 10px">Nothing here</p>
              <p style="font-size:.95rem;color:#6b4e35;line-height:1.7;margin:0 0 22px;max-width:420px">Browse open sits and tap the heart icon to save ones you like. They&rsquo;ll gather here.</p>
              <a href="/listings" style="display:inline-flex;align-items:center;justify-content:center;font-size:.78rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#fff;background:#2f5d45;border:1.5px solid #2f5d45;border-radius:50px;box-shadow:0 6px 20px rgba(110,84,56,.28);padding:13px 28px;text-decoration:none;transition:background .25s ease,transform .15s ease"
                onmouseover="this.style.background='#3e7a5b';this.style.transform='translateY(-2px)'" onmouseout="this.style.background='#2f5d45';this.style.transform='translateY(0)'">Browse open sits</a>
            </div>
          ) : (
            <div data-cards="1" style="display:grid;grid-template-columns:1fr 1fr;gap:18px" id="sitsGrid">
              {savedSits.map((s: any) => {
                const listing = s.listing;
                if (!listing) return null;
                const heroImages: any[] = Array.isArray(listing.hero_images_json) ? listing.hero_images_json : [];
                const pic = heroImages[0]?.url || '';
                const isOpen = listing.status === 'active';
                const statusLabel = isOpen ? 'Open' : listing.status === 'filled' ? 'Filled' : 'Closed';
                const statusBg = isOpen ? 'rgba(44,26,14,.62)' : '#2c1a0e';
                const ownerName = listing.profiles?.name || 'Owner';
                const location = listing.profiles?.location || '';
                const slug = listing.profiles?.slug || '';
                return (
                  <article data-sit-id={s.id} data-status={listing.status}
                    style="background:#fff;border:1px solid rgba(110,84,56,.22);border-radius:18px;overflow:hidden;display:flex;flex-direction:column;box-shadow:0 1px 2px rgba(44,26,14,.04);transition:box-shadow .3s ease,border-color .3s ease"
                    onmouseover="this.style.boxShadow='0 10px 34px rgba(44,26,14,.08)';this.style.borderColor='rgba(110,84,56,.4)'"
                    onmouseout="this.style.boxShadow='0 1px 2px rgba(44,26,14,.04)';this.style.borderColor='rgba(110,84,56,.22)'">
                    <div style="position:relative">
                      {pic ? (
                        <img src={pic} alt="" style="width:100%;height:168px;object-fit:cover;display:block" />
                      ) : (
                        <div style="width:100%;height:168px;background:linear-gradient(135deg,#e9e0d2,#d4c4a8);display:flex;align-items:center;justify-content:center">
                          <img src="/images/logo-mark.png" alt="" style="width:48px;height:48px;opacity:.3" />
                        </div>
                      )}
                      <div style="position:absolute;inset:0;background:linear-gradient(to top,rgba(44,26,14,.18),transparent)"></div>
                      <span style={`position:absolute;top:12px;left:12px;font-family:'Montserrat',sans-serif;font-size:.68rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#fff;background:${statusBg};border-radius:50px;padding:5px 12px`}>{statusLabel}</span>
                      <button type="button" onclick={`removeSit('${s.id}', this)`} title="Remove"
                        style="position:absolute;top:10px;right:12px;width:32px;height:32px;border-radius:50%;background:rgba(255,255,255,.9);border:none;cursor:pointer;font-size:1rem;color:#b91c1c;display:flex;align-items:center;justify-content:center;transition:background .2s"
                        onmouseover="this.style.background='#fff'" onmouseout="this.style.background='rgba(255,255,255,.9)'">♥</button>
                    </div>
                    <div style="padding:22px 24px 24px;display:flex;flex-direction:column;gap:14px;flex:1">
                      <div>
                        <h2 style="font-family:'Marcellus',serif;font-size:1.18rem;color:#2c1a0e;margin:0 0 6px;line-height:1.3">{listing.title}</h2>
                        <p style="font-size:.82rem;color:#2f5d45;font-weight:600;margin:0">{ownerName}{location ? ` · ${location}` : ''}</p>
                      </div>
                      <div style="display:flex;flex-direction:column;gap:8px;font-size:.86rem;color:#6b4e35">
                        <span style="display:flex;align-items:center;gap:9px">
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#2f5d45" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0"><rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M3 10h18M8 3v4M16 3v4"></path></svg>
                          {listing.date_from && listing.date_to ? `${fmt(listing.date_from)} – ${fmt(listing.date_to)}` : 'Dates TBC'}
                        </span>
                      </div>
                      <p style="font-size:.8rem;color:#6e5438;margin:0">Saved {fmtAgo(s.created_at)}</p>
                      <div style="display:flex;gap:10px;margin-top:auto">
                        <a href={`/listings/${listing.id}`} style="flex:1;text-align:center;font-size:.76rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#fff;background:#2f5d45;border:1.5px solid #2f5d45;border-radius:50px;padding:13px 12px;text-decoration:none;transition:background .25s ease,transform .15s ease"
                          onmouseover="this.style.background='#3e7a5b';this.style.transform='translateY(-2px)'" onmouseout="this.style.background='#2f5d45';this.style.transform='translateY(0)'">View sit</a>
                        <button type="button" onclick={`removeSit('${s.id}', this.closest('article'))`}
                          style="font-family:'Montserrat',sans-serif;font-size:.74rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#6b4e35;background:none;border:1.5px solid rgba(44,26,14,.15);border-radius:50px;padding:11px 18px;cursor:pointer;transition:border-color .2s,color .2s"
                          onmouseover="this.style.borderColor='#b91c1c';this.style.color='#b91c1c'" onmouseout="this.style.borderColor='rgba(44,26,14,.15)';this.style.color='#6b4e35'">Remove</button>
                      </div>
                    </div>
                  </article>
                );
              })}
            </div>
          )}
        </div>

        <aside data-aside="1" style="position:sticky;top:28px;display:flex;flex-direction:column;gap:20px">
          <div style="background:#fff;border:1px solid rgba(110,84,56,.22);border-radius:18px;padding:26px 26px 28px;box-shadow:0 1px 2px rgba(44,26,14,.04);transition:box-shadow .3s ease,border-color .3s ease"
            onmouseover="this.style.boxShadow='0 10px 34px rgba(44,26,14,.08)';this.style.borderColor='rgba(110,84,56,.4)'"
            onmouseout="this.style.boxShadow='0 1px 2px rgba(44,26,14,.04)';this.style.borderColor='rgba(110,84,56,.22)'">
            <p style="font-size:.7rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:#6e5438;margin:0 0 8px">Saved searches</p>
            <p style="font-size:.87rem;color:#6b4e35;line-height:1.7;margin:0 0 20px">We&rsquo;ll email you when a new sit matches. Set up your preferences from the dashboard.</p>
            <a href="/dashboard" style="display:flex;align-items:center;justify-content:center;font-size:.76rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#2f5d45;text-decoration:none;border:1.5px dashed rgba(110,84,56,.5);border-radius:50px;padding:13px 20px;transition:background .25s ease,border-color .25s ease"
              onmouseover="this.style.background='rgba(110,84,56,.1)';this.style.borderColor='#2f5d45'" onmouseout="this.style.background='';this.style.borderColor='rgba(110,84,56,.5)'">Go to dashboard</a>
          </div>

          <div style="background:#faf6ee;border:1px solid rgba(110,84,56,.28);border-radius:18px;padding:22px 24px">
            <p style="font-size:.86rem;color:#6b4e35;line-height:1.7;margin:0">Saved sits disappear once the dates pass. Apply before they fill &mdash; most good sits go within a week.</p>
          </div>

          <div style="background:#fff;border:1px solid rgba(44,26,14,.1);border-radius:18px;padding:22px 24px">
            <p style="font-size:.86rem;color:#6b4e35;line-height:1.7;margin:0 0 14px">Browse more sits</p>
            <a href="/listings" style="display:inline-flex;align-items:center;gap:8px;font-size:.76rem;font-weight:600;letter-spacing:.11em;text-transform:uppercase;color:#2f5d45;text-decoration:none;border-bottom:1px solid rgba(110,84,56,.4);padding-bottom:2px;transition:gap .2s,color .2s"
              onmouseover="this.style.gap='12px';this.style.color='#2c1a0e'" onmouseout="this.style.gap='8px';this.style.color='#2f5d45'">Open listings &rarr;</a>
          </div>
        </aside>
      </div>
    </div>
  </main>
</div>

<script>
function setFilter(key) {
  document.querySelectorAll('[data-filter]').forEach(btn => {
    const active = (btn as HTMLElement).dataset.filter === key;
    (btn as HTMLElement).style.background = active ? '#2f5d45' : '#fff';
    (btn as HTMLElement).style.color = active ? '#fff' : '#5c3d20';
    (btn as HTMLElement).style.borderColor = active ? '#2f5d45' : 'rgba(110,84,56,.32)';
    const span = btn.querySelector('span');
    if (span) {
      (span as HTMLElement).style.background = active ? 'rgba(255,255,255,.25)' : 'rgba(110,84,56,.14)';
      (span as HTMLElement).style.color = active ? '#fff' : '#2f5d45';
    }
  });
  document.querySelectorAll('[data-sit-id]').forEach(el => {
    if (key === 'open') {
      (el as HTMLElement).style.display = (el as HTMLElement).dataset.status === 'active' ? '' : 'none';
    } else {
      (el as HTMLElement).style.display = '';
    }
  });
}

function removeSit(id, el) {
  const card = el.closest ? el.closest('[data-sit-id]') : el;
  if (!card) return;
  card.style.opacity = '0';
  card.style.transform = 'scale(.96)';
  card.style.transition = 'opacity .3s ease, transform .3s ease';
  setTimeout(() => card.remove(), 320);
  fetch('/api/saved-sits/remove', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id }) }).catch(() => {});
}

document.querySelectorAll('a[href]').forEach(a => {
  const href = a.getAttribute('href') || '';
  if (href.startsWith('#') || href.startsWith('http')) return;
  const loader = document.querySelector('[data-loader]');
  if (!loader) return;
  a.addEventListener('click', e => {
    if (e.metaKey || e.ctrlKey || e.shiftKey) return;
    (loader as HTMLElement).style.opacity = '1';
    (loader as HTMLElement).style.pointerEvents = 'all';
    setTimeout(() => { (loader as HTMLElement).style.opacity = '0'; (loader as HTMLElement).style.pointerEvents = 'none'; }, 1600);
  });
});
</script>
</body>
</html>
