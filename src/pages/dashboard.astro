---
export const prerender = false;

import '../styles/global.css';
import { getSession } from '../lib/auth';
import { supabase } from '../lib/supabase';

const session = await getSession(Astro.request);
if (!session) return Astro.redirect('/login');
if ((session.role ?? 'sitter') === 'owner') return Astro.redirect('/owner/dashboard');

let profile: any = null;
try {
  const { data } = await supabase
    .from('profiles')
    .select('*')
    .eq('user_id', session.userId)
    .single();
  profile = data;
} catch {}

const reviewCount = Array.isArray(profile?.reviews_json) ? profile.reviews_json.length : 0;
const heroImages: any[] = Array.isArray(profile?.hero_images_json) ? profile.hero_images_json : [];
const aboutImages: any[] = Array.isArray(profile?.about_images_json) ? profile.about_images_json : [];
const gallery: any[] = Array.isArray(profile?.gallery_json) ? profile.gallery_json : [];
const reviews: any[] = Array.isArray(profile?.reviews_json) ? profile.reviews_json : [];
const platforms: any[] = Array.isArray(profile?.platforms_json) ? profile.platforms_json : [];
const h = (profile?.headings_json ?? {}) as Record<string, string>;
const t = (profile?.theme_json ?? {}) as Record<string, string>;

const { data: listings } = await supabase
  .from('listings')
  .select('id, title, description, date_from, date_to, profile_id, profiles!inner(name, location, slug, profile_pic, pets_json, hero_images_json)')
  .eq('status', 'active')
  .gte('date_to', new Date().toISOString().slice(0, 10))
  .order('date_from', { ascending: true });

const sits = (listings ?? []) as any[];

function formatDate(d: string) {
  return new Date(d + 'T00:00:00').toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });
}

function formatDateLong(d: string) {
  return new Date(d + 'T00:00:00').toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
}

function daysBetween(from: string, to: string) {
  const ms = new Date(to + 'T00:00:00').getTime() - new Date(from + 'T00:00:00').getTime();
  return Math.ceil(ms / 86400000);
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Lato:wght@300;400;700&display=swap" rel="stylesheet" />
    <title>Dashboard — Grotto Sitters</title>
  </head>
  <body>
    <nav>
      <a href="/" class="nav-logo">Grotto <span>Sitters</span></a>

      <div class="tab-toggle">
        <button class="toggle-btn active" data-tab="dashboard">Dashboard</button>
        <button class="toggle-btn" data-tab="sits">Available Sits</button>
      </div>

      <div class="nav-right">
        <a href="/messages" class="nav-messages" title="Messages">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
          <span class="nav-msg-badge" id="navMsgBadge" style="display:none">0</span>
        </a>
        <span class="nav-email">{session.email}</span>
        <a href="/api/auth/logout" class="nav-logout">Log out</a>
      </div>

      <button class="burger" id="burger" aria-label="Menu">
        <span></span><span></span><span></span>
      </button>
    </nav>

    <div id="msgToasts" class="msg-toast-container"></div>
    <div class="mm-overlay" id="mmOverlay"></div>
    <div class="mobile-menu" id="mobileMenu">
      <div class="mm-header">
        <a href="/" class="mm-logo">Grotto <span>Sitters</span></a>
        <button class="mm-close" id="mmClose" aria-label="Close menu">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
      </div>
      <div class="mm-body">
        {profile && (
          <div class="mm-profile">
            {profile.profile_pic && <img src={profile.profile_pic} alt="" class="mm-avatar" />}
            <div>
              <p class="mm-profile-name">{profile.name}</p>
              <p class="mm-profile-email">{session.email}</p>
            </div>
          </div>
        )}
        <a href="#" class="mm-item" data-tab-link="dashboard">
          <div class="mm-item-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect></svg></div>
          <div class="mm-item-text">
            <span class="mm-item-title">Dashboard</span>
            <span class="mm-item-desc">Your profile overview</span>
          </div>
          <span class="mm-chevron">&#8250;</span>
        </a>
        <a href="#" class="mm-item" data-tab-link="sits">
          <div class="mm-item-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg></div>
          <div class="mm-item-text">
            <span class="mm-item-title">Available Sits</span>
            <span class="mm-item-desc">Browse homes that need a sitter</span>
          </div>
          <span class="mm-chevron">&#8250;</span>
        </a>
        <a href="/messages" class="mm-item">
          <div class="mm-item-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg></div>
          <div class="mm-item-text">
            <span class="mm-item-title">Messages <span class="mm-badge" id="mmMsgBadge" style="display:none">0</span></span>
            <span class="mm-item-desc">Chat with pet owners</span>
          </div>
          <span class="mm-chevron">&#8250;</span>
        </a>
        <div class="mm-divider"></div>
        <a href="/profile/edit" class="mm-item">
          <div class="mm-item-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg></div>
          <div class="mm-item-text">
            <span class="mm-item-title">Edit Profile</span>
            <span class="mm-item-desc">Update your bio, photos & colours</span>
          </div>
          <span class="mm-chevron">&#8250;</span>
        </a>
        {profile && (
          <a href={`/${profile.slug}`} class="mm-item">
            <div class="mm-item-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg></div>
            <div class="mm-item-text">
              <span class="mm-item-title">View Public Page</span>
              <span class="mm-item-desc">See how others see you</span>
            </div>
            <span class="mm-chevron">&#8250;</span>
          </a>
        )}
        <div class="mm-divider"></div>
        <a href="/api/auth/logout" class="mm-item mm-item-logout">
          <div class="mm-item-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg></div>
          <div class="mm-item-text">
            <span class="mm-item-title">Log Out</span>
          </div>
        </a>
      </div>
    </div>

    <main class="dash-wrap">
      <div class="section-inner">

        <!-- ═══ DASHBOARD TAB ═══ -->
        <div class="tab-panel active" id="panel-dashboard">
          {profile ? (
            <div class="dash-grid">
              <div class="dash-card profile-card">
                <div class="profile-card-inner">
                  {profile.profile_pic && (
                    <img src={profile.profile_pic} alt={profile.name} class="profile-avatar" />
                  )}
                  <div class="profile-card-info">
                    <h2 class="profile-name">{profile.name}</h2>
                    {profile.tagline && <p class="profile-tagline">{profile.tagline}</p>}
                    <a href={`/${profile.slug}`} target="_blank" class="profile-link">
                      grottositters.com/{profile.slug}
                    </a>
                  </div>
                </div>
                <div class="profile-card-actions">
                  <a href="/profile/edit" class="btn-primary">Edit profile</a>
                  <a href={`/${profile.slug}`} target="_blank" class="btn-view">View public page</a>
                </div>
              </div>

              <div class="stats-grid">
                <div class="stat-card">
                  <span class="stat-number">{reviewCount}</span>
                  <span class="stat-label">Reviews</span>
                </div>
                <div class="stat-card">
                  <span class="stat-number">{sits.length}</span>
                  <span class="stat-label">Sits Available</span>
                </div>
              </div>

              <div class="dash-card share-card">
                <h3>Share your profile</h3>
                <p>Send this link to pet owners so they can view your full portfolio, reviews, and get in touch.</p>
                <div class="share-url">
                  <input type="text" readonly value={`https://grottositters.com/${profile.slug}`} id="shareUrl" />
                  <button onclick="copyUrl()" class="copy-btn">Copy</button>
                </div>
              </div>
            </div>

            <div class="page-preview-wrap">
              <div class="page-preview-header">
                <div>
                  <h2 class="section-title preview-title">Your page preview</h2>
                  <p class="preview-sub">How your public profile currently looks with your colours applied.</p>
                </div>
                <a href="/profile/edit" class="preview-edit-link">Edit profile</a>
              </div>
              <div class="page-preview" style={`--pv-bg:${t.background || '#faf6ee'};--pv-accent:${t.accent || '#c8963e'};--pv-accent-light:${t.accent_light || '#e8b96a'};--pv-text:${t.text || '#2c1a0e'};--pv-text-soft:${t.text_soft || '#6b4e35'};`}>
                <div class="pv-hero">
                  {heroImages.length > 0 ? (
                    <img src={heroImages[0].src} alt="" class="pv-hero-img" style={`object-position:${heroImages[0].pos}`} />
                  ) : (
                    <div class="pv-hero-img pv-hero-empty"></div>
                  )}
                  <div class="pv-hero-overlay"></div>
                  <div class="pv-hero-content">
                    {profile.badge_text && <span class="pv-badge">{profile.badge_text}</span>}
                    <p class="pv-brand">Grotto <em>Sitters</em></p>
                    <p class="pv-name">{profile.name}</p>
                    {profile.tagline && <p class="pv-tagline">{profile.tagline}</p>}
                    <span class="pv-btn">Book {profile.account_type === 'joint' ? 'Us' : 'Me'} Today</span>
                  </div>
                </div>

                <div class="pv-section" style="background:var(--pv-bg);">
                  <p class="pv-label">{h.about_label || (profile.account_type === 'joint' ? 'Who We Are' : 'Who I Am')}</p>
                  <div class="pv-about-row">
                    {aboutImages.length > 0 && <img src={aboutImages[0].src} alt="" class="pv-about-img" />}
                    <div class="pv-about-text">
                      {profile.bio ? (
                        <p>{profile.bio.length > 100 ? profile.bio.slice(0, 100) + '...' : profile.bio}</p>
                      ) : (
                        <p class="pv-empty">No bio yet</p>
                      )}
                    </div>
                  </div>
                </div>

                {reviews.length > 0 && (
                  <div class="pv-section" style="background:var(--pv-bg);">
                    <p class="pv-label">{h.reviews_label || 'What Pet Owners Say'}</p>
                    <div class="pv-reviews-row">
                      {reviews.slice(0, 3).map((r: any) => (
                        <div class="pv-review-card">
                          <span class="pv-stars">★★★★★</span>
                          <p>"{r.text.length > 50 ? r.text.slice(0, 50) + '...' : r.text}"</p>
                          <span class="pv-reviewer">— {r.name}</span>
                        </div>
                      ))}
                    </div>
                  </div>
                )}

                {gallery.length > 0 && (
                  <div class="pv-section pv-gallery-section">
                    <p class="pv-label">{h.gallery_label || (profile.account_type === 'joint' ? "Pets We've Loved" : "Pets I've Loved")}</p>
                    <div class="pv-gallery-grid">
                      {gallery.slice(0, 8).map((img: any) => (
                        <div class="pv-gallery-item"><img src={img.src} alt="" /></div>
                      ))}
                    </div>
                  </div>
                )}

                {platforms.length > 0 && (
                  <div class="pv-section" style="background:var(--pv-bg);">
                    <p class="pv-label">{h.platforms_label || (profile.account_type === 'joint' ? 'Find Us Online' : 'Find Me Online')}</p>
                    <div class="pv-platforms-row">
                      {platforms.map((p: any) => (
                        <div class="pv-platform-chip">
                          <span class="pv-platform-letter">{p.name.charAt(0).toUpperCase()}</span>
                          <span>{p.name}</span>
                        </div>
                      ))}
                    </div>
                  </div>
                )}

                <div class="pv-section" style="background:var(--pv-bg);">
                  <p class="pv-label">{h.enquiry_label || 'Get In Touch'}</p>
                  <div class="pv-enquiry-mock">
                    <div class="pv-mock-field"></div>
                    <div class="pv-mock-field"></div>
                    <div class="pv-mock-field pv-mock-tall"></div>
                    <div class="pv-mock-btn">Send Enquiry</div>
                  </div>
                </div>

                <div class="pv-footer">
                  <p>Grotto <em>Sitters</em></p>
                  <span>{profile.name}</span>
                </div>
              </div>
            </div>
          ) : (
            <div class="no-profile">
              <div class="no-profile-icon">🐾</div>
              <h2>You don't have a profile yet</h2>
              <p>Create your sitter profile to get a shareable page with your bio, photos, and reviews.</p>
              <a href="/profile/create" class="btn-primary">Create your profile</a>
            </div>
          )}
        </div>

        <!-- ═══ AVAILABLE SITS TAB ═══ -->
        <div class="tab-panel" id="panel-sits">
          <header class="sits-header">
            <div>
              <h1 class="sits-heading">Find your next sit</h1>
              <p class="sits-sub">Browse homes looking for trusted sitters. Click any listing to see the full details, meet the pets, and get in touch.</p>
            </div>
          </header>

          {sits.length === 0 ? (
            <div class="sits-empty">
              <div class="sits-empty-icon">🔍</div>
              <h2>No sits available right now</h2>
              <p>Check back soon — new listings are posted regularly.</p>
            </div>
          ) : (
            <div class="sits-grid">
              {sits.map((listing: any) => {
                const lp = listing.profiles;
                const pets: any[] = Array.isArray(lp?.pets_json) ? lp.pets_json : [];
                const lHero: any[] = Array.isArray(lp?.hero_images_json) ? lp.hero_images_json : [];
                const duration = daysBetween(listing.date_from, listing.date_to);
                return (
                  <a href={`/listings/${listing.id}`} class="sit-card">
                    <div class="sit-card-img">
                      {lHero.length > 0 ? (
                        <img src={lHero[0].src} alt="" />
                      ) : lp?.profile_pic ? (
                        <img src={lp.profile_pic} alt="" />
                      ) : (
                        <div class="sit-card-placeholder"></div>
                      )}
                      <span class="sit-card-duration">{duration} day{duration !== 1 ? 's' : ''}</span>
                    </div>
                    <div class="sit-card-body">
                      <div class="sit-card-top">
                        <h3 class="sit-card-title">{listing.title}</h3>
                        {lp?.profile_pic && <img src={lp.profile_pic} alt="" class="sit-card-avatar" />}
                      </div>
                      <p class="sit-card-owner">{lp?.name}{lp?.location ? ` · ${lp.location}` : ''}</p>
                      <p class="sit-card-dates">{formatDateLong(listing.date_from)} — {formatDateLong(listing.date_to)}</p>
                      {pets.length > 0 && (
                        <div class="sit-card-pets">
                          {pets.slice(0, 3).map((p: any) => (
                            <span class="sit-card-pet">{p.name}{p.type ? ` · ${p.type}` : ''}</span>
                          ))}
                          {pets.length > 3 && <span class="sit-card-pet">+{pets.length - 3} more</span>}
                        </div>
                      )}
                      {listing.description && (
                        <p class="sit-card-desc">{listing.description.slice(0, 100)}{listing.description.length > 100 ? '...' : ''}</p>
                      )}
                    </div>
                  </a>
                );
              })}
            </div>
          )}
        </div>

      </div>
    </main>

    <script>
      function copyUrl() {
        const input = document.getElementById('shareUrl') as HTMLInputElement;
        input?.select();
        navigator.clipboard?.writeText(input?.value ?? '').then(() => {
          const btn = document.querySelector('.copy-btn') as HTMLButtonElement;
          if (btn) { btn.textContent = 'Copied!'; setTimeout(() => { btn.textContent = 'Copy'; }, 2000); }
        });
      }

      function switchTab(tab: string) {
        document.querySelectorAll('.toggle-btn').forEach(b => b.classList.remove('active'));
        document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
        document.querySelector(`.toggle-btn[data-tab="${tab}"]`)?.classList.add('active');
        document.getElementById(`panel-${tab}`)?.classList.add('active');
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }

      document.querySelectorAll('.toggle-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          switchTab((btn as HTMLElement).dataset.tab!);
        });
      });

      // Mobile menu
      const burger = document.getElementById('burger');
      const menu = document.getElementById('mobileMenu');
      const mmOverlay = document.getElementById('mmOverlay');
      const mmClose = document.getElementById('mmClose');

      function openMenu() { menu?.classList.add('open'); mmOverlay?.classList.add('open'); }
      function closeMenu() { menu?.classList.remove('open'); mmOverlay?.classList.remove('open'); }

      burger?.addEventListener('click', openMenu);
      mmClose?.addEventListener('click', closeMenu);
      mmOverlay?.addEventListener('click', closeMenu);

      document.querySelectorAll('[data-tab-link]').forEach(link => {
        link.addEventListener('click', (e) => {
          e.preventDefault();
          switchTab((link as HTMLElement).dataset.tabLink!);
          closeMenu();
        });
      });

      menu?.querySelectorAll('a:not([data-tab-link])').forEach(a => {
        a.addEventListener('click', closeMenu);
      });

      // ── MESSAGE NOTIFICATIONS ──
      (function() {
        const seenIds = new Set();
        let isFirst = true;

        function playNotifSound() {
          try {
            const ctx = new (window.AudioContext || window.webkitAudioContext)();
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();
            osc.connect(gain);
            gain.connect(ctx.destination);
            osc.frequency.setValueAtTime(660, ctx.currentTime);
            osc.frequency.setValueAtTime(880, ctx.currentTime + 0.1);
            osc.type = 'sine';
            gain.gain.setValueAtTime(0.08, ctx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.4);
            osc.start(ctx.currentTime);
            osc.stop(ctx.currentTime + 0.4);
          } catch {}
        }

        function esc(str) {
          const d = document.createElement('div');
          d.textContent = str;
          return d.innerHTML;
        }

        function showToast(msg) {
          const container = document.getElementById('msgToasts');
          if (!container) return;
          const sender = msg.sender || {};
          const initial = (sender.name || '?').charAt(0).toUpperCase();
          const avatar = sender.profile_pic
            ? `<img src="${esc(sender.profile_pic)}" class="msg-toast-avatar" />`
            : `<div class="msg-toast-avatar-ph">${initial}</div>`;
          const toast = document.createElement('a');
          toast.href = `/messages/${msg.conversation_id}`;
          toast.className = 'msg-toast';
          toast.innerHTML = `${avatar}<div class="msg-toast-body"><div class="msg-toast-name">${esc(sender.name || 'Someone')}</div><div class="msg-toast-preview">${esc((msg.body || '').slice(0, 80))}</div></div>`;
          container.appendChild(toast);
          setTimeout(() => { toast.classList.add('toast-out'); setTimeout(() => toast.remove(), 300); }, 5000);
        }

        function updateBadge(count) {
          const nav = document.getElementById('navMsgBadge');
          const mm = document.getElementById('mmMsgBadge');
          const label = count > 99 ? '99+' : String(count);
          [nav, mm].forEach(el => {
            if (!el) return;
            if (count > 0) { el.textContent = label; el.style.display = 'inline-flex'; }
            else { el.style.display = 'none'; }
          });
        }

        async function checkUnread() {
          try {
            const res = await fetch('/api/messages/unread');
            const data = await res.json();
            updateBadge(data.count || 0);
            if (data.messages) {
              if (!isFirst) {
                const fresh = data.messages.filter(m => !seenIds.has(m.id));
                if (fresh.length > 0) {
                  playNotifSound();
                  fresh.slice(0, 3).forEach(showToast);
                }
              }
              data.messages.forEach(m => seenIds.add(m.id));
            }
            isFirst = false;
          } catch {}
        }

        checkUnread();
        setInterval(checkUnread, 8000);
      })();
    </script>

    <style>
      body { min-height: 100vh; display: flex; flex-direction: column; background: var(--cream); }

      nav {
        position: static;
        border-bottom: 1px solid rgba(200,150,62,0.2);
        padding: 14px 48px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: #fff;
      }

      .nav-right { display: flex; align-items: center; gap: 20px; }

      /* ── NAV MESSAGES ICON ────────────────────────────────── */
      .nav-messages {
        position: relative; color: var(--text-soft); text-decoration: none;
        display: flex; align-items: center; padding: 4px;
        transition: color 0.2s;
      }
      .nav-messages:hover { color: var(--gold); }
      .nav-msg-badge {
        position: absolute; top: -6px; right: -8px;
        background: #ef4444; color: #fff; font-size: 0.6rem; font-weight: 700;
        min-width: 16px; height: 16px; border-radius: 8px; padding: 0 4px;
        display: inline-flex; align-items: center; justify-content: center;
        line-height: 1;
      }

      /* ── TOAST NOTIFICATIONS ──────────────────────────────── */
      .msg-toast-container {
        position: fixed; top: 20px; right: 20px; z-index: 1000;
        display: flex; flex-direction: column; gap: 10px;
        pointer-events: none;
      }
      .msg-toast {
        background: #fff; border-radius: 14px; padding: 14px 18px;
        box-shadow: 0 8px 32px rgba(0,0,0,0.18), 0 2px 8px rgba(0,0,0,0.08);
        display: flex; gap: 12px; align-items: center;
        pointer-events: auto; cursor: pointer; text-decoration: none; color: inherit;
        transform: translateX(120%); animation: toast-in 0.4s cubic-bezier(0.34,1.56,0.64,1) forwards;
        max-width: 380px; border-left: 4px solid var(--gold, #c8963e);
      }
      .msg-toast.toast-out { animation: toast-out 0.3s ease forwards; }
      @keyframes toast-in { from { transform: translateX(120%); opacity: 0; } to { transform: translateX(0); opacity: 1; } }
      @keyframes toast-out { from { transform: translateX(0); opacity: 1; } to { transform: translateX(120%); opacity: 0; } }
      .msg-toast-avatar { width: 42px; height: 42px; border-radius: 50%; object-fit: cover; flex-shrink: 0; }
      .msg-toast-avatar-ph {
        width: 42px; height: 42px; border-radius: 50%; flex-shrink: 0;
        background: rgba(200,150,62,0.12); color: var(--gold, #c8963e);
        display: flex; align-items: center; justify-content: center;
        font-weight: 700; font-size: 1rem; font-family: "Playfair Display", serif;
      }
      .msg-toast-body { flex: 1; min-width: 0; }
      .msg-toast-name { font-weight: 700; font-size: 0.88rem; color: var(--brown-dark, #2c1a0e); }
      .msg-toast-preview { font-size: 0.82rem; color: var(--text-soft, #6b4e35); margin-top: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

      /* ── HAMBURGER BADGE ──────────────────────────────────── */
      .mm-badge {
        display: inline-flex; align-items: center; justify-content: center;
        background: #ef4444; color: #fff; font-size: 0.6rem; font-weight: 700;
        min-width: 18px; height: 18px; border-radius: 9px; padding: 0 5px;
        margin-left: 6px; vertical-align: middle;
      }
      .nav-email { font-size: 0.85rem; color: var(--text-soft); }
      .nav-logout {
        font-size: 0.8rem; font-weight: 700; letter-spacing: 0.1em;
        text-transform: uppercase; color: var(--gold); text-decoration: none;
      }
      .nav-logout:hover { color: var(--brown-dark); }

      /* ── SEGMENTED TOGGLE ─────────────────────────────────── */
      .tab-toggle {
        display: flex;
        background: var(--cream); border-radius: 10px; padding: 4px;
        border: 1px solid rgba(44,26,14,0.08);
      }
      .toggle-btn {
        background: none; border: none; cursor: pointer;
        padding: 10px 24px; font-family: "Lato", sans-serif;
        font-size: 0.88rem; font-weight: 600; color: var(--text-soft);
        border-radius: 8px; transition: all 0.2s;
        white-space: nowrap;
      }
      .toggle-btn:hover { color: var(--brown-dark); }
      .toggle-btn.active {
        background: #fff; color: var(--brown-dark); font-weight: 700;
        box-shadow: 0 1px 4px rgba(44,26,14,0.1);
      }

      /* ── BURGER ───────────────────────────────────────────── */
      .burger {
        display: none; background: none; border: none; cursor: pointer;
        flex-direction: column; gap: 5px; padding: 4px;
      }
      .burger span {
        display: block; width: 22px; height: 2px;
        background: var(--brown-dark); border-radius: 2px;
        transition: transform 0.3s, opacity 0.3s;
      }

      /* ── MOBILE MENU DRAWER ───────────────────────────────── */
      .mm-overlay {
        position: fixed; inset: 0; background: rgba(0,0,0,0.5);
        z-index: 200; opacity: 0; pointer-events: none;
        transition: opacity 0.3s;
      }
      .mm-overlay.open { opacity: 1; pointer-events: auto; }

      .mobile-menu {
        position: fixed; top: 0; right: 0; bottom: 0;
        width: 320px; max-width: 85vw; background: #fff; z-index: 201;
        transform: translateX(100%); transition: transform 0.3s ease;
        display: flex; flex-direction: column;
      }
      .mobile-menu.open { transform: translateX(0); }

      .mm-header {
        display: flex; justify-content: space-between; align-items: center;
        padding: 20px 24px; border-bottom: 1px solid rgba(200,150,62,0.15);
      }
      .mm-logo { font-family: "Playfair Display", serif; font-size: 1.2rem; color: var(--brown-dark); text-decoration: none; }
      .mm-logo span { color: var(--gold); font-style: italic; }
      .mm-close { background: none; border: none; cursor: pointer; color: var(--text-soft); padding: 4px; }
      .mm-close:hover { color: var(--brown-dark); }

      .mm-body { flex: 1; overflow-y: auto; padding: 16px 0; }

      .mm-profile {
        display: flex; gap: 14px; align-items: center;
        padding: 12px 24px 20px; margin-bottom: 4px;
      }
      .mm-avatar { width: 44px; height: 44px; border-radius: 50%; object-fit: cover; }
      .mm-profile-name { font-family: "Playfair Display", serif; font-size: 1rem; color: var(--brown-dark); font-weight: 700; }
      .mm-profile-email { font-size: 0.78rem; color: var(--text-soft); margin-top: 2px; }

      .mm-item {
        display: flex; align-items: center; gap: 14px;
        padding: 14px 24px; text-decoration: none; color: var(--text);
        transition: background 0.15s;
      }
      .mm-item:hover { background: var(--cream); }
      .mm-item-icon { color: var(--gold); flex-shrink: 0; }
      .mm-item-text { flex: 1; }
      .mm-item-title { display: block; font-size: 0.92rem; font-weight: 600; color: var(--brown-dark); }
      .mm-item-desc { display: block; font-size: 0.78rem; color: var(--text-soft); margin-top: 2px; }
      .mm-chevron { font-size: 1.2rem; color: rgba(44,26,14,0.2); font-weight: 300; }
      .mm-item-logout { margin-top: auto; }
      .mm-item-logout .mm-item-title { color: #b91c1c; }
      .mm-item-logout .mm-item-icon { color: #b91c1c; }
      .mm-divider { height: 1px; background: rgba(44,26,14,0.08); margin: 8px 24px; }

      /* ── TAB PANELS ───────────────────────────────────────── */
      .tab-panel { display: none; }
      .tab-panel.active { display: block; }

      .dash-wrap { flex: 1; padding: 40px 48px 60px; }

      /* ── DASHBOARD TAB ────────────────────────────────────── */
      .dash-grid {
        display: grid;
        grid-template-columns: 1fr 260px;
        grid-template-rows: auto auto;
        gap: 24px;
      }

      .dash-card {
        background: #fff; border-radius: 12px; padding: 32px;
        box-shadow: 0 2px 16px rgba(44,26,14,0.06);
      }

      .profile-card { grid-column: 1; grid-row: 1; }
      .profile-card-inner { display: flex; gap: 24px; align-items: flex-start; margin-bottom: 24px; }
      .profile-avatar { width: 80px; height: 80px; border-radius: 50%; object-fit: cover; flex-shrink: 0; }
      .profile-name { font-family: "Playfair Display", serif; font-size: 1.4rem; color: var(--brown-dark); margin-bottom: 6px; }
      .profile-tagline { font-size: 0.9rem; color: var(--text-soft); line-height: 1.5; margin-bottom: 10px; }
      .profile-link { font-size: 0.8rem; color: var(--gold); font-weight: 700; text-decoration: none; letter-spacing: 0.03em; }
      .profile-link:hover { text-decoration: underline; }
      .profile-card-actions { border-top: 1px solid rgba(44,26,14,0.08); padding-top: 24px; display: flex; gap: 16px; align-items: center; }
      .btn-view { font-size: 0.82rem; color: var(--gold); font-weight: 700; text-decoration: none; letter-spacing: 0.04em; }
      .btn-view:hover { text-decoration: underline; }

      .stats-grid { grid-column: 2; grid-row: 1; display: flex; flex-direction: column; gap: 16px; }
      .stat-card {
        background: #fff; border-radius: 12px; padding: 24px;
        box-shadow: 0 2px 16px rgba(44,26,14,0.06);
        text-align: center; flex: 1; display: flex; flex-direction: column; gap: 6px;
      }
      .stat-number { font-family: "Playfair Display", serif; font-size: 2rem; color: var(--gold); font-weight: 700; }
      .stat-label { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-soft); }

      .share-card { grid-column: 1 / -1; grid-row: 2; }
      .share-card h3 { font-family: "Playfair Display", serif; font-size: 1.2rem; color: var(--brown-dark); margin-bottom: 8px; }
      .share-card p { font-size: 0.9rem; color: var(--text-soft); margin-bottom: 16px; line-height: 1.6; }
      .share-url { display: flex; gap: 10px; }
      .share-url input {
        flex: 1; border: 1.5px solid rgba(44,26,14,0.15); border-radius: 6px;
        padding: 10px 14px; font-size: 0.9rem; font-family: "Lato", sans-serif;
        color: var(--text); background: var(--cream); outline: none;
      }
      .copy-btn {
        background: var(--gold); color: #fff; border: none; border-radius: 6px;
        padding: 10px 20px; font-size: 0.85rem; font-weight: 700;
        cursor: pointer; white-space: nowrap; transition: background 0.2s;
      }
      .copy-btn:hover { background: var(--gold-light); }

      .no-profile {
        background: #fff; border-radius: 12px; padding: 80px 48px; text-align: center;
        box-shadow: 0 2px 16px rgba(44,26,14,0.06); max-width: 520px; margin: 0 auto;
      }
      .no-profile-icon { font-size: 3rem; margin-bottom: 20px; }
      .no-profile h2 { font-family: "Playfair Display", serif; font-size: 1.6rem; color: var(--brown-dark); margin-bottom: 12px; }
      .no-profile p { font-size: 0.95rem; color: var(--text-soft); line-height: 1.7; margin-bottom: 32px; }

      /* ── AVAILABLE SITS TAB ───────────────────────────────── */
      .sits-header { margin-bottom: 32px; }
      .sits-heading {
        font-family: "Playfair Display", serif; font-size: 2rem;
        color: var(--brown-dark); margin-bottom: 8px;
      }
      .sits-sub { font-size: 0.95rem; color: var(--text-soft); line-height: 1.7; max-width: 600px; }

      .sits-empty {
        background: #fff; border-radius: 16px; padding: 80px 48px; text-align: center;
        box-shadow: 0 2px 12px rgba(44,26,14,0.05); max-width: 520px; margin: 0 auto;
      }
      .sits-empty-icon { font-size: 3rem; margin-bottom: 20px; }
      .sits-empty h2 { font-family: "Playfair Display", serif; font-size: 1.5rem; color: var(--brown-dark); margin-bottom: 12px; }
      .sits-empty p { font-size: 0.95rem; color: var(--text-soft); line-height: 1.7; }

      .sits-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 28px;
      }

      .sit-card {
        background: #fff; border-radius: 16px; overflow: hidden;
        text-decoration: none; color: inherit;
        box-shadow: 0 1px 6px rgba(44,26,14,0.06);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
      }
      .sit-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 40px rgba(44,26,14,0.13);
      }

      .sit-card-img {
        position: relative; width: 100%; aspect-ratio: 16/10; overflow: hidden;
        background: linear-gradient(135deg, #e8dcc8 0%, #d4c4a8 100%);
      }
      .sit-card-img img {
        width: 100%; height: 100%; object-fit: cover; display: block;
        transition: transform 0.4s ease;
      }
      .sit-card:hover .sit-card-img img { transform: scale(1.06); }
      .sit-card-placeholder {
        width: 100%; height: 100%;
        background: linear-gradient(135deg, #e8dcc8 0%, #d4c4a8 100%);
      }
      .sit-card-duration {
        position: absolute; top: 14px; left: 14px;
        background: #fff; color: var(--brown-dark); font-size: 0.75rem; font-weight: 700;
        padding: 6px 14px; border-radius: 24px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.12);
      }

      .sit-card-body { padding: 18px 20px 22px; }
      .sit-card-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; }
      .sit-card-title {
        font-family: "Playfair Display", serif; font-size: 1.1rem;
        color: var(--brown-dark); line-height: 1.3; flex: 1;
      }
      .sit-card-avatar {
        width: 36px; height: 36px; border-radius: 50%; object-fit: cover;
        flex-shrink: 0; border: 2px solid rgba(200,150,62,0.2);
      }
      .sit-card-owner { font-size: 0.82rem; color: var(--text-soft); margin-top: 4px; margin-bottom: 10px; }
      .sit-card-dates {
        font-size: 0.82rem; color: var(--brown-mid); font-weight: 600; margin-bottom: 12px;
      }
      .sit-card-pets { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 12px; }
      .sit-card-pet {
        background: rgba(200,150,62,0.08); color: var(--brown-mid);
        font-size: 0.75rem; font-weight: 600; padding: 4px 12px;
        border-radius: 20px; border: 1px solid rgba(200,150,62,0.15);
      }
      .sit-card-desc {
        font-size: 0.85rem; color: var(--text-soft); line-height: 1.6;
        display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
      }

      /* ── FULL PAGE PREVIEW ────────────────────────────────── */
      .page-preview-wrap { margin-top: 56px; }
      .page-preview-header {
        display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px;
      }
      .preview-title { font-size: 1.6rem; margin-bottom: 4px; }
      .preview-sub { font-size: 0.9rem; color: var(--text-soft); line-height: 1.6; }
      .preview-edit-link {
        font-size: 0.78rem; font-weight: 700; color: var(--gold);
        text-decoration: none; letter-spacing: 0.04em; white-space: nowrap; margin-top: 6px;
      }
      .preview-edit-link:hover { text-decoration: underline; }

      .page-preview {
        background: var(--pv-bg); border-radius: 12px; overflow: hidden;
        box-shadow: 0 4px 24px rgba(44,26,14,0.12); border: 1px solid rgba(44,26,14,0.08);
      }

      .pv-hero { position: relative; height: 220px; overflow: hidden; }
      .pv-hero-img { width: 100%; height: 100%; object-fit: cover; display: block; }
      .pv-hero-empty { background: linear-gradient(135deg, #2c1a0e 0%, #4a3525 100%); height: 100%; }
      .pv-hero-overlay { position: absolute; inset: 0; background: rgba(44,26,14,0.5); }
      .pv-hero-content { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; z-index: 2; text-align: center; padding: 16px; }
      .pv-badge { font-size: 0.6rem; background: rgba(255,255,255,0.15); color: #fff; padding: 4px 12px; border-radius: 50px; margin-bottom: 8px; font-weight: 700; letter-spacing: 0.06em; }
      .pv-brand { font-family: "Playfair Display", serif; font-size: 1.8rem; color: #fff; line-height: 1; }
      .pv-brand em { color: var(--pv-accent); font-style: italic; }
      .pv-name { font-size: 0.75rem; color: rgba(255,255,255,0.85); font-weight: 700; letter-spacing: 0.06em; margin-top: 6px; }
      .pv-tagline { font-size: 0.65rem; color: rgba(255,255,255,0.6); margin-top: 2px; }
      .pv-btn { display: inline-block; margin-top: 10px; background: var(--pv-accent); color: #fff; font-size: 0.6rem; font-weight: 700; padding: 6px 16px; border-radius: 6px; letter-spacing: 0.06em; text-transform: uppercase; }

      .pv-section { padding: 20px 24px; }
      .pv-label { font-size: 0.6rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--pv-accent); margin-bottom: 10px; }

      .pv-about-row { display: flex; gap: 14px; align-items: flex-start; }
      .pv-about-img { width: 70px; height: 70px; border-radius: 8px; object-fit: cover; flex-shrink: 0; }
      .pv-about-text p { font-size: 0.72rem; color: var(--pv-text-soft); line-height: 1.6; }
      .pv-empty { font-style: italic; opacity: 0.4; }

      .pv-reviews-row { display: flex; gap: 10px; overflow: hidden; }
      .pv-review-card { flex: 1; min-width: 0; background: var(--pv-bg); border: 1px solid rgba(200,150,62,0.1); border-radius: 8px; padding: 12px; }
      .pv-stars { color: var(--pv-accent); font-size: 0.55rem; display: block; margin-bottom: 4px; }
      .pv-review-card p { font-size: 0.62rem; color: var(--pv-text-soft); line-height: 1.5; font-style: italic; margin-bottom: 4px; }
      .pv-reviewer { font-size: 0.55rem; font-weight: 700; color: var(--pv-accent); }

      .pv-gallery-section { background: var(--pv-bg); }
      .pv-gallery-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 4px; }
      .pv-gallery-item { aspect-ratio: 1; border-radius: 4px; overflow: hidden; }
      .pv-gallery-item img { width: 100%; height: 100%; object-fit: cover; display: block; }

      .pv-platforms-row { display: flex; flex-wrap: wrap; gap: 8px; }
      .pv-platform-chip { display: flex; align-items: center; gap: 8px; padding: 6px 12px; background: rgba(200,150,62,0.08); border-radius: 6px; font-size: 0.65rem; font-weight: 600; color: var(--pv-text); }
      .pv-platform-letter { font-family: "Playfair Display", serif; font-size: 0.6rem; font-weight: 700; width: 20px; height: 20px; border-radius: 50%; background: var(--pv-accent); color: #fff; display: flex; align-items: center; justify-content: center; }

      .pv-enquiry-mock { display: flex; flex-direction: column; gap: 6px; max-width: 240px; }
      .pv-mock-field { height: 18px; background: rgba(44,26,14,0.04); border: 1px solid rgba(44,26,14,0.08); border-radius: 3px; }
      .pv-mock-tall { height: 32px; }
      .pv-mock-btn { background: var(--pv-accent); color: #fff; text-align: center; padding: 6px; border-radius: 4px; font-size: 0.55rem; font-weight: 700; }

      .pv-footer { background: var(--pv-text, #2c1a0e); padding: 14px 24px; display: flex; justify-content: space-between; align-items: center; }
      .pv-footer p { font-family: "Playfair Display", serif; font-size: 0.75rem; color: rgba(255,255,255,0.7); }
      .pv-footer p em { color: var(--pv-accent); font-style: italic; }
      .pv-footer span { font-size: 0.6rem; color: rgba(255,255,255,0.4); }

      @media (max-width: 768px) {
        nav { padding: 12px 20px; }
        .nav-right { display: none; }
        .tab-toggle { display: flex; }
        .toggle-btn { padding: 8px 16px; font-size: 0.82rem; }
        .burger { display: flex; }
        .dash-wrap { padding: 28px 20px; }
        .dash-grid { grid-template-columns: 1fr; grid-template-rows: auto; }
        .stats-grid { grid-column: 1; grid-row: 2; flex-direction: row; }
        .share-card { grid-column: 1; grid-row: 3; }
        .share-url { flex-direction: column; }
        .sits-grid { grid-template-columns: 1fr; }
        .sits-heading { font-size: 1.5rem; }
        .no-profile { padding: 48px 24px; }
        .page-preview-header { flex-direction: column; gap: 8px; }
      }
    </style>
  </body>
</html>
