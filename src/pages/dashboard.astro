                      <span style="width:10px;height:10px;border-radius:50%;background:rgba(44,26,14,.14);display:block"></span>
                    </span>
                    <span style="flex:1;background:#faf6ee;border:1px solid rgba(110,84,56,.25);border-radius:50px;padding:7px 16px;font-size:.74rem;color:#6b4e35;letter-spacing:.02em;display:flex;align-items:center;gap:9px;min-width:0">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#2f5d45" stroke-width="1.8" stroke-linecap="round" style="flex-shrink:0"><rect x="4.5" y="10.5" width="15" height="10" rx="2"></rect><path d="M8 10.5V8a4 4 0 0 1 8 0v2.5"></path></svg>
                      myahsits.com/{profile.slug}
                    </span>
                  </div>
                  <div style="position:relative;height:230px;overflow:hidden">
                    {heroImages.length > 0 ? (
                      <img src={heroImages[0].src} alt="" style={`width:100%;height:100%;object-fit:cover;display:block;object-position:${heroImages[0].pos || 'center 30%'}`} />
                    ) : (
                      <div style="width:100%;height:100%;background:linear-gradient(135deg,#2c1a0e 0%,#4a3525 100%)"></div>
                    )}
                    <div style="position:absolute;inset:0;background:rgba(44,26,14,.55)"></div>
                    <div style="position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;z-index:2;text-align:center;padding:16px">
                      {profile.badge_text && <span style="font-size:.58rem;background:rgba(255,255,255,.16);border:1px solid rgba(196,171,138,.4);color:#fff;padding:5px 14px;border-radius:50px;margin-bottom:10px;font-weight:600;letter-spacing:.12em;text-transform:uppercase">{profile.badge_text}</span>}
                      <p style="font-family:'Montserrat',sans-serif;font-weight:500;letter-spacing:.28em;font-size:1.9rem;color:#fff;line-height:1;margin:0">MYAH</p>
                      <p style="font-size:.72rem;color:rgba(255,255,255,.88);font-weight:600;letter-spacing:.12em;text-transform:uppercase;margin:8px 0 0">{profile.name}</p>
                      <span style="display:inline-block;margin-top:12px;background:#2f5d45;color:#fff;font-size:.58rem;font-weight:600;padding:8px 18px;border-radius:50px;letter-spacing:.1em;text-transform:uppercase">Book {profile.account_type === 'joint' ? 'Us' : 'Me'} Today</span>
                    </div>
                  </div>
                  {aboutImages.length > 0 || profile.bio ? (
                    <div style="padding:22px 26px">
                      <p style="font-size:.58rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:#6e5438;margin:0 0 12px">{h.about_label || (profile.account_type === 'joint' ? 'Who we are' : 'Who I am')}</p>
                      <div style="display:flex;gap:14px;align-items:flex-start">
                        {aboutImages.length > 0 && <img src={aboutImages[0].src} alt="" style="width:74px;height:74px;border-radius:10px;object-fit:cover;flex-shrink:0" />}
                        <p style="font-size:.74rem;color:#6b4e35;line-height:1.7;margin:0">{profile.bio ? (profile.bio.length > 120 ? profile.bio.slice(0, 120) + '…' : profile.bio) : ''}</p>
                      </div>
                    </div>
                  ) : null}
                  {reviews.length > 0 && (
                    <div style="padding:22px 26px">
                      <p style="font-size:.58rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:#6e5438;margin:0 0 12px">What pet owners say</p>
                      <div style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px">
                        {reviews.slice(0, 3).map((r: any) => (
                          <div style="background:#fff;border:1px solid rgba(110,84,56,.18);border-radius:10px;padding:13px">
                            <span style="color:#2f5d45;font-size:.55rem;display:block;margin-bottom:6px;letter-spacing:.2em">★★★★★</span>
                            <p style="font-size:.64rem;color:#6b4e35;line-height:1.6;font-style:italic;margin:0 0 6px">"{r.text && r.text.length > 60 ? r.text.slice(0, 60) + '…' : r.text}"</p>
                            <span style="font-size:.56rem;font-weight:700;color:#2f5d45;letter-spacing:.04em">— {r.name}</span>
                          </div>
                        ))}
                      </div>
                    </div>
                  )}
                  {gallery.length > 0 && (
                    <div style="padding:22px 26px">
                      <p style="font-size:.58rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:#6e5438;margin:0 0 12px">Pets we've loved</p>
                      <div style="display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:5px">
                        {gallery.slice(0, 8).map((img: any) => (
                          <div style="aspect-ratio:1;border-radius:6px;overflow:hidden;background:#e9e0d2"><img src={img.src} alt="" style="width:100%;height:100%;object-fit:cover;display:block" /></div>
                        ))}
                      </div>
                    </div>
                  )}
                  <div style="background:#2c1a0e;padding:16px 26px;display:flex;justify-content:space-between;align-items:center;gap:16px">
                    <p style="font-family:'Marcellus',serif;font-size:.82rem;margin:0"><span style="color:#2f5d45">MYAH</span></p>
                    <span style="font-size:.6rem;font-weight:600;color:rgba(255,255,255,.45);letter-spacing:.1em;text-transform:uppercase">{profile.name}</span>
                  </div>
                </div>
              </div>
            </div>
          </>
        ) : (
          <div style="background:#fff;border:1px solid rgba(110,84,56,.22);border-radius:18px;padding:80px 48px;text-align:center;max-width:540px;margin:0 auto;box-shadow:0 1px 2px rgba(44,26,14,.04)">
            <span style="width:58px;height:58px;border-radius:16px;background:#faf6ee;border:1px solid rgba(110,84,56,.28);color:#6e5438;display:inline-flex;align-items:center;justify-content:center;margin-bottom:22px"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg></span>
            <h2 style="font-family:'Marcellus',serif;font-size:1.6rem;color:#2c1a0e;margin:0 0 12px">You don't have a profile yet</h2>
            <p style="font-size:.95rem;color:#6b4e35;line-height:1.7;margin:0 0 28px">Create your sitter profile to get a shareable page with your bio, photos, and reviews.</p>
            <a href="/profile/create" style="display:inline-flex;align-items:center;justify-content:center;gap:8px;font-size:.82rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#fff;text-decoration:none;background:#2f5d45;border:1.5px solid #2f5d45;border-radius:50px;padding:16px 36px;box-shadow:0 6px 20px rgba(110,84,56,.28);transition:background .2s, border-color .2s, transform .12s">Create your profile</a>
          </div>
        )}
      </div>

      <!-- SITS TAB -->
      <div id="panel-sits" class="tab-panel" style="display:none">
        <div style="margin-bottom:34px">
          <p style="font-size:.75rem;font-weight:600;letter-spacing:.2em;text-transform:uppercase;color:#6e5438;margin:0 0 16px;display:flex;align-items:center;gap:12px"><span style="width:26px;height:1px;background:#6e5438;display:block;flex-shrink:0"></span>Available sits</p>
          <h1 style="font-family:'Marcellus',serif;font-size:2.3rem;color:#2c1a0e;margin:0 0 10px;line-height:1.2">Find your <em style="color:#2f5d45;">next sit</em></h1>
          <p style="font-size:.95rem;color:#6b4e35;line-height:1.7;max-width:600px;margin:0">Browse homes looking for trusted sitters. Open any listing to see the full details, meet the pets, and get in touch.</p>
        </div>
        {sits.length === 0 ? (
          <div style="background:#fff;border:1px solid rgba(110,84,56,.22);border-radius:18px;padding:80px 48px;text-align:center;max-width:520px;margin:0 auto;box-shadow:0 1px 2px rgba(44,26,14,.04)">
            <span style="width:58px;height:58px;border-radius:16px;background:#faf6ee;border:1px solid rgba(110,84,56,.28);color:#6e5438;display:inline-flex;align-items:center;justify-content:center;margin-bottom:22px"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg></span>
            <h2 style="font-family:'Marcellus',serif;font-size:1.6rem;color:#2c1a0e;margin:0 0 12px">No sits available right now</h2>
            <p style="font-size:.95rem;color:#6b4e35;line-height:1.7;margin:0">Check back soon — new listings are posted regularly.</p>
          </div>
        ) : (
          <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:26px">
            {sits.map((listing: any) => {
              const lp = listing.profiles;
              const pets: any[] = Array.isArray(lp?.pets_json) ? lp.pets_json : [];
              const lHero: any[] = Array.isArray(lp?.hero_images_json) ? lp.hero_images_json : [];
              const duration = daysBetween(listing.date_from, listing.date_to);
              return (
                <a href={`/listings/${listing.id}`} class="sit-card" style="background:#fff;border:1px solid rgba(110,84,56,.22);border-radius:18px;overflow:hidden;text-decoration:none;color:inherit;box-shadow:0 1px 2px rgba(44,26,14,.04);display:block;transition:transform .3s ease, box-shadow .3s ease, border-color .3s ease">
                  <div style="position:relative;width:100%;aspect-ratio:16/10;overflow:hidden;background:#e9e0d2">
                    {lHero.length > 0 ? (
                      <img src={lHero[0].src} alt="" style="width:100%;height:100%;object-fit:cover;display:block" />
                    ) : lp?.profile_pic ? (
                      <img src={lp.profile_pic} alt="" style="width:100%;height:100%;object-fit:cover;display:block" />
                    ) : (
                      <div style="width:100%;height:100%;background:linear-gradient(135deg,#e8dcc8 0%,#d4c4a8 100%)"></div>
                    )}
                    <span style="position:absolute;top:14px;left:14px;background:#fff;color:#2c1a0e;font-size:.72rem;font-weight:700;letter-spacing:.06em;padding:7px 15px;border-radius:50px;box-shadow:0 2px 8px rgba(0,0,0,.14)">{duration} day{duration !== 1 ? 's' : ''}</span>
                  </div>
                  <div style="padding:20px 22px 24px">
                    <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:12px">
                      <h3 style="font-family:'Marcellus',serif;font-size:1.12rem;color:#2c1a0e;line-height:1.3;margin:0;flex:1">{listing.title}</h3>
                      {lp?.profile_pic && <img src={lp.profile_pic} alt="" style="width:38px;height:38px;border-radius:50%;object-fit:cover;flex-shrink:0;border:2px solid rgba(110,84,56,.25)" />}
                    </div>
                    <p style="font-size:.83rem;color:#6b4e35;margin:6px 0 10px">{lp?.name}{lp?.location ? ` · ${lp.location}` : ''}</p>
                    <p style="font-size:.83rem;color:#5c3d20;font-weight:700;margin:0 0 12px">{formatDateLong(listing.date_from)} — {formatDateLong(listing.date_to)}</p>
                    {pets.length > 0 && (
                      <div style="display:flex;flex-wrap:wrap;gap:7px">
                        {pets.slice(0, 3).map((p: any) => (
                          <span style="background:rgba(110,84,56,.08);color:#5c3d20;font-size:.74rem;font-weight:700;padding:5px 13px;border-radius:50px;border:1px solid rgba(110,84,56,.22)">{p.name}{p.type ? ` · ${p.type}` : ''}</span>
                        ))}
                        {pets.length > 3 && <span style="background:rgba(110,84,56,.08);color:#5c3d20;font-size:.74rem;font-weight:700;padding:5px 13px;border-radius:50px;border:1px solid rgba(110,84,56,.22)">+{pets.length - 3} more</span>}
                      </div>
                    )}
                  </div>
                </a>
              );
            })}
          </div>
        )}
      </div>

      <!-- MESSAGES TAB -->
      <div id="panel-messages" class="tab-panel" style="display:none">
        <div style="background:#fff;border:1px solid rgba(110,84,56,.22);border-radius:18px;padding:80px 48px;text-align:center;max-width:540px;margin:0 auto;box-shadow:0 1px 2px rgba(44,26,14,.04)">
          <span style="width:58px;height:58px;border-radius:16px;background:#faf6ee;border:1px solid rgba(110,84,56,.28);color:#6e5438;display:inline-flex;align-items:center;justify-content:center;margin-bottom:22px"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg></span>
          <h2 style="font-family:'Marcellus',serif;font-size:1.6rem;color:#2c1a0e;margin:0 0 12px">No messages yet</h2>
          <p style="font-size:.95rem;color:#6b4e35;line-height:1.7;margin:0 0 28px">When an owner gets in touch about a sit, the conversation will appear here.</p>
          <a href="/messages" style="display:inline-flex;align-items:center;justify-content:center;gap:8px;font-size:.82rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#fff;text-decoration:none;background:#2f5d45;border:1.5px solid #2f5d45;border-radius:50px;padding:16px 36px;box-shadow:0 6px 20px rgba(110,84,56,.28);transition:background .2s, border-color .2s, transform .12s">Open messages</a>
        </div>
      </div>

      <!-- PROFILE TAB -->
      <div id="panel-profile" class="tab-panel" style="display:none">
        <div style="background:#fff;border:1px solid rgba(110,84,56,.22);border-radius:18px;padding:80px 48px;text-align:center;max-width:540px;margin:0 auto;box-shadow:0 1px 2px rgba(44,26,14,.04)">
          <span style="width:58px;height:58px;border-radius:16px;background:#faf6ee;border:1px solid rgba(110,84,56,.28);color:#6e5438;display:inline-flex;align-items:center;justify-content:center;margin-bottom:22px"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg></span>
          <h2 style="font-family:'Marcellus',serif;font-size:1.6rem;color:#2c1a0e;margin:0 0 12px">Edit your profile</h2>
          <p style="font-size:.95rem;color:#6b4e35;line-height:1.7;margin:0 0 28px">Update your bio, photos, reviews, platform links and colours — everything that appears on your public page.</p>
          <a href="/profile/edit" style="display:inline-flex;align-items:center;justify-content:center;gap:8px;font-size:.82rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#fff;text-decoration:none;background:#2f5d45;border:1.5px solid #2f5d45;border-radius:50px;padding:16px 36px;box-shadow:0 6px 20px rgba(110,84,56,.28);transition:background .2s, border-color .2s, transform .12s">Open profile editor</a>
        </div>
      </div>

    </div>
  </main>
</div>

<style>
  .sit-card:hover { transform:translateY(-6px); box-shadow:0 20px 50px rgba(44,26,14,.12); border-color:rgba(110,84,56,.45) !important; }
  #btn-edit-profile:hover { background:#3e7a5b; border-color:#3e7a5b; transform:translateY(-2px); box-shadow:0 12px 28px rgba(110,84,56,.36); }
  #btn-edit-profile:active { transform:translateY(0) scale(.98); }
  #copyBtn:hover { background:#3e7a5b; border-color:#3e7a5b; transform:translateY(-2px); box-shadow:0 12px 28px rgba(110,84,56,.36); }
  #copyBtn:active { transform:translateY(0) scale(.98); }
  #card-profile:hover, #card-share:hover, #card-strength:hover, #stat-reviews:hover, #stat-sits:hover { box-shadow:0 10px 34px rgba(44,26,14,.08); border-color:rgba(110,84,56,.4) !important; }
  #btn-photos:hover, #btn-reviews:hover, #btn-colours:hover { background:#2f5d45; color:#fff; border-color:#2f5d45 !important; }
  [data-acct-links] a:hover { color:#2f5d45 !important; }
  .msg-toast { background:#fff; border-radius:14px; padding:14px 18px; box-shadow:0 8px 32px rgba(0,0,0,.18),0 2px 8px rgba(0,0,0,.08); display:flex; gap:12px; align-items:center; pointer-events:auto; cursor:pointer; text-decoration:none; color:inherit; transform:translateX(120%); animation:toast-in .4s cubic-bezier(.34,1.56,.64,1) forwards; max-width:380px; border-left:4px solid #2f5d45; }
  .msg-toast.toast-out { animation:toast-out .3s ease forwards; }
  .msg-toast-avatar { width:42px; height:42px; border-radius:50%; object-fit:cover; flex-shrink:0; }
  .msg-toast-avatar-ph { width:42px; height:42px; border-radius:50%; flex-shrink:0; background:rgba(47,93,69,.12); color:#2f5d45; display:flex; align-items:center; justify-content:center; font-weight:700; font-size:1rem; font-family:"Marcellus",serif; }
  .msg-toast-body { flex:1; min-width:0; }
  .msg-toast-name { font-weight:700; font-size:.88rem; color:#2c1a0e; }
  .msg-toast-preview { font-size:.82rem; color:#6b4e35; margin-top:2px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
</style>

<script>
  // Tab switching
  const tabs = document.querySelectorAll('[data-tab]');
  const panels = { dashboard: document.getElementById('panel-dashboard'), sits: document.getElementById('panel-sits'), messages: document.getElementById('panel-messages'), profile: document.getElementById('panel-profile') };

  function switchTab(id: string) {
    tabs.forEach(btn => {
      const on = (btn as HTMLElement).dataset.tab === id;
      (btn as HTMLElement).style.color = on ? '#2f5d45' : '#6e5438';
      const line = btn.querySelector('.tab-line') as HTMLElement | null;
      if (line) line.style.background = on ? '#2f5d45' : 'transparent';
    });
    Object.entries(panels).forEach(([key, el]) => {
      if (el) el.style.display = key === id ? (key === 'dashboard' ? 'flex' : 'block') : 'none';
    });
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  tabs.forEach(btn => btn.addEventListener('click', () => switchTab((btn as HTMLElement).dataset.tab!)));

  // Copy URL
  const copyBtn = document.getElementById('copyBtn');
  copyBtn?.addEventListener('click', () => {
    const input = document.getElementById('shareUrl') as HTMLInputElement;
    input?.select();
    navigator.clipboard?.writeText(input?.value ?? '').then(() => {
      if (copyBtn) { copyBtn.textContent = 'Copied!'; setTimeout(() => { copyBtn.textContent = 'Copy'; }, 2000); }
    });
  });

  // Loading overlay
  const loader = document.querySelector('[data-loader]') as HTMLElement | null;
  const showLoader = () => {
    if (!loader) return;
    loader.style.opacity = '1';
    loader.style.pointerEvents = 'all';
  };
  document.querySelectorAll('a[href]').forEach(a => {
    const href = a.getAttribute('href') || '';
    if (href.startsWith('#') || href.startsWith('http') || href.startsWith('mailto') || href.startsWith('tel')) return;
    a.addEventListener('click', (e: Event) => { if ((e as MouseEvent).metaKey || (e as MouseEvent).ctrlKey || (e as MouseEvent).shiftKey) return; showLoader(); });
  });
  window.addEventListener('pageshow', e => {
    if (e.persisted && loader) { loader.style.opacity = '0'; loader.style.pointerEvents = 'none'; }
  });

  // Message notifications
  (function() {
    const seenIds = new Set<string>();
    let isFirst = true;

    function playNotifSound() {
      try {
        const ctx = new (window.AudioContext || (window as any).webkitAudioContext)();
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.frequency.setValueAtTime(660, ctx.currentTime);
        osc.frequency.setValueAtTime(880, ctx.currentTime + 0.1);
        osc.type = 'sine';
        gain.gain.setValueAtTime(0.08, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.4);
        osc.start(ctx.currentTime);
        osc.stop(ctx.currentTime + 0.4);
      } catch {}
    }

    function esc(str: string) {
      const d = document.createElement('div');
      d.textContent = str;
      return d.innerHTML;
    }

    function showToast(msg: any) {
      const container = document.getElementById('msgToasts');
      if (!container) return;
      const sender = msg.sender || {};
      const initial = (sender.name || '?').charAt(0).toUpperCase();
      const avatar = sender.profile_pic
        ? `<img src="${esc(sender.profile_pic)}" class="msg-toast-avatar" />`
        : `<div class="msg-toast-avatar-ph">${initial}</div>`;
      const toast = document.createElement('a') as HTMLAnchorElement;
      toast.href = `/messages/${msg.conversation_id}`;
      toast.className = 'msg-toast';
      toast.innerHTML = `${avatar}<div class="msg-toast-body"><div class="msg-toast-name">${esc(sender.name || 'Someone')}</div><div class="msg-toast-preview">${esc((msg.body || '').slice(0, 80))}</div></div>`;
      container.appendChild(toast);
      setTimeout(() => { toast.classList.add('toast-out'); setTimeout(() => toast.remove(), 300); }, 5000);
    }

    function updateBadge(count: number) {
      const nav = document.getElementById('navMsgBadge') as HTMLElement | null;
      if (!nav) return;
      const label = count > 99 ? '99+' : String(count);
      if (count > 0) { nav.textContent = label; nav.style.display = 'inline-flex'; }
      else { nav.style.display = 'none'; }
    }

    async function checkUnread() {
      try {
        const res = await fetch('/api/messages/unread');
        const data = await res.json();
        updateBadge(data.count || 0);
        if (data.messages) {
          if (!isFirst) {
            const fresh = data.messages.filter((m: any) => !seenIds.has(m.id));
            if (fresh.length > 0) {
              playNotifSound();
              fresh.slice(0, 3).forEach(showToast);
            }
          }
          data.messages.forEach((m: any) => seenIds.add(m.id));
        }
        isFirst = false;
      } catch {}
    }

    checkUnread();
    setInterval(checkUnread, 8000);
  })();
</script>
</body>
</html>
