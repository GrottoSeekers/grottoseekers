---
export const prerender = false;

import '../styles/global.css';
import { getSession } from '../lib/auth';

const session = await getSession(Astro.request);
if (session) return Astro.redirect('/dashboard');

const error = Astro.url.searchParams.get('error');
const detail = Astro.url.searchParams.get('detail');
const errorMessages: Record<string, string> = {
  missing: 'Please fill in all fields.',
  short: 'Password must be at least 8 characters.',
  mismatch: 'Passwords do not match.',
  exists: 'An account with that email already exists.',
  server: 'Something went wrong. Please try again.',
  db: `Database error: ${detail ?? 'unknown'}`,
};
const errorText = error ? (errorMessages[error] ?? 'Something went wrong. Please try again.') : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Lato:wght@300;400;700&display=swap" rel="stylesheet" />
    <title>Sign up — Grotto Sitters</title>
  </head>
  <body>
    <nav>
      <a href="/" class="nav-logo">Grotto <span>Sitters</span></a>
    </nav>

    <main class="auth-wrap">
      <div class="auth-card">
        <p class="section-label">Grotto Sitters</p>
        <h1 class="section-title">Create your account</h1>
        <div class="divider"></div>
        <p class="auth-intro">Join Grotto Sitters — whether you're offering pet sitting services or looking for a trusted sitter.</p>

        {errorText && <p class="auth-error">{errorText}</p>}

        <form method="POST" action="/api/auth/signup" class="auth-form">
          <div class="role-picker">
            <p class="role-label">I am a...</p>
            <div class="role-options">
              <label class="role-option">
                <input type="radio" name="role" value="sitter" checked />
                <div class="role-card">
                  <span class="role-icon">🐾</span>
                  <span class="role-name">Pet Sitter</span>
                  <span class="role-desc">I look after pets & homes</span>
                </div>
              </label>
              <label class="role-option">
                <input type="radio" name="role" value="owner" />
                <div class="role-card">
                  <span class="role-icon">🏠</span>
                  <span class="role-name">Pet Owner</span>
                  <span class="role-desc">I need a trusted sitter</span>
                </div>
              </label>
            </div>
          </div>
          <label>
            Email address
            <input type="email" name="email" required autocomplete="email" />
          </label>
          <label>
            Password
            <div class="password-wrap">
              <input type="password" name="password" required autocomplete="new-password" minlength="8" />
              <button type="button" class="pw-toggle" aria-label="Show password">Show</button>
            </div>
          </label>
          <label>
            Confirm password
            <div class="password-wrap">
              <input type="password" name="confirm" required autocomplete="new-password" minlength="8" />
              <button type="button" class="pw-toggle" aria-label="Show password">Show</button>
            </div>
          </label>
          <button type="submit" class="btn-primary" style="width:100%;margin-top:8px;">Create account</button>
        </form>

        <p class="auth-footer">
          Already have an account? <a href="/login">Log in</a>
        </p>
      </div>
    </main>

    <style>
      body { min-height: 100vh; display: flex; flex-direction: column; }
      nav { position: static; border-bottom: 1px solid rgba(200,150,62,0.2); padding: 18px 48px; }
      .auth-wrap {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 60px 24px;
      }
      .auth-card {
        background: #fff;
        border-radius: 12px;
        padding: 48px;
        width: 100%;
        max-width: 420px;
        box-shadow: 0 4px 32px rgba(44,26,14,0.08);
      }
      .auth-intro {
        font-size: 0.95rem;
        color: var(--text-soft);
        line-height: 1.6;
        margin-bottom: 24px;
      }
      .auth-error {
        background: #fef2f2;
        color: #b91c1c;
        border: 1px solid #fecaca;
        border-radius: 6px;
        padding: 12px 16px;
        font-size: 0.9rem;
        margin-bottom: 20px;
      }
      .auth-form {
        display: flex;
        flex-direction: column;
        gap: 20px;
      }
      .auth-form label {
        display: flex;
        flex-direction: column;
        gap: 6px;
        font-size: 0.85rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        color: var(--brown-mid);
        text-transform: uppercase;
      }
      .auth-form input {
        border: 1.5px solid rgba(44,26,14,0.2);
        border-radius: 6px;
        padding: 11px 14px;
        font-size: 1rem;
        font-family: "Lato", sans-serif;
        color: var(--text);
        background: var(--cream);
        outline: none;
        transition: border-color 0.2s;
      }
      .auth-form input:focus { border-color: var(--gold); }
      .auth-footer {
        margin-top: 24px;
        text-align: center;
        font-size: 0.9rem;
        color: var(--text-soft);
      }
      .auth-footer a { color: var(--gold); font-weight: 700; text-decoration: none; }
      .auth-footer a:hover { text-decoration: underline; }

      .role-picker { margin-bottom: 4px; }
      .role-label { font-size: 0.85rem; font-weight: 700; letter-spacing: 0.06em; color: var(--brown-mid); text-transform: uppercase; margin-bottom: 10px; }
      .role-options { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
      .role-option { cursor: pointer; }
      .role-option input { display: none; }
      .role-card {
        display: flex; flex-direction: column; align-items: center; gap: 4px;
        padding: 20px 12px; border: 2px solid rgba(44,26,14,0.12); border-radius: 10px;
        text-align: center; transition: border-color 0.2s, background 0.2s;
      }
      .role-option input:checked + .role-card { border-color: var(--gold); background: rgba(200,150,62,0.06); }
      .role-icon { font-size: 1.6rem; }
      .role-name { font-family: "Playfair Display", serif; font-size: 1rem; font-weight: 700; color: var(--brown-dark); }
      .role-desc { font-size: 0.75rem; color: var(--text-soft); }
      .password-wrap { position: relative; }
      .password-wrap input { width: 100%; padding-right: 60px; }
      .pw-toggle {
        position: absolute; right: 8px; top: 50%; transform: translateY(-50%);
        background: none; border: none; color: var(--gold); font-size: 0.78rem;
        font-weight: 700; letter-spacing: 0.04em; cursor: pointer; padding: 4px 8px;
        text-transform: uppercase; font-family: "Lato", sans-serif;
      }
      .pw-toggle:hover { color: var(--brown-dark); }
    </style>
    <script>
      document.querySelectorAll('.pw-toggle').forEach(btn => {
        btn.addEventListener('click', () => {
          const input = btn.previousElementSibling as HTMLInputElement;
          const showing = input.type === 'text';
          input.type = showing ? 'password' : 'text';
          btn.textContent = showing ? 'Show' : 'Hide';
        });
      });
    </script>
  </body>
</html>
