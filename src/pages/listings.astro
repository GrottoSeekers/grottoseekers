---
export const prerender = false;

import '../styles/global.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import { supabase } from '../lib/supabase';

const { data: listings } = await supabase
  .from('listings')
  .select('id, title, description, date_from, date_to, profile_id, profiles!inner(name, location, slug, profile_pic, pets_json)')
  .eq('status', 'active')
  .gte('date_to', new Date().toISOString().slice(0, 10))
  .order('date_from', { ascending: true });

const items = (listings ?? []) as any[];

function formatDate(d: string) {
  return new Date(d + 'T00:00:00').toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
}

function daysBetween(from: string, to: string) {
  const ms = new Date(to + 'T00:00:00').getTime() - new Date(from + 'T00:00:00').getTime();
  return Math.ceil(ms / 86400000);
}
---

<BaseLayout title="Browse sits — Grotto Sitters">
  <main class="listings-page">
    <div class="section-inner">
      <header class="listings-header">
        <p class="section-label">Available Sits</p>
        <h1 class="section-title">Find your next sit</h1>
        <div class="divider"></div>
        <p class="listings-intro">Browse homes looking for trusted sitters. Click any listing to see the full details, meet the pets, and get in touch.</p>
      </header>

      {items.length === 0 ? (
        <div class="empty-state">
          <div class="empty-icon">🔍</div>
          <h2>No sits available right now</h2>
          <p>Check back soon — new listings are posted regularly.</p>
        </div>
      ) : (
        <div class="listings-grid">
          {items.map((listing: any) => {
            const profile = listing.profiles;
            const pets: any[] = Array.isArray(profile?.pets_json) ? profile.pets_json : [];
            const duration = daysBetween(listing.date_from, listing.date_to);
            return (
              <a href={`/listings/${listing.id}`} class="listing-card">
                <div class="listing-card-header">
                  {profile?.profile_pic && (
                    <img src={profile.profile_pic} alt={profile.name} class="listing-avatar" />
                  )}
                  <div>
                    <h3 class="listing-title">{listing.title}</h3>
                    <p class="listing-owner">{profile?.name}</p>
                  </div>
                </div>
                <div class="listing-meta">
                  {profile?.location && <span class="listing-location">📍 {profile.location}</span>}
                  <span class="listing-dates">📅 {formatDate(listing.date_from)} — {formatDate(listing.date_to)}</span>
                  <span class="listing-duration">{duration} day{duration !== 1 ? 's' : ''}</span>
                </div>
                {pets.length > 0 && (
                  <div class="listing-pets">
                    🐾 {pets.map((p: any) => p.name).join(', ')}
                  </div>
                )}
                {listing.description && (
                  <p class="listing-desc">{listing.description.slice(0, 140)}{listing.description.length > 140 ? '…' : ''}</p>
                )}
              </a>
            );
          })}
        </div>
      )}
    </div>
  </main>

  <style>
    .listings-page { padding: 80px 48px 100px; }
    .listings-header { text-align: center; margin-bottom: 48px; }
    .listings-intro { font-size: 1rem; color: var(--text-soft); line-height: 1.7; max-width: 600px; margin: 0 auto; }

    .empty-state {
      background: #fff; border-radius: 12px; padding: 80px 48px; text-align: center;
      box-shadow: 0 2px 16px rgba(44,26,14,0.06); max-width: 520px; margin: 0 auto;
    }
    .empty-icon { font-size: 3rem; margin-bottom: 20px; }
    .empty-state h2 { font-family: "Playfair Display", serif; font-size: 1.6rem; color: var(--brown-dark); margin-bottom: 12px; }
    .empty-state p { font-size: 0.95rem; color: var(--text-soft); line-height: 1.7; }

    .listings-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 24px; }

    .listing-card {
      background: #fff; border-radius: 12px; padding: 28px; text-decoration: none; color: inherit;
      box-shadow: 0 2px 16px rgba(44,26,14,0.06); transition: transform 0.2s, box-shadow 0.2s;
      display: flex; flex-direction: column; gap: 16px;
    }
    .listing-card:hover { transform: translateY(-3px); box-shadow: 0 8px 32px rgba(44,26,14,0.12); }

    .listing-card-header { display: flex; gap: 16px; align-items: flex-start; }
    .listing-avatar { width: 52px; height: 52px; border-radius: 50%; object-fit: cover; flex-shrink: 0; }
    .listing-title { font-family: "Playfair Display", serif; font-size: 1.15rem; color: var(--brown-dark); margin-bottom: 2px; }
    .listing-owner { font-size: 0.85rem; color: var(--gold); font-weight: 600; }

    .listing-meta { display: flex; flex-wrap: wrap; gap: 12px; font-size: 0.82rem; color: var(--text-soft); }
    .listing-duration {
      background: rgba(200,150,62,0.1); color: var(--gold); font-weight: 700;
      padding: 2px 10px; border-radius: 20px; font-size: 0.78rem;
    }
    .listing-pets { font-size: 0.88rem; color: var(--brown-mid); }
    .listing-desc { font-size: 0.88rem; color: var(--text-soft); line-height: 1.6; }

    @media (max-width: 768px) {
      .listings-page { padding: 60px 24px 80px; }
      .listings-grid { grid-template-columns: 1fr; }
    }
  </style>
</BaseLayout>
