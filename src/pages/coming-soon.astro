---
export const prerender = false;
// "Launching soon" — all a visitor sees at myahsits.com before launch:
// a short note and the register-your-interest form. Nothing else to click.

const registered = Astro.url.searchParams.has('registered');
const error = Astro.url.searchParams.get('error');
const desc = "MYAH is a new home for house & pet sitters and home owners, launching soon. Register your interest and we'll tell you the moment it's live.";
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>MYAH — launching soon</title>
  <meta name="description" content={desc} />
  <link rel="icon" href="/images/favicon.png" />
  <link rel="apple-touch-icon" href="/images/app-tile.png" />
  <link rel="canonical" href="https://www.myahsits.com/" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://www.myahsits.com/" />
  <meta property="og:site_name" content="MYAH" />
  <meta property="og:title" content="MYAH — Make Yourself At Home. Launching soon" />
  <meta property="og:description" content={desc} />
  <meta property="og:image" content="https://www.myahsits.com/images/logo-tile.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Marcellus&family=Montserrat:wght@400;500;600&family=Lato:wght@400;700&display=swap" rel="stylesheet" />
  <style is:global>
    body { margin:0; background:#faf6ee; color:#2c1a0e; font-family:"Montserrat",sans-serif; }
    * { box-sizing:border-box; }
    a { color:#2f5d45; }
    .cs-top { padding:16px 48px; display:flex; justify-content:space-between; align-items:center; gap:24px; box-shadow:0 1px 0 rgba(110,84,56,.2); background:rgba(250,246,238,.97); }
    .cs-logo { display:inline-flex; align-items:center; gap:14px; text-decoration:none; line-height:1; font-weight:500; font-size:1.4rem; letter-spacing:.28em; }
    .cs-logo img { height:46px; width:46px; display:block; object-fit:contain; }
    .cs-logo > span { display:flex; flex-direction:column; gap:5px; padding-left:14px; border-left:1px solid rgba(110,84,56,.4); }
    .cs-logo b { color:#2f5d45; font-weight:500; }
    .cs-logo small { font-family:'Lato',sans-serif; font-weight:700; font-size:.5rem; letter-spacing:.2em; text-transform:uppercase; color:#8a6a4f; }
    .cs-pill { font-family:'Lato',sans-serif; font-size:.72rem; font-weight:700; letter-spacing:.18em; text-transform:uppercase; color:#2f5d45; background:#fff; border:1px solid rgba(47,93,69,.35); border-radius:50px; padding:9px 16px; white-space:nowrap; }
    main { max-width:620px; margin:0 auto; padding:88px 24px 96px; text-align:center; min-height:calc(100vh - 160px); display:flex; flex-direction:column; justify-content:center; }
    main .cs-eyebrow { justify-content:center; }
    main .cs-eyebrow::after { content:""; width:26px; height:1px; background:#6e5438; }
    main .cs-lead { margin-left:auto; margin-right:auto; }
    .cs-card { text-align:left; }
    .cs-eyebrow { font-family:'Lato',sans-serif; font-size:.75rem; font-weight:700; letter-spacing:.2em; text-transform:uppercase; color:#6e5438; margin:0 0 18px; display:flex; align-items:center; gap:12px; }
    .cs-eyebrow::before { content:""; width:26px; height:1px; background:#6e5438; }
    h1 { font-family:'Marcellus',serif; font-weight:400; font-size:3rem; line-height:1.12; margin:0 0 18px; }
    h1 em { font-style:normal; color:#2f5d45; }
    .cs-lead { color:#6b4e35; font-size:1.05rem; line-height:1.8; margin:0 0 30px; max-width:520px; }
    .cs-card { background:#fff; border:1px solid rgba(110,84,56,.22); border-radius:18px; padding:28px; box-shadow:0 1px 2px rgba(44,26,14,.04); }
    .cs-card h2 { font-family:'Marcellus',serif; font-weight:400; font-size:1.45rem; margin:0 0 6px; }
    .cs-card p { color:#6b4e35; font-size:.92rem; line-height:1.7; margin:0 0 18px; }
    .cs-form { display:flex; flex-direction:column; gap:12px; }
    .cs-form label { font-size:.72rem; font-weight:600; letter-spacing:.12em; text-transform:uppercase; color:#5c3d20; }
    .cs-form input[type=email] { width:100%; font:inherit; font-size:1rem; padding:14px 16px; border:1px solid rgba(110,84,56,.35); border-radius:12px; background:#faf6ee; color:#2c1a0e; }
    .cs-form input[type=email]:focus { outline:2px solid rgba(47,93,69,.35); border-color:#2f5d45; }
    .cs-roles { display:flex; gap:8px; flex-wrap:wrap; }
    .cs-roles label { display:inline-flex; align-items:center; gap:7px; text-transform:none; letter-spacing:0; font-size:.9rem; font-weight:500; color:#4a3726; background:#faf6ee; border:1px solid rgba(110,84,56,.25); border-radius:50px; padding:9px 14px; cursor:pointer; }
    .cs-roles input { accent-color:#2f5d45; }
    .cs-btn { font:inherit; font-size:.8rem; font-weight:600; letter-spacing:.1em; text-transform:uppercase; color:#fff; background:#2f5d45; border:0; border-radius:50px; padding:16px 28px; cursor:pointer; box-shadow:0 4px 14px rgba(44,26,14,.18); margin-top:6px; }
    .cs-btn:hover { background:#3e7a5b; }
    .cs-ok { background:#eef4ef; border:1px solid rgba(47,93,69,.3); color:#2f5d45; border-radius:12px; padding:14px 16px; font-size:.92rem; line-height:1.6; margin:0 0 14px; }
    .cs-err { background:#fbf0ec; border:1px solid rgba(160,82,45,.3); color:#8a3f1e; border-radius:12px; padding:12px 16px; font-size:.9rem; margin:0 0 14px; }
    .cs-trap { position:absolute; left:-9999px; }
    footer { border-top:1px solid rgba(110,84,56,.2); padding:26px 48px 32px; }
    footer .bar { max-width:1100px; margin:0 auto; display:flex; justify-content:space-between; gap:16px; flex-wrap:wrap; font-size:.76rem; font-weight:600; letter-spacing:.1em; text-transform:uppercase; color:#8a6a4f; }
    footer a { color:#6e5438; text-decoration:none; }
    @media (max-width:860px) {
      main { padding:48px 16px 64px; min-height:0; }
    }
    @media (max-width:640px) {
      .cs-top { padding:10px 16px; }
      .cs-logo img { height:36px; width:36px; }
      .cs-logo small { display:none; }
      .cs-pill { font-size:.62rem; padding:7px 12px; }
      h1 { font-size:2.2rem; }
      .cs-card { padding:22px 18px; }
      footer { padding:22px 16px 28px; }
    }
  </style>
</head>
<body>
  <header class="cs-top">
    <span class="cs-logo"><img src="/images/logo-mark.png" alt="" /><span><b>MYAH</b><small>Make Yourself At Home</small></span></span>
    <span class="cs-pill">Launching soon</span>
  </header>
  <main>
    <section>
      <p class="cs-eyebrow">Coming soon</p>
      <h1>House &amp; pet sitting, <em>made simple</em></h1>
      <p class="cs-lead">MYAH brings trusted house &amp; pet sitters and home owners together in one place. We're putting the finishing touches to it now.</p>
      <div class="cs-card" id="register">
        <h2>Register your interest</h2>
        <p>Leave your email and we'll let you know the moment MYAH launches.</p>
        {registered && <p class="cs-ok" role="status">Thank you, you're on the list. We'll email you as soon as MYAH is live.</p>}
        {error && <p class="cs-err" role="alert">{error === 'email' ? 'Please check your email address and try again.' : 'Something went wrong, please try again.'}</p>}
        <form class="cs-form" method="post" action="/api/interest" data-interest>
          <label for="cs-email">Email address</label>
          <input id="cs-email" type="email" name="email" required autocomplete="email" placeholder="you@example.com" />
          <input class="cs-trap" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <input type="hidden" name="source" value="coming-soon" />
          <div class="cs-roles" role="radiogroup" aria-label="I'm interested as a">
            <label><input type="radio" name="role" value="sitter" /> Sitter</label>
            <label><input type="radio" name="role" value="owner" /> Home owner</label>
            <label><input type="radio" name="role" value="both" /> Both</label>
          </div>
          <button class="cs-btn" type="submit">Notify me at launch</button>
        </form>
      </div>
    </section>
  </main>
  <footer>
    <div class="bar">
      <span>&copy; 2026 MYAH</span>
      <span><a href="/privacy">Privacy</a> &nbsp;·&nbsp; <a href="mailto:hello@myahsits.com">hello@myahsits.com</a></span>
    </div>
  </footer>
</body>
</html>
