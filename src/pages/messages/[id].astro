---
// One conversation
// opens in the inbox
// with it selected.
export const prerender =
  false;
import {
  getSession,
} from '../../lib/auth';
import {
  supabase,
} from
  '../../lib/supabase';

const session =
  await getSession(
    Astro.request,
  );
if (!session) {
  return Astro.redirect(
    '/login',
  );
}

const pr =
  await supabase
  .from('profiles')
  .select('id')
  .eq(
    'user_id',
    session.userId,
  )
  .single();
const profile: any =
  pr.data;
if (!profile) {
  return Astro.redirect(
    '/login',
  );
}

const convId =
  Astro.params.id || '';
const cr =
  await supabase
  .from('conversations')
  .select(
    'id,' +
    ' sitter_profile_id,' +
    ' owner_profile_id',
  )
  .eq('id', convId)
  .single();
const conv: any =
  cr.data;
const mine =
  conv &&
  (conv
    .sitter_profile_id ===
    profile.id ||
    conv
    .owner_profile_id ===
    profile.id);
if (!mine) {
  return Astro.redirect(
    '/messages',
  );
}

return Astro.redirect(
  '/messages?c=' +
  encodeURIComponent(
    convId,
  ),
);
---
